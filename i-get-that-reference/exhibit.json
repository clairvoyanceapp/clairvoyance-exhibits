    "type": "html",
    "bundle": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>References</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Serif+Display:ital@0;1&family=Inter:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n<style>\n:root{\n  --bg:#0b0710; --bg2:#150c1d; --ink:#f6efe4; --muted:#b6a8c2; --dim:#7d6f8a;\n  --gold:#ffc857; --red:#ff4d6d; --teal:#2ec4b6; --violet:#9b5de5; --blue:#4cc9f0;\n  --card:#1b1124; --line:rgba(255,255,255,.08);\n  --r:18px;\n}\n*{box-sizing:border-box;margin:0;padding:0}\nhtml,body{height:100%}\nbody{\n  font-family:Inter,system-ui,sans-serif;color:var(--ink);background:var(--bg);\n  background-image:\n    radial-gradient(1200px 600px at 10% -10%, rgba(155,93,229,.28), transparent 60%),\n    radial-gradient(900px 500px at 110% 10%, rgba(255,77,109,.20), transparent 60%),\n    radial-gradient(800px 600px at 50% 120%, rgba(46,196,182,.14), transparent 60%);\n  background-attachment:fixed;min-height:100vh;overflow-x:hidden;\n}\n/* film grain */\nbody::before{content:\"\";position:fixed;inset:0;pointer-events:none;z-index:100;opacity:.06;\n  background-image:url(\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>\");}\nbutton{font:inherit;color:inherit;cursor:pointer;border:0;background:none}\ninput,textarea,select{font:inherit;color:var(--ink)}\n\n/* marquee header */\n.marquee{position:relative;padding:34px 28px 26px;text-align:center;border-bottom:1px solid var(--line);\n  background:linear-gradient(180deg,rgba(0,0,0,.35),transparent)}\n.bulbs{position:absolute;left:0;right:0;height:10px;display:flex;justify-content:space-around}\n.bulbs.top{top:10px}.bulbs.bot{bottom:8px}\n.bulbs i{width:7px;height:7px;border-radius:50%;background:var(--gold);box-shadow:0 0 10px var(--gold),0 0 20px rgba(255,200,87,.5);animation:blink 1.6s infinite}\n.bulbs i:nth-child(odd){animation-delay:.8s}\n@keyframes blink{0%,100%{opacity:1}50%{opacity:.25}}\n.title{font-family:\"Bebas Neue\",sans-serif;font-size:clamp(56px,9vw,104px);letter-spacing:.06em;line-height:.9;\n  background:linear-gradient(180deg,#fff6d8 0%,var(--gold) 55%,#e08a1e 100%);-webkit-background-clip:text;background-clip:text;color:transparent;\n  filter:drop-shadow(0 4px 24px rgba(255,200,87,.35))}\n.tag{font-family:\"DM Serif Display\",serif;font-style:italic;color:var(--muted);font-size:19px;margin-top:6px}\n.stats{display:flex;gap:10px;justify-content:center;margin-top:16px;flex-wrap:wrap}\n.pill{font-size:12px;letter-spacing:.08em;text-transform:uppercase;padding:6px 12px;border-radius:999px;border:1px solid var(--line);background:rgba(255,255,255,.04);color:var(--muted)}\n.pill b{color:var(--ink)}\n\n/* toolbar */\n.bar{position:sticky;top:0;z-index:20;display:flex;gap:10px;align-items:center;flex-wrap:wrap;padding:14px 28px;\n  background:rgba(11,7,16,.78);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}\n.search{flex:1 1 240px;display:flex;align-items:center;gap:8px;background:rgba(255,255,255,.05);border:1px solid var(--line);border-radius:12px;padding:9px 12px}\n.search input{flex:1;background:none;border:0;outline:none}\n.chips{display:flex;gap:6px;flex-wrap:wrap}\n.chip{padding:7px 12px;border-radius:999px;font-size:13px;border:1px solid var(--line);background:rgba(255,255,255,.03);transition:.15s}\n.chip:hover{background:rgba(255,255,255,.08)}\n.chip.on{background:var(--ink);color:#120a18;border-color:transparent;font-weight:600}\n.btn{display:inline-flex;align-items:center;gap:8px;padding:10px 16px;border-radius:12px;font-weight:600;font-size:14px;transition:transform .12s, box-shadow .2s}\n.btn:active{transform:scale(.97)}\n.btn.primary{background:linear-gradient(135deg,var(--red),#ff8a5b);color:#fff;box-shadow:0 8px 24px rgba(255,77,109,.35)}\n.btn.primary:hover{box-shadow:0 10px 30px rgba(255,77,109,.55)}\n.btn.ghost{border:1px solid var(--line);background:rgba(255,255,255,.04)}\n.btn.ghost:hover{background:rgba(255,255,255,.09)}\n.btn.gold{background:var(--gold);color:#1a0f00}\n.btn.sm{padding:6px 10px;font-size:12px;border-radius:9px}\n\n/* tabs */\n.tabs{display:flex;gap:4px;padding:18px 28px 0}\n.tab{padding:10px 16px;border-radius:12px 12px 0 0;color:var(--muted);font-weight:600;font-size:14px;border-bottom:2px solid transparent}\n.tab.on{color:var(--ink);border-color:var(--gold)}\n\nmain{padding:22px 28px 80px}\n.grid{columns:340px;column-gap:18px}\n.card{break-inside:avoid;margin-bottom:18px;position:relative;border-radius:var(--r);background:var(--card);border:1px solid var(--line);\n  overflow:hidden;transition:transform .2s, box-shadow .25s;animation:rise .45s both}\n.card:hover{transform:translateY(-3px);box-shadow:0 18px 40px rgba(0,0,0,.45)}\n@keyframes rise{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}\n.card .strip{height:6px;background:var(--accent,var(--gold))}\n.card .sprockets{position:absolute;top:6px;bottom:0;left:0;width:14px;background:repeating-linear-gradient(180deg,transparent 0 8px,rgba(0,0,0,.55) 8px 14px);opacity:.5}\n.card .body{padding:20px 20px 16px 30px}\n.vibe{display:inline-block;font-size:11px;letter-spacing:.12em;text-transform:uppercase;font-weight:700;color:var(--accent,var(--gold));margin-bottom:10px}\n.quote{font-family:\"DM Serif Display\",serif;font-size:24px;line-height:1.2;position:relative}\n.quote::before{content:\"\\201C\";position:absolute;left:-18px;top:-10px;font-size:52px;color:var(--accent,var(--gold));opacity:.35}\n.src{margin-top:10px;color:var(--muted);font-size:13px}\n.src b{color:var(--ink);font-weight:600}\n.meaning{margin-top:14px;padding:12px 14px;border-radius:12px;background:rgba(255,255,255,.045);border-left:3px solid var(--accent,var(--gold));font-size:14px;line-height:1.5}\n.meaning small{display:block;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--dim);margin-bottom:4px;font-weight:700}\n.when{margin-top:8px;font-size:13px;color:var(--muted);line-height:1.45}\n.when em{color:var(--ink);font-style:normal}\n.explain{margin-top:10px;font-size:13px;line-height:1.5;color:#d9cfe4;padding:10px 12px;border-radius:10px;background:rgba(76,201,240,.08);border:1px dashed rgba(76,201,240,.35)}\n.foot{display:flex;align-items:center;gap:6px;margin-top:14px;flex-wrap:wrap}\n.who{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--muted);margin-right:auto}\n.av{width:26px;height:26px;border-radius:50%;display:grid;place-items:center;font-weight:700;font-size:12px;color:#120a18}\n.react{display:inline-flex;align-items:center;gap:5px;padding:5px 9px;border-radius:999px;font-size:12px;border:1px solid var(--line);background:rgba(255,255,255,.03);transition:.15s}\n.react:hover{background:rgba(255,255,255,.1)}\n.react.mine{border-color:var(--accent,var(--gold));background:rgba(255,200,87,.12)}\n.react .n{font-variant-numeric:tabular-nums;color:var(--muted)}\n.icon{opacity:.6;padding:5px;border-radius:8px}.icon:hover{opacity:1;background:rgba(255,255,255,.08)}\n\n/* empty */\n.empty{text-align:center;padding:60px 20px;max-width:560px;margin:0 auto}\n.empty .reel{font-size:64px;animation:spin 6s linear infinite;display:inline-block}\n@keyframes spin{to{transform:rotate(360deg)}}\n.empty h2{font-family:\"DM Serif Display\",serif;font-size:32px;margin:14px 0 8px}\n.empty p{color:var(--muted);line-height:1.6;margin-bottom:20px}\n\n/* decoder */\n.decoder{max-width:760px;margin:0 auto}\n.decoder h2{font-family:\"DM Serif Display\",serif;font-size:34px}\n.decoder p.lead{color:var(--muted);margin:6px 0 20px;line-height:1.55}\n.dbox{display:flex;gap:10px}\n.dbox input{flex:1;padding:14px 16px;border-radius:14px;background:rgba(255,255,255,.05);border:1px solid var(--line);outline:none;font-size:16px}\n.dbox input:focus{border-color:var(--gold)}\n.result{margin-top:20px}\n.spot{margin-top:26px;padding:28px;border-radius:22px;background:linear-gradient(135deg,rgba(155,93,229,.25),rgba(255,77,109,.18));border:1px solid var(--line);text-align:center}\n.spot .quote{font-size:30px}\n.spot .quote::before{display:none}\n\n/* people */\n.people{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:16px}\n.person{padding:18px;border-radius:var(--r);background:var(--card);border:1px solid var(--line)}\n.person h3{display:flex;align-items:center;gap:10px;font-size:17px}\n.person .av{width:36px;height:36px;font-size:15px}\n.meter{margin-top:14px;font-size:12px;color:var(--muted)}\n.meter .track{height:8px;border-radius:99px;background:rgba(255,255,255,.07);margin-top:6px;overflow:hidden}\n.meter .fill{height:100%;background:linear-gradient(90deg,var(--teal),var(--blue));border-radius:99px}\n.person ul{list-style:none;margin-top:12px;font-size:13px;color:var(--muted);line-height:1.7}\n\n/* modal */\n.scrim{position:fixed;inset:0;background:rgba(5,2,8,.7);backdrop-filter:blur(6px);display:none;align-items:center;justify-content:center;z-index:50;padding:20px}\n.scrim.open{display:flex;animation:fade .2s}\n@keyframes fade{from{opacity:0}}\n.modal{width:min(620px,100%);max-height:92vh;overflow:auto;border-radius:22px;background:var(--bg2);border:1px solid var(--line);box-shadow:0 30px 80px rgba(0,0,0,.6);animation:pop .25s}\n@keyframes pop{from{transform:scale(.96);opacity:0}}\n.modal header{padding:22px 24px 6px}\n.modal h2{font-family:\"DM Serif Display\",serif;font-size:28px}\n.modal header p{color:var(--muted);font-size:14px;margin-top:4px}\n.form{padding:14px 24px 24px;display:grid;gap:14px}\n.row{display:grid;grid-template-columns:1fr 1fr;gap:12px}\nlabel{display:grid;gap:6px;font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);font-weight:600}\n.form input,.form textarea,.form select{padding:11px 13px;border-radius:11px;background:rgba(255,255,255,.05);border:1px solid var(--line);outline:none;text-transform:none;letter-spacing:0;font-weight:400;font-size:15px}\n.form input:focus,.form textarea:focus,.form select:focus{border-color:var(--gold)}\n.form textarea{resize:vertical;min-height:70px}\n.form select option{background:#1b1124}\n.form .actions{display:flex;gap:10px;justify-content:flex-end;align-items:center;margin-top:4px}\n.hint{font-size:12px;color:var(--dim);margin-right:auto}\n\n.toast{position:fixed;bottom:22px;left:50%;transform:translateX(-50%) translateY(40px);opacity:0;padding:12px 18px;border-radius:12px;background:var(--ink);color:#120a18;font-weight:600;font-size:14px;transition:.3s;z-index:60;pointer-events:none}\n.toast.show{opacity:1;transform:translateX(-50%)}\n.banner{margin:14px 28px 0;padding:10px 14px;border-radius:12px;font-size:13px;background:rgba(255,200,87,.1);border:1px solid rgba(255,200,87,.3);color:#ffe2a3;display:none}\n.banner.show{display:block}\n.spinner{display:inline-block;width:12px;height:12px;border:2px solid currentColor;border-right-color:transparent;border-radius:50%;animation:spin .7s linear infinite}\n@media (max-width:600px){.row{grid-template-columns:1fr}.bar,.tabs,main{padding-left:14px;padding-right:14px}}\n</style>\n</head>\n<body>\n<header class=\"marquee\">\n  <div class=\"bulbs top\" id=\"bulbsTop\"></div>\n  <h1 class=\"title\">References</h1>\n  <div class=\"tag\">Say it with a movie line. Explain what you actually mean.</div>\n  <div class=\"stats\" id=\"stats\"></div>\n  <div class=\"bulbs bot\" id=\"bulbsBot\"></div>\n</header>\n<div class=\"banner\" id=\"banner\"></div>\n\n<nav class=\"tabs\">\n  <button class=\"tab on\" data-tab=\"wall\">🎞️ The Wall</button>\n  <button class=\"tab\" data-tab=\"decoder\">🔎 Decoder</button>\n  <button class=\"tab\" data-tab=\"people\">🍿 The Cast</button>\n</nav>\n\n<div class=\"bar\" id=\"bar\">\n  <div class=\"search\">🔍<input id=\"q\" placeholder=\"Search quotes, movies, meanings, people…\"></div>\n  <div class=\"chips\" id=\"chips\"></div>\n  <button class=\"btn primary\" id=\"addBtn\">＋ Share a reference</button>\n</div>\n\n<main id=\"main\"></main>\n\n<div class=\"scrim\" id=\"scrim\">\n  <div class=\"modal\" role=\"dialog\" aria-modal=\"true\">\n    <header>\n      <h2 id=\"mTitle\">Share a reference</h2>\n      <p>The line is half of it. The other half is what <em>you</em> mean when you say it.</p>\n    </header>\n    <form class=\"form\" id=\"form\">\n      <label>The quote<textarea id=\"fQuote\" required maxlength=\"280\" placeholder=\"e.g. We're gonna need a bigger boat.\"></textarea></label>\n      <div class=\"row\">\n        <label>Movie<input id=\"fMovie\" required maxlength=\"80\" placeholder=\"Jaws\"></label>\n        <label>Year<input id=\"fYear\" maxlength=\"4\" inputmode=\"numeric\" placeholder=\"1975\"></label>\n      </div>\n      <div class=\"row\">\n        <label>Who says it<input id=\"fChar\" maxlength=\"60\" placeholder=\"Chief Brody\"></label>\n        <label>Vibe<select id=\"fVibe\"></select></label>\n      </div>\n      <label>When I say it, I mean…<textarea id=\"fMeaning\" required maxlength=\"400\" placeholder=\"This problem is way bigger than we planned for, and we need more resources.\"></textarea></label>\n      <label>I'd use it when…<input id=\"fWhen\" maxlength=\"160\" placeholder=\"the scope of a task just tripled in a meeting\"></label>\n      <label>Shared by<input id=\"fBy\" required maxlength=\"40\" placeholder=\"Your name\"></label>\n      <div class=\"actions\">\n        <span class=\"hint\" id=\"fHint\"></span>\n        <button type=\"button\" class=\"btn ghost\" id=\"cancelBtn\">Cancel</button>\n        <button type=\"submit\" class=\"btn primary\" id=\"saveBtn\">Add to the wall</button>\n      </div>\n    </form>\n  </div>\n</div>\n<div class=\"toast\" id=\"toast\"></div>\n<script>\n(function(){\n\"use strict\";\nvar cv = window.clairvoyance || null;\nvar KEY = \"refs:v1\", ME_KEY = \"refs:me\";\nvar VIBES = [\n  {id:\"all\",label:\"All\",color:\"#ffc857\"},\n  {id:\"warning\",label:\"⚠️ Warning\",color:\"#ff4d6d\"},\n  {id:\"hype\",label:\"🔥 Hype\",color:\"#ff8a5b\"},\n  {id:\"deadpan\",label:\"😐 Deadpan\",color:\"#9b5de5\"},\n  {id:\"wisdom\",label:\"🧠 Wisdom\",color:\"#2ec4b6\"},\n  {id:\"chaos\",label:\"🌀 Chaos\",color:\"#4cc9f0\"},\n  {id:\"heart\",label:\"💛 Heart\",color:\"#f7b2d9\"}\n];\nvar REACTS = [\n  {id:\"got\",e:\"🎯\",t:\"I get it\"},\n  {id:\"unseen\",e:\"🙈\",t:\"Never seen it\"},\n  {id:\"lol\",e:\"😂\",t:\"Love it\"}\n];\nvar STARTER = [\n  {quote:\"We're gonna need a bigger boat.\",movie:\"Jaws\",year:\"1975\",character:\"Chief Brody\",vibe:\"warning\",meaning:\"This is way bigger than we planned for. Our current resources won't cut it.\",when:\"scope triples in the middle of a meeting\"},\n  {quote:\"I'll be back.\",movie:\"The Terminator\",year:\"1984\",character:\"The Terminator\",vibe:\"deadpan\",meaning:\"I'm stepping away, but this isn't finished. I'm returning to it.\",when:\"leaving for lunch mid-argument\"},\n  {quote:\"Houston, we have a problem.\",movie:\"Apollo 13\",year:\"1995\",character:\"Jim Lovell\",vibe:\"warning\",meaning:\"Something serious just broke. Calmly stop what you're doing and look at this.\",when:\"the build is red five minutes before a demo\"},\n  {quote:\"Just keep swimming.\",movie:\"Finding Nemo\",year:\"2003\",character:\"Dory\",vibe:\"heart\",meaning:\"It's rough right now, but don't stop. Steady progress gets us through.\",when:\"a teammate is grinding through a brutal week\"},\n  {quote:\"Do. Or do not. There is no try.\",movie:\"The Empire Strikes Back\",year:\"1980\",character:\"Yoda\",vibe:\"wisdom\",meaning:\"Commit fully or don't start. Half-effort is the worst option.\",when:\"someone says they'll 'try to look at it'\"},\n  {quote:\"Why so serious?\",movie:\"The Dark Knight\",year:\"2008\",character:\"The Joker\",vibe:\"chaos\",meaning:\"Lighten up. Everyone's wound too tight about this.\",when:\"a thread has gotten unnecessarily tense\"}\n];\n\nvar state = {refs:[], me:\"\", vibe:\"all\", q:\"\", tab:\"wall\", editing:null, explaining:{}, explanations:{}};\nvar canStore = false, canAI = false, canClip = false;\n\nfunction $(id){return document.getElementById(id)}\nfunction esc(s){return String(s==null?\"\":s).replace(/[&<>\"']/g,function(c){return {\"&\":\"&amp;\",\"<\":\"&lt;\",\">\":\"&gt;\",'\"':\"&quot;\",\"'\":\"&#39;\"}[c]})}\nfunction uid(){return \"r\"+Date.now().toString(36)+Math.random().toString(36).slice(2,7)}\nfunction vibe(id){for(var i=1;i<VIBES.length;i++)if(VIBES[i].id===id)return VIBES[i];return VIBES[1]}\nfunction hue(name){name=name||\"\";var h=0;for(var i=0;i<name.length;i++)h=(h*31+name.charCodeAt(i))%360;return \"hsl(\"+h+\",80%,70%)\"}\nfunction initial(n){return (n||\"?\").trim().charAt(0).toUpperCase()||\"?\"}\nfunction toast(msg){var t=$(\"toast\");t.textContent=msg;t.classList.add(\"show\");clearTimeout(toast._t);toast._t=setTimeout(function(){t.classList.remove(\"show\")},2200)}\nfunction banner(msg){var b=$(\"banner\");if(!msg){b.classList.remove(\"show\");return}b.innerHTML=msg;b.classList.add(\"show\")}\n\n[\"bulbsTop\",\"bulbsBot\"].forEach(function(id){var h=\"\";for(var i=0;i<34;i++)h+=\"<i></i>\";$(id).innerHTML=h});\n\n/* ---------- capabilities + persistence ---------- */\nfunction grantedSet(caps){\n  var g = caps && (caps.granted || caps.capabilities || caps);\n  return function(c){\n    if(Array.isArray(g)) return g.some(function(x){return x===c || (x && (x.name===c || x.id===c) && x.granted!==false)});\n    if(g && typeof g===\"object\") return !!g[c];\n    return false;\n  };\n}\nasync function init(){\n  if(cv && typeof cv.capabilities===\"function\"){\n    try{\n      var has = grantedSet(await cv.capabilities());\n      canStore = has(\"storage.kv\"); canAI = has(\"ai\"); canClip = has(\"clipboard.writeText\");\n    }catch(e){}\n  }\n  // Grants can be prompt-on-first-use; fall back to probing the bridge directly.\n  if(cv && cv.storage && !canStore) canStore = true;\n  if(cv && cv.ai && !canAI) canAI = true;\n  if(cv && cv.clipboard && !canClip) canClip = true;\n\n  if(cv && cv.storage && canStore){\n    try{\n      var refs = await cv.storage.get(KEY);\n      var me = await cv.storage.get(ME_KEY);\n      state.refs = Array.isArray(refs) ? refs : [];\n      state.me = (me && me.name) || \"\";\n    }catch(e){\n      canStore=false;\n      banner(\"⚠️ Couldn't open storage (\"+esc((e && e.message) || \"permission denied\")+\"). References will only last until you close this exhibit.\");\n    }\n  } else {\n    banner(\"⚠️ The Clairvoyance storage bridge isn't available here, so references won't be saved between sessions.\");\n  }\n  render();\n}\nasync function save(){\n  if(!(cv && cv.storage && canStore)) return;\n  try{ await cv.storage.set(KEY, state.refs); }\n  catch(e){ toast(\"Couldn't save: \"+((e && e.message) || \"storage error\")); }\n}\nasync function saveMe(){ if(cv && cv.storage && canStore){ try{ await cv.storage.set(ME_KEY,{name:state.me}); }catch(e){} } }\n\nasync function askAI(prompt, system){\n  if(!(cv && cv.ai && canAI)) throw new Error(\"AI isn't available in this runtime.\");\n  var res = await cv.ai.complete({prompt:prompt, system:system, maxTokens:220});\n  if(typeof res === \"string\") return res.trim();\n  var t = res && (res.text || res.content || res.completion || (res.output && res.output.text));\n  if(Array.isArray(t)) t = t.map(function(x){return x.text||\"\"}).join(\"\");\n  if(!t) throw new Error((res && res.error) || \"Empty AI response.\");\n  return String(t).trim();\n}\n\n/* ---------- filtering ---------- */\nfunction filtered(){\n  var q = state.q.toLowerCase().trim();\n  return state.refs.filter(function(r){\n    if(state.vibe!==\"all\" && r.vibe!==state.vibe) return false;\n    if(!q) return true;\n    return [r.quote,r.movie,r.character,r.meaning,r.when,r.by,r.year].join(\" \").toLowerCase().indexOf(q)>=0;\n  }).sort(function(a,b){return (b.at||0)-(a.at||0)});\n}\nfunction countR(r,id){return (r.reacts && r.reacts[id] ? r.reacts[id].length : 0)}\nfunction mine(r,id){return !!(state.me && r.reacts && r.reacts[id] && r.reacts[id].indexOf(state.me)>=0)}\n\r\n/* ---------- render ---------- */\r\nfunction renderStats(){\r\n  var people = {}, movies = {};\r\n  state.refs.forEach(function(r){people[r.by]=1; movies[(r.movie||\"\").toLowerCase()]=1});\r\n  $(\"stats\").innerHTML =\r\n    '<span class=\"pill\"><b>'+state.refs.length+'</b> references</span>'+\r\n    '<span class=\"pill\"><b>'+Object.keys(movies).length+'</b> movies</span>'+\r\n    '<span class=\"pill\"><b>'+Object.keys(people).length+'</b> people</span>'+\r\n    (state.me?'<span class=\"pill\">You are <b>'+esc(state.me)+'</b> · <button id=\"who\" style=\"text-decoration:underline\">change</button></span>':'');\r\n  var w=$(\"who\"); if(w) w.onclick=function(){ askName(); };\r\n}\r\nfunction renderChips(){\r\n  $(\"chips\").innerHTML = VIBES.map(function(v){\r\n    return '<button class=\"chip'+(state.vibe===v.id?' on':'')+'\" data-v=\"'+v.id+'\">'+esc(v.label)+'</button>';\r\n  }).join(\"\");\r\n}\r\nfunction cardHTML(r, i){\r\n  var v = vibe(r.vibe);\r\n  var exp = state.explanations[r.id] || r.explain;\r\n  var reacts = REACTS.map(function(x){\r\n    var who = r.reacts && r.reacts[x.id] && r.reacts[x.id].length ? \": \"+r.reacts[x.id].join(\", \") : \"\";\r\n    return '<button class=\"react'+(mine(r,x.id)?' mine':'')+'\" data-act=\"react\" data-id=\"'+r.id+'\" data-r=\"'+x.id+'\" title=\"'+esc(x.t+who)+'\">'+x.e+' <span class=\"n\">'+countR(r,x.id)+'</span></button>';\r\n  }).join(\"\");\r\n  return '<article class=\"card\" style=\"--accent:'+v.color+';animation-delay:'+Math.min(i*40,400)+'ms\">'+\r\n    '<div class=\"strip\"></div><div class=\"sprockets\"></div><div class=\"body\">'+\r\n    '<span class=\"vibe\">'+esc(v.label)+'</span>'+\r\n    '<div class=\"quote\">'+esc(r.quote)+'</div>'+\r\n    '<div class=\"src\">— '+(r.character?esc(r.character)+', ':'')+'<b>'+esc(r.movie)+'</b>'+(r.year?' ('+esc(r.year)+')':'')+'</div>'+\r\n    '<div class=\"meaning\"><small>What I mean</small>'+esc(r.meaning)+'</div>'+\r\n    (r.when?'<div class=\"when\">Use it when <em>'+esc(r.when)+'</em>.</div>':'')+\r\n    (exp?'<div class=\"explain\">🎬 <b>Never seen it?</b> '+esc(exp)+'</div>':'')+\r\n    '<div class=\"foot\">'+\r\n      '<span class=\"who\"><span class=\"av\" style=\"background:'+hue(r.by)+'\">'+esc(initial(r.by))+'</span>'+esc(r.by)+'</span>'+\r\n      reacts+\r\n      '<button class=\"icon\" data-act=\"explain\" data-id=\"'+r.id+'\" title=\"Explain the scene for anyone who has not seen it\">'+(state.explaining[r.id]?'<span class=\"spinner\"></span>':'💡')+'</button>'+\r\n      '<button class=\"icon\" data-act=\"copy\" data-id=\"'+r.id+'\" title=\"Copy\">📋</button>'+\r\n      (r.by===state.me?'<button class=\"icon\" data-act=\"edit\" data-id=\"'+r.id+'\" title=\"Edit\">✏️</button><button class=\"icon\" data-act=\"del\" data-id=\"'+r.id+'\" title=\"Delete\">🗑️</button>':'')+\r\n    '</div></div></article>';\r\n}\r\nfunction renderWall(){\r\n  var list = filtered();\r\n  if(!state.refs.length){\r\n    return '<div class=\"empty\"><div class=\"reel\">🎞️</div><h2>The wall is empty.</h2>'+\r\n      '<p>Share the movie lines you actually use, and say what you mean by them. Your coworkers will finally understand why you said “I’ll be back” and walked out of standup.</p>'+\r\n      '<div style=\"display:flex;gap:10px;justify-content:center;flex-wrap:wrap\"><button class=\"btn primary\" data-act=\"add\">＋ Share the first one</button>'+\r\n      '<button class=\"btn ghost\" data-act=\"starter\">🍿 Load a starter pack</button></div></div>';\r\n  }\r\n  if(!list.length) return '<div class=\"empty\"><div class=\"reel\">🔍</div><h2>No matches.</h2><p>Nothing on the wall matches that. Maybe it’s yours to add.</p><button class=\"btn primary\" data-act=\"add\">＋ Share a reference</button></div>';\r\n  return '<div class=\"grid\">'+list.map(cardHTML).join(\"\")+'</div>';\r\n}\r\nfunction renderDecoder(){\r\n  return '<div class=\"decoder\"><h2>The Decoder</h2>'+\r\n    '<p class=\"lead\">Type what you <em>want to say</em> to find the reference for it, or paste a line someone threw at you to find out what they meant.</p>'+\r\n    '<form class=\"dbox\" id=\"dform\"><input id=\"dq\" placeholder=\"e.g. “this is bigger than we thought” or “I’ll be back”\" autocomplete=\"off\"><button class=\"btn gold\">Decode</button></form>'+\r\n    '<div class=\"result\" id=\"dres\"></div>'+\r\n    (state.refs.length?'<div class=\"spot\" id=\"spot\"></div><div style=\"text-align:center;margin-top:12px\"><button class=\"btn ghost\" id=\"shuffle\">🎲 Random reference</button></div>':'')+\r\n    '</div>';\r\n}\r\nfunction renderPeople(){\r\n  var by = {};\r\n  state.refs.forEach(function(r){ (by[r.by]=by[r.by]||[]).push(r); });\r\n  var names = Object.keys(by);\r\n  if(!names.length) return '<div class=\"empty\"><div class=\"reel\">🍿</div><h2>No cast yet.</h2><p>Once people share references, you’ll see who speaks which movie, and how well the room gets them.</p></div>';\r\n  return '<div class=\"people\">'+names.sort().map(function(n){\r\n    var rs = by[n], got=0, total=0, unseen=0, movies={};\r\n    rs.forEach(function(r){ var g=countR(r,\"got\"), u=countR(r,\"unseen\"); got+=g; unseen+=u; total+=g+u; movies[r.movie]=(movies[r.movie]||0)+1; });\r\n    var pct = total? Math.round(got/total*100) : 0;\r\n    var top = Object.keys(movies).sort(function(a,b){return movies[b]-movies[a]}).slice(0,3);\r\n    return '<div class=\"person\"><h3><span class=\"av\" style=\"background:'+hue(n)+'\">'+esc(initial(n))+'</span>'+esc(n)+'</h3>'+\r\n      '<div class=\"meter\">Understood by the room: <b style=\"color:var(--ink)\">'+(total?pct+'%':'no votes yet')+'</b>'+\r\n      '<div class=\"track\"><div class=\"fill\" style=\"width:'+pct+'%\"></div></div></div>'+\r\n      '<ul><li>🎞️ '+rs.length+' reference'+(rs.length>1?'s':'')+'</li><li>🎬 Speaks fluent: '+top.map(esc).join(\", \")+'</li>'+\r\n      (unseen?'<li>🙈 '+unseen+' “never seen it” from others</li>':'')+'</ul></div>';\r\n  }).join(\"\")+'</div>';\r\n}\r\nfunction render(){\r\n  renderStats(); renderChips();\r\n  $(\"bar\").style.display = state.tab===\"wall\" ? \"\" : \"none\";\r\n  document.querySelectorAll(\".tab\").forEach(function(t){t.classList.toggle(\"on\",t.dataset.tab===state.tab)});\r\n  var m=$(\"main\");\r\n  if(state.tab===\"wall\") m.innerHTML = renderWall();\r\n  else if(state.tab===\"decoder\"){ m.innerHTML = renderDecoder(); wireDecoder(); }\r\n  else m.innerHTML = renderPeople();\r\n}\r\n\r\n/* ---------- decoder ---------- */\r\nvar STOP = {the:1,a:1,an:1,and:1,or:1,to:1,of:1,is:1,it:1,i:1,we:1,you:1,this:1,that:1,in:1,on:1,for:1,be:1,are:1,was:1,me:1,my:1,our:1,just:1,so:1,but:1,with:1,what:1,when:1,than:1};\r\nfunction words(s){return (s||\"\").toLowerCase().replace(/[^a-z0-9' ]/g,\" \").split(/\\s+/).filter(function(w){return w.length>2&&!STOP[w]})}\r\nfunction scoreRef(r, q){\r\n  var qs = words(q); if(!qs.length) return 0;\r\n  var hay = words([r.quote,r.meaning,r.when,r.movie,r.character].join(\" \"));\r\n  var set = {}; hay.forEach(function(w){set[w]=1});\r\n  var s=0; qs.forEach(function(w){ if(set[w]) s+=1; else if(hay.some(function(h){return h.indexOf(w)===0||w.indexOf(h)===0})) s+=.5; });\r\n  if(r.quote.toLowerCase().indexOf(q.toLowerCase().trim())>=0) s+=5;\r\n  return s/qs.length;\r\n}\r\nfunction spotHTML(r){\r\n  var v = vibe(r.vibe);\r\n  return '<div class=\"vibe\" style=\"color:'+v.color+'\">'+esc(v.label)+'</div><div class=\"quote\">“'+esc(r.quote)+'”</div>'+\r\n    '<div class=\"src\">— '+esc(r.movie)+(r.year?' ('+esc(r.year)+')':'')+' · shared by '+esc(r.by)+'</div>'+\r\n    '<div class=\"meaning\" style=\"text-align:left;margin-top:16px\"><small>Translation</small>'+esc(r.meaning)+'</div>';\r\n}\r\nfunction wireDecoder(){\r\n  var shuffle = $(\"shuffle\");\r\n  var pick = function(){ var r = state.refs[Math.floor(Math.random()*state.refs.length)]; $(\"spot\").innerHTML = spotHTML(r); };\r\n  if(shuffle){ shuffle.onclick = pick; pick(); }\r\n  $(\"dform\").onsubmit = async function(e){\r\n    e.preventDefault();\r\n    var q = $(\"dq\").value.trim(); if(!q) return;\r\n    var res = $(\"dres\");\r\n    var ranked = state.refs.map(function(r){return {r:r,s:scoreRef(r,q)}}).filter(function(x){return x.s>=.34}).sort(function(a,b){return b.s-a.s}).slice(0,3);\r\n    var html = '';\r\n    if(ranked.length){\r\n      html += '<p style=\"color:var(--muted);margin-bottom:12px\">From the wall:</p><div class=\"grid\">'+ranked.map(function(x,i){return cardHTML(x.r,i)}).join(\"\")+'</div>';\r\n    } else {\r\n      html += '<p style=\"color:var(--muted)\">Nobody on the wall has used that one yet.</p>';\r\n    }\r\n    html += '<div id=\"aiBox\" style=\"margin-top:16px\"></div>';\r\n    res.innerHTML = html;\r\n    var box = $(\"aiBox\");\r\n    if(!(cv && cv.ai && canAI)){ box.innerHTML = '<p class=\"hint\">AI suggestions need the Clairvoyance AI bridge, which isn’t available here.</p>'; return; }\r\n    box.innerHTML = '<button class=\"btn ghost\" id=\"aiGo\">✨ Ask AI for a reference</button>';\r\n    $(\"aiGo\").onclick = async function(){\r\n      box.innerHTML = '<p style=\"color:var(--muted)\"><span class=\"spinner\"></span> Consulting the projectionist…</p>';\r\n      try{\r\n        var t = await askAI(\r\n          'Input: \"'+q+'\"\\nIf this is a movie quote, explain in 2 sentences what someone usually means when they say it at work or among friends, and name the movie. Otherwise, suggest ONE well-known, short movie line someone could say to express this, formatted as: \"Quote\" — Movie (Year). Then one sentence on why it fits. Keep it under 70 words.',\r\n          \"You are a witty film buff who helps coworkers understand each other's movie references. Be accurate; if unsure of a quote, say so.\"\r\n        );\r\n        box.innerHTML = '<div class=\"explain\" style=\"font-size:14px\">✨ '+esc(t).replace(/\\n/g,\"<br>\")+'</div>';\r\n      }catch(err){\r\n        box.innerHTML = '<p class=\"hint\" style=\"color:var(--red)\">AI couldn’t answer: '+esc(err.message||err)+'</p>';\r\n      }\r\n    };\r\n  };\r\n}\r\n\n/* ---------- name dialog (prompt() is blocked in sandboxed iframes) ---------- */\nvar nameScrim = document.createElement(\"div\");\nnameScrim.className = \"scrim\";\nnameScrim.innerHTML = '<div class=\"modal\" style=\"width:min(420px,100%)\"><header><h2>Who’s in the theater?</h2><p>Your name shows on references and reactions.</p></header>'+\n  '<form class=\"form\" id=\"nform\"><label>Your name<input id=\"nIn\" required maxlength=\"40\" placeholder=\"e.g. Brad\"></label>'+\n  '<div class=\"actions\"><button type=\"button\" class=\"btn ghost\" id=\"nCancel\">Cancel</button><button class=\"btn primary\">Take a seat</button></div></form></div>';\ndocument.body.appendChild(nameScrim);\nvar nameThen = null;\nfunction askName(then){\n  nameThen = then || null;\n  $(\"nIn\").value = state.me || \"\";\n  nameScrim.classList.add(\"open\");\n  setTimeout(function(){ $(\"nIn\").focus(); }, 30);\n}\n$(\"nform\").onsubmit = function(e){\n  e.preventDefault();\n  var n = $(\"nIn\").value.trim().slice(0,40); if(!n) return;\n  state.me = n; saveMe(); nameScrim.classList.remove(\"open\");\n  var t = nameThen; nameThen = null; render(); if(t) t();\n};\n$(\"nCancel\").onclick = function(){ nameThen=null; nameScrim.classList.remove(\"open\"); };\nfunction needName(then){ if(state.me) return then(); askName(then); }\n\n/* ---------- add / edit modal ---------- */\n$(\"fVibe\").innerHTML = VIBES.slice(1).map(function(v){return '<option value=\"'+v.id+'\">'+esc(v.label)+'</option>'}).join(\"\");\nfunction openForm(ref){\n  state.editing = ref ? ref.id : null;\n  $(\"mTitle\").textContent = ref ? \"Edit reference\" : \"Share a reference\";\n  $(\"saveBtn\").textContent = ref ? \"Save changes\" : \"Add to the wall\";\n  $(\"fQuote\").value = ref ? ref.quote : \"\";\n  $(\"fMovie\").value = ref ? ref.movie : \"\";\n  $(\"fYear\").value = ref ? (ref.year||\"\") : \"\";\n  $(\"fChar\").value = ref ? (ref.character||\"\") : \"\";\n  $(\"fVibe\").value = ref ? ref.vibe : \"warning\";\n  $(\"fMeaning\").value = ref ? ref.meaning : \"\";\n  $(\"fWhen\").value = ref ? (ref.when||\"\") : \"\";\n  $(\"fBy\").value = ref ? ref.by : state.me;\n  $(\"fHint\").textContent = canStore ? \"\" : \"Not saved between sessions.\";\n  $(\"scrim\").classList.add(\"open\");\n  setTimeout(function(){ $(\"fQuote\").focus(); }, 30);\n}\nfunction closeForm(){ $(\"scrim\").classList.remove(\"open\"); state.editing=null; }\n$(\"cancelBtn\").onclick = closeForm;\n$(\"scrim\").addEventListener(\"mousedown\", function(e){ if(e.target===$(\"scrim\")) closeForm(); });\nnameScrim.addEventListener(\"mousedown\", function(e){ if(e.target===nameScrim) nameScrim.classList.remove(\"open\"); });\ndocument.addEventListener(\"keydown\", function(e){ if(e.key===\"Escape\"){ closeForm(); nameScrim.classList.remove(\"open\"); } });\n\n$(\"form\").onsubmit = function(e){\n  e.preventDefault();\n  var year = $(\"fYear\").value.replace(/\\D/g,\"\").slice(0,4);\n  var by = $(\"fBy\").value.trim().slice(0,40);\n  var data = {\n    quote: $(\"fQuote\").value.trim().replace(/^[\"“]|[\"”]$/g,\"\"),\n    movie: $(\"fMovie\").value.trim(), year: year,\n    character: $(\"fChar\").value.trim(), vibe: $(\"fVibe\").value,\n    meaning: $(\"fMeaning\").value.trim(), when: $(\"fWhen\").value.trim().replace(/\\.$/,\"\"), by: by\n  };\n  if(!data.quote || !data.movie || !data.meaning || !by) return;\n  if(!state.me){ state.me = by; saveMe(); }\n  if(state.editing){\n    var r = state.refs.find(function(x){return x.id===state.editing});\n    if(r){ Object.assign(r, data); if(r.explain && r.movie!==data.movie) delete r.explain; }\n    toast(\"Reference updated ✏️\");\n  } else {\n    data.id = uid(); data.at = Date.now(); data.reacts = {};\n    state.refs.push(data);\n    toast(\"Rolling! 🎬 Added to the wall\");\n  }\n  closeForm(); save(); state.tab=\"wall\"; render();\n};\n\n/* ---------- actions ---------- */\nasync function explain(r){\n  if(state.explanations[r.id] || r.explain){ delete state.explanations[r.id]; delete r.explain; save(); render(); return; }\n  if(!(cv && cv.ai && canAI)){ toast(\"AI explanations need the Clairvoyance AI bridge\"); return; }\n  state.explaining[r.id] = true; render();\n  try{\n    var t = await askAI(\n      'Quote: \"'+r.quote+'\" from '+r.movie+(r.year?' ('+r.year+')':'')+(r.character?', said by '+r.character:'')+'.\\nIn 2 short sentences, explain the scene and why the line is memorable, for someone who has never seen the movie. No spoilers beyond what is needed. Under 55 words.',\n      \"You are a concise, warm film buff. If you are not confident the quote is from that movie, say so briefly.\"\n    );\n    r.explain = t; save();\n  }catch(err){ toast(\"AI couldn’t explain: \"+(err.message||err)); }\n  delete state.explaining[r.id]; render();\n}\nasync function copyRef(r){\n  var text = '“'+r.quote+'” — '+r.movie+(r.year?' ('+r.year+')':'')+'\\nTranslation: '+r.meaning;\n  try{\n    if(cv && cv.clipboard && canClip) await cv.clipboard.writeText(text);\n    else if(navigator.clipboard) await navigator.clipboard.writeText(text);\n    else throw new Error(\"no clipboard\");\n    toast(\"Copied 📋\");\n  }catch(e){ toast(\"Clipboard isn’t available here\"); }\n}\nfunction react(r, id){\n  needName(function(){\n    r.reacts = r.reacts || {};\n    var arr = r.reacts[id] = r.reacts[id] || [];\n    var i = arr.indexOf(state.me);\n    if(i>=0) arr.splice(i,1);\n    else {\n      arr.push(state.me);\n      // \"got it\" and \"never seen it\" are mutually exclusive\n      var other = id===\"got\" ? \"unseen\" : id===\"unseen\" ? \"got\" : null;\n      if(other && r.reacts[other]){ var j=r.reacts[other].indexOf(state.me); if(j>=0) r.reacts[other].splice(j,1); }\n    }\n    save(); render();\n  });\n}\nfunction loadStarter(){\n  needName(function(){\n    var now = Date.now();\n    STARTER.forEach(function(s, i){\n      state.refs.push(Object.assign({}, s, {id:uid(), at:now-i*1000, by:state.me, reacts:{}}));\n    });\n    save(); render(); toast(\"Starter pack loaded 🍿 Edit them to make them yours\");\n  });\n}\n\ndocument.addEventListener(\"click\", function(e){\n  var chip = e.target.closest(\".chip\");\n  if(chip){ state.vibe = chip.dataset.v; render(); return; }\n  var tab = e.target.closest(\".tab\");\n  if(tab){ state.tab = tab.dataset.tab; render(); return; }\n  var b = e.target.closest(\"[data-act]\"); if(!b) return;\n  var act = b.dataset.act;\n  if(act===\"add\") return needName(function(){ openForm(null); });\n  if(act===\"starter\") return loadStarter();\n  var r = state.refs.find(function(x){return x.id===b.dataset.id}); if(!r) return;\n  if(act===\"react\") react(r, b.dataset.r);\n  else if(act===\"explain\") explain(r);\n  else if(act===\"copy\") copyRef(r);\n  else if(act===\"edit\") openForm(r);\n  else if(act===\"del\"){\n    if(b.dataset.confirm){ state.refs = state.refs.filter(function(x){return x!==r}); save(); render(); toast(\"Cut from the final edit ✂️\"); }\n    else { b.dataset.confirm=\"1\"; b.textContent=\"Sure?\"; b.style.color=\"var(--red)\"; setTimeout(function(){ if(b.isConnected){ delete b.dataset.confirm; b.textContent=\"🗑️\"; b.style.color=\"\"; } }, 2500); }\n  }\n});\n$(\"addBtn\").onclick = function(){ needName(function(){ openForm(null); }); };\nvar qT; $(\"q\").addEventListener(\"input\", function(e){ clearTimeout(qT); qT=setTimeout(function(){ state.q=e.target.value; render(); },120); });\n\ninit();\n})();\n</script>\n</body>\n</html>\n"
