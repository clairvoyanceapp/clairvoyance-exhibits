{
  "version": 1,
  "metadata": {
    "id": "exhibit-1771426186346-asym01",
    "name": "Volumetric Clouds (Asymmetric)",
    "description": "Interactive volumetric cloud rendering - fixed asymmetric noise",
    "createdAt": 1771426186346,
    "updatedAt": 1771426186346,
    "tags": [
      "volumetric",
      "clouds",
      "raymarching",
      "shaders",
      "webgl"
    ]
  },
  "content": {
    "type": "html",
    "bundle": "<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Volumetric Clouds (Asymmetric)</title>\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    body { overflow: hidden; background: #000; font-family: system-ui, sans-serif; }\n    canvas { display: block; width: 100vw; height: 100vh; }\n    #controls {\n      position: fixed;\n      top: 16px;\n      left: 16px;\n      background: rgba(0, 0, 0, 0.7);\n      padding: 16px;\n      border-radius: 8px;\n      color: #fff;\n      font-size: 13px;\n      z-index: 100;\n      min-width: 220px;\n    }\n    #controls h3 { margin-bottom: 12px; font-size: 14px; color: #8cf; }\n    .control-row {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      margin-bottom: 10px;\n    }\n    .control-row label { flex: 1; }\n    .control-row input[type=\"range\"] { width: 100px; }\n    .control-row span { width: 40px; text-align: right; font-size: 11px; color: #aaa; }\n    #info {\n      position: fixed;\n      bottom: 16px;\n      left: 16px;\n      background: rgba(0, 0, 0, 0.6);\n      padding: 10px 14px;\n      border-radius: 6px;\n      color: #888;\n      font-size: 12px;\n    }\n  </style>\n</head>\n<body>\n\n<div id=\"controls\">\n  <h3>Cloud Parameters</h3>\n  <div class=\"control-row\">\n    <label>Density</label>\n    <input type=\"range\" id=\"density\" min=\"0.1\" max=\"2\" step=\"0.05\" value=\"0.8\">\n    <span id=\"densityVal\">0.8</span>\n  </div>\n  <div class=\"control-row\">\n    <label>Coverage</label>\n    <input type=\"range\" id=\"coverage\" min=\"0\" max=\"1\" step=\"0.05\" value=\"0.5\">\n    <span id=\"coverageVal\">0.5</span>\n  </div>\n  <div class=\"control-row\">\n    <label>Light Intensity</label>\n    <input type=\"range\" id=\"lightIntensity\" min=\"0.5\" max=\"3\" step=\"0.1\" value=\"1.5\">\n    <span id=\"lightIntensityVal\">1.5</span>\n  </div>\n  <div class=\"control-row\">\n    <label>Detail Scale</label>\n    <input type=\"range\" id=\"detailScale\" min=\"0.5\" max=\"4\" step=\"0.1\" value=\"2\">\n    <span id=\"detailScaleVal\">2.0</span>\n  </div>\n  <div class=\"control-row\">\n    <label>Animation Speed</label>\n    <input type=\"range\" id=\"speed\" min=\"0\" max=\"2\" step=\"0.1\" value=\"0.5\">\n    <span id=\"speedVal\">0.5</span>\n  </div>\n</div>\n\n<div id=\"info\">Drag to rotate • Scroll to zoom</div>\n\n<canvas id=\"canvas\"></canvas>\n\n<script>\n(function() {\n  'use strict';\n  \n  var canvas = document.getElementById('canvas');\n  var gl = canvas.getContext('webgl2') || canvas.getContext('webgl');\n  \n  if (!gl) {\n    document.body.innerHTML = '<div style=\"color:white;padding:20px;\">WebGL not supported</div>';\n    return;\n  }\n  \n  // Uniforms\n  var uTime = 0;\n  var uDensity = 0.8;\n  var uCoverage = 0.5;\n  var uLightIntensity = 1.5;\n  var uDetailScale = 2.0;\n  var animSpeed = 0.5;\n  \n  // Camera\n  var camDist = 4.0;\n  var camTheta = 0.0;\n  var camPhi = 0.3;\n  \n  // Shaders\n  var vertSrc = `\n    attribute vec2 aPos;\n    varying vec2 vUv;\n    void main() {\n      vUv = aPos * 0.5 + 0.5;\n      gl_Position = vec4(aPos, 0.0, 1.0);\n    }\n  `;\n  \n  var fragSrc = `\n    precision highp float;\n    \n    varying vec2 vUv;\n    \n    uniform float uTime;\n    uniform float uDensity;\n    uniform float uCoverage;\n    uniform float uLightIntensity;\n    uniform float uDetailScale;\n    uniform vec2 uResolution;\n    uniform vec3 uCamPos;\n    uniform vec3 uCamTarget;\n    \n    // Better hash using dot product with primes - breaks symmetry\n    float hash(vec3 p) {\n      p = fract(p * vec3(443.897, 441.423, 437.195));\n      p += dot(p, p.yzx + 19.19);\n      return fract((p.x + p.y) * p.z);\n    }\n    \n    // 3D Noise with offset to break remaining symmetry\n    float noise(vec3 p) {\n      // Add asymmetric offset\n      p += vec3(31.416, 17.593, 23.871);\n      \n      vec3 i = floor(p);\n      vec3 f = fract(p);\n      f = f * f * (3.0 - 2.0 * f);\n      \n      // Use different offsets for each corner to prevent symmetry\n      float n000 = hash(i + vec3(0.0, 0.0, 0.0));\n      float n100 = hash(i + vec3(1.0, 0.0, 0.0));\n      float n010 = hash(i + vec3(0.0, 1.0, 0.0));\n      float n110 = hash(i + vec3(1.0, 1.0, 0.0));\n      float n001 = hash(i + vec3(0.0, 0.0, 1.0));\n      float n101 = hash(i + vec3(1.0, 0.0, 1.0));\n      float n011 = hash(i + vec3(0.0, 1.0, 1.0));\n      float n111 = hash(i + vec3(1.0, 1.0, 1.0));\n      \n      return mix(\n        mix(mix(n000, n100, f.x), mix(n010, n110, f.x), f.y),\n        mix(mix(n001, n101, f.x), mix(n011, n111, f.x), f.y),\n        f.z\n      );\n    }\n    \n    // FBM with rotation to break axis alignment\n    float fbm(vec3 p) {\n      float v = 0.0, a = 0.5;\n      // Rotation matrix to break axis-aligned patterns\n      mat3 rot = mat3(\n        0.8, 0.36, -0.48,\n        -0.44, 0.9, -0.04,\n        0.4, 0.17, 0.88\n      );\n      for(int i = 0; i < 4; i++) {\n        v += a * noise(p);\n        p = rot * p;\n        p = p * 2.0 + vec3(1.7, 2.3, 1.1);\n        a *= 0.5;\n      }\n      return v;\n    }\n    \n    // Ray-sphere intersection\n    vec2 sphereIntersect(vec3 ro, vec3 rd, float r) {\n      float b = dot(ro, rd);\n      float c = dot(ro, ro) - r * r;\n      float h = b * b - c;\n      if(h < 0.0) return vec2(-1.0);\n      h = sqrt(h);\n      return vec2(-b - h, -b + h);\n    }\n    \n    // Cloud density\n    float cloudDensity(vec3 p) {\n      float d = fbm(p * uDetailScale + uTime * 0.1);\n      d = smoothstep(1.0 - uCoverage, 1.0, d);\n      float dist = length(p);\n      float falloff = 1.0 - smoothstep(0.0, 1.0, dist);\n      return d * falloff * uDensity;\n    }\n    \n    // Camera matrix\n    mat3 setCamera(vec3 ro, vec3 ta) {\n      vec3 cw = normalize(ta - ro);\n      vec3 cp = vec3(0.0, 1.0, 0.0);\n      vec3 cu = normalize(cross(cw, cp));\n      vec3 cv = cross(cu, cw);\n      return mat3(cu, cv, cw);\n    }\n    \n    void main() {\n      vec2 uv = (gl_FragCoord.xy - 0.5 * uResolution) / uResolution.y;\n      \n      // Camera setup\n      mat3 ca = setCamera(uCamPos, uCamTarget);\n      vec3 rd = ca * normalize(vec3(uv, 1.5));\n      \n      // Sky gradient\n      float skyGrad = 0.5 + 0.5 * rd.y;\n      vec3 skyColor = mix(vec3(0.4, 0.6, 0.9), vec3(0.1, 0.2, 0.4), skyGrad);\n      \n      // Intersect cloud sphere\n      vec2 t = sphereIntersect(uCamPos, rd, 1.5);\n      \n      vec3 color = skyColor;\n      \n      if(t.x > 0.0) {\n        // Raymarch through cloud\n        float tMin = max(t.x, 0.0);\n        float tMax = t.y;\n        \n        float stepSize = 0.03;\n        float transmittance = 1.0;\n        vec3 lightDir = normalize(vec3(0.5, 0.8, 0.3));\n        vec3 lightColor = vec3(1.0, 0.95, 0.9) * uLightIntensity;\n        vec3 ambient = vec3(0.4, 0.5, 0.7);\n        vec3 cloudColor = vec3(0.0);\n        \n        for(float i = 0.0; i < 80.0; i++) {\n          if(transmittance < 0.01) break;\n          \n          float tt = tMin + i * stepSize;\n          if(tt > tMax) break;\n          \n          vec3 p = uCamPos + rd * tt;\n          float d = cloudDensity(p);\n          \n          if(d > 0.001) {\n            // Simple lighting\n            float lightSample = cloudDensity(p + lightDir * 0.2);\n            float shadow = exp(-lightSample * 3.0);\n            vec3 sampleColor = mix(ambient, lightColor, shadow);\n            \n            float alpha = 1.0 - exp(-d * stepSize * 10.0);\n            cloudColor += transmittance * alpha * sampleColor;\n            transmittance *= 1.0 - alpha;\n          }\n        }\n        \n        color = cloudColor + transmittance * skyColor;\n      }\n      \n      // Tone mapping\n      color = color / (color + vec3(1.0));\n      color = pow(color, vec3(0.4545));\n      \n      gl_FragColor = vec4(color, 1.0);\n    }\n  `;\n  \n  // Compile shader\n  function createShader(type, src) {\n    var shader = gl.createShader(type);\n    gl.shaderSource(shader, src);\n    gl.compileShader(shader);\n    if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {\n      console.error(gl.getShaderInfoLog(shader));\n      return null;\n    }\n    return shader;\n  }\n  \n  var vs = createShader(gl.VERTEX_SHADER, vertSrc);\n  var fs = createShader(gl.FRAGMENT_SHADER, fragSrc);\n  \n  var program = gl.createProgram();\n  gl.attachShader(program, vs);\n  gl.attachShader(program, fs);\n  gl.linkProgram(program);\n  \n  if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {\n    console.error(gl.getProgramInfoLog(program));\n  }\n  \n  gl.useProgram(program);\n  \n  // Fullscreen quad\n  var quad = new Float32Array([-1,-1, 1,-1, -1,1, 1,1]);\n  var vbo = gl.createBuffer();\n  gl.bindBuffer(gl.ARRAY_BUFFER, vbo);\n  gl.bufferData(gl.ARRAY_BUFFER, quad, gl.STATIC_DRAW);\n  \n  var aPos = gl.getAttribLocation(program, 'aPos');\n  gl.enableVertexAttribArray(aPos);\n  gl.vertexAttribPointer(aPos, 2, gl.FLOAT, false, 0, 0);\n  \n  // Uniforms\n  var uTimeLoc = gl.getUniformLocation(program, 'uTime');\n  var uDensityLoc = gl.getUniformLocation(program, 'uDensity');\n  var uCoverageLoc = gl.getUniformLocation(program, 'uCoverage');\n  var uLightIntensityLoc = gl.getUniformLocation(program, 'uLightIntensity');\n  var uDetailScaleLoc = gl.getUniformLocation(program, 'uDetailScale');\n  var uResolutionLoc = gl.getUniformLocation(program, 'uResolution');\n  var uCamPosLoc = gl.getUniformLocation(program, 'uCamPos');\n  var uCamTargetLoc = gl.getUniformLocation(program, 'uCamTarget');\n  \n  // Resize\n  function resize() {\n    var dpr = window.devicePixelRatio || 1;\n    canvas.width = window.innerWidth * dpr;\n    canvas.height = window.innerHeight * dpr;\n    gl.viewport(0, 0, canvas.width, canvas.height);\n  }\n  resize();\n  window.addEventListener('resize', resize);\n  \n  // Mouse interaction\n  var dragging = false;\n  var lastX = 0, lastY = 0;\n  \n  canvas.addEventListener('mousedown', function(e) {\n    dragging = true;\n    lastX = e.clientX;\n    lastY = e.clientY;\n  });\n  \n  window.addEventListener('mouseup', function() { dragging = false; });\n  \n  window.addEventListener('mousemove', function(e) {\n    if (!dragging) return;\n    var dx = e.clientX - lastX;\n    var dy = e.clientY - lastY;\n    camTheta -= dx * 0.01;\n    camPhi = Math.max(-1.5, Math.min(1.5, camPhi + dy * 0.01));\n    lastX = e.clientX;\n    lastY = e.clientY;\n  });\n  \n  canvas.addEventListener('wheel', function(e) {\n    e.preventDefault();\n    camDist = Math.max(2, Math.min(10, camDist + e.deltaY * 0.01));\n  });\n  \n  // UI\n  document.getElementById('density').oninput = function() {\n    uDensity = parseFloat(this.value);\n    document.getElementById('densityVal').textContent = this.value;\n  };\n  document.getElementById('coverage').oninput = function() {\n    uCoverage = parseFloat(this.value);\n    document.getElementById('coverageVal').textContent = this.value;\n  };\n  document.getElementById('lightIntensity').oninput = function() {\n    uLightIntensity = parseFloat(this.value);\n    document.getElementById('lightIntensityVal').textContent = this.value;\n  };\n  document.getElementById('detailScale').oninput = function() {\n    uDetailScale = parseFloat(this.value);\n    document.getElementById('detailScaleVal').textContent = parseFloat(this.value).toFixed(1);\n  };\n  document.getElementById('speed').oninput = function() {\n    animSpeed = parseFloat(this.value);\n    document.getElementById('speedVal').textContent = this.value;\n  };\n  \n  // Render loop\n  var lastTime = 0;\n  function render(time) {\n    var dt = (time - lastTime) * 0.001;\n    lastTime = time;\n    uTime += dt * animSpeed;\n    \n    // Camera position\n    var camX = camDist * Math.cos(camPhi) * Math.sin(camTheta);\n    var camY = camDist * Math.sin(camPhi);\n    var camZ = camDist * Math.cos(camPhi) * Math.cos(camTheta);\n    \n    gl.uniform1f(uTimeLoc, uTime);\n    gl.uniform1f(uDensityLoc, uDensity);\n    gl.uniform1f(uCoverageLoc, uCoverage);\n    gl.uniform1f(uLightIntensityLoc, uLightIntensity);\n    gl.uniform1f(uDetailScaleLoc, uDetailScale);\n    gl.uniform2f(uResolutionLoc, canvas.width, canvas.height);\n    gl.uniform3f(uCamPosLoc, camX, camY, camZ);\n    gl.uniform3f(uCamTargetLoc, 0, 0, 0);\n    \n    gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);\n    requestAnimationFrame(render);\n  }\n  requestAnimationFrame(render);\n})();\n</script>\n</body>\n</html>"
  },
  "permissions": {
    "allowNetwork": true,
    "allowStorage": false,
    "allowClipboard": false
  }
}
