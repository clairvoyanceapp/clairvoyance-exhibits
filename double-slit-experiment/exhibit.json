  "content": {
    "type": "html",
    "bundle": "<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    html, body { width: 100%; height: 100%; overflow: hidden; background: #000; font-family: 'Segoe UI', system-ui, sans-serif; }\n    canvas { display: block; }\n    #ui { position: absolute; top: 16px; left: 16px; color: #c8d8ff; font-size: 13px; background: rgba(10,12,30,0.88); border: 1px solid rgba(100,140,255,0.3); border-radius: 10px; padding: 16px 20px; backdrop-filter: blur(8px); max-width: 310px; z-index: 10; user-select: none; }\n    #ui h2 { font-size: 15px; color: #7cacff; margin-bottom: 6px; font-weight: 600; }\n    #ui p { margin-bottom: 6px; line-height: 1.4; color: #8899bb; font-size: 11.5px; }\n    #ui em { color: #99bbdd; }\n    .controls { margin-top: 10px; display: flex; flex-direction: column; gap: 7px; }\n    .control-row { display: flex; align-items: center; gap: 10px; }\n    .control-row label { flex: 0 0 80px; font-size: 12px; color: #99aacc; }\n    .control-row input[type=range] { flex: 1; accent-color: #5588ff; }\n    .control-row span { flex: 0 0 32px; text-align: right; font-size: 11px; color: #6688bb; font-variant-numeric: tabular-nums; }\n    button { background: rgba(60,100,220,0.25); color: #7cacff; border: 1px solid rgba(100,140,255,0.4); border-radius: 6px; padding: 6px 12px; cursor: pointer; font-size: 12px; transition: all 0.2s; }\n    button:hover { background: rgba(60,100,220,0.45); }\n    button.active { background: rgba(60,100,220,0.5); border-color: #7cacff; }\n    button.obs-active { background: rgba(220,60,60,0.4); border-color: #ff6655; color: #ff9988; }\n    .btn-row { display: flex; gap: 6px; margin-top: 4px; flex-wrap: wrap; }\n    #modeInfo { margin-top: 8px; padding: 8px 10px; border-radius: 6px; font-size: 11px; line-height: 1.4; }\n    #modeInfo.quantum { background: rgba(40,80,180,0.2); border: 1px solid rgba(80,120,255,0.25); color: #88aadd; }\n    #modeInfo.classical { background: rgba(180,60,40,0.2); border: 1px solid rgba(255,100,80,0.25); color: #ddaa88; }\n    #stats { position: absolute; bottom: 16px; left: 16px; color: #556688; font-size: 11px; font-family: monospace; }\n    #legend { position: absolute; bottom: 16px; right: 16px; color: #6678aa; font-size: 11px; text-align: right; line-height: 1.6; }\n  </style>\n</head>\n<body>\n<div id=\"ui\">\n  <h2>Double Slit Experiment</h2>\n  <p>Fire photons through two slits. Toggle observation to see how <em>measuring which slit</em> destroys the interference pattern.</p>\n  <div class=\"controls\">\n    <div class=\"control-row\"><label>Fire Rate</label><input type=\"range\" id=\"rateSlider\" min=\"1\" max=\"30\" value=\"10\"><span id=\"rateVal\">10</span></div>\n    <div class=\"control-row\"><label>Slit Width</label><input type=\"range\" id=\"widthSlider\" min=\"2\" max=\"15\" value=\"5\"><span id=\"widthVal\">5</span></div>\n    <div class=\"control-row\"><label>Slit Gap</label><input type=\"range\" id=\"spacingSlider\" min=\"4\" max=\"30\" value=\"12\"><span id=\"spacingVal\">12</span></div>\n    <div class=\"control-row\"><label>Wavelength</label><input type=\"range\" id=\"waveSlider\" min=\"3\" max=\"15\" value=\"6\"><span id=\"waveVal\">6</span></div>\n    <div class=\"btn-row\">\n      <button id=\"btnBoth\" class=\"active\">Both Slits</button>\n      <button id=\"btnOne\">One Slit</button>\n      <button id=\"btnReset\">Reset</button>\n    </div>\n    <div class=\"btn-row\">\n      <button id=\"btnUnobs\" class=\"active\">Not Observed</button>\n      <button id=\"btnObs\">Observed</button>\n    </div>\n    <div id=\"modeInfo\" class=\"quantum\">Quantum mode: each photon's wave function passes through <em>both</em> slits. Interference pattern forms.</div>\n  </div>\n</div>\n<div id=\"stats\">Photons detected: <span id=\"photonCount\">0</span></div>\n<div id=\"legend\">Drag to orbit &middot; Scroll to zoom<br><span style=\"color:#ff6644\">&mdash;</span> Predicted intensity</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/@vladkrutenyuk/three-umd@0.0.10/dist/three.umd.min.js\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/@vladkrutenyuk/three-umd@0.0.10/dist/addons/controls/OrbitControls.umd.js\"></script>\n\n<script>\n(function() {\n  'use strict';\n\n  var EMITTER_Z = -40;\n  var BARRIER_Z = 0;\n  var DETECTOR_Z = 40;\n  var FADE_Z = BARRIER_Z - 8;\n  var BARRIER_HEIGHT = 8;\n  var BARRIER_EXTENT = 40;\n  var DETECTOR_HEIGHT = 8;\n  var DETECTOR_EXTENT = 35;\n  var HIT_DELAY = 55;\n\n  var fireRate = 10;\n  var slitHalfWidth = 0.25;\n  var slitSpacing = 1.2;\n  var wavelength = 0.6;\n  var bothSlits = true;\n  var observed = false;\n  var photons = [];\n  var pendingHits = [];\n  var flashes = [];\n  var hitCount = 0;\n  var frameCount = 0;\n\n  var DET_TEX_W = 512;\n  var DET_TEX_H = 64;\n  var detectorTexData = new Uint8Array(DET_TEX_W * DET_TEX_H * 4);\n  clearDetectorTex();\n\n  function clearDetectorTex() {\n    for (var i = 0; i < DET_TEX_W * DET_TEX_H * 4; i += 4) {\n      detectorTexData[i] = 3; detectorTexData[i+1] = 5;\n      detectorTexData[i+2] = 15; detectorTexData[i+3] = 255;\n    }\n  }\n\n  var OrbitControls = ThreeAddons.OrbitControls.OrbitControls;\n  var scene = new THREE.Scene();\n  scene.background = new THREE.Color(0x050a14);\n  scene.fog = new THREE.FogExp2(0x050a14, 0.004);\n\n  var w0 = document.documentElement.clientWidth || window.innerWidth || 960;\n  var h0 = document.documentElement.clientHeight || window.innerHeight || 540;\n  var camera = new THREE.PerspectiveCamera(50, w0/h0, 0.1, 300);\n  camera.position.set(0, 45, -35);\n\n  var renderer = new THREE.WebGLRenderer({ antialias: true });\n  renderer.setSize(w0, h0);\n  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));\n  renderer.toneMapping = THREE.ACESFilmicToneMapping;\n  renderer.toneMappingExposure = 1.3;\n  document.body.appendChild(renderer.domElement);\n\n  var controls = new OrbitControls(camera, renderer.domElement);\n  controls.enableDamping = true;\n  controls.dampingFactor = 0.05;\n  controls.target.set(0, 2, 10);\n  controls.maxPolarAngle = Math.PI * 0.85;\n\n  scene.add(new THREE.AmbientLight(0x334466, 0.8));\n  var dirLight = new THREE.DirectionalLight(0x6688cc, 0.6);\n  dirLight.position.set(10, 30, -10);\n  scene.add(dirLight);\n\n  var gridHelper = new THREE.GridHelper(120, 60, 0x0a1830, 0x060f22);\n  gridHelper.position.y = -0.5;\n  scene.add(gridHelper);\n\n  var emitter = new THREE.Mesh(new THREE.BoxGeometry(2, 2, 3),\n    new THREE.MeshStandardMaterial({ color: 0x223355, emissive: 0x112266, emissiveIntensity: 2, metalness: 0.7, roughness: 0.3 }));\n  emitter.position.set(0, 1, EMITTER_Z);\n  scene.add(emitter);\n  var nozzle = new THREE.Mesh(new THREE.ConeGeometry(0.6, 2, 8),\n    new THREE.MeshStandardMaterial({ color: 0x334488, emissive: 0x2244aa, emissiveIntensity: 2.5 }));\n  nozzle.rotation.x = -Math.PI / 2;\n  nozzle.position.set(0, 1, EMITTER_Z + 2.5);\n  scene.add(nozzle);\n  var emitterLight = new THREE.PointLight(0x4488ff, 3, 20);\n  emitterLight.position.set(0, 2, EMITTER_Z + 3);\n  scene.add(emitterLight);\n\n  var barrierGroup = new THREE.Group();\n  scene.add(barrierGroup);\n  var barrierMat = new THREE.MeshStandardMaterial({ color: 0x1a1a2a, metalness: 0.5, roughness: 0.5, side: THREE.DoubleSide });\n  var slitGlowMat = new THREE.MeshBasicMaterial({ color: 0x3366cc, transparent: true, opacity: 0.6 });\n\n  function buildBarrier() {\n    while (barrierGroup.children.length > 0) {\n      var c = barrierGroup.children[0]; barrierGroup.remove(c);\n      if (c.geometry) c.geometry.dispose();\n    }\n    var bH = BARRIER_HEIGHT, bE = BARRIER_EXTENT, sw = slitHalfWidth, sd = slitSpacing/2, thick = 0.5;\n    if (bothSlits) {\n      var leftW = bE - sd - sw;\n      if (leftW > 0) { var m = new THREE.Mesh(new THREE.BoxGeometry(leftW, bH, thick), barrierMat); m.position.set(-(sd+sw)-leftW/2, bH/2, BARRIER_Z); barrierGroup.add(m); }\n      var centerW = (sd - sw) * 2;\n      if (centerW > 0) { var m = new THREE.Mesh(new THREE.BoxGeometry(centerW, bH, thick), barrierMat); m.position.set(0, bH/2, BARRIER_Z); barrierGroup.add(m); }\n      if (leftW > 0) { var m = new THREE.Mesh(new THREE.BoxGeometry(leftW, bH, thick), barrierMat); m.position.set((sd+sw)+leftW/2, bH/2, BARRIER_Z); barrierGroup.add(m); }\n      var edges = [-(sd+sw), -(sd-sw), (sd-sw), (sd+sw)];\n      for (var i = 0; i < edges.length; i++) { var e = new THREE.Mesh(new THREE.BoxGeometry(0.08, bH+0.5, 0.6), slitGlowMat); e.position.set(edges[i], bH/2, BARRIER_Z); barrierGroup.add(e); }\n    } else {\n      var lw = bE - sw;\n      var m1 = new THREE.Mesh(new THREE.BoxGeometry(lw, bH, thick), barrierMat); m1.position.set(-sw-lw/2, bH/2, BARRIER_Z); barrierGroup.add(m1);\n      var m2 = new THREE.Mesh(new THREE.BoxGeometry(lw, bH, thick), barrierMat); m2.position.set(sw+lw/2, bH/2, BARRIER_Z); barrierGroup.add(m2);\n      var edgesS = [-sw, sw];\n      for (var i = 0; i < edgesS.length; i++) { var e = new THREE.Mesh(new THREE.BoxGeometry(0.08, bH+0.5, 0.6), slitGlowMat); e.position.set(edgesS[i], bH/2, BARRIER_Z); barrierGroup.add(e); }\n    }\n  }\n  buildBarrier();\n\n  var slitDetectorGroup = new THREE.Group();\n  scene.add(slitDetectorGroup);\n  var detectorBoxGeo = new THREE.BoxGeometry(0.5, 0.7, 0.9);\n  var detectorBoxMat = new THREE.MeshStandardMaterial({ color: 0xcc3322, emissive: 0xff2211, emissiveIntensity: 2, metalness: 0.4, roughness: 0.5 });\n\n  function updateSlitDetectors() {\n    while (slitDetectorGroup.children.length > 0) slitDetectorGroup.remove(slitDetectorGroup.children[0]);\n    if (!observed) return;\n    if (bothSlits) {\n      var d1 = new THREE.Mesh(detectorBoxGeo, detectorBoxMat); d1.position.set(-slitSpacing/2, BARRIER_HEIGHT+0.8, BARRIER_Z); d1.add(new THREE.PointLight(0xff3322, 1.5, 5)); slitDetectorGroup.add(d1);\n      var d2 = new THREE.Mesh(detectorBoxGeo, detectorBoxMat); d2.position.set(slitSpacing/2, BARRIER_HEIGHT+0.8, BARRIER_Z); d2.add(new THREE.PointLight(0xff3322, 1.5, 5)); slitDetectorGroup.add(d2);\n    } else {\n      var d1 = new THREE.Mesh(detectorBoxGeo, detectorBoxMat); d1.position.set(0, BARRIER_HEIGHT+0.8, BARRIER_Z); d1.add(new THREE.PointLight(0xff3322, 1.5, 5)); slitDetectorGroup.add(d1);\n    }\n  }\n\n  var detectorTexture = new THREE.DataTexture(detectorTexData, DET_TEX_W, DET_TEX_H, THREE.RGBAFormat);\n  detectorTexture.needsUpdate = true;\n  var detectorScreen = new THREE.Mesh(\n    new THREE.PlaneGeometry(DETECTOR_EXTENT*2, DETECTOR_HEIGHT),\n    new THREE.MeshBasicMaterial({ map: detectorTexture, side: THREE.DoubleSide }));\n  detectorScreen.rotation.y = Math.PI;\n  detectorScreen.position.set(0, DETECTOR_HEIGHT/2, DETECTOR_Z);\n  scene.add(detectorScreen);\n\n  var frameMat = new THREE.MeshBasicMaterial({ color: 0x223355 });\n  function addFrame(x,y,z,sx,sy,sz) { var m = new THREE.Mesh(new THREE.BoxGeometry(sx,sy,sz), frameMat); m.position.set(x,y,z); scene.add(m); }\n  addFrame(0, DETECTOR_HEIGHT, DETECTOR_Z, DETECTOR_EXTENT*2+0.5, 0.3, 0.3);\n  addFrame(0, 0, DETECTOR_Z, DETECTOR_EXTENT*2+0.5, 0.3, 0.3);\n  addFrame(-DETECTOR_EXTENT, DETECTOR_HEIGHT/2, DETECTOR_Z, 0.3, DETECTOR_HEIGHT, 0.3);\n  addFrame(DETECTOR_EXTENT, DETECTOR_HEIGHT/2, DETECTOR_Z, 0.3, DETECTOR_HEIGHT, 0.3);\n\n  var waveWidth = 60;\n  var waveDepth = DETECTOR_Z - BARRIER_Z;\n  var waveUniforms = {\n    uTime: { value: 0.0 },\n    uWavelength: { value: wavelength },\n    uSlit1X: { value: -slitSpacing/2 },\n    uSlit2X: { value: slitSpacing/2 },\n    uBothSlits: { value: 1.0 },\n    uPlaneWidth: { value: waveWidth },\n    uPlaneDepth: { value: waveDepth }\n  };\n  var waveVS = 'varying vec2 vUv; void main(){ vUv=uv; gl_Position=projectionMatrix*modelViewMatrix*vec4(position,1.0); }';\n  var waveFS = [\n    'precision highp float;',\n    'uniform float uTime, uWavelength, uSlit1X, uSlit2X, uBothSlits, uPlaneWidth, uPlaneDepth;',\n    'varying vec2 vUv;',\n    '#define PI 3.14159265359',\n    'void main(){',\n    '  float x=(vUv.x-0.5)*uPlaneWidth;',\n    '  float z=vUv.y*uPlaneDepth+0.3;',\n    '  float dx1=x-uSlit1X; float d1=sqrt(dx1*dx1+z*z);',\n    '  float a1=sin(2.0*PI*(d1/uWavelength-uTime))/max(1.0,sqrt(d1));',\n    '  float dx2=x-uSlit2X; float d2=sqrt(dx2*dx2+z*z);',\n    '  float a2=sin(2.0*PI*(d2/uWavelength-uTime))/max(1.0,sqrt(d2));',\n    '  float total=a1+a2*uBothSlits;',\n    '  float intensity=total*total;',\n    '  float ef=smoothstep(0.0,0.08,vUv.x)*smoothstep(0.0,0.08,1.0-vUv.x);',\n    '  ef*=smoothstep(0.0,0.03,vUv.y)*smoothstep(0.0,0.08,1.0-vUv.y);',\n    '  intensity*=ef;',\n    '  gl_FragColor=vec4(0.25*intensity,0.65*intensity,1.8*intensity,min(intensity*0.7,1.0));',\n    '}'\n  ].join('\\n');\n  var wavePlaneMat = new THREE.ShaderMaterial({\n    uniforms: waveUniforms, vertexShader: waveVS, fragmentShader: waveFS,\n    transparent: true, side: THREE.DoubleSide, depthWrite: false\n  });\n  var wavePlane = new THREE.Mesh(new THREE.PlaneGeometry(waveWidth, waveDepth), wavePlaneMat);\n  wavePlane.rotation.x = Math.PI / 2;\n  wavePlane.position.set(0, 0.8, (BARRIER_Z + DETECTOR_Z) / 2);\n  wavePlane.renderOrder = 1;\n  scene.add(wavePlane);\n\n  var CURVE_PTS = 400;\n  var curvePositions = new Float32Array(CURVE_PTS * 3);\n  var curveGeo = new THREE.BufferGeometry();\n  curveGeo.setAttribute('position', new THREE.BufferAttribute(curvePositions, 3));\n  var intensityCurve = new THREE.Line(curveGeo, new THREE.LineBasicMaterial({ color: 0xff6644, transparent: true, opacity: 0.8 }));\n  scene.add(intensityCurve);\n  var baseGeo = new THREE.BufferGeometry().setFromPoints([\n    new THREE.Vector3(-DETECTOR_EXTENT, -0.5, DETECTOR_Z+0.5),\n    new THREE.Vector3(DETECTOR_EXTENT, -0.5, DETECTOR_Z+0.5)\n  ]);\n  scene.add(new THREE.Line(baseGeo, new THREE.LineBasicMaterial({ color: 0x334455, transparent: true, opacity: 0.4 })));\n\n  function getInterferenceProbability(x) {\n    var L = DETECTOR_Z - BARRIER_Z;\n    var theta = Math.atan2(x, L);\n    var sinTheta = Math.sin(theta);\n    var a = slitHalfWidth * 2;\n    var beta = Math.PI * a * sinTheta / wavelength;\n    var sinc = (Math.abs(beta) < 0.0001) ? 1.0 : Math.sin(beta) / beta;\n    var envelope = sinc * sinc;\n    if (observed && bothSlits) {\n      var pj = slitSpacing/2 * 10;\n      var sig = 1.5;\n      var g1 = Math.exp(-(x+pj)*(x+pj)/(2*sig*sig));\n      var g2 = Math.exp(-(x-pj)*(x-pj)/(2*sig*sig));\n      return Math.max(g1, g2);\n    }\n    if (!bothSlits) return envelope;\n    var d = slitSpacing;\n    var delta = Math.PI * d * sinTheta / wavelength;\n    var cosD = Math.cos(delta);\n    return envelope * cosD * cosD;\n  }\n\n  function updateIntensityCurve() {\n    for (var i = 0; i < CURVE_PTS; i++) {\n      var frac = i / (CURVE_PTS - 1);\n      var x = (frac - 0.5) * DETECTOR_EXTENT * 2;\n      var prob = getInterferenceProbability(x);\n      curvePositions[i*3] = x;\n      curvePositions[i*3+1] = -0.5 + prob * 7;\n      curvePositions[i*3+2] = DETECTOR_Z + 0.5;\n    }\n    curveGeo.attributes.position.needsUpdate = true;\n  }\n\n  function sampleDetectorX() {\n    for (var attempt = 0; attempt < 300; attempt++) {\n      var x = (Math.random() - 0.5) * DETECTOR_EXTENT * 1.6;\n      if (Math.random() < getInterferenceProbability(x)) return x;\n    }\n    return (Math.random() - 0.5) * 2;\n  }\n\n  function makeLabel(text, x, y, z) {\n    var c = document.createElement('canvas'); c.width = 256; c.height = 64;\n    var ctx = c.getContext('2d'); ctx.fillStyle = '#4477aa';\n    ctx.font = 'bold 26px Segoe UI, sans-serif'; ctx.textAlign = 'center';\n    ctx.fillText(text, 128, 42);\n    var s = new THREE.Sprite(new THREE.SpriteMaterial({ map: new THREE.CanvasTexture(c), transparent: true, opacity: 0.7 }));\n    s.scale.set(8, 2, 1); s.position.set(x, y, z); scene.add(s);\n  }\n  makeLabel('EMITTER', 0, 5, EMITTER_Z);\n  makeLabel('BARRIER', 0, BARRIER_HEIGHT + 3, BARRIER_Z);\n  makeLabel('DETECTOR', 0, DETECTOR_HEIGHT + 3, DETECTOR_Z);\n\n  var beam = new THREE.Mesh(new THREE.BoxGeometry(0.15, 0.15, Math.abs(FADE_Z - EMITTER_Z)),\n    new THREE.MeshBasicMaterial({ color: 0x1133aa, transparent: true, opacity: 0.08 }));\n  beam.position.set(0, 1, (EMITTER_Z + FADE_Z) / 2);\n  scene.add(beam);\n\n  var photonGeo = new THREE.SphereGeometry(0.2, 10, 10);\n  var photonCoreMat = new THREE.MeshBasicMaterial({ color: 0x88ccff });\n  var photonGlowGeo = new THREE.SphereGeometry(0.55, 10, 10);\n  var photonGlowMat = new THREE.MeshBasicMaterial({ color: 0x3388ff, transparent: true, opacity: 0.15 });\n  var photonLeftMat = new THREE.MeshBasicMaterial({ color: 0xff8844 });\n  var photonRightMat = new THREE.MeshBasicMaterial({ color: 0x44ccff });\n  var photonLeftGlowMat = new THREE.MeshBasicMaterial({ color: 0xff6622, transparent: true, opacity: 0.15 });\n  var photonRightGlowMat = new THREE.MeshBasicMaterial({ color: 0x2299ff, transparent: true, opacity: 0.15 });\n  var flashGeo = new THREE.SphereGeometry(0.35, 8, 8);\n\n  function enforceSlitConstraints() {\n    var minSpacing = slitHalfWidth * 2 + 0.15;\n    if (slitSpacing < minSpacing) {\n      slitSpacing = minSpacing;\n      var sv = Math.ceil(slitSpacing * 10);\n      document.getElementById('spacingSlider').value = sv;\n      document.getElementById('spacingVal').textContent = sv;\n    }\n  }\n\n  function updateWaveUniforms() {\n    waveUniforms.uWavelength.value = wavelength;\n    waveUniforms.uSlit1X.value = bothSlits ? -slitSpacing/2 : 0;\n    waveUniforms.uSlit2X.value = bothSlits ? slitSpacing/2 : 0;\n    waveUniforms.uBothSlits.value = bothSlits ? 1.0 : 0.0;\n  }\n\n  function firePhoton() {\n    if (photons.length > 200) return;\n    var group = new THREE.Group();\n    var isObs = observed;\n    var slitX = 0;\n    var destX;\n    var destY = (Math.random()-0.5) * DETECTOR_HEIGHT * 0.7;\n    if (isObs && bothSlits) {\n      slitX = (Math.random() < 0.5) ? -slitSpacing/2 : slitSpacing/2;\n      slitX += (Math.random()-0.5) * slitHalfWidth * 1.2;\n      var pjx = slitX * 10;\n      var u1 = Math.random(), u2 = Math.random();\n      destX = pjx + Math.sqrt(-2*Math.log(Math.max(u1,0.0001)))*Math.cos(2*Math.PI*u2)*1.5;\n    } else if (isObs) {\n      slitX = (Math.random()-0.5) * slitHalfWidth * 1.2;\n      destX = sampleDetectorX();\n    } else {\n      destX = sampleDetectorX();\n    }\n    if (isObs) {\n      var isLeft = slitX < 0;\n      group.add(new THREE.Mesh(photonGeo, isLeft ? photonLeftMat : photonRightMat));\n      group.add(new THREE.Mesh(photonGlowGeo, isLeft ? photonLeftGlowMat : photonRightGlowMat));\n      group.add(new THREE.PointLight(isLeft ? 0xff6622 : 0x4488ff, 1, 6));\n    } else {\n      group.add(new THREE.Mesh(photonGeo, photonCoreMat));\n      group.add(new THREE.Mesh(photonGlowGeo, photonGlowMat));\n      group.add(new THREE.PointLight(0x4488ff, 1, 6));\n    }\n    group.position.set(0, 1, EMITTER_Z);\n    scene.add(group);\n    photons.push({\n      mesh: group, phase: 0, t: 0,\n      speed: 0.5 + Math.random()*0.1,\n      fadeTimer: 0, maxFade: 12,\n      isObs: isObs, slitX: slitX,\n      destX: destX, destY: destY\n    });\n  }\n\n  function recordHit(x, y) {\n    hitCount++;\n    document.getElementById('photonCount').textContent = hitCount;\n    var tx = Math.floor(((x/(DETECTOR_EXTENT*2))+0.5)*DET_TEX_W);\n    var ty = Math.floor(((y/DETECTOR_HEIGHT)+0.5)*DET_TEX_H);\n    tx = Math.max(0, Math.min(DET_TEX_W-1, tx));\n    ty = Math.max(0, Math.min(DET_TEX_H-1, ty));\n    var radius = 3;\n    for (var dx = -radius; dx <= radius; dx++) {\n      for (var dy = -radius; dy <= radius; dy++) {\n        var px = tx+dx, py = ty+dy;\n        if (px<0||px>=DET_TEX_W||py<0||py>=DET_TEX_H) continue;\n        var dist = Math.sqrt(dx*dx+dy*dy);\n        if (dist > radius) continue;\n        var inten = (1-dist/radius)*0.6;\n        var idx = (py*DET_TEX_W+px)*4;\n        detectorTexData[idx]=Math.min(255,detectorTexData[idx]+Math.floor(60*inten));\n        detectorTexData[idx+1]=Math.min(255,detectorTexData[idx+1]+Math.floor(100*inten));\n        detectorTexData[idx+2]=Math.min(255,detectorTexData[idx+2]+Math.floor(220*inten));\n      }\n    }\n    detectorTexture.needsUpdate = true;\n  }\n\n  function createFlash(x, y) {\n    var mat = new THREE.MeshBasicMaterial({ color: 0xaaddff, transparent: true, opacity: 1.0 });\n    var mesh = new THREE.Mesh(flashGeo, mat);\n    mesh.position.set(x, DETECTOR_HEIGHT/2 + y, DETECTOR_Z - 0.3);\n    mesh.add(new THREE.PointLight(0x88bbff, 2, 4));\n    scene.add(mesh);\n    flashes.push({ mesh: mesh, life: 20, timer: 0 });\n  }\n\n  function resetExperiment() {\n    for (var i = 0; i < photons.length; i++) scene.remove(photons[i].mesh);\n    photons = [];\n    for (var i = 0; i < flashes.length; i++) { scene.remove(flashes[i].mesh); flashes[i].mesh.material.dispose(); }\n    flashes = []; pendingHits = [];\n    hitCount = 0;\n    document.getElementById('photonCount').textContent = '0';\n    clearDetectorTex(); detectorTexture.needsUpdate = true;\n    enforceSlitConstraints(); buildBarrier();\n    updateWaveUniforms(); updateIntensityCurve();\n    wavePlane.visible = !observed;\n    updateSlitDetectors();\n    var info = document.getElementById('modeInfo');\n    if (observed) {\n      info.className = 'classical';\n      info.innerHTML = 'Observed: detectors at slits reveal which path each photon takes. <em>Interference vanishes</em> \\u2014 just two overlapping blobs.';\n    } else {\n      info.className = 'quantum';\n      info.innerHTML = 'Quantum: each photon\\u2019s wave function passes through <em>both</em> slits. Interference pattern forms.';\n    }\n  }\n\n  document.getElementById('rateSlider').addEventListener('input', function() {\n    fireRate = parseInt(this.value); document.getElementById('rateVal').textContent = fireRate;\n  });\n  document.getElementById('widthSlider').addEventListener('input', function() {\n    slitHalfWidth = parseInt(this.value)/20; document.getElementById('widthVal').textContent = this.value; resetExperiment();\n  });\n  document.getElementById('spacingSlider').addEventListener('input', function() {\n    slitSpacing = parseInt(this.value)/10; document.getElementById('spacingVal').textContent = this.value; resetExperiment();\n  });\n  document.getElementById('waveSlider').addEventListener('input', function() {\n    wavelength = parseInt(this.value)/10; document.getElementById('waveVal').textContent = this.value; resetExperiment();\n  });\n  document.getElementById('btnBoth').addEventListener('click', function() {\n    bothSlits = true; this.classList.add('active'); document.getElementById('btnOne').classList.remove('active'); resetExperiment();\n  });\n  document.getElementById('btnOne').addEventListener('click', function() {\n    bothSlits = false; this.classList.add('active'); document.getElementById('btnBoth').classList.remove('active'); resetExperiment();\n  });\n  document.getElementById('btnUnobs').addEventListener('click', function() {\n    observed = false; this.classList.add('active'); document.getElementById('btnObs').classList.remove('active'); document.getElementById('btnObs').classList.remove('obs-active'); resetExperiment();\n  });\n  document.getElementById('btnObs').addEventListener('click', function() {\n    observed = true; this.classList.add('obs-active'); document.getElementById('btnUnobs').classList.remove('active'); resetExperiment();\n  });\n  document.getElementById('btnReset').addEventListener('click', resetExperiment);\n\n  updateIntensityCurve();\n  updateWaveUniforms();\n\n  function animate() {\n    requestAnimationFrame(animate);\n    frameCount++;\n    waveUniforms.uTime.value += 1.5;\n\n    var interval = Math.max(1, Math.floor(60/fireRate));\n    if (frameCount % interval === 0) firePhoton();\n\n    for (var i = photons.length-1; i >= 0; i--) {\n      var p = photons[i];\n      if (p.isObs) {\n        if (p.phase === 0) {\n          p.t += p.speed;\n          var targetZ = BARRIER_Z;\n          var prog = Math.min(p.t / Math.abs(targetZ - EMITTER_Z), 1);\n          var curX = 0 + (p.slitX - 0) * prog;\n          p.mesh.position.set(curX, 1, EMITTER_Z + (targetZ - EMITTER_Z) * prog);\n          p.mesh.scale.setScalar(0.9 + 0.15 * Math.sin(p.t * 6));\n          if (prog >= 1) { p.phase = 1; p.t = 0; }\n        } else if (p.phase === 1) {\n          p.t += p.speed;\n          var prog = Math.min(p.t / Math.abs(DETECTOR_Z - BARRIER_Z), 1);\n          var startX = p.slitX;\n          var curX = startX + (p.destX - startX) * prog;\n          var curY = 1 + (DETECTOR_HEIGHT/2 + p.destY - 1) * prog;\n          p.mesh.position.set(curX, curY, BARRIER_Z + (DETECTOR_Z - BARRIER_Z) * prog);\n          p.mesh.scale.setScalar(0.9 + 0.15 * Math.sin(p.t * 6));\n          if (prog >= 1) {\n            recordHit(p.destX, p.destY); createFlash(p.destX, p.destY);\n            scene.remove(p.mesh); photons.splice(i, 1);\n          }\n        }\n      } else {\n        if (p.phase === 0) {\n          p.t += p.speed;\n          var prog = Math.min(p.t / Math.abs(FADE_Z - EMITTER_Z), 1);\n          p.mesh.position.set(0, 1, EMITTER_Z + (FADE_Z - EMITTER_Z) * prog);\n          p.mesh.scale.setScalar(0.9 + 0.15 * Math.sin(p.t * 6));\n          if (prog >= 1) {\n            p.phase = 1; p.fadeTimer = 0;\n            pendingHits.push({ x: p.destX, y: p.destY, delay: HIT_DELAY, timer: 0 });\n          }\n        } else {\n          p.fadeTimer++;\n          var fp = p.fadeTimer / p.maxFade;\n          p.mesh.scale.setScalar(1 - fp);\n          if (fp >= 1) { scene.remove(p.mesh); photons.splice(i, 1); }\n        }\n      }\n    }\n\n    for (var i = pendingHits.length-1; i >= 0; i--) {\n      pendingHits[i].timer++;\n      if (pendingHits[i].timer >= pendingHits[i].delay) {\n        var h = pendingHits[i];\n        recordHit(h.x, h.y); createFlash(h.x, h.y);\n        pendingHits.splice(i, 1);\n      }\n    }\n\n    for (var i = flashes.length-1; i >= 0; i--) {\n      flashes[i].timer++;\n      var fp = flashes[i].timer / flashes[i].life;\n      flashes[i].mesh.scale.setScalar(1 + fp*0.5);\n      flashes[i].mesh.material.opacity = 1 - fp;\n      if (fp >= 1) { scene.remove(flashes[i].mesh); flashes[i].mesh.material.dispose(); flashes.splice(i, 1); }\n    }\n\n    emitterLight.intensity = 2.5 + Math.sin(frameCount * 0.06);\n    controls.update();\n    renderer.render(scene, camera);\n  }\n  animate();\n\n  window.addEventListener('resize', function() {\n    var w = document.documentElement.clientWidth || window.innerWidth || 960;\n    var h = document.documentElement.clientHeight || window.innerHeight || 540;\n    camera.aspect = w/h; camera.updateProjectionMatrix(); renderer.setSize(w, h);\n  });\n})();\n</script>\n</body>\n</html>"
  },
