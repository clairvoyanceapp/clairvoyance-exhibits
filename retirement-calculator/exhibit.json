  "content": {
    "type": "html",
    "bundle": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Retirement Calculator</title>\n<style>\n  :root{\n    --bg0:#0b1020; --bg1:#111a33; --card:#151f3d; --card2:#1a2648;\n    --ink:#eaf0ff; --ink-dim:#93a0c4; --ink-faint:#5f6c92;\n    --accent:#4f8cff; --accent2:#7c5cff; --gold:#f5b942; --green:#3ddc97; --red:#ff6b81;\n    --line:rgba(255,255,255,.08);\n  }\n  *{box-sizing:border-box; margin:0; padding:0;}\n  html,body{height:100%;}\n  body{\n    font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif;\n    background:radial-gradient(1200px 700px at 80% -10%, #1c2c5e 0%, transparent 60%),\n               radial-gradient(900px 600px at -10% 110%, #23164a 0%, transparent 55%),\n               linear-gradient(180deg, var(--bg0), var(--bg1));\n    color:var(--ink); min-height:100%; padding:28px 22px 46px;\n  }\n  .wrap{max-width:1180px; margin:0 auto;}\n  header{display:flex; align-items:center; gap:16px; margin-bottom:26px;}\n  .logo{width:52px; height:52px; flex:0 0 52px;}\n  h1{font-size:26px; font-weight:700; letter-spacing:.2px;}\n  .sub{color:var(--ink-dim); font-size:14px; margin-top:3px;}\n  .grid{display:grid; grid-template-columns: 380px 1fr; gap:22px;}\n  @media (max-width: 900px){ .grid{grid-template-columns:1fr;} }\n  .card{\n    background:linear-gradient(180deg, var(--card), var(--card2));\n    border:1px solid var(--line); border-radius:16px; padding:22px;\n    box-shadow:0 12px 40px rgba(0,0,0,.35);\n  }\n  .card h2{font-size:13px; text-transform:uppercase; letter-spacing:1.4px; color:var(--ink-dim); margin-bottom:18px;}\n  .field{margin-bottom:18px;}\n  .field-head{display:flex; justify-content:space-between; align-items:baseline; margin-bottom:7px;}\n  .field label{font-size:13.5px; color:var(--ink); font-weight:500;}\n  .field .val{font-size:13.5px; font-weight:700; color:var(--accent); font-variant-numeric:tabular-nums;}\n  input[type=range]{\n    -webkit-appearance:none; width:100%; height:6px; border-radius:3px;\n    background:linear-gradient(90deg, var(--accent) var(--fill,50%), rgba(255,255,255,.12) var(--fill,50%));\n    outline:none; cursor:pointer;\n  }\n  input[type=range]::-webkit-slider-thumb{\n    -webkit-appearance:none; width:18px; height:18px; border-radius:50%;\n    background:#fff; border:3px solid var(--accent);\n    box-shadow:0 2px 8px rgba(0,0,0,.5); cursor:grab;\n  }\n  .hint{font-size:11.5px; color:var(--ink-faint); margin-top:5px;}\n  .divider{height:1px; background:var(--line); margin:20px 0;}\n  .hero{\n    display:flex; align-items:center; gap:22px; padding:24px 26px; margin-bottom:22px;\n    background:linear-gradient(135deg, rgba(79,140,255,.18), rgba(124,92,255,.14));\n    border:1px solid rgba(79,140,255,.35); border-radius:16px;\n  }\n  .hero-ring{flex:0 0 118px; width:118px; height:118px; position:relative;}\n  .hero-ring svg{width:100%; height:100%; transform:rotate(-90deg);}\n  .hero-age{\n    position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center;\n  }\n  .hero-age .num{font-size:36px; font-weight:800; line-height:1; font-variant-numeric:tabular-nums;}\n  .hero-age .lbl{font-size:10px; letter-spacing:1.5px; text-transform:uppercase; color:var(--ink-dim); margin-top:4px;}\n  .hero-text h3{font-size:20px; font-weight:700; margin-bottom:6px;}\n  .hero-text p{font-size:13.5px; color:var(--ink-dim); line-height:1.55;}\n  .hero-text .good{color:var(--green); font-weight:600;}\n  .hero-text .warn{color:var(--gold); font-weight:600;}\n  .hero-text .bad{color:var(--red); font-weight:600;}\n  .stats{display:grid; grid-template-columns:repeat(auto-fit, minmax(150px,1fr)); gap:14px; margin-bottom:22px;}\n  .stat{background:rgba(255,255,255,.04); border:1px solid var(--line); border-radius:12px; padding:14px 16px;}\n  .stat .k{font-size:11px; text-transform:uppercase; letter-spacing:1px; color:var(--ink-faint); margin-bottom:6px;}\n  .stat .v{font-size:19px; font-weight:700; font-variant-numeric:tabular-nums;}\n  .stat .v small{font-size:12px; color:var(--ink-dim); font-weight:500;}\n  .chart-card{padding:22px;}\n  .chart-head{display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;}\n  .legend{display:flex; gap:16px; font-size:12px; color:var(--ink-dim);}\n  .legend span{display:inline-flex; align-items:center; gap:6px;}\n  .dot{width:10px; height:10px; border-radius:3px; display:inline-block;}\n  canvas{width:100%; height:300px; display:block;}\n  footer{margin-top:26px; text-align:center; font-size:11.5px; color:var(--ink-faint); line-height:1.6;}\n</style>\n</head>\n<body>\n<div class=\"wrap\">\n  <header>\n    <svg class=\"logo\" viewBox=\"0 0 64 64\" aria-hidden=\"true\">\n      <defs>\n        <linearGradient id=\"lg\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n          <stop offset=\"0\" stop-color=\"#4f8cff\"/><stop offset=\"1\" stop-color=\"#7c5cff\"/>\n        </linearGradient>\n      </defs>\n      <circle cx=\"32\" cy=\"32\" r=\"29\" fill=\"none\" stroke=\"url(#lg)\" stroke-width=\"4\"/>\n      <path d=\"M18 42 L28 32 L35 37 L46 22\" fill=\"none\" stroke=\"#f5b942\" stroke-width=\"4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n      <circle cx=\"46\" cy=\"22\" r=\"4\" fill=\"#f5b942\"/>\n    </svg>\n    <div>\n      <h1>Retirement Calculator</h1>\n      <div class=\"sub\">Find the age you can retire while keeping the lifestyle you want.</div>\n    </div>\n  </header>\n\n  <div class=\"grid\">\n    <div class=\"card\" id=\"inputs\">\n      <h2>Your Numbers</h2>\n      <div id=\"fields\"></div>\n      <div class=\"divider\"></div>\n      <h2>Assumptions</h2>\n      <div id=\"assumptions\"></div>\n      <div class=\"hint\" style=\"margin-top:10px\">All figures are in today's dollars. Returns are adjusted for inflation automatically.</div>\n    </div>\n\n    <div>\n      <div class=\"hero\" id=\"hero\">\n        <div class=\"hero-ring\">\n          <svg viewBox=\"0 0 120 120\">\n            <circle cx=\"60\" cy=\"60\" r=\"52\" fill=\"none\" stroke=\"rgba(255,255,255,.1)\" stroke-width=\"10\"/>\n            <circle id=\"ringArc\" cx=\"60\" cy=\"60\" r=\"52\" fill=\"none\" stroke=\"url(#lg2)\" stroke-width=\"10\"\n                    stroke-linecap=\"round\" stroke-dasharray=\"326.7\" stroke-dashoffset=\"326.7\"/>\n            <defs>\n              <linearGradient id=\"lg2\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n                <stop offset=\"0\" stop-color=\"#4f8cff\"/><stop offset=\"1\" stop-color=\"#3ddc97\"/>\n              </linearGradient>\n            </defs>\n          </svg>\n          <div class=\"hero-age\"><div class=\"num\" id=\"heroAge\">--</div><div class=\"lbl\">Retire At</div></div>\n        </div>\n        <div class=\"hero-text\">\n          <h3 id=\"heroTitle\">Crunching the numbers...</h3>\n          <p id=\"heroBody\"></p>\n        </div>\n      </div>\n\n      <div class=\"stats\">\n        <div class=\"stat\"><div class=\"k\">Nest Egg Needed</div><div class=\"v\" id=\"stTarget\">--</div></div>\n        <div class=\"stat\"><div class=\"k\">Projected at Retirement</div><div class=\"v\" id=\"stAtRet\">--</div></div>\n        <div class=\"stat\"><div class=\"k\">Annual Retirement Budget</div><div class=\"v\" id=\"stBudget\">--</div></div>\n        <div class=\"stat\"><div class=\"k\">Years Until Retirement</div><div class=\"v\" id=\"stYears\">--</div></div>\n      </div>\n\n      <div class=\"card chart-card\">\n        <div class=\"chart-head\">\n          <h2 style=\"margin:0\">Savings Projection</h2>\n          <div class=\"legend\">\n            <span><i class=\"dot\" style=\"background:#4f8cff\"></i>Nest Egg</span>\n            <span><i class=\"dot\" style=\"background:#3ddc97\"></i>Retirement</span>\n          </div>\n        </div>\n        <canvas id=\"chart\"></canvas>\n      </div>\n    </div>\n  </div>\n\n  <footer>\n    Projections use inflation-adjusted (real) returns and your chosen safe withdrawal rate.<br>\n    This is an educational estimate, not financial advice. Markets vary; talk to a fiduciary advisor for real planning.<br>\n    <span style=\"opacity:.5\">build v7</span>\n  </footer>\n</div>\n\n<script>\n(function(){\n  'use strict';\n\n  var STORE_KEY = 'inputs:v1';\n  var state = {\n    age: 40, income: 120000, savings: 250000, saveRate: 15,\n    lifestyle: 80, ssAge: 67, ss: 28000,\n    ret: 7, infl: 2.5, swr: 4\n  };\n  var chartData = null;\n\n  var FIELDS = [\n    { id:'age',      grp:'fields', label:'Current age',                   min:18, max:75,  step:1,    fmt: function(v){return v;} },\n    { id:'income',   grp:'fields', label:'Annual household income',       min:20000, max:5000000, step:10000, fmt: money },\n    { id:'savings',  grp:'fields', label:'Current retirement savings',    min:0, max:20000000, step:50000, fmt: money },\n    { id:'saveRate', grp:'fields', label:'Savings rate (% of income)',    min:0, max:60,  step:1,    fmt: pct },\n    { id:'lifestyle',grp:'fields', label:'Retirement lifestyle (% of income)', min:40, max:120, step:5, fmt: pct,\n      hint:'How much of your current income you want to spend each year in retirement.' },\n    { id:'ss',       grp:'fields', label:'Social Security / pension (per yr)', min:0, max:80000, step:1000, fmt: money },\n    { id:'ssAge',    grp:'fields', label:'Benefits start at age',         min:62, max:70,  step:1,    fmt: function(v){return v;} },\n    { id:'ret',      grp:'assumptions', label:'Investment return (nominal)', min:2, max:12, step:0.5, fmt: pct },\n    { id:'infl',     grp:'assumptions', label:'Inflation',                min:0, max:8,   step:0.5,  fmt: pct },\n    { id:'swr',      grp:'assumptions', label:'Safe withdrawal rate',     min:2.5, max:15, step:0.25, fmt: pct,\n      hint:'The classic \"4% rule\" is the common baseline.' }\n  ];\n\n  function money(v){\n    if (v >= 1000000) return '$' + (v/1000000).toFixed(v % 1000000 === 0 ? 0 : 2) + 'M';\n    if (v >= 1000) return '$' + Math.round(v/1000) + 'K';\n    return '$' + Math.round(v);\n  }\n  function moneyFull(v){\n    return '$' + Math.round(v).toLocaleString('en-US');\n  }\n  function pct(v){ return v + '%'; }\n\n  function buildFields(){\n    FIELDS.forEach(function(f){\n      var wrap = document.createElement('div');\n      wrap.className = 'field';\n      wrap.innerHTML =\n        '<div class=\"field-head\"><label for=\"in_'+f.id+'\">'+f.label+'</label>' +\n        '<span class=\"val\" id=\"val_'+f.id+'\"></span></div>' +\n        '<input type=\"range\" id=\"in_'+f.id+'\" min=\"'+f.min+'\" max=\"'+f.max+'\" step=\"'+f.step+'\">' +\n        (f.hint ? '<div class=\"hint\">'+f.hint+'</div>' : '');\n      document.getElementById(f.grp).appendChild(wrap);\n      var input = wrap.querySelector('input');\n      input.value = state[f.id];\n      var onMove = function(){\n        state[f.id] = parseFloat(input.value);\n        syncField(f);\n        recalc();\n        saveSoon();\n      };\n      input.addEventListener('input', onMove);\n      input.addEventListener('change', onMove);\n      syncField(f);\n    });\n  }\n\n  function syncField(f){\n    var input = document.getElementById('in_'+f.id);\n    input.value = state[f.id];\n    document.getElementById('val_'+f.id).textContent = f.fmt(state[f.id]);\n    var fill = ((state[f.id]-f.min)/(f.max-f.min))*100;\n    input.style.setProperty('--fill', fill + '%');\n  }\n\n  function simulate(){\n    var realReturn = (1 + state.ret/100) / (1 + state.infl/100) - 1;\n    var spending = state.income * state.lifestyle/100;\n    var contrib = state.income * state.saveRate/100;\n    var swr = state.swr/100;\n\n    var series = [];\n    var bal = state.savings;\n    var retireAge = null;\n    var runOutAge = null;\n    var annualDraw = 0;\n    var maxAge = 100;\n\n    for (var age = state.age; age <= maxAge; age++){\n      var gap = Math.max(0, spending - (age >= state.ssAge ? state.ss : 0));\n      // Bridge: if retiring before SS starts, must also fund the pre-SS gap years fully\n      var target;\n      if (age >= state.ssAge){\n        target = gap / swr;\n      } else {\n        var postSSGap = Math.max(0, spending - state.ss);\n        var bridgeYears = state.ssAge - age;\n        // fund bridge years at full spending (present value at real return), plus perpetuity after SS\n        var pv = 0;\n        for (var y = 0; y < bridgeYears; y++) pv += spending / Math.pow(1+realReturn, y);\n        target = pv + (postSSGap / swr) / Math.pow(1+realReturn, bridgeYears);\n      }\n      series.push({ age: age, bal: bal, target: target, retired: retireAge !== null });\n      if (retireAge === null && bal >= target && age > state.age){\n        retireAge = age;\n        // From here on you withdraw SWR% of the retirement-day nest egg,\n        // fixed in real dollars — the classic safe-withdrawal-rate rule.\n        annualDraw = bal * swr;\n      }\n\n      // Monthly compounding: growth compounds each month, with contributions\n      // (or withdrawals) applied monthly rather than in one annual lump.\n      var rm = Math.pow(1 + realReturn, 1/12) - 1;\n      if (retireAge === null || age < retireAge){\n        var cm = contrib / 12;\n        for (var m = 0; m < 12; m++) bal = bal * (1 + rm) + cm;\n      } else {\n        var dm = annualDraw / 12;\n        for (var m2 = 0; m2 < 12; m2++){\n          bal = bal * (1 + rm) - dm;\n          if (bal <= 0){\n            bal = 0;\n            if (runOutAge === null) runOutAge = age + 1;\n            break;\n          }\n        }\n      }\n    }\n\n    // target to display: the one at retirement age (or at maxAge)\n    var idx = retireAge !== null ? (retireAge - state.age) : series.length - 1;\n    return {\n      retireAge: retireAge,\n      runOutAge: runOutAge,\n      annualDraw: annualDraw,\n      series: series,\n      targetAtRet: series[idx].target,\n      balAtRet: series[idx].bal,\n      spending: spending\n    };\n  }\n\n  function recalc(){\n    var r = simulate();\n    chartData = r;\n\n    var heroAge = document.getElementById('heroAge');\n    var heroTitle = document.getElementById('heroTitle');\n    var heroBody = document.getElementById('heroBody');\n    var ring = document.getElementById('ringArc');\n    var C = 326.7;\n\n    if (r.retireAge !== null){\n      var yrs = r.retireAge - state.age;\n      heroAge.textContent = r.retireAge;\n      var frac = Math.max(0.04, Math.min(1, 1 - yrs/45));\n      ring.setAttribute('stroke-dashoffset', (C * (1-frac)).toFixed(1));\n      if (r.runOutAge !== null){\n        heroTitle.innerHTML = 'You could retire at ' + r.retireAge + ', but the money <span class=\"bad\">runs out at ' + r.runOutAge + '</span>.';\n        heroBody.textContent = 'Withdrawing ' + state.swr + '% a year (' + moneyFull(r.annualDraw) +\n          ') outpaces growth and depletes the nest egg by age ' + r.runOutAge +\n          '. Lower the withdrawal rate, save longer, or trim the lifestyle target.';\n      } else if (yrs <= 10){\n        heroTitle.innerHTML = 'You’re on a <span class=\"good\">strong track</span>.';\n        heroBody.textContent = 'At your current pace you can retire at ' + r.retireAge +\n          ' with ' + moneyFull(r.spending) + ' a year to spend (in today’s dollars), sustained by a ' +\n          state.swr + '% withdrawal rate.';\n      } else if (yrs <= 25){\n        heroTitle.innerHTML = 'Retirement at ' + r.retireAge + ' is <span class=\"warn\">within reach</span>.';\n        heroBody.textContent = 'Keep saving ' + state.saveRate + '% of income and you’ll hit your ' +\n          moneyFull(r.spending) + '/yr lifestyle target in ' + yrs + ' years. Bumping your savings rate moves this needle fastest.';\n      } else {\n        heroTitle.innerHTML = 'It’s a <span class=\"warn\">long road</span> at the current pace.';\n        heroBody.textContent = 'You’d reach your target at ' + r.retireAge + '. Raising your savings rate or trimming the lifestyle target will bring that in significantly.';\n      }\n      document.getElementById('stYears').innerHTML = yrs + ' <small>years</small>';\n    } else {\n      heroAge.textContent = '100+';\n      ring.setAttribute('stroke-dashoffset', C * 0.96);\n      heroTitle.innerHTML = 'Target <span class=\"bad\">not reached</span> by age 100.';\n      heroBody.textContent = 'At the current savings rate the portfolio never covers a ' +\n        moneyFull(r.spending) + '/yr lifestyle. Try a higher savings rate, a later benefits estimate, or a leaner lifestyle target.';\n      document.getElementById('stYears').innerHTML = '&mdash;';\n    }\n\n    document.getElementById('stTarget').textContent = money(r.targetAtRet);\n    document.getElementById('stAtRet').textContent = money(r.balAtRet);\n    document.getElementById('stBudget').textContent = moneyFull(r.spending);\n    drawChart();\n  }\n\n  // ---- Chart (hand-rolled canvas, DPI-aware) ----\n  var canvas = document.getElementById('chart');\n  var ctx = canvas.getContext('2d');\n\n  function chartW(){ return canvas.clientWidth || canvas.parentNode.clientWidth || 700; }\n\n  function drawChart(){\n    if (!chartData) return;\n    var dpr = window.devicePixelRatio || 1;\n    var w = chartW(), h = 300;\n    if (w < 10) w = 700;\n    canvas.width = w * dpr; canvas.height = h * dpr;\n    canvas.style.height = h + 'px';\n    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);\n    ctx.clearRect(0, 0, w, h);\n\n    var s = chartData.series;\n    var padL = 56, padR = 16, padT = 14, padB = 30;\n    var iw = w - padL - padR, ih = h - padT - padB;\n\n    var view = s;\n    var maxV = 0;\n    view.forEach(function(p){ maxV = Math.max(maxV, p.bal); });\n    maxV *= 1.08;\n    if (maxV <= 0) maxV = 1;\n\n    function X(i){ return padL + (i/(view.length-1||1)) * iw; }\n    function Y(v){ return padT + ih - (v/maxV) * ih; }\n\n    // gridlines\n    ctx.font = '11px -apple-system, sans-serif';\n    ctx.fillStyle = 'rgba(255,255,255,.35)';\n    ctx.strokeStyle = 'rgba(255,255,255,.07)';\n    ctx.lineWidth = 1;\n    for (var g = 0; g <= 4; g++){\n      var v = maxV * g/4, y = Y(v);\n      ctx.beginPath(); ctx.moveTo(padL, y); ctx.lineTo(w-padR, y); ctx.stroke();\n      ctx.textAlign = 'right';\n      ctx.fillText(money(v), padL - 8, y + 4);\n    }\n    // x labels (ages)\n    ctx.textAlign = 'center';\n    var stepN = Math.max(1, Math.round(view.length/8));\n    for (var i = 0; i < view.length; i += stepN){\n      ctx.fillText(view[i].age, X(i), h - 10);\n    }\n\n    // portfolio area fill\n    var gradFill = ctx.createLinearGradient(0, padT, 0, padT + ih);\n    gradFill.addColorStop(0, 'rgba(79,140,255,.35)');\n    gradFill.addColorStop(1, 'rgba(79,140,255,.02)');\n    ctx.beginPath();\n    view.forEach(function(p, i){ i === 0 ? ctx.moveTo(X(i), Y(p.bal)) : ctx.lineTo(X(i), Y(p.bal)); });\n    ctx.lineTo(X(view.length-1), padT + ih);\n    ctx.lineTo(X(0), padT + ih);\n    ctx.closePath();\n    ctx.fillStyle = gradFill;\n    ctx.fill();\n\n    // portfolio line\n    ctx.strokeStyle = '#4f8cff'; ctx.lineWidth = 2.4;\n    ctx.beginPath();\n    view.forEach(function(p, i){ i === 0 ? ctx.moveTo(X(i), Y(p.bal)) : ctx.lineTo(X(i), Y(p.bal)); });\n    ctx.stroke();\n\n    // retirement marker\n    if (chartData.retireAge !== null){\n      var ri = chartData.retireAge - state.age;\n      if (ri >= 0 && ri < view.length){\n        var rx = X(ri), ry = Y(view[ri].bal);\n        ctx.strokeStyle = 'rgba(61,220,151,.55)';\n        ctx.setLineDash([3,4]);\n        ctx.beginPath(); ctx.moveTo(rx, padT); ctx.lineTo(rx, padT + ih); ctx.stroke();\n        ctx.setLineDash([]);\n        ctx.fillStyle = '#3ddc97';\n        ctx.beginPath(); ctx.arc(rx, ry, 5.5, 0, Math.PI*2); ctx.fill();\n        ctx.strokeStyle = '#0b1020'; ctx.lineWidth = 2;\n        ctx.beginPath(); ctx.arc(rx, ry, 5.5, 0, Math.PI*2); ctx.stroke();\n        ctx.fillStyle = '#3ddc97';\n        ctx.font = 'bold 12px -apple-system, sans-serif';\n        ctx.textAlign = rx > w - 90 ? 'right' : 'left';\n        ctx.fillText('Retire @ ' + chartData.retireAge, rx + (rx > w - 90 ? -10 : 10), padT + 16);\n      }\n    }\n\n    // depletion marker\n    if (chartData.runOutAge !== null){\n      var di = chartData.runOutAge - state.age;\n      if (di >= 0 && di < view.length){\n        var dx = X(di);\n        ctx.strokeStyle = 'rgba(255,107,129,.6)';\n        ctx.setLineDash([3,4]);\n        ctx.beginPath(); ctx.moveTo(dx, padT); ctx.lineTo(dx, padT + ih); ctx.stroke();\n        ctx.setLineDash([]);\n        ctx.fillStyle = '#ff6b81';\n        ctx.beginPath(); ctx.arc(dx, padT + ih, 5.5, 0, Math.PI*2); ctx.fill();\n        ctx.font = 'bold 12px -apple-system, sans-serif';\n        ctx.textAlign = dx > w - 110 ? 'right' : 'left';\n        ctx.fillText('Runs out @ ' + chartData.runOutAge, dx + (dx > w - 110 ? -10 : 10), padT + 34);\n      }\n    }\n  }\n\n  // ---- Persistence via CV bridge (storage.kv), graceful without it ----\n  var cv = window.clairvoyance;\n  var saveTimer = null;\n  function saveSoon(){\n    if (!cv || !cv.storage) return;\n    clearTimeout(saveTimer);\n    saveTimer = setTimeout(function(){\n      cv.storage.set(STORE_KEY, state).catch(function(){ /* ignore */ });\n    }, 600);\n  }\n  function loadSaved(){\n    if (!cv || !cv.storage) return Promise.resolve();\n    return cv.storage.get(STORE_KEY).then(function(saved){\n      if (saved && typeof saved === 'object'){\n        FIELDS.forEach(function(f){\n          if (typeof saved[f.id] === 'number' && isFinite(saved[f.id])){\n            state[f.id] = Math.min(f.max, Math.max(f.min, saved[f.id]));\n          }\n        });\n        FIELDS.forEach(syncField);\n      }\n    }).catch(function(){ /* first run or denied — defaults are fine */ });\n  }\n\n  // ---- Init ----\n  buildFields();\n  recalc();\n  loadSaved().then(recalc);\n  window.addEventListener('resize', drawChart);\n  // iframe may lay out after script runs\n  setTimeout(drawChart, 80);\n  setTimeout(drawChart, 400);\n})();\n</script>\n</body>\n</html>\n"
  },
  "permissions": {
    "allowNetwork": false,
    "allowStorage": false,
    "allowClipboardRead": false,
    "allowClipboardWrite": false
  },
  "capabilities": {
    "version": 1,
    "requested": [
      "storage.kv"
    ]
  }
}
