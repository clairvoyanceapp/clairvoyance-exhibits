  "content": {
    "type": "html",
    "bundle": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Hot Dog Physics Sandbox</title>\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    html, body { width: 100%; height: 100%; overflow: hidden; background: #9ecfff; font-family: \"Segoe UI\", system-ui, sans-serif; color: #2b2118; }\n    canvas { display: block; cursor: default; }\n    #hud { position: absolute; top: 14px; left: 14px; width: 262px; background: rgba(255, 250, 240, 0.9); border: 2px solid #c8372d; border-radius: 10px; padding: 12px 14px; box-shadow: 0 4px 18px rgba(0,0,0,0.18); }\n    #hud h1 { font-size: 16px; font-weight: 700; color: #c8372d; letter-spacing: 0.02em; }\n    #hud h1 small { display: block; font-size: 10px; font-weight: 500; color: #8a6d4b; letter-spacing: 0.12em; text-transform: uppercase; margin-top: 2px; }\n    .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; margin-top: 10px; }\n    .grid button.wide { grid-column: 1 / span 2; }\n    button { background: #f6c84c; border: 1px solid #c99a1c; color: #3a2a12; border-radius: 6px; padding: 6px 8px; font-size: 12px; font-weight: 600; cursor: pointer; }\n    button:hover { background: #ffd866; }\n    button.fire { background: #c8372d; border-color: #8e1f17; color: #fff6e8; }\n    button.fire:hover { background: #e04a3f; }\n    button.quiet { background: #efe6d6; border-color: #cdbfa8; color: #5a4632; font-weight: 500; }\n    .row { display: flex; align-items: center; justify-content: space-between; margin-top: 10px; font-size: 12px; gap: 8px; }\n    select { font-size: 12px; padding: 3px 6px; border-radius: 5px; border: 1px solid #cdbfa8; background: #fff; color: #3a2a12; }\n    #score { margin-top: 12px; padding-top: 10px; border-top: 1px dashed #cdbfa8; font-size: 12px; line-height: 1.6; }\n    #score b { color: #c8372d; font-size: 16px; }\n    #stats { position: absolute; top: 14px; right: 14px; font-size: 11px; color: #4a3b2a; text-align: right; line-height: 1.6; background: rgba(255, 250, 240, 0.85); padding: 6px 10px; border-radius: 6px; }\n    #hint { position: absolute; bottom: 14px; left: 50%; transform: translateX(-50%); font-size: 12px; color: #3a2a12; background: rgba(255, 250, 240, 0.85); padding: 6px 14px; border-radius: 6px; white-space: nowrap; }\n    #loading { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: #3a2a12; font-size: 13px; letter-spacing: 0.15em; text-transform: uppercase; }\n    #error { position: absolute; inset: 0; display: none; align-items: center; justify-content: center; padding: 30px; text-align: center; color: #8e1f17; background: rgba(255,250,240,0.95); font-size: 13px; line-height: 1.6; }\n  </style>\n</head>\n<body>\n<div id=\"loading\">Heating the grill…</div>\n<div id=\"error\"></div>\n\n<div id=\"hud\">\n  <h1>Hot Dog Physics<small>three.js r169 · cannon-es</small></h1>\n  <div class=\"grid\">\n    <button id=\"addDog\">+ Hot dog</button>\n    <button id=\"addBun\">+ Dog in bun</button>\n    <button id=\"rain\">Rain × 12</button>\n    <button id=\"pyramid\">Build pyramid</button>\n    <button id=\"fire\" class=\"fire wide\">FIRE! (space)</button>\n  </div>\n  <div class=\"row\"><span>Gravity</span>\n    <select id=\"gravity\">\n      <option value=\"1.62\">Moon</option>\n      <option value=\"3.71\">Mars</option>\n      <option value=\"9.82\" selected>Earth</option>\n      <option value=\"24.79\">Jupiter</option>\n    </select>\n  </div>\n  <div class=\"row\"><span>Slow motion</span><button id=\"slow\" class=\"quiet\">Off</button></div>\n  <div class=\"row\"><span>Clear the table</span><button id=\"reset\" class=\"quiet\">Reset</button></div>\n  <div id=\"score\">Tallest stack: <b id=\"stack\">0</b> dogs high</div>\n</div>\n<div id=\"stats\"><span id=\"fps\">— fps</span><br><span id=\"count\">0 hot dogs</span></div>\n<div id=\"hint\">Drag a hot dog to fling it · Right-drag to orbit · Scroll to zoom</div>\n\n<!-- Import map MUST precede the module script -->\n<script type=\"importmap\">\n{\n  \"imports\": {\n    \"three\": \"https://cdn.jsdelivr.net/npm/three@0.169.0/build/three.module.js\",\n    \"three/addons/\": \"https://cdn.jsdelivr.net/npm/three@0.169.0/examples/jsm/\",\n    \"cannon-es\": \"https://cdn.jsdelivr.net/npm/cannon-es@0.20.0/dist/cannon-es.js\"\n  }\n}\n</script>\n\n<script>\n  window.addEventListener('error', function (e) {\n    var el = document.getElementById('error');\n    el.style.display = 'flex';\n    el.textContent = 'Failed to start: ' + (e.message || 'unknown error') + '. If the scene stays empty, the CDN for three.js or cannon-es may be unreachable.';\n    document.getElementById('loading').style.display = 'none';\n  });\n</script>\n\n<script type=\"module\">\n  import * as THREE from 'three';\n  import { OrbitControls } from 'three/addons/controls/OrbitControls.js';\n  import * as CANNON from 'cannon-es';\n\n  document.getElementById('loading').style.display = 'none';\n\n  function viewW() { return document.documentElement.clientWidth || window.innerWidth || 800; }\n  function viewH() { return document.documentElement.clientHeight || window.innerHeight || 600; }\n  const rnd = (a, b) => a + Math.random() * (b - a);\n\n  // ---------- Three.js scene ----------\n  const scene = new THREE.Scene();\n  scene.background = new THREE.Color(0x9ecfff);\n  scene.fog = new THREE.Fog(0x9ecfff, 70, 170);\n\n  const camera = new THREE.PerspectiveCamera(50, viewW() / viewH(), 0.1, 400);\n  camera.position.set(0, 12, 24);\n\n  const renderer = new THREE.WebGLRenderer({ antialias: true });\n  renderer.setSize(viewW(), viewH());\n  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));\n  renderer.shadowMap.enabled = true;\n  renderer.shadowMap.type = THREE.PCFSoftShadowMap;\n  renderer.toneMapping = THREE.ACESFilmicToneMapping;\n  renderer.toneMappingExposure = 1.05;\n  document.body.appendChild(renderer.domElement);\n\n  const controls = new OrbitControls(camera, renderer.domElement);\n  controls.enableDamping = true;\n  controls.dampingFactor = 0.08;\n  controls.target.set(0, 1, 0);\n  controls.minDistance = 5;\n  controls.maxDistance = 70;\n  controls.maxPolarAngle = Math.PI / 2 - 0.04;\n\n  scene.add(new THREE.HemisphereLight(0xcfe4ff, 0x5f8a3f, 0.7));\n  const sunLight = new THREE.DirectionalLight(0xfff1dc, 2.4);\n  sunLight.position.set(14, 22, 10);\n  sunLight.castShadow = true;\n  sunLight.shadow.mapSize.set(2048, 2048);\n  sunLight.shadow.camera.left = -18; sunLight.shadow.camera.right = 18;\n  sunLight.shadow.camera.top = 16; sunLight.shadow.camera.bottom = -16;\n  sunLight.shadow.camera.near = 2; sunLight.shadow.camera.far = 70;\n  sunLight.shadow.bias = -0.0008;\n  scene.add(sunLight);\n\n  // ---------- Physics world ----------\n  const world = new CANNON.World({ gravity: new CANNON.Vec3(0, -9.82, 0) });\n  world.broadphase = new CANNON.SAPBroadphase(world);\n  world.allowSleep = true;\n  const matTable = new CANNON.Material('table');\n  const matDog = new CANNON.Material('dog');\n  world.addContactMaterial(new CANNON.ContactMaterial(matDog, matTable, { friction: 0.55, restitution: 0.25 }));\n  world.addContactMaterial(new CANNON.ContactMaterial(matDog, matDog, { friction: 0.45, restitution: 0.2 }));\n  world.defaultContactMaterial.friction = 0.5;\n\n  // ---------- Static scenery ----------\n  const TABLE_HX = 12, TABLE_HZ = 8;\n\n  // Grass\n  const grass = new THREE.Mesh(new THREE.PlaneGeometry(300, 300), new THREE.MeshStandardMaterial({ color: 0x5b9a3c, roughness: 1 }));\n  grass.rotation.x = -Math.PI / 2; grass.position.y = -6; grass.receiveShadow = true;\n  scene.add(grass);\n  const grassBody = new CANNON.Body({ mass: 0, material: matTable, shape: new CANNON.Plane() });\n  grassBody.quaternion.setFromEuler(-Math.PI / 2, 0, 0);\n  grassBody.position.set(0, -6, 0);\n  world.addBody(grassBody);\n\n  // Checkered tablecloth texture\n  function makeClothTexture() {\n    const c = document.createElement('canvas'); c.width = 256; c.height = 256;\n    const ctx = c.getContext('2d');\n    const n = 8, s = c.width / n;\n    for (let y = 0; y < n; y++) for (let x = 0; x < n; x++) {\n      ctx.fillStyle = (x + y) % 2 ? '#d8352b' : '#fff8ee';\n      ctx.fillRect(x * s, y * s, s, s);\n    }\n    const t = new THREE.CanvasTexture(c);\n    t.wrapS = t.wrapT = THREE.RepeatWrapping;\n    t.repeat.set(6, 4);\n    t.colorSpace = THREE.SRGBColorSpace;\n    t.anisotropy = 8;\n    return t;\n  }\n  const clothMat = new THREE.MeshStandardMaterial({ map: makeClothTexture(), roughness: 0.9 });\n  const woodMat = new THREE.MeshStandardMaterial({ color: 0x8a5a2b, roughness: 0.85 });\n  const tableTop = new THREE.Mesh(new THREE.BoxGeometry(TABLE_HX * 2, 1, TABLE_HZ * 2), [woodMat, woodMat, clothMat, woodMat, woodMat, woodMat]);\n  tableTop.position.y = -0.5; tableTop.receiveShadow = true; tableTop.castShadow = true;\n  scene.add(tableTop);\n  [[-1, -1], [1, -1], [-1, 1], [1, 1]].forEach(([sx, sz]) => {\n    const leg = new THREE.Mesh(new THREE.BoxGeometry(0.7, 5, 0.7), woodMat);\n    leg.position.set(sx * (TABLE_HX - 1.2), -3.5, sz * (TABLE_HZ - 1.2)); leg.castShadow = true;\n    scene.add(leg);\n  });\n  const tableBody = new CANNON.Body({ mass: 0, material: matTable, shape: new CANNON.Box(new CANNON.Vec3(TABLE_HX, 0.5, TABLE_HZ)) });\n  tableBody.position.set(0, -0.5, 0);\n  world.addBody(tableBody);\n\n  // Plate\n  const PLATE_R = 3.2, PLATE_H = 0.25;\n  const plate = new THREE.Mesh(new THREE.CylinderGeometry(PLATE_R, PLATE_R * 0.85, PLATE_H, 48), new THREE.MeshStandardMaterial({ color: 0xf4f1ea, roughness: 0.35, metalness: 0.05 }));\n  plate.position.y = PLATE_H / 2; plate.receiveShadow = true; plate.castShadow = true;\n  scene.add(plate);\n  const plateRim = new THREE.Mesh(new THREE.TorusGeometry(PLATE_R - 0.05, 0.06, 12, 64), new THREE.MeshStandardMaterial({ color: 0x3b6fb6, roughness: 0.4 }));\n  plateRim.rotation.x = Math.PI / 2; plateRim.position.y = PLATE_H + 0.01;\n  scene.add(plateRim);\n  const plateBody = new CANNON.Body({ mass: 0, material: matTable, shape: new CANNON.Cylinder(PLATE_R, PLATE_R * 0.85, PLATE_H, 24) });\n  plateBody.position.set(0, PLATE_H / 2, 0);\n  world.addBody(plateBody);\n\n  // ---------- Hot dog assets (shared) ----------\n  const geoSausage = new THREE.CapsuleGeometry(0.2, 1.5, 6, 18);\n  const geoBun = new THREE.CapsuleGeometry(0.3, 1.4, 6, 18);\n  const matSausage = new THREE.MeshStandardMaterial({ color: 0xb8452a, roughness: 0.5, metalness: 0.02 });\n  const matBun = new THREE.MeshStandardMaterial({ color: 0xe2a95c, roughness: 0.95 });\n  const matMustard = new THREE.MeshStandardMaterial({ color: 0xf3c40c, roughness: 0.4, emissive: 0x3a2d00 });\n  const matKetchup = new THREE.MeshStandardMaterial({ color: 0xc8161d, roughness: 0.3, emissive: 0x2a0305 });\n  function squiggle(freq, phase, zOff) {\n    const pts = [];\n    for (let i = 0; i <= 28; i++) {\n      const t = i / 28;\n      pts.push(new THREE.Vector3(-0.7 + 1.4 * t, 0.37, zOff + 0.11 * Math.sin(t * Math.PI * freq + phase)));\n    }\n    return new THREE.TubeGeometry(new THREE.CatmullRomCurve3(pts), 56, 0.04, 6, false);\n  }\n  const geoMustard = squiggle(6, 0, 0);\n  const geoKetchup = squiggle(5, 1.3, 0.05);\n\n  const BUN_HALF = new CANNON.Vec3(1.0, 0.4, 0.56);\n  const ROW_H = 0.82;\n\n  function makeHotDogMesh(withBun) {\n    const g = new THREE.Group();\n    const s = new THREE.Mesh(geoSausage, matSausage);\n    s.rotation.z = Math.PI / 2;\n    s.position.y = withBun ? 0.16 : 0;\n    s.castShadow = true; s.receiveShadow = true;\n    g.add(s);\n    if (withBun) {\n      [-0.24, 0.24].forEach(z => {\n        const b = new THREE.Mesh(geoBun, matBun);\n        b.rotation.z = Math.PI / 2;\n        b.position.set(0, -0.1, z);\n        b.castShadow = true; b.receiveShadow = true;\n        g.add(b);\n      });\n      const sauce = new THREE.Mesh(Math.random() < 0.7 ? geoMustard : geoKetchup, Math.random() < 0.7 ? matMustard : matKetchup);\n      sauce.castShadow = true;\n      g.add(sauce);\n    }\n    return g;\n  }\n\n  // ---------- Dynamic bodies ----------\n  const dogs = [];\n  const MAX_DOGS = 160;\n\n  function spawn(withBun, pos, quat) {\n    if (dogs.length >= MAX_DOGS) {\n      const victim = dogs.find(d => d !== (dragging && dragging.dog));\n      if (victim) removeDog(victim);\n    }\n    const mesh = makeHotDogMesh(withBun);\n    const body = new CANNON.Body({ mass: withBun ? 1.4 : 0.8, material: matDog, linearDamping: 0.04, angularDamping: 0.25 });\n    if (withBun) {\n      body.addShape(new CANNON.Box(BUN_HALF), new CANNON.Vec3(0, -0.02, 0));\n    } else {\n      [-0.55, -0.18, 0.18, 0.55].forEach(x => body.addShape(new CANNON.Sphere(0.2), new CANNON.Vec3(x, 0, 0)));\n    }\n    body.position.set(pos.x, pos.y, pos.z);\n    if (quat) body.quaternion.copy(quat); else body.quaternion.setFromEuler(rnd(0, Math.PI), rnd(0, Math.PI * 2), rnd(0, Math.PI));\n    body.sleepSpeedLimit = 0.3;\n    body.sleepTimeLimit = 0.7;\n    world.addBody(body);\n    scene.add(mesh);\n    const dog = { body, mesh, withBun };\n    mesh.userData.dog = dog;\n    dogs.push(dog);\n    updateCount();\n    return dog;\n  }\n\n  function removeDog(dog) {\n    const i = dogs.indexOf(dog);\n    if (i >= 0) dogs.splice(i, 1);\n    world.removeBody(dog.body);\n    scene.remove(dog.mesh);\n    updateCount();\n  }\n\n  function dropAbovePlate(withBun) {\n    return spawn(withBun, new THREE.Vector3(rnd(-1.8, 1.8), rnd(6, 9), rnd(-1.4, 1.4)));\n  }\n\n  function rain(n) {\n    let i = 0;\n    const t = setInterval(() => { dropAbovePlate(Math.random() < 0.5); if (++i >= n) clearInterval(t); }, 110);\n  }\n\n  function pyramid() {\n    const rows = 5;\n    const q = new CANNON.Quaternion(0, 0, 0, 1);\n    for (let k = 0; k < rows; k++) {\n      const n = rows - k;\n      for (let i = 0; i < n; i++) {\n        const z = (i - (n - 1) / 2) * 1.16;\n        const y = PLATE_H + 0.42 + k * ROW_H + 0.02;\n        spawn(true, new THREE.Vector3(rnd(-0.03, 0.03), y, z), q);\n      }\n    }\n  }\n\n  function fire() {\n    const dir = camera.getWorldDirection(new THREE.Vector3());\n    const pos = camera.position.clone().add(dir.clone().multiplyScalar(3));\n    const d = spawn(Math.random() < 0.6, pos);\n    const v = 32;\n    d.body.velocity.set(dir.x * v, dir.y * v + 2, dir.z * v);\n    d.body.angularVelocity.set(rnd(-8, 8), rnd(-8, 8), rnd(-8, 8));\n  }\n\n  function resetAll() {\n    endDrag();\n    while (dogs.length) removeDog(dogs[dogs.length - 1]);\n  }\n\n  // ---------- Mouse grab (point-to-point constraint to a massless joint body) ----------\n  const raycaster = new THREE.Raycaster();\n  const pointer = new THREE.Vector2();\n  const dragPlane = new THREE.Plane();\n  const planeHit = new THREE.Vector3();\n  const jointBody = new CANNON.Body({ mass: 0 });\n  jointBody.addShape(new CANNON.Sphere(0.05));\n  jointBody.collisionFilterGroup = 0;\n  jointBody.collisionFilterMask = 0;\n  world.addBody(jointBody);\n  let dragging = null;\n\n  function setPointer(e) {\n    pointer.x = (e.clientX / viewW()) * 2 - 1;\n    pointer.y = -(e.clientY / viewH()) * 2 + 1;\n  }\n  function pickDog() {\n    raycaster.setFromCamera(pointer, camera);\n    const hits = raycaster.intersectObjects(dogs.map(d => d.mesh), true);\n    if (!hits.length) return null;\n    let o = hits[0].object;\n    while (o && !o.userData.dog) o = o.parent;\n    return o ? { dog: o.userData.dog, point: hits[0].point } : null;\n  }\n  function endDrag() {\n    if (!dragging) return;\n    world.removeConstraint(dragging.constraint);\n    dragging = null;\n    controls.enabled = true;\n    renderer.domElement.style.cursor = 'default';\n  }\n\n  // Capture on window so a grab reaches us before OrbitControls sees the pointerdown.\n  window.addEventListener('pointerdown', e => {\n    if (e.button !== 0 || e.target !== renderer.domElement) return;\n    setPointer(e);\n    const hit = pickDog();\n    if (!hit) return;\n    e.stopPropagation(); e.preventDefault();\n    const body = hit.dog.body;\n    body.wakeUp();\n    const camDir = camera.getWorldDirection(new THREE.Vector3());\n    dragPlane.setFromNormalAndCoplanarPoint(camDir, hit.point);\n    const worldPivot = new CANNON.Vec3(hit.point.x, hit.point.y, hit.point.z);\n    const localPivot = body.pointToLocalFrame(worldPivot);\n    jointBody.position.copy(worldPivot);\n    const constraint = new CANNON.PointToPointConstraint(body, localPivot, jointBody, new CANNON.Vec3(0, 0, 0), 600);\n    world.addConstraint(constraint);\n    dragging = { dog: hit.dog, constraint };\n    controls.enabled = false;\n    renderer.domElement.style.cursor = 'grabbing';\n  }, true);\n\n  window.addEventListener('pointermove', e => {\n    setPointer(e);\n    if (dragging) {\n      raycaster.setFromCamera(pointer, camera);\n      if (raycaster.ray.intersectPlane(dragPlane, planeHit)) {\n        jointBody.position.set(planeHit.x, planeHit.y, planeHit.z);\n        dragging.constraint.update();\n      }\n    } else if (e.target === renderer.domElement) {\n      renderer.domElement.style.cursor = pickDog() ? 'grab' : 'default';\n    }\n  });\n  window.addEventListener('pointerup', endDrag);\n  window.addEventListener('pointercancel', endDrag);\n  window.addEventListener('blur', endDrag);\n\n  // Scroll while holding a dog pulls it toward or away from you instead of zooming.\n  renderer.domElement.addEventListener('wheel', e => {\n    if (!dragging) return;\n    e.preventDefault(); e.stopImmediatePropagation();\n    const camDir = camera.getWorldDirection(new THREE.Vector3());\n    const shift = camDir.multiplyScalar(e.deltaY > 0 ? 0.6 : -0.6);\n    dragPlane.constant -= shift.dot(dragPlane.normal);\n    jointBody.position.set(jointBody.position.x + shift.x, jointBody.position.y + shift.y, jointBody.position.z + shift.z);\n    dragging.constraint.update();\n  }, { passive: false, capture: true });\n\n  // ---------- HUD wiring ----------\n  let timeScale = 1;\n  document.getElementById('addDog').addEventListener('click', () => dropAbovePlate(false));\n  document.getElementById('addBun').addEventListener('click', () => dropAbovePlate(true));\n  document.getElementById('rain').addEventListener('click', () => rain(12));\n  document.getElementById('pyramid').addEventListener('click', pyramid);\n  document.getElementById('fire').addEventListener('click', fire);\n  document.getElementById('reset').addEventListener('click', resetAll);\n  document.getElementById('gravity').addEventListener('change', e => {\n    world.gravity.set(0, -parseFloat(e.target.value), 0);\n    dogs.forEach(d => d.body.wakeUp());\n  });\n  document.getElementById('slow').addEventListener('click', e => {\n    timeScale = timeScale === 1 ? 0.25 : 1;\n    e.target.textContent = timeScale === 1 ? 'Off' : 'On';\n  });\n  window.addEventListener('keydown', e => {\n    if (e.code === 'Space') { e.preventDefault(); fire(); }\n  });\n  function updateCount() {\n    document.getElementById('count').textContent = dogs.length + (dogs.length === 1 ? ' hot dog' : ' hot dogs');\n  }\n\n  // ---------- Loop ----------\n  const clock = new THREE.Clock();\n  let frames = 0, fpsT = 0, scoreT = 0;\n  function animate() {\n    requestAnimationFrame(animate);\n    const dt = Math.min(clock.getDelta(), 0.05);\n    world.step(1 / 60, dt * timeScale, 6);\n\n    for (let i = dogs.length - 1; i >= 0; i--) {\n      const d = dogs[i];\n      d.mesh.position.copy(d.body.position);\n      d.mesh.quaternion.copy(d.body.quaternion);\n      if (d.body.position.y < -40) removeDog(d);\n    }\n\n    controls.update();\n    renderer.render(scene, camera);\n\n    frames++; fpsT += dt; scoreT += dt;\n    if (fpsT >= 0.5) { document.getElementById('fps').textContent = Math.round(frames / fpsT) + ' fps'; frames = 0; fpsT = 0; }\n    if (scoreT >= 0.3) {\n      scoreT = 0;\n      let top = 0;\n      dogs.forEach(d => {\n        const p = d.body.position;\n        const resting = d.body.sleepState === CANNON.Body.SLEEPING || d.body.velocity.lengthSquared() < 0.05;\n        if (resting && Math.abs(p.x) < TABLE_HX && Math.abs(p.z) < TABLE_HZ && p.y > 0) top = Math.max(top, p.y + 0.4);\n      });\n      document.getElementById('stack').textContent = String(Math.max(0, Math.round(top / ROW_H)));\n    }\n  }\n\n  function onResize() {\n    camera.aspect = viewW() / viewH();\n    camera.updateProjectionMatrix();\n    renderer.setSize(viewW(), viewH());\n  }\n  window.addEventListener('resize', onResize);\n  if (window.ResizeObserver) new ResizeObserver(onResize).observe(document.body);\n\n  rain(8);\n  animate();\n</script>\n</body>\n</html>\n"
  },
  "permissions": {
    "allowNetwork": true,
    "allowStorage": false,
    "allowClipboard": false
  }
}
