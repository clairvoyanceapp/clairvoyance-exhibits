{
  "version": 1,
  "metadata": {
    "type": "container",
    "id": "exhibit-1793745394226-5ycp81lb1",
    "name": "Snake",
    "description": "Snake with progressive sparkle bursts, WebAudio sound effects (eat, level-up, death, start — M to mute), and obstacle blocks that spawn after every 5th food, growing in number each level.",
    "createdAt": 1793745394226,
    "updatedAt": 1793746397752,
    "tags": [
      "game",
      "snake",
      "canvas"
    ],
    "categories": []
  },
  "content": {
    "type": "html",
    "bundle": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Snake</title>\n<style>\n  :root {\n    --bg: #0f172a;\n    --panel: #1e293b;\n    --grid: #16213a;\n    --text: #e2e8f0;\n    --dim: #64748b;\n    --accent: #4ade80;\n  }\n  * { margin: 0; padding: 0; box-sizing: border-box; }\n  body {\n    background: var(--bg);\n    color: var(--text);\n    font-family: \"SF Mono\", ui-monospace, Menlo, Consolas, monospace;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    min-height: 100vh;\n    gap: 16px;\n    padding: 16px;\n    user-select: none;\n  }\n  h1 {\n    font-size: 22px;\n    letter-spacing: 6px;\n    color: var(--accent);\n    text-shadow: 0 0 24px rgba(74, 222, 128, 0.35);\n  }\n  .stats {\n    display: flex;\n    gap: 24px;\n    font-size: 14px;\n    color: var(--dim);\n  }\n  .stats b { color: var(--text); font-size: 16px; margin-left: 6px; }\n  .hud {\n    position: relative;\n  }\n  .mute-btn {\n    position: absolute;\n    top: 10px;\n    right: 10px;\n    z-index: 5;\n    background: rgba(15, 23, 42, 0.7);\n    border: 1px solid #334155;\n    color: var(--dim);\n    font: inherit;\n    font-size: 12px;\n    padding: 4px 10px;\n    border-radius: 8px;\n    cursor: pointer;\n  }\n  .mute-btn:hover { color: var(--text); border-color: var(--accent); }\n  canvas {\n    background: var(--grid);\n    border-radius: 10px;\n    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.5), 0 0 0 1px #334155;\n    display: block;\n  }\n  .hint { font-size: 12px; color: var(--dim); }\n  kbd {\n    background: var(--panel);\n    border: 1px solid #334155;\n    border-radius: 4px;\n    padding: 1px 6px;\n    font-size: 11px;\n  }\n</style>\n</head>\n<body>\n  <h1>SNAKE</h1>\n  <div class=\"stats\">\n    <div>Score<b id=\"score\">0</b></div>\n    <div>Best<b id=\"best\">0</b></div>\n    <div>Level<b id=\"level\">1</b></div>\n  </div>\n  <div class=\"hud\">\n    <button class=\"mute-btn\" id=\"muteBtn\">Sound: On</button>\n    <canvas id=\"game\"></canvas>\n  </div>\n  <div class=\"hint\">Arrows / WASD to move &middot; Space to pause &middot; M to mute &middot; Swipe on touch</div>\n\n<script>\n(function () {\n  \"use strict\";\n\n  var canvas = document.getElementById(\"game\");\n  var ctx = canvas.getContext(\"2d\");\n  var scoreEl = document.getElementById(\"score\");\n  var bestEl = document.getElementById(\"best\");\n  var levelEl = document.getElementById(\"level\");\n  var muteBtn = document.getElementById(\"muteBtn\");\n\n  var COLS = 24, ROWS = 24, CELL = 26;\n  canvas.width = COLS * CELL;\n  canvas.height = ROWS * CELL;\n\n  var snake, dir, nextDir, food, score, best = 0, running, dead;\n  var speed, stepAccum, lastTime;\n  var foodsEaten, level, obstacles, levelFlash;\n  var particles = [];\n\n  // ---------- Audio ----------\n  var audioCtx = null, muted = false;\n\n  function ensureAudio() {\n    if (!audioCtx) {\n      try {\n        audioCtx = new (window.AudioContext || window.webkitAudioContext)();\n      } catch (e) {\n        audioCtx = null;\n      }\n    }\n    if (audioCtx && audioCtx.state === \"suspended\") {\n      audioCtx.resume();\n    }\n  }\n\n  function beep(freq, dur, type, vol, delay, slideTo) {\n    if (!audioCtx || muted) return;\n    var t0 = audioCtx.currentTime + (delay || 0);\n    var osc = audioCtx.createOscillator();\n    var gain = audioCtx.createGain();\n    osc.type = type || \"square\";\n    osc.frequency.setValueAtTime(freq, t0);\n    if (slideTo) {\n      osc.frequency.exponentialRampToValueAtTime(slideTo, t0 + dur);\n    }\n    gain.gain.setValueAtTime(vol || 0.12, t0);\n    gain.gain.exponentialRampToValueAtTime(0.001, t0 + dur);\n    osc.connect(gain);\n    gain.connect(audioCtx.destination);\n    osc.start(t0);\n    osc.stop(t0 + dur + 0.02);\n  }\n\n  function sfxEat() {\n    var f = 320 + Math.min(foodsEaten, 40) * 18;\n    beep(f, 0.09, \"square\", 0.11);\n    beep(f * 1.5, 0.07, \"square\", 0.07, 0.05);\n  }\n\n  function sfxLevel() {\n    beep(440, 0.1, \"triangle\", 0.14);\n    beep(554, 0.1, \"triangle\", 0.14, 0.09);\n    beep(659, 0.18, \"triangle\", 0.14, 0.18);\n  }\n\n  function sfxDeath() {\n    beep(220, 0.55, \"sawtooth\", 0.15, 0, 50);\n  }\n\n  function sfxStart() {\n    beep(392, 0.08, \"triangle\", 0.12);\n    beep(523, 0.12, \"triangle\", 0.12, 0.08);\n  }\n\n  function toggleMute() {\n    muted = !muted;\n    muteBtn.textContent = muted ? \"Sound: Off\" : \"Sound: On\";\n    if (!muted) ensureAudio();\n  }\n  muteBtn.addEventListener(\"click\", toggleMute);\n\n  // ---------- Game state ----------\n  function reset() {\n    snake = [\n      { x: 8, y: 12 },\n      { x: 7, y: 12 },\n      { x: 6, y: 12 }\n    ];\n    dir = { x: 1, y: 0 };\n    nextDir = { x: 1, y: 0 };\n    score = 0;\n    speed = 130;\n    stepAccum = 0;\n    foodsEaten = 0;\n    level = 1;\n    obstacles = [];\n    levelFlash = 0;\n    particles = [];\n    dead = false;\n    placeFood();\n    updateStats();\n  }\n\n  function updateStats() {\n    scoreEl.textContent = String(score);\n    bestEl.textContent = String(best);\n    levelEl.textContent = String(level);\n  }\n\n  function cellFree(x, y) {\n    if (x < 0 || y < 0 || x >= COLS || y >= ROWS) return false;\n    for (var i = 0; i < snake.length; i++) {\n      if (snake[i].x === x && snake[i].y === y) return false;\n    }\n    for (var j = 0; j < obstacles.length; j++) {\n      if (obstacles[j].x === x && obstacles[j].y === y) return false;\n    }\n    if (food && food.x === x && food.y === y) return false;\n    return true;\n  }\n\n  function placeFood() {\n    var free = [];\n    for (var x = 0; x < COLS; x++) {\n      for (var y = 0; y < ROWS; y++) {\n        if (cellFree(x, y)) free.push({ x: x, y: y });\n      }\n    }\n    if (free.length === 0) {\n      food = null;\n      return;\n    }\n    food = free[Math.floor(Math.random() * free.length)];\n  }\n\n  function spawnObstacles(count) {\n    var head = snake[0];\n    for (var i = 0; i < count; i++) {\n      for (var attempt = 0; attempt < 80; attempt++) {\n        var x = 1 + Math.floor(Math.random() * (COLS - 2));\n        var y = 1 + Math.floor(Math.random() * (ROWS - 2));\n        if (!cellFree(x, y)) continue;\n        var dist = Math.max(Math.abs(head.x - x), Math.abs(head.y - y));\n        if (dist < 3) continue;\n        obstacles.push({ x: x, y: y });\n        break;\n      }\n    }\n  }\n\n  // ---------- Sparkles ----------\n  function spawnSparkles(cx, cy) {\n    var count = 8 + Math.min(foodsEaten, 24);\n    var hueSpan = 30 + Math.min(foodsEaten, 20) * 12;\n    var baseHue = (Math.random() * 360) | 0;\n    var light = Math.min(60 + foodsEaten * 2, 85);\n    for (var i = 0; i < count; i++) {\n      var angle = Math.random() * Math.PI * 2;\n      var sp = (0.05 + Math.random() * 0.22) * (1 + Math.min(foodsEaten, 20) * 0.04);\n      particles.push({\n        x: cx,\n        y: cy,\n        vx: Math.cos(angle) * sp,\n        vy: Math.sin(angle) * sp - 0.08,\n        life: 1,\n        decay: 0.02 + Math.random() * 0.025,\n        size: 1.5 + Math.random() * 3 + Math.min(foodsEaten, 20) * 0.1,\n        hue: (baseHue + (Math.random() * 2 - 1) * (hueSpan / 2) + 360) % 360,\n        light: light,\n        star: foodsEaten >= 6 && Math.random() < 0.25\n      });\n    }\n    particles.push({\n      x: cx, y: cy, vx: 0, vy: 0,\n      life: 1, decay: 0.06,\n      size: 4, hue: baseHue, light: light,\n      ring: true\n    });\n  }\n\n  function updateParticles() {\n    for (var i = particles.length - 1; i >= 0; i--) {\n      var p = particles[i];\n      p.life -= p.decay;\n      if (p.life <= 0) {\n        particles.splice(i, 1);\n        continue;\n      }\n      if (!p.ring) {\n        p.x += p.vx;\n        p.y += p.vy;\n        p.vy += 0.006;\n        p.vx *= 0.985;\n        p.vy *= 0.985;\n      } else {\n        p.size += 0.55;\n      }\n    }\n  }\n\n  function drawParticles() {\n    for (var i = 0; i < particles.length; i++) {\n      var p = particles[i];\n      var alpha = Math.max(p.life, 0);\n      if (p.ring) {\n        ctx.strokeStyle = \"hsla(\" + p.hue + \", 100%, \" + p.light + \"%, \" + (alpha * 0.8) + \")\";\n        ctx.lineWidth = 2;\n        ctx.beginPath();\n        ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);\n        ctx.stroke();\n        continue;\n      }\n      ctx.save();\n      ctx.globalAlpha = alpha;\n      ctx.shadowColor = \"hsl(\" + p.hue + \", 100%, \" + p.light + \"%)\";\n      ctx.shadowBlur = 6 + Math.min(foodsEaten, 20) * 0.5;\n      ctx.fillStyle = \"hsl(\" + p.hue + \", 100%, \" + p.light + \"%)\";\n      if (p.star) {\n        drawStar(p.x, p.y, p.size * 1.6);\n      } else {\n        ctx.beginPath();\n        ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);\n        ctx.fill();\n      }\n      ctx.restore();\n    }\n  }\n\n  function drawStar(cx, cy, r) {\n    ctx.beginPath();\n    for (var i = 0; i < 8; i++) {\n      var rad = i % 2 === 0 ? r : r * 0.4;\n      var a = (i * Math.PI) / 4 - Math.PI / 2;\n      var px = cx + Math.cos(a) * rad;\n      var py = cy + Math.sin(a) * rad;\n      if (i === 0) ctx.moveTo(px, py);\n      else ctx.lineTo(px, py);\n    }\n    ctx.closePath();\n    ctx.fill();\n  }\n\n  // ---------- Step ----------\n  function step() {\n    dir = nextDir;\n    var head = snake[0];\n    var nx = head.x + dir.x;\n    var ny = head.y + dir.y;\n\n    if (nx < 0 || ny < 0 || nx >= COLS || ny >= ROWS) {\n      gameOver();\n      return;\n    }\n    for (var i = 0; i < snake.length; i++) {\n      if (snake[i].x === nx && snake[i].y === ny) {\n        gameOver();\n        return;\n      }\n    }\n    for (var j = 0; j < obstacles.length; j++) {\n      if (obstacles[j].x === nx && obstacles[j].y === ny) {\n        gameOver();\n        return;\n      }\n    }\n\n    snake.unshift({ x: nx, y: ny });\n\n    if (food && nx === food.x && ny === food.y) {\n      foodsEaten++;\n      score += 10;\n      if (score > best) best = score;\n      speed = Math.max(55, 130 - foodsEaten * 3);\n      spawnSparkles(nx * CELL + CELL / 2, ny * CELL + CELL / 2);\n      sfxEat();\n      if (foodsEaten % 5 === 0) {\n        level++;\n        levelFlash = 1.2;\n        spawnObstacles(1 + Math.floor(level / 2));\n        sfxLevel();\n      }\n      placeFood();\n      updateStats();\n    } else {\n      snake.pop();\n    }\n  }\n\n  function gameOver() {\n    dead = true;\n    sfxDeath();\n  }\n\n  // ---------- Render ----------\n  function draw() {\n    ctx.clearRect(0, 0, canvas.width, canvas.height);\n\n    // subtle grid\n    ctx.strokeStyle = \"rgba(148, 163, 184, 0.05)\";\n    ctx.lineWidth = 1;\n    for (var gx = 1; gx < COLS; gx++) {\n      ctx.beginPath();\n      ctx.moveTo(gx * CELL + 0.5, 0);\n      ctx.lineTo(gx * CELL + 0.5, canvas.height);\n      ctx.stroke();\n    }\n    for (var gy = 1; gy < ROWS; gy++) {\n      ctx.beginPath();\n      ctx.moveTo(0, gy * CELL + 0.5);\n      ctx.lineTo(canvas.width, gy * CELL + 0.5);\n      ctx.stroke();\n    }\n\n    // obstacles\n    for (var j = 0; j < obstacles.length; j++) {\n      var o = obstacles[j];\n      var ox = o.x * CELL + 2, oy = o.y * CELL + 2, os = CELL - 4;\n      ctx.fillStyle = \"#475569\";\n      roundRect(ox, oy, os, os, 5);\n      ctx.fill();\n      ctx.fillStyle = \"#334155\";\n      roundRect(ox + 3, oy + 3, os - 6, os - 6, 3);\n      ctx.fill();\n      ctx.strokeStyle = \"rgba(248, 113, 113, 0.35)\";\n      ctx.lineWidth = 1;\n      roundRect(ox + 0.5, oy + 0.5, os - 1, os - 1, 5);\n      ctx.stroke();\n    }\n\n    // food (pulsing)\n    if (food) {\n      var pulse = 1 + Math.sin(performance.now() / 200) * 0.12;\n      var fx = food.x * CELL + CELL / 2;\n      var fy = food.y * CELL + CELL / 2;\n      ctx.save();\n      ctx.shadowColor = \"#f87171\";\n      ctx.shadowBlur = 12;\n      ctx.fillStyle = \"#f87171\";\n      ctx.beginPath();\n      ctx.arc(fx, fy, (CELL / 2 - 5) * pulse, 0, Math.PI * 2);\n      ctx.fill();\n      ctx.fillStyle = \"#4ade80\";\n      ctx.fillRect(fx - 1, fy - CELL / 2 + 1, 2, 4);\n      ctx.restore();\n    }\n\n    // snake\n    for (var i = snake.length - 1; i >= 0; i--) {\n      var s = snake[i];\n      var t = i / Math.max(snake.length - 1, 1);\n      var r = Math.round(74 - t * 30);\n      var g = Math.round(222 - t * 120);\n      var b = Math.round(128 - t * 50);\n      ctx.fillStyle = \"rgb(\" + r + \", \" + g + \", \" + b + \")\";\n      var pad = i === 0 ? 1 : 2;\n      roundRect(s.x * CELL + pad, s.y * CELL + pad, CELL - pad * 2, CELL - pad * 2, 6);\n      ctx.fill();\n    }\n\n    // eyes on head\n    if (snake.length > 0) {\n      var h = snake[0];\n      var hx = h.x * CELL + CELL / 2;\n      var hy = h.y * CELL + CELL / 2;\n      var ex = dir.y !== 0 ? 5 : 0;\n      var ey = dir.x !== 0 ? 5 : 0;\n      var fx2 = dir.x * 4, fy2 = dir.y * 4;\n      ctx.fillStyle = \"#0f172a\";\n      ctx.beginPath();\n      ctx.arc(hx + fx2 - ex, hy + fy2 - ey, 2.4, 0, Math.PI * 2);\n      ctx.arc(hx + fx2 + ex, hy + fy2 + ey, 2.4, 0, Math.PI * 2);\n      ctx.fill();\n    }\n\n    drawParticles();\n\n    // level flash\n    if (levelFlash > 0) {\n      ctx.save();\n      ctx.globalAlpha = Math.min(levelFlash, 1);\n      ctx.fillStyle = \"#fbbf24\";\n      ctx.shadowColor = \"#fbbf24\";\n      ctx.shadowBlur = 20;\n      ctx.font = \"bold 28px 'SF Mono', Menlo, monospace\";\n      ctx.textAlign = \"center\";\n      ctx.fillText(\"LEVEL \" + level, canvas.width / 2, canvas.height / 2 - 20);\n      ctx.font = \"13px 'SF Mono', Menlo, monospace\";\n      ctx.fillStyle = \"#e2e8f0\";\n      ctx.shadowBlur = 8;\n      ctx.fillText(\"obstacles incoming\", canvas.width / 2, canvas.height / 2 + 8);\n      ctx.restore();\n    }\n\n    // overlays\n    if (dead) {\n      overlay(\"GAME OVER\", \"Score \" + score + \" \\u2014 press Space to retry\");\n    } else if (!running) {\n      overlay(\"SNAKE\", \"Press Space or tap to start\");\n    } else if (paused) {\n      overlay(\"PAUSED\", \"Press Space to resume\");\n    }\n  }\n\n  var paused = false;\n\n  function overlay(title, sub) {\n    ctx.save();\n    ctx.fillStyle = \"rgba(15, 23, 42, 0.78)\";\n    ctx.fillRect(0, 0, canvas.width, canvas.height);\n    ctx.textAlign = \"center\";\n    ctx.fillStyle = \"#e2e8f0\";\n    ctx.font = \"bold 30px 'SF Mono', Menlo, monospace\";\n    ctx.shadowColor = \"rgba(74, 222, 128, 0.5)\";\n    ctx.shadowBlur = 18;\n    ctx.fillText(title, canvas.width / 2, canvas.height / 2 - 12);\n    ctx.shadowBlur = 0;\n    ctx.fillStyle = \"#94a3b8\";\n    ctx.font = \"13px 'SF Mono', Menlo, monospace\";\n    ctx.fillText(sub, canvas.width / 2, canvas.height / 2 + 18);\n    ctx.restore();\n  }\n\n  function roundRect(x, y, w, h, r) {\n    ctx.beginPath();\n    ctx.moveTo(x + r, y);\n    ctx.arcTo(x + w, y, x + w, y + h, r);\n    ctx.arcTo(x + w, y + h, x, y + h, r);\n    ctx.arcTo(x, y + h, x, y, r);\n    ctx.arcTo(x, y, x + w, y, r);\n    ctx.closePath();\n  }\n\n  // ---------- Loop ----------\n  function loop(now) {\n    if (lastTime === null) lastTime = now;\n    var dt = Math.min(now - lastTime, 100);\n    lastTime = now;\n\n    if (levelFlash > 0) levelFlash -= dt / 1000;\n    updateParticles();\n\n    if (running && !dead && !paused) {\n      stepAccum += dt;\n      while (stepAccum >= speed) {\n        stepAccum -= speed;\n        step();\n        if (dead) break;\n      }\n    }\n    draw();\n    requestAnimationFrame(loop);\n  }\n\n  // ---------- Input ----------\n  function setDir(x, y) {\n    if (dir.x === -x && dir.y === -y) return;\n    nextDir = { x: x, y: y };\n  }\n\n  function startOrPause() {\n    ensureAudio();\n    if (dead) {\n      reset();\n      running = true;\n      paused = false;\n      sfxStart();\n      return;\n    }\n    if (!running) {\n      running = true;\n      paused = false;\n      sfxStart();\n      return;\n    }\n    paused = !paused;\n  }\n\n  document.addEventListener(\"keydown\", function (e) {\n    var k = e.key;\n    if (k === \"ArrowUp\" || k === \"w\" || k === \"W\") { setDir(0, -1); e.preventDefault(); }\n    else if (k === \"ArrowDown\" || k === \"s\" || k === \"S\") { setDir(0, 1); e.preventDefault(); }\n    else if (k === \"ArrowLeft\" || k === \"a\" || k === \"A\") { setDir(-1, 0); e.preventDefault(); }\n    else if (k === \"ArrowRight\" || k === \"d\" || k === \"D\") { setDir(1, 0); e.preventDefault(); }\n    else if (k === \" \") { startOrPause(); e.preventDefault(); }\n    else if (k === \"m\" || k === \"M\") { toggleMute(); }\n  });\n\n  var touchStart = null;\n  canvas.addEventListener(\"pointerdown\", function (e) {\n    ensureAudio();\n    touchStart = { x: e.clientX, y: e.clientY, t: performance.now() };\n  });\n  canvas.addEventListener(\"pointerup\", function (e) {\n    if (!touchStart) return;\n    var dx = e.clientX - touchStart.x;\n    var dy = e.clientY - touchStart.y;\n    var adx = Math.abs(dx), ady = Math.abs(dy);\n    if (adx < 20 && ady < 20 && performance.now() - touchStart.t < 400) {\n      startOrPause();\n    } else if (adx > ady) {\n      setDir(dx > 0 ? 1 : -1, 0);\n    } else {\n      setDir(0, dy > 0 ? 1 : -1);\n    }\n    touchStart = null;\n  });\n\n  reset();\n  running = false;\n  requestAnimationFrame(loop);\n})();\n</script>\n</body>\n</html>\n"
  },
  "permissions": {
    "allowNetwork": true,
    "allowStorage": false,
    "allowClipboard": false
  }
}
