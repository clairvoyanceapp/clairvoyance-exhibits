    "type": "html",
    "bundle": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<title>Vibelifter</title>\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<style>\n  html,body{margin:0;height:100%;background:#000;overflow:hidden}\n  body{display:flex;flex-direction:column;align-items:center;justify-content:center;font-family:\"Courier New\",monospace;color:#9a9a9a}\n  #wrap{position:relative;line-height:0}\n  canvas{image-rendering:pixelated;image-rendering:crisp-edges;display:block;background:#000;outline:none}\n  #crt{position:absolute;inset:0;pointer-events:none;\n    background:repeating-linear-gradient(to bottom,rgba(0,0,0,0) 0,rgba(0,0,0,0) 2px,rgba(0,0,0,.28) 3px);\n    box-shadow:inset 0 0 60px rgba(0,0,0,.75)}\n  #help{font-size:12px;line-height:1.5;margin-top:8px;text-align:center;letter-spacing:.5px}\n  #help b{color:#e8e8e8;font-weight:normal}\n</style>\n</head>\n<body>\n<div id=\"wrap\"><canvas id=\"scr\" width=\"280\" height=\"192\" tabindex=\"0\"></canvas><div id=\"crt\"></div></div>\n<div id=\"help\"><b>ARROWS/WASD</b> fly &nbsp; <b>SPACE</b> cannon &nbsp; <b>X</b> pulse bomb &nbsp; <b>P</b> pause &nbsp; <b>M</b> sound &mdash; hover low &amp; slow over survivors to winch them up, land on the home pad to unload &amp; refuel</div>\n<script>\n(function(){\n'use strict';\nvar W=280,H=192,GROUND=172,CEIL=26,WORLD=2440,CAP=8;\nvar COL={W:'#ffffff',G:'#2ff53c',P:'#e03cff',O:'#ff6a1e',B:'#22b4ff',K:'#000000'};\nvar OUTPOSTS=[620,1120,1660,2240],PER_OUTPOST=6;\nvar cv=document.getElementById('scr'),ctx=cv.getContext('2d');\nctx.imageSmoothingEnabled=false;\n\n// ---------- seeded rng ----------\nfunction rng(seed){return function(){seed|=0;seed=seed+0x6D2B79F5|0;var t=Math.imul(seed^seed>>>15,1|seed);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296;};}\n\n// ---------- font 3x5 ----------\nvar F={A:[2,5,7,5,5],B:[6,5,6,5,6],C:[3,4,4,4,3],D:[6,5,5,5,6],E:[7,4,6,4,7],F:[7,4,6,4,4],G:[3,4,5,5,3],H:[5,5,7,5,5],I:[7,2,2,2,7],J:[1,1,1,5,2],K:[5,5,6,5,5],L:[4,4,4,4,7],M:[5,7,7,5,5],N:[6,5,5,5,5],O:[2,5,5,5,2],P:[6,5,6,4,4],Q:[2,5,5,6,3],R:[6,5,6,5,5],S:[3,4,2,1,6],T:[7,2,2,2,2],U:[5,5,5,5,7],V:[5,5,5,5,2],W:[5,5,7,7,5],X:[5,5,2,5,5],Y:[5,5,2,2,2],Z:[7,1,2,4,7],\n'0':[7,5,5,5,7],'1':[2,6,2,2,7],'2':[6,1,2,4,7],'3':[6,1,2,1,6],'4':[5,5,7,1,1],'5':[7,4,6,1,6],'6':[3,4,7,5,7],'7':[7,1,1,2,2],'8':[7,5,7,5,7],'9':[7,5,7,1,6],\n' ':[0,0,0,0,0],'.':[0,0,0,0,2],':':[0,2,0,2,0],'-':[0,0,7,0,0],'!':[2,2,2,0,2],'/':[1,1,2,4,4],'?':[6,1,2,0,2],',':[0,0,0,2,4],'>':[4,2,1,2,4],'<':[1,2,4,2,1],'(':[1,2,2,2,1],')':[4,2,2,2,4],\"'\":[2,2,0,0,0],'+':[0,2,7,2,0],'&':[2,5,2,5,3]};\nfunction text(s,x,y,col,sc){sc=sc||1;s=String(s).toUpperCase();ctx.fillStyle=col;\n  for(var i=0;i<s.length;i++){var g=F[s[i]]||F[' '];for(var r=0;r<5;r++)for(var c=0;c<3;c++)if((g[r]>>(2-c))&1)ctx.fillRect(x+c*sc,y+r*sc,sc,sc);x+=4*sc;}}\nfunction textW(s,sc){sc=sc||1;return String(s).length*4*sc-sc;}\nfunction ctext(s,y,col,sc){text(s,Math.floor((W-textW(s,sc))/2),y,col,sc);}\nfunction pad(n,l){n=String(Math.max(0,Math.floor(n)));while(n.length<l)n='0'+n;return n;}\n\n// ---------- sprites ----------\nfunction mk(rows,flip){var h=rows.length,w=rows[0].length,c=document.createElement('canvas');c.width=w;c.height=h;var x=c.getContext('2d');\n  for(var r=0;r<h;r++){var row=flip?rows[r].split('').reverse().join(''):rows[r];for(var i=0;i<w;i++){var k=row[i];if(k!=='.'&&COL[k]){x.fillStyle=COL[k];x.fillRect(i,r,1,1);}}}return c;}\nvar LIFT_BODY=[\"....W........W....\",\"...PPPPPPPPPPPP...\",\"..PPPPPPPPPPWWWW..\",\"OPPPPPPPPPPPWBBBW.\",\".PPPPPPPPPPPPPPPP.\",\"..PPPPPPPPPPPPPP..\",\"....W........W....\",\"...WWWWWWWWWWWWW..\"];\nfunction liftRows(f){var fan=f===0?\"..BWBW......BWBW..\":f===1?\"..WBWB......WBWB..\":\"..BBBB......BBBB..\";return[fan].concat(LIFT_BODY);}\nvar SPR={lift:[[mk(liftRows(0)),mk(liftRows(1)),mk(liftRows(2))],[mk(liftRows(0),1),mk(liftRows(1),1),mk(liftRows(2),1)]],\n  crawl:[mk([\".....GG.....\",\"....GGGG....\",\"..OOOOOOOO..\",\".OOOOOOOOOO.\",\"OOOOOOOOOOOO\",\"W.W.W.W.W.W.\",\".WWWWWWWWWW.\"]),\n         mk([\".....GG.....\",\"....GGGG....\",\"..OOOOOOOO..\",\".OOOOOOOOOO.\",\"OOOOOOOOOOOO\",\".W.W.W.W.W.W\",\".WWWWWWWWWW.\"])],\n  hunt:[mk([\"G.........G\",\"GG..WWW..GG\",\"GGGGGGGGGGG\",\".GGG.G.GGG.\",\"..G.....G..\"]),mk([\".........  \".replace(/ /g,'.'),\"GG..WWW..GG\",\"GGGGGGGGGGG\",\".GGG.G.GGG.\",\"G.G.....G.G\"])],\n  mine:[mk([\"..P..\",\".PWP.\",\"PWWWP\",\".PWP.\",\"..P..\"]),mk([\"..P..\",\".POP.\",\"POOOP\",\".POP.\",\"..P..\"])],\n  surv:[mk([\".W.\",\"WWW\",\".W.\",\"W.W\",\"W.W\"]),mk([\"WW.\",\".WW\",\".W.\",\"W.W\",\"W.W\"]),mk([\".W.\",\"WW.\",\".WW\",\"W..\",\"..W\"]),mk([\".W.\",\".WW\",\"WW.\",\"..W\",\"W..\"])]};\n\n// ---------- background ----------\nvar MT=new Array(1024);\nfor(var i=0;i<1024;i++){var a=i/1024*Math.PI*2;MT[i]=Math.round(128+17*Math.sin(a*2)+10*Math.sin(a*5+1)+5*Math.sin(a*13+2)+2*Math.sin(a*31));}\nvar STARS=[];(function(){var r=rng(7);for(var i=0;i<46;i++)STARS.push({x:r()*560,y:CEIL+r()*95,c:r()<.15?'B':(r()<.2?'P':'W')});})();\nvar SCENERY=[];(function(){var r=rng(42);for(var x=230;x<WORLD;x+=30+r()*60){var t=r();SCENERY.push({x:x,t:t<.45?'shrub':(t<.8?'rock':'crystal')});}})();\nvar groundTile=(function(){var c=document.createElement('canvas');c.width=64;c.height=20;var x=c.getContext('2d');\n  x.fillStyle=COL.G;x.fillRect(0,0,64,1);x.fillRect(0,2,64,1);\n  for(var yy=4;yy<20;yy++)for(var xx=0;xx<64;xx++){var h=(xx*31+yy*17+xx*yy)%23;if(h===0){x.fillStyle=COL.O;x.fillRect(xx,yy,1,1);}else if(h===11&&yy%3===0){x.fillStyle=COL.P;x.fillRect(xx,yy,1,1);}}\n  return c;})();\n\n// ---------- audio (1-bit-speaker flavored) ----------\nvar AC=null,muted=false,noiseBuf=null;\nfunction audio(){if(!AC){try{AC=new (window.AudioContext||window.webkitAudioContext)();var n=AC.sampleRate*0.6;noiseBuf=AC.createBuffer(1,n,AC.sampleRate);var d=noiseBuf.getChannelData(0);for(var i=0;i<n;i++)d[i]=Math.random()<.5?-1:1;}catch(e){AC=null;}}\n  if(AC&&AC.state==='suspended')AC.resume();}\nfunction beep(f1,f2,dur,vol){if(!AC||muted)return;var t=AC.currentTime,o=AC.createOscillator(),g=AC.createGain();o.type='square';o.frequency.setValueAtTime(f1,t);o.frequency.exponentialRampToValueAtTime(Math.max(20,f2),t+dur);\n  g.gain.setValueAtTime(vol||0.05,t);g.gain.exponentialRampToValueAtTime(0.0001,t+dur);o.connect(g);g.connect(AC.destination);o.start(t);o.stop(t+dur+0.02);}\nfunction noise(dur,vol,rate){if(!AC||muted||!noiseBuf)return;var t=AC.currentTime,s=AC.createBufferSource(),g=AC.createGain();s.buffer=noiseBuf;s.playbackRate.value=rate||0.25;\n  g.gain.setValueAtTime(vol||0.08,t);g.gain.exponentialRampToValueAtTime(0.0001,t+dur);s.connect(g);g.connect(AC.destination);s.start(t);s.stop(t+dur);}\nvar SFX={gun:function(){beep(900,300,0.05,0.035);},bomb:function(){beep(500,90,0.35,0.04);},boom:function(){noise(0.45,0.12,0.18);},small:function(){noise(0.18,0.07,0.4);},\n  hit:function(){beep(140,60,0.25,0.07);noise(0.2,0.08,0.3);},pick:function(){beep(600,1200,0.08,0.04);setTimeout(function(){beep(900,1800,0.06,0.03);},70);},\n  drop:function(){beep(1200,500,0.07,0.03);},flak:function(){beep(300,180,0.06,0.025);},land:function(){beep(120,80,0.05,0.04);},\n  alarm:function(){beep(880,880,0.08,0.04);setTimeout(function(){beep(660,660,0.08,0.04);},110);},\n  win:function(){[523,659,784,1046].forEach(function(f,i){setTimeout(function(){beep(f,f,0.12,0.045);},i*120);});},\n  lose:function(){[392,330,262,196].forEach(function(f,i){setTimeout(function(){beep(f,f*0.97,0.18,0.05);},i*170);});},\n  scream:function(){beep(1400,300,0.3,0.03);},tick:function(){beep(70,60,0.012,0.012);}};\n\n// ---------- storage (Clairvoyance storage.kv; opaque origin means no localStorage) ----------\nvar HI_KEY='vibelifter.hiscore',hiscore=0,storageOk=false;\nfunction cvStore(){try{return window.clairvoyance&&window.clairvoyance.storage?window.clairvoyance.storage:null;}catch(e){return null;}}\n(async function(){var s=cvStore();if(!s)return;try{var v=await s.get(HI_KEY);storageOk=true;var n=v&&typeof v==='object'?v.score:v;if(typeof n==='number'&&n>hiscore)hiscore=n;}catch(e){storageOk=false;}})();\nasync function saveHi(){var s=cvStore();if(!s)return;try{await s.set(HI_KEY,{score:hiscore,at:Date.now()});storageOk=true;}catch(e){storageOk=false;}}\n\n// ---------- input ----------\nvar keys={},pressed={};\nvar KEYMAP={ArrowLeft:'l',KeyA:'l',ArrowRight:'r',KeyD:'r',ArrowUp:'u',KeyW:'u',ArrowDown:'d',KeyS:'d',Space:'f',KeyX:'b',KeyB:'b',KeyP:'p',KeyM:'m',Enter:'s',Escape:'p'};\nwindow.addEventListener('keydown',function(e){var k=KEYMAP[e.code];audio();if(!k)return;e.preventDefault();if(!keys[k])pressed[k]=true;keys[k]=true;});\nwindow.addEventListener('keyup',function(e){var k=KEYMAP[e.code];if(!k)return;e.preventDefault();keys[k]=false;});\ncv.addEventListener('mousedown',function(){cv.focus();audio();});\nwindow.addEventListener('blur',function(){keys={};if(g&&g.state==='play')g.paused=true;});\nvar focused=document.hasFocus();window.addEventListener('focus',function(){focused=true;});window.addEventListener('blur',function(){focused=false;});\nfunction hit(k){var v=pressed[k];pressed[k]=false;return v;}\n\n// ---------- game state ----------\nvar g=null,p=null,survivors=[],outposts=[],enemies=[],shots=[],eshots=[],bombs=[],parts=[],camX=0,frame=0;\nvar titleT=0;\nfunction newGame(){g={state:'play',mission:1,score:0,lives:3,paused:false,shake:0,bannerT:0,banner:'',timer:0};startMission();}\nfunction startMission(){\n  g.rescued=0;g.lost=0;g.total=OUTPOSTS.length*PER_OUTPOST;g.missionScore0=g.score;g.state='play';g.timer=0;\n  survivors=[];enemies=[];shots=[];eshots=[];bombs=[];parts=[];\n  outposts=OUTPOSTS.map(function(x,i){return{x:x,alerted:false,left:PER_OUTPOST,releaseT:0,i:i};});\n  var r=rng(1000+g.mission*77),nm=Math.min(14,2+g.mission*2);\n  for(var i=0;i<nm;i++)enemies.push({t:'m',x:1250+r()*(WORLD-1350),y0:CEIL+20+r()*80,y:0,ph:r()*6.28,hp:2,w:5,h:5});\n  g.crawlT=200;g.huntT=420;\n  spawnPlayer();\n  g.banner='MISSION '+g.mission;g.bannerT=150;\n}\nfunction spawnPlayer(){p={x:91,y:GROUND-9,vx:0,vy:0,face:1,hull:3,fuel:100,aboard:0,landed:true,gun:0,bomb:0,inv:90,winch:null,dead:false,strand:0,rep:0,unload:0,warn:0};camX=0;}\nfunction pcx(){return p.x+9;}\nfunction onPad(){return p.landed&&p.x+9>=70&&p.x+9<=132;}\n\nfunction boom(x,y,n,cols,spd){for(var i=0;i<n;i++){var a=Math.random()*6.28,s=Math.random()*(spd||1.6);parts.push({x:x,y:y,vx:Math.cos(a)*s,vy:Math.sin(a)*s-0.6,life:20+Math.random()*30,c:cols[i%cols.length]});}}\nfunction damage(){if(p.inv>0||p.dead)return;p.hull--;p.inv=70;g.shake=10;SFX.hit();boom(pcx(),p.y+5,10,['O','W']);if(p.hull<=0)crash('HULL BREACH');}\nfunction crash(why){\n  if(p.dead)return;p.dead=true;g.shake=24;SFX.boom();\n  boom(pcx(),p.y+5,60,['O','W','P','O'],2.6);\n  if(p.aboard>0){g.lost+=p.aboard;SFX.scream();}\n  p.aboard=0;if(p.winch){p.winch.st='fall';p.winch.vy=0;p.winch.fy=p.winch.y;p.winch=null;}\n  g.lives--;g.state='crashed';g.timer=170;g.banner=why;g.bannerT=170;\n}\nfunction killEnemy(e,pts){e.dead=true;g.score+=pts;g.shake=Math.max(g.shake,4);\n  if(e.t==='c'){boom(e.x+6,e.y+3,26,['O','W','G']);SFX.boom();}else{boom(e.x+e.w/2,e.y+2,16,e.t==='m'?['P','W']:['G','W']);SFX.small();}}\nfunction loseSurvivor(s,why){s.dead=true;g.lost++;boom(s.x+1,s.y+2,6,['W','O']);SFX.scream();}\n\n// ---------- update ----------\nfunction update(){\n  frame++;\n  if(!g){titleT++;if(hit('f')||hit('s')){newGame();}return;}\n  if(hit('m'))muted=!muted;\n  if(g.state==='over'){g.timer++;if(g.timer>60&&(hit('f')||hit('s')))g=null;return;}\n  if(g.state==='complete'){g.timer++;if(g.timer>70&&(hit('f')||hit('s'))){g.mission++;startMission();}return;}\n  if(hit('p')&&g.state==='play')g.paused=!g.paused;\n  if(g.paused)return;\n  if(g.bannerT>0)g.bannerT--;\n  if(g.shake>0)g.shake--;\n\n  if(g.state==='crashed'){g.timer--;if(g.timer<=0){if(g.lives>0){spawnPlayer();g.state='play';g.banner='NEW LIFTER';g.bannerT=90;}else endGame(false);}}\n  else updatePlayer();\n\n  updateOutposts();updateSurvivors();updateEnemies();updateShots();\n  for(var i=parts.length-1;i>=0;i--){var q=parts[i];q.x+=q.vx;q.y+=q.vy;q.vy+=0.06;q.life--;if(q.y>GROUND){q.y=GROUND;q.vy*=-0.3;q.vx*=0.6;}if(q.life<=0)parts.splice(i,1);}\n\n  var tgt=(p?pcx():100)-W/2+(p?p.face*34:0);camX+=(tgt-camX)*0.08;camX=Math.max(0,Math.min(WORLD-W,camX));\n\n  if(g.state==='play'&&g.rescued+g.lost>=g.total&&p.aboard===0&&!survivors.some(function(s){return!s.dead&&s.st!=='home';})){\n    var bonus=g.rescued*100+(g.lost===0?5000:0);g.score+=bonus;g.bonus=bonus;\n    if(g.lost===0){g.lives=Math.min(6,g.lives+1);}\n    g.state='complete';g.timer=0;SFX.win();if(g.score>hiscore){hiscore=g.score;saveHi();}\n  }\n}\nfunction endGame(){g.state='over';g.timer=0;SFX.lose();if(g.score>hiscore){hiscore=g.score;g.newHi=true;saveHi();}}\n\nfunction updatePlayer(){\n  var hasFuel=p.fuel>0;\n  if(hasFuel){\n    if(keys.l){p.vx-=0.09;p.face=-1;}\n    if(keys.r){p.vx+=0.09;p.face=1;}\n    if(keys.u)p.vy-=0.16;\n    if(keys.d)p.vy+=0.08;\n    p.fuel-=0.015+(keys.u?0.006:0)+((keys.l||keys.r)?0.003:0);\n    if(p.landed&&!keys.u&&!keys.l&&!keys.r)p.fuel+=0.012; // idle on ground barely sips\n    if(p.fuel<=0){p.fuel=0;SFX.alarm();g.banner='ENGINES OUT';g.bannerT=120;}\n  }\n  p.vy+=0.06;p.vx*=0.985;p.vy*=0.96;\n  if(p.landed&&!keys.u){p.vx*=0.82;}\n  p.vx=Math.max(-2.3,Math.min(2.3,p.vx));p.vy=Math.max(-1.8,Math.min(2.6,p.vy));\n  p.x+=p.vx;p.y+=p.vy;\n  if(p.x<0){p.x=0;p.vx=0;}if(p.x>WORLD-18){p.x=WORLD-18;p.vx=0;}\n  if(p.y<CEIL){p.y=CEIL;p.vy=Math.max(0,p.vy);}\n  if(p.y+9>=GROUND){\n    var impact=p.vy;p.y=GROUND-9;\n    if(impact>1.65){if(!p.landed){p.vy=-1.1;p.landed=false;damage();}}\n    else{if(!p.landed&&impact>0.4)SFX.land();p.vy=0;p.landed=true;}\n  }else p.landed=false;\n  if(p.dead)return;\n  if(p.inv>0)p.inv--;\n  if(hasFuel&&!p.landed&&frame%7===0)SFX.tick();\n  if(p.fuel<20&&p.fuel>0&&frame%90===0)SFX.alarm();\n\n  // weapons\n  if(p.gun>0)p.gun--;if(p.bomb>0)p.bomb--;\n  if(keys.f&&p.gun===0){p.gun=9;shots.push({x:p.face>0?p.x+18:p.x-2,y:p.y+5,vx:p.face*5+p.vx,life:46});SFX.gun();}\n  if(keys.b&&p.bomb===0&&!p.landed){p.bomb=34;bombs.push({x:pcx(),y:p.y+9,vx:p.vx*0.8,vy:Math.max(0,p.vy)});SFX.bomb();}\n\n  // home pad: unload, refuel, repair\n  if(onPad()){\n    if(p.fuel<100)p.fuel=Math.min(100,p.fuel+0.6);\n    if(p.hull<3&&++p.rep>=110){p.hull++;p.rep=0;SFX.pick();}\n    if(p.aboard>0&&++p.unload>=12){p.unload=0;p.aboard--;g.rescued++;g.score+=250;\n      survivors.push({x:pcx(),y:GROUND-5,st:'home',an:0});SFX.drop();}\n    p.strand=0;\n  }else{p.rep=0;\n    if(p.fuel<=0&&p.landed){if(++p.strand>150)crash('STRANDED');}\n  }\n}\n\nfunction updateOutposts(){\n  outposts.forEach(function(o){\n    if(!o.alerted&&p&&!p.dead&&Math.abs(pcx()-o.x)<150){o.alerted=true;g.banner='SIGNAL FOUND';g.bannerT=60;SFX.alarm();}\n    if(o.alerted&&o.left>0&&--o.releaseT<=0){o.left--;o.releaseT=22+Math.random()*16;\n      survivors.push({x:o.x-1,y:GROUND-5,st:'wait',o:o,tx:o.x+(Math.random()*70-35),an:Math.random()*60});}\n  });\n}\n\nfunction updateSurvivors(){\n  var px=p?pcx():0,lifting=p&&p.winch;\n  for(var i=survivors.length-1;i>=0;i--){\n    var s=survivors[i];if(s.dead){survivors.splice(i,1);continue;}\n    s.an++;\n    var dx=px-(s.x+1),near=p&&!p.dead&&Math.abs(dx)<75&&p.y+9>GROUND-72&&p.aboard<CAP;\n    if(s.st==='wait'){\n      if(Math.abs(s.tx-s.x)>1)s.x+=Math.sign(s.tx-s.x)*0.25;else if(Math.random()<0.004)s.tx=s.o.x+(Math.random()*80-40);\n      if(near)s.st='run';\n    }else if(s.st==='run'){\n      if(!near){s.st='wait';s.tx=s.x;continue;}\n      if(Math.abs(dx)>1.5)s.x+=Math.sign(dx)*0.75;\n      if(p.landed&&Math.abs(dx)<10){boardOne(s);continue;}\n      if(!p.landed&&!p.winch&&Math.abs(dx)<4&&Math.abs(p.vx)<0.9&&p.y+9>GROUND-62){s.st='lift';p.winch=s;}\n    }else if(s.st==='lift'){\n      if(!p||p.dead||p.winch!==s||Math.abs(p.vx)>1.5||Math.abs(dx)>14){s.st='fall';s.vy=0;s.fy=s.y;if(p&&p.winch===s)p.winch=null;g.banner='LINE SNAPPED';g.bannerT=50;continue;}\n      s.x=px-1;s.y-=1.0;\n      if(p.landed||s.y<=p.y+9){p.winch=null;boardOne(s);continue;}\n    }else if(s.st==='fall'){\n      s.vy+=0.12;s.y+=s.vy;\n      if(s.y>=GROUND-5){s.y=GROUND-5;if(GROUND-5-s.fy>24)loseSurvivor(s);else{s.st='wait';s.tx=s.x;}}\n    }else if(s.st==='home'){\n      s.x+=0.7;if(s.x>=170)survivors.splice(i,1);\n    }\n  }\n}\nfunction boardOne(s){s.dead=true;p.aboard++;g.score+=50;SFX.pick();var i=survivors.indexOf(s);if(i>=0)survivors.splice(i,1);}\n\nfunction updateEnemies(){\n  var m=g.mission,alive=p&&!p.dead,px=alive?pcx():camX+W/2,anyAlert=outposts.some(function(o){return o.alerted;});\n  var nC=0,nH=0;enemies.forEach(function(e){if(e.t==='c')nC++;if(e.t==='h')nH++;});\n  if(anyAlert&&--g.crawlT<=0&&nC<Math.min(6,1+m)){\n    g.crawlT=Math.max(120,300-m*30);var side=Math.random()<.7?1:-1,x=side>0?camX+W+20:camX-30;\n    if(x>260&&x<WORLD-12)enemies.push({t:'c',x:x,y:GROUND-7,w:12,h:7,cd:90,hp:2});else g.crawlT=30;\n  }\n  var huntMax=Math.min(4,Math.ceil(m/2)+(p&&p.aboard>0?1:0));\n  if((p&&p.aboard>0||m>=3)&&--g.huntT<=0&&nH<huntMax){\n    g.huntT=Math.max(160,420-m*40);var hs=Math.random()<.5?1:-1;\n    enemies.push({t:'h',x:hs>0?camX+W+10:camX-20,y:CEIL+10+Math.random()*40,vx:0,vy:0,w:11,h:5,cd:80,hp:1});\n  }\n  for(var i=enemies.length-1;i>=0;i--){\n    var e=enemies[i];if(e.dead){enemies.splice(i,1);continue;}\n    if(e.t==='c'){\n      var d=px-(e.x+6);if(Math.abs(d)>20){e.x+=Math.sign(d)*(0.32+0.04*m);}\n      if(e.x<250)e.x=250;\n      if(--e.cd<=0&&alive&&Math.abs(d)<170){\n        e.cd=Math.max(45,115-m*9);var sx=e.x+6,sy=e.y,tx=px+p.vx*20,ty=p.y+5,ddx=tx-sx,ddy=ty-sy,dd=Math.hypot(ddx,ddy)||1,v=1.6+0.15*m;\n        eshots.push({x:sx,y:sy,vx:ddx/dd*v+(Math.random()-.5)*0.25,vy:ddy/dd*v,life:150,k:'f'});SFX.flak();\n      }\n    }else if(e.t==='h'){\n      var ty2=alive?p.y-2:CEIL+20;\n      e.vx+=Math.sign(px-(e.x+5))*0.05;e.vy+=Math.sign(ty2-e.y)*0.035;e.vx*=0.985;e.vy*=0.96;\n      var sp=1.5+0.1*m;e.vx=Math.max(-sp,Math.min(sp,e.vx));e.x+=e.vx;e.y+=e.vy;if(e.y>GROUND-30)e.y=GROUND-30;if(e.y<CEIL)e.y=CEIL;\n      if(--e.cd<=0&&alive&&Math.abs(p.y+5-(e.y+2))<10&&Math.abs(px-e.x)<150){e.cd=Math.max(50,100-m*6);var dir=Math.sign(px-e.x)||1;eshots.push({x:e.x+5,y:e.y+2,vx:dir*2.7,vy:0,life:90,k:'d'});SFX.flak();}\n    }else if(e.t==='m'){e.ph+=0.03;e.y=e.y0+Math.sin(e.ph)*14;}\n    if(alive&&p.inv===0&&overlap(e.x,e.y,e.w,e.h,p.x+2,p.y+2,14,7)){damage();killEnemy(e,0);}\n  }\n}\nfunction overlap(ax,ay,aw,ah,bx,by,bw,bh){return ax<bx+bw&&ax+aw>bx&&ay<by+bh&&ay+ah>by;}\n\nfunction updateShots(){\n  var i,j,e;\n  for(i=shots.length-1;i>=0;i--){var s=shots[i];s.x+=s.vx;if(--s.life<=0||s.x<0||s.x>WORLD){shots.splice(i,1);continue;}\n    for(j=0;j<enemies.length;j++){e=enemies[j];if(!e.dead&&overlap(s.x,s.y,3,1,e.x,e.y,e.w,e.h)){shots.splice(i,1);boom(s.x,s.y,3,['W']);if(--e.hp<=0)killEnemy(e,e.t==='c'?150:e.t==='h'?200:50);break;}}}\n  for(i=bombs.length-1;i>=0;i--){var b=bombs[i];b.vy+=0.14;b.x+=b.vx;b.y+=b.vy;b.vx*=0.99;var det=false;\n    for(j=0;j<enemies.length;j++){e=enemies[j];if(!e.dead&&e.t!=='c'&&overlap(b.x-1,b.y-1,3,3,e.x,e.y,e.w,e.h)){det=true;break;}}\n    if(b.y>=GROUND-1||det){bombs.splice(i,1);g.shake=Math.max(g.shake,6);boom(b.x,Math.min(b.y,GROUND-1),22,['O','W','P'],2);SFX.boom();\n      for(j=0;j<enemies.length;j++){e=enemies[j];if(!e.dead&&Math.hypot(e.x+e.w/2-b.x,e.y+e.h/2-b.y)<18)killEnemy(e,e.t==='c'?150:e.t==='h'?200:50);}\n      survivors.forEach(function(s){if(!s.dead&&s.st!=='lift'&&s.st!=='home'&&Math.abs(s.x+1-b.x)<12&&Math.abs(s.y-b.y)<14){loseSurvivor(s);g.banner='FRIENDLY FIRE';g.bannerT=70;}});\n      if(p&&!p.dead&&Math.hypot(pcx()-b.x,p.y+5-b.y)<12)damage();\n    }}\n  for(i=eshots.length-1;i>=0;i--){var q=eshots[i];q.x+=q.vx;q.y+=q.vy;\n    if(--q.life<=0||q.y<CEIL-4||q.y>GROUND){if(q.k==='f')boom(q.x,q.y,4,['O']);eshots.splice(i,1);continue;}\n    if(p&&!p.dead&&p.inv===0&&overlap(q.x-1,q.y-1,2,2,p.x+2,p.y+1,14,8)){eshots.splice(i,1);damage();}}\n}\n\n// ---------- draw ----------\nfunction sx(x){return Math.round(x-camX);}\nfunction draw(){\n  ctx.setTransform(1,0,0,1,0,0);ctx.fillStyle='#000';ctx.fillRect(0,0,W,H);\n  if(!g){drawTitle();return;}\n  var sh=g.shake>0?((Math.random()*3|0)-1):0,shy=g.shake>0?((Math.random()*3|0)-1):0;\n  ctx.setTransform(1,0,0,1,sh,shy);\n  drawWorld();\n  ctx.setTransform(1,0,0,1,0,0);\n  drawHUD();\n  if(g.bannerT>0&&(g.bannerT>40||(g.bannerT>>2)&1))ctext(g.banner,62,g.banner==='MISSION '+g.mission?COL.W:COL.O,2);\n  if(g.paused){box(80,70,120,40);ctext('PAUSED',80,COL.W,2);ctext('P TO RESUME',98,COL.B);}\n  if(g.state==='complete')drawComplete();\n  if(g.state==='over')drawOver();\n  if(!focused&&g.state==='play'&&!g.paused)ctext('CLICK TO FOCUS',150,COL.O);\n}\nfunction box(x,y,w,h){ctx.fillStyle='#000';ctx.fillRect(x,y,w,h);ctx.fillStyle=COL.B;ctx.fillRect(x,y,w,1);ctx.fillRect(x,y+h-1,w,1);ctx.fillRect(x,y,1,h);ctx.fillRect(x+w-1,y,1,h);}\n\nfunction drawBackdrop(){\n  var i;\n  STARS.forEach(function(s){var x=Math.round(((s.x-camX*0.08)%560+560)%560);if(x<W&&((frame+s.x*7|0)%97!==0)){ctx.fillStyle=COL[s.c];ctx.fillRect(x,Math.round(s.y),1,1);}});\n  // moon\n  var mx=Math.round(236-camX*0.03);ctx.fillStyle=COL.P;for(var a=0;a<40;a++){var an=a/40*6.28;ctx.fillRect(Math.round(mx+Math.cos(an)*8),Math.round(46+Math.sin(an)*8),1,1);}\n  ctx.fillStyle=COL.W;ctx.fillRect(mx-3,44,2,1);ctx.fillRect(mx+2,48,1,1);\n  // mountain outline (parallax)\n  ctx.fillStyle=COL.B;var prev=null;\n  for(i=0;i<W;i++){var wx=((Math.floor(i+camX*0.3))%1024+1024)%1024,h=MT[wx];if(prev===null)prev=h;var y0=Math.min(prev,h),y1=Math.max(prev,h);ctx.fillRect(i,y0,1,Math.max(1,y1-y0));prev=h;\n    if(((wx*13)%29)===0&&h<GROUND-6){ctx.fillRect(i,h+3,1,1);}}\n}\nfunction drawWorld(){\n  drawBackdrop();\n  // base\n  drawBase();\n  // scenery\n  SCENERY.forEach(function(o){var x=sx(o.x);if(x<-8||x>W+8)return;\n    if(o.t==='shrub'){ctx.fillStyle=COL.G;ctx.fillRect(x,GROUND-3,1,3);ctx.fillRect(x-2,GROUND-2,1,2);ctx.fillRect(x+2,GROUND-4,1,4);ctx.fillRect(x-1,GROUND-5,1,1);ctx.fillRect(x+1,GROUND-1,1,1);}\n    else if(o.t==='rock'){ctx.fillStyle=COL.W;ctx.fillRect(x-3,GROUND-1,7,1);ctx.fillRect(x-2,GROUND-2,1,1);ctx.fillRect(x+2,GROUND-2,1,1);ctx.fillRect(x-1,GROUND-3,3,1);}\n    else{ctx.fillStyle=COL.P;ctx.fillRect(x,GROUND-7,1,7);ctx.fillRect(x-1,GROUND-4,1,4);ctx.fillRect(x+1,GROUND-5,1,5);ctx.fillStyle=COL.W;ctx.fillRect(x,GROUND-8,1,1);}});\n  outposts.forEach(drawOutpost);\n  // ground\n  var off=-(((Math.round(camX))%64)+64)%64;for(var x=off;x<W;x+=64)ctx.drawImage(groundTile,x,GROUND);\n  // survivors\n  survivors.forEach(function(s){var x=sx(s.x);if(x<-4||x>W+4)return;var f;\n    if(s.st==='run'||s.st==='home')f=2+((s.an>>3)&1);else if(s.st==='lift'||s.st==='fall')f=1;else f=((s.an>>4)&1)&&p&&!p.dead&&Math.abs(pcx()-s.x)<160?1:0;\n    ctx.drawImage(SPR.surv[f],x,Math.round(s.y));});\n  // winch line\n  if(p&&p.winch&&!p.dead){ctx.fillStyle=COL.W;var lx=sx(pcx()),y0=p.y+9,y1=Math.round(p.winch.y);for(var y=y0;y<y1;y+=2)ctx.fillRect(lx,y,1,1);}\n  // enemies\n  enemies.forEach(function(e){var x=sx(e.x);if(x<-14||x>W+14)return;\n    if(e.t==='c')ctx.drawImage(SPR.crawl[(frame>>3)&1],x,Math.round(e.y));\n    else if(e.t==='h')ctx.drawImage(SPR.hunt[(frame>>2)&1],x,Math.round(e.y));\n    else ctx.drawImage(SPR.mine[(frame>>4)&1],x,Math.round(e.y));});\n  // shots\n  ctx.fillStyle=COL.W;shots.forEach(function(s){ctx.fillRect(sx(s.x),s.y,3,1);});\n  bombs.forEach(function(b){ctx.fillStyle=COL.O;ctx.fillRect(sx(b.x)-1,Math.round(b.y),3,2);ctx.fillStyle=COL.W;ctx.fillRect(sx(b.x),Math.round(b.y)-1,1,1);});\n  eshots.forEach(function(q){ctx.fillStyle=q.k==='f'?COL.O:COL.G;if(q.k==='f')ctx.fillRect(sx(q.x)-1,Math.round(q.y)-1,2,2);else ctx.fillRect(sx(q.x)-1,Math.round(q.y),3,1);});\n  // player\n  if(p&&!p.dead&&!(p.inv>0&&(p.inv>>2)&1)){\n    var fr=p.fuel>0?((frame>>1)%2):2;ctx.drawImage(SPR.lift[p.face>0?0:1][fr],sx(p.x),Math.round(p.y));\n    if(p.fuel>0&&(keys.l||keys.r)&&(frame&2)){ctx.fillStyle=COL.O;ctx.fillRect(p.face>0?sx(p.x)-1:sx(p.x)+18,Math.round(p.y)+4,1,1);}\n    if(p.aboard>0){ctx.fillStyle=COL.G;for(var k=0;k<p.aboard;k++)ctx.fillRect(sx(p.x)+4+k,Math.round(p.y)+6,1,1);}\n  }\n  // particles\n  parts.forEach(function(q){ctx.fillStyle=COL[q.c];ctx.fillRect(sx(q.x),Math.round(q.y),1,1);});\n}\nfunction drawBase(){\n  var x0=sx(0);if(x0>W)return;\n  // beacon tower\n  ctx.fillStyle=COL.W;var tx=sx(36);\n  ctx.fillRect(tx,GROUND-44,1,44);ctx.fillRect(tx+8,GROUND-44,1,44);\n  for(var y=GROUND-44;y<GROUND;y+=6){for(var k=0;k<8;k++)ctx.fillRect(tx+k,y+((k*6/8)|0),1,1);ctx.fillRect(tx,y,9,1);}\n  ctx.fillStyle=(frame>>4)&1?COL.G:COL.B;ctx.fillRect(tx+3,GROUND-48,3,3);\n  // pad\n  for(var i=0;i<62;i+=4){ctx.fillStyle=(i>>2)&1?COL.W:COL.O;ctx.fillRect(sx(70+i),GROUND-1,4,1);}\n  ctx.fillStyle=COL.W;ctx.fillRect(sx(70),GROUND-3,1,2);ctx.fillRect(sx(131),GROUND-3,1,2);\n  if(p&&p.aboard>0&&!onPad()&&(frame>>4)&1){ctx.fillStyle=COL.G;ctx.fillRect(sx(98),GROUND-5,6,1);ctx.fillRect(sx(100),GROUND-7,2,1);}\n  // HQ\n  var hx=sx(150);ctx.fillStyle=COL.B;ctx.fillRect(hx,GROUND-24,40,1);ctx.fillRect(hx,GROUND-24,1,24);ctx.fillRect(hx+39,GROUND-24,1,24);\n  ctx.fillRect(hx+4,GROUND-28,32,1);ctx.fillRect(hx+4,GROUND-28,1,4);ctx.fillRect(hx+35,GROUND-28,1,4);\n  text('VIBE',hx+12,GROUND-21,COL.P);text('BASE',hx+12,GROUND-14,COL.P);\n  ctx.fillStyle=COL.W;ctx.fillRect(hx+18,GROUND-7,5,7);ctx.fillStyle='#000';ctx.fillRect(hx+19,GROUND-6,3,6);\n}\nfunction drawOutpost(o){\n  var cx=sx(o.x);if(cx<-20||cx>W+20)return;\n  ctx.fillStyle=COL.P;\n  for(var dx=-12;dx<=12;dx++){var yy=Math.round(Math.sqrt(Math.max(0,1-(dx*dx)/(12.5*12.5)))*12);ctx.fillRect(cx+dx,GROUND-yy,1,1);if(Math.abs(dx)>10)ctx.fillRect(cx+dx,GROUND-yy,1,yy);}\n  ctx.fillStyle=COL.W;ctx.fillRect(cx-7,GROUND-8,1,1);ctx.fillRect(cx-3,GROUND-10,1,1);ctx.fillRect(cx+5,GROUND-8,1,1);\n  // door\n  ctx.fillStyle=COL.B;ctx.