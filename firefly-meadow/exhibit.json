    "type": "html",
    "bundle": "<!DOCTYPE html><html><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1.0\"><title>Firefly Meadow</title><style>*{margin:0;padding:0;box-sizing:border-box}html,body{width:100%;height:100%;overflow:hidden;background:#020210}canvas{display:block}#hint{position:absolute;bottom:16px;left:50%;transform:translateX(-50%);color:rgba(150,180,120,0.45);font:11px/1.4 system-ui,sans-serif;pointer-events:none;letter-spacing:.5px;text-align:center;transition:opacity 3s}#hint.fade{opacity:0}</style></head><body><canvas id=\"c\"></canvas><div id=\"hint\">move to attract &middot; click to flash &middot; hold to gather</div><script>(function(){'use strict';var canvas=document.getElementById('c'),ctx=canvas.getContext('2d');function getW(){return document.documentElement.clientWidth||window.innerWidth||960}function getH(){return document.documentElement.clientHeight||window.innerHeight||540}var W,H;var mouse={x:-9999,y:-9999,down:false,active:false};canvas.addEventListener('mousemove',function(e){mouse.x=e.clientX;mouse.y=e.clientY;mouse.active=true});canvas.addEventListener('mouseleave',function(){mouse.active=false});canvas.addEventListener('mousedown',function(e){mouse.down=true;createBurst(e.clientX,e.clientY,14)});canvas.addEventListener('mouseup',function(){mouse.down=false});canvas.addEventListener('touchstart',function(e){e.preventDefault();var t=e.touches[0];mouse.x=t.clientX;mouse.y=t.clientY;mouse.active=true;mouse.down=true;createBurst(t.clientX,t.clientY,14)},{passive:false});canvas.addEventListener('touchmove',function(e){e.preventDefault();var t=e.touches[0];mouse.x=t.clientX;mouse.y=t.clientY},{passive:false});canvas.addEventListener('touchend',function(){mouse.active=false;mouse.down=false});setTimeout(function(){var h=document.getElementById('hint');if(h)h.classList.add('fade')},6000);var stars=[];function genStars(){stars=[];for(var i=0;i<180;i++){stars.push({x:Math.random()*W,y:Math.random()*H*0.55,r:Math.random()*1.3+0.2,ts:Math.random()*2+0.8,tp:Math.random()*6.28,br:Math.random()*0.4+0.25})}}var hillPts=[[],[],[]];function genHills(){for(var layer=0;layer<3;layer++){hillPts[layer]=[];var baseY=[0.62,0.74,0.86][layer];var amp1=[35,25,18][layer];var amp2=[20,15,10][layer];var f1=[0.003,0.004,0.005][layer];var f2=[0.007,0.009,0.013][layer];var off=[0,2,4.5][layer];for(var x=0;x<=W;x+=4){var y=H*baseY+Math.sin(x*f1+off)*amp1+Math.sin(x*f2+off+1)*amp2;hillPts[layer].push({x:x,y:y})}}}var trees=[];function genTrees(){trees=[];for(var i=0;i<35;i++){var tx=Math.random()*W;var f1=0.003,f2=0.007;var by=H*0.62+Math.sin(tx*f1)*35+Math.sin(tx*f2+1)*20;trees.push({x:tx,y:by,h:25+Math.random()*55,w:12+Math.random()*22,pine:Math.random()>0.4})}}var grass=[];function genGrass(){grass=[];for(var i=0;i<200;i++){var gx=Math.random()*W;var by=H*0.86+Math.sin(gx*0.005+4.5)*18+Math.sin(gx*0.013+5.5)*10;grass.push({x:gx,y:by,h:8+Math.random()*28,sp:Math.random()*6.28,ss:0.4+Math.random()*1.2})}}function resize(){W=getW();H=getH();if(W<1)W=960;if(H<1)H=540;canvas.width=W;canvas.height=H;genStars();genHills();genTrees();genGrass()}var GROUPS=6;var gPhase=[];for(var g=0;g<GROUPS;g++)gPhase.push(Math.random()*6.28);var fireflies=[];var time=0;resize();if(canvas.width<1||canvas.height<1){var ri=setInterval(function(){resize();if(canvas.width>0&&canvas.height>0){clearInterval(ri);initFF();loop()}},50)}else{initFF();loop()}window.addEventListener('resize',resize);function mkFF(x,y,opts){opts=opts||{};var layer=opts.layer!==undefined?opts.layer:(Math.random()<0.25?0:Math.random()<0.55?1:2);var ls=[0.35,0.65,1.0][layer];return{x:x!==undefined?x:Math.random()*W,y:y!==undefined?y:H*0.25+Math.random()*H*0.55,vx:0,vy:0,layer:layer,sz:(1.2+Math.random()*2.2)*ls,gz:(6+Math.random()*14)*ls,wa:Math.random()*6.28,ws:(0.15+Math.random()*0.5)*ls,px:Math.random()*6.28,py:Math.random()*6.28,fx:0.25+Math.random()*0.6,fy:0.3+Math.random()*0.7,sg:Math.floor(Math.random()*GROUPS),fp:Math.random()*6.28,br:0,tbr:0,hue:52+Math.random()*42,life:opts.life||Infinity,age:0,trail:[]}}function initFF(){fireflies=[];var n=Math.min(150,Math.max(60,Math.floor(W*H/6000)));for(var i=0;i<n;i++)fireflies.push(mkFF())}function createBurst(x,y,n){for(var i=0;i<n;i++){var a=Math.random()*6.28,d=Math.random()*40;var f=mkFF(x+Math.cos(a)*d,y+Math.sin(a)*d,{life:250+Math.random()*250});f.br=1;f.vx=Math.cos(a)*(1+Math.random()*2);f.vy=Math.sin(a)*(1+Math.random()*2);fireflies.push(f)}}function update(){time+=1/60;for(var g=0;g<GROUPS;g++)gPhase[g]+=0.018+Math.sin(time*0.1+g)*0.003;for(var i=fireflies.length-1;i>=0;i--){var f=fireflies[i];f.age++;if(f.life!==Infinity&&f.age>f.life){fireflies.splice(i,1);continue}f.wa+=(Math.random()-0.5)*0.25;f.px+=f.fx*0.016;f.py+=f.fy*0.016;var wx=Math.cos(f.wa)*f.ws+Math.sin(f.px)*0.25;var wy=Math.sin(f.wa)*f.ws*0.4+Math.sin(f.py)*0.15;if(mouse.active){var dx=mouse.x-f.x,dy=mouse.y-f.y;var dist=Math.sqrt(dx*dx+dy*dy);var range=mouse.down?350:220;if(dist<range&&dist>3){var str=mouse.down?1.2:0.4;var force=str/(dist*0.08+1);wx+=dx/dist*force;wy+=dy/dist*force}}f.vx=f.vx*0.94+wx*0.06;f.vy=f.vy*0.94+wy*0.06;f.x+=f.vx;f.y+=f.vy;if(f.x<-60)f.x=W+60;if(f.x>W+60)f.x=-60;if(f.y<H*0.08)f.vy+=0.06;if(f.y>H*0.88)f.vy-=0.12;var sp=gPhase[f.sg]+f.fp*0.25;var wave=Math.sin(sp);var flash=Math.max(0,Math.pow(Math.max(0,wave),12));f.tbr=flash*0.85+0.04;if(Math.random()<0.002)f.tbr=1;f.br+=(f.tbr-f.br)*0.1;if(f.life!==Infinity){var lr=1-f.age/f.life;if(lr<0.25)f.br*=lr/0.25}if(f.br>0.12&&f.trail.length<25){f.trail.push({x:f.x,y:f.y,b:f.br,a:0})}for(var t=f.trail.length-1;t>=0;t--){f.trail[t].a++;if(f.trail[t].a>18)f.trail.splice(t,1)}}}function drawSky(){var g=ctx.createLinearGradient(0,0,0,H);g.addColorStop(0,'#020215');g.addColorStop(0.35,'#050522');g.addColorStop(0.7,'#0a0a28');g.addColorStop(1,'#0c0c1e');ctx.fillStyle=g;ctx.fillRect(0,0,W,H)}function drawMoon(){var mx=W*0.82,my=H*0.13;var mg=ctx.createRadialGradient(mx,my,0,mx,my,90);mg.addColorStop(0,'rgba(180,195,220,0.07)');mg.addColorStop(0.4,'rgba(130,150,190,0.025)');mg.addColorStop(1,'rgba(80,100,140,0)');ctx.fillStyle=mg;ctx.beginPath();ctx.arc(mx,my,90,0,6.28);ctx.fill();ctx.beginPath();ctx.arc(mx,my,12,0,6.28);ctx.fillStyle='rgba(190,200,220,0.12)';ctx.fill();ctx.beginPath();ctx.arc(mx+5,my-2,11,0,6.28);ctx.fillStyle='#020215';ctx.fill()}function drawStars(){for(var i=0;i<stars.length;i++){var s=stars[i];var tw=Math.sin(time*s.ts+s.tp)*0.3+0.7;var a=s.br*tw;ctx.beginPath();ctx.arc(s.x,s.y,s.r,0,6.28);ctx.fillStyle='rgba(190,200,235,'+a+')';ctx.fill()}}function drawHill(pts,col){ctx.beginPath();ctx.moveTo(0,H);for(var p=0;p<pts.length;p++)ctx.lineTo(pts[p].x,pts[p].y);ctx.lineTo(W,H);ctx.closePath();ctx.fillStyle=col;ctx.fill()}function drawTrees(){ctx.fillStyle='#06061a';for(var i=0;i<trees.length;i++){var t=trees[i];if(t.pine){ctx.beginPath();ctx.moveTo(t.x,t.y-t.h);ctx.lineTo(t.x-t.w*0.6,t.y-t.h*0.15);ctx.lineTo(t.x-t.w*0.15,t.y-t.h*0.35);ctx.lineTo(t.x-t.w*0.75,t.y+2);ctx.lineTo(t.x+t.w*0.75,t.y+2);ctx.lineTo(t.x+t.w*0.15,t.y-t.h*0.35);ctx.lineTo(t.x+t.w*0.6,t.y-t.h*0.15);ctx.closePath();ctx.fill()}else{ctx.fillRect(t.x-2.5,t.y-t.h*0.35,5,t.h*0.35+2);ctx.beginPath();ctx.arc(t.x,t.y-t.h*0.55,t.w*0.7,0,6.28);ctx.fill()}}}function drawGrass(){ctx.strokeStyle='#08081a';ctx.lineWidth=1.5;for(var i=0;i<grass.length;i++){var g=grass[i];var sw=Math.sin(time*g.ss+g.sp)*4;ctx.beginPath();ctx.moveTo(g.x,g.y);ctx.quadraticCurveTo(g.x+sw*0.4,g.y-g.h*0.5,g.x+sw,g.y-g.h);ctx.stroke()}}function drawFireflies(){for(var i=0;i<fireflies.length;i++){var f=fireflies[i];if(f.trail.length>1&&f.br>0.08){ctx.beginPath();ctx.moveTo(f.trail[0].x,f.trail[0].y);for(var t=1;t<f.trail.length;t++)ctx.lineTo(f.trail[t].x,f.trail[t].y);ctx.strokeStyle='hsla('+f.hue+',100%,70%,'+f.br*0.08+')';ctx.lineWidth=f.sz*0.4;ctx.stroke()}}ctx.globalCompositeOperation='lighter';for(var i=0;i<fireflies.length;i++){var f=fireflies[i];if(f.br<0.015)continue;var gr=f.gz*(0.7+f.br*0.6);var rg=ctx.createRadialGradient(f.x,f.y,0,f.x,f.y,gr);var a1=f.br*0.45,a2=f.br*0.12;rg.addColorStop(0,'hsla('+f.hue+',100%,82%,'+a1+')');rg.addColorStop(0.35,'hsla('+f.hue+',95%,62%,'+a2+')');rg.addColorStop(1,'hsla('+f.hue+',90%,50%,0)');ctx.beginPath();ctx.arc(f.x,f.y,gr,0,6.28);ctx.fillStyle=rg;ctx.fill();if(f.br>0.25){ctx.beginPath();ctx.arc(f.x,f.y,f.sz*f.br,0,6.28);ctx.fillStyle='hsla('+(f.hue-8)+',75%,92%,'+(f.br*0.85)+')';ctx.fill()}}ctx.globalCompositeOperation='source-over'}function drawCursorGlow(){if(!mouse.active)return;var cg=ctx.createRadialGradient(mouse.x,mouse.y,0,mouse.x,mouse.y,mouse.down?60:30);cg.addColorStop(0,'rgba(160,220,100,'+(mouse.down?0.06:0.025)+')');cg.addColorStop(1,'rgba(120,200,80,0)');ctx.fillStyle=cg;ctx.beginPath();ctx.arc(mouse.x,mouse.y,mouse.down?60:30,0,6.28);ctx.fill()}function draw(){ctx.clearRect(0,0,W,H);drawSky();drawMoon();drawStars();drawHill(hillPts[0],'#080818');drawTrees();drawHill(hillPts[1],'#060614');drawFireflies();drawHill(hillPts[2],'#040410');drawGrass();drawCursorGlow()}function loop(){update();draw();requestAnimationFrame(loop)}})();</script></body></html>"
  },
