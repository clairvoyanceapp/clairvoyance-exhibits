    "bundle": "<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>7th Grade American History — April 2026</title><style>*{margin:0;padding:0;box-sizing:border-box}:root{--bg:#faf8f5;--card:#fff;--text:#2d2a26;--muted:#7a756d;--border:#e8e4de;--unit1:#c9a96e;--unit1-bg:#faf3e8;--unit2:#b84c44;--unit2-bg:#fdf0ef;--unit3:#4a7c59;--unit3-bg:#eef6f0;--unit4:#3b6b9a;--unit4-bg:#edf4fa;--unit5:#8b6914;--unit5-bg:#faf5e8;--radius:10px;--shadow:0 2px 12px rgba(0,0,0,.08)}html,body{height:100%;font-family:'Segoe UI',system-ui,-apple-system,sans-serif;background:var(--bg);color:var(--text);overflow-x:hidden}body{display:flex;flex-direction:column}.header{text-align:center;padding:28px 20px 18px;background:linear-gradient(135deg,#3b2e1a 0%,#5c3d1e 50%,#3b2e1a 100%);color:#fff}.header h1{font-size:1.6rem;font-weight:700;letter-spacing:.5px;margin-bottom:4px}.header p{font-size:.95rem;opacity:.8;font-weight:400}.legend{display:flex;flex-wrap:wrap;justify-content:center;gap:8px 16px;padding:14px 20px;background:var(--card);border-bottom:1px solid var(--border)}.legend-item{display:flex;align-items:center;gap:6px;font-size:.78rem;color:var(--muted)}.legend-dot{width:10px;height:10px;border-radius:50%}.main{flex:1;display:flex;overflow:hidden}@media(max-width:800px){.main{flex-direction:column}}.calendar-wrap{flex:1;padding:20px;overflow-y:auto}.day-labels{display:grid;grid-template-columns:repeat(7,1fr);gap:4px;margin-bottom:6px;text-align:center}.day-labels span{font-size:.72rem;font-weight:600;color:var(--muted);text-transform:uppercase;padding:4px 0}.cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:6px}.day-cell{aspect-ratio:1;border-radius:var(--radius);display:flex;flex-direction:column;align-items:center;justify-content:center;cursor:pointer;transition:transform .15s,box-shadow .15s;border:2px solid transparent;position:relative}.day-cell:hover{transform:translateY(-2px);box-shadow:var(--shadow)}.day-cell.active{border-color:var(--text);box-shadow:0 0 0 2px rgba(45,42,38,.15)}.day-cell .day-num{font-size:1.1rem;font-weight:700;line-height:1}.day-cell .day-topic{font-size:.55rem;text-align:center;line-height:1.2;margin-top:3px;padding:0 4px;color:var(--text);opacity:.75;max-height:2.4em;overflow:hidden}.empty-cell{aspect-ratio:1}.detail-panel{width:420px;border-left:1px solid var(--border);background:var(--card);overflow-y:auto;padding:0;transition:opacity .2s}.detail-panel.empty{display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:.95rem;font-style:italic}@media(max-width:800px){.detail-panel{width:100%;border-left:none;border-top:1px solid var(--border);max-height:55vh}}.dp-header{padding:20px 24px 16px;border-bottom:1px solid var(--border)}.dp-header .dp-unit{font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:1px;margin-bottom:4px}.dp-header .dp-date{font-size:.82rem;color:var(--muted);margin-bottom:2px}.dp-header .dp-title{font-size:1.25rem;font-weight:700;line-height:1.3}.dp-body{padding:20px 24px 32px}.dp-section{margin-bottom:18px}.dp-section h3{font-size:.78rem;font-weight:700;text-transform:uppercase;letter-spacing:.8px;color:var(--muted);margin-bottom:6px;display:flex;align-items:center;gap:6px}.dp-section h3 .icon{font-style:normal}.dp-section p,.dp-section li{font-size:.88rem;line-height:1.55;color:var(--text)}.dp-section ul{padding-left:18px}.dp-section li{margin-bottom:4px}.dp-section .vocab{display:flex;flex-wrap:wrap;gap:6px}.dp-section .vocab span{background:var(--bg);border:1px solid var(--border);border-radius:20px;padding:2px 10px;font-size:.78rem;font-weight:500}.u1{background:var(--unit1-bg);--accent:var(--unit1)}.u2{background:var(--unit2-bg);--accent:var(--unit2)}.u3{background:var(--unit3-bg);--accent:var(--unit3)}.u4{background:var(--unit4-bg);--accent:var(--unit4)}.u5{background:var(--unit5-bg);--accent:var(--unit5)}.day-cell .day-num{color:var(--accent)}.dp-header .dp-unit{color:var(--accent)}</style></head><body><div class=\"header\"><h1>7th Grade American History</h1><p>Daily Lesson Plans — April 2026</p></div><div class=\"legend\"><div class=\"legend-item\"><span class=\"legend-dot\" style=\"background:var(--unit1)\"></span>Unit 1: Colonial America</div><div class=\"legend-item\"><span class=\"legend-dot\" style=\"background:var(--unit2)\"></span>Unit 2: The Revolution</div><div class=\"legend-item\"><span class=\"legend-dot\" style=\"background:var(--unit3)\"></span>Unit 3: Building a Nation</div><div class=\"legend-item\"><span class=\"legend-dot\" style=\"background:var(--unit4)\"></span>Unit 4: The Early Republic</div><div class=\"legend-item\"><span class=\"legend-dot\" style=\"background:var(--unit5)\"></span>Unit 5: Expansion & Reform</div></div><div class=\"main\"><div class=\"calendar-wrap\"><div class=\"day-labels\"><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span></div><div class=\"cal-grid\" id=\"calGrid\"></div></div><div class=\"detail-panel empty\" id=\"detailPanel\">Click a day to view the lesson plan</div></div><script>var lessons=[{day:1,unit:1,unitName:'Unit 1: Colonial America',title:'Life in the Thirteen Colonies',objective:'Students will compare daily life across the New England, Middle, and Southern colonies and explain how geography shaped each region\\'s economy and culture.',vocab:['Colonial regions','Subsistence farming','Cash crops','Indentured servants','Town meetings'],activities:['Warm-up: Map labeling — locate and color-code the 13 colonies by region','Mini-lecture: Three colonial regions and their defining characteristics','Group activity: \"Colony Cards\" — teams receive primary source descriptions and sort them by region','Exit ticket: Write 3 sentences explaining how geography influenced one colony\\'s way of life'],discussion:['Why did people leave Europe for an uncertain life in the colonies?','How did the environment shape what colonists could grow, build, and trade?'],homework:'Read textbook pp. 84–89. Write a diary entry from the perspective of a colonist in any region.'},{day:2,unit:1,unitName:'Unit 1: Colonial America',title:'Colonial Economy & the Atlantic Trade',objective:'Students will trace the flow of goods in the triangular trade and evaluate the role of enslaved labor in the colonial economy.',vocab:['Triangular trade','Middle Passage','Mercantilism','Exports','Imports'],activities:['Warm-up: Examine a trade map — identify routes and goods','Direct instruction: Mercantilism and why England wanted colonies','Interactive mapping: Students trace trade routes on large poster maps, labeling goods at each stop','Primary source analysis: Excerpts from Olaudah Equiano\\'s narrative'],discussion:['Who benefited most from the triangular trade? Who suffered?','How is mercantilism different from free trade today?'],homework:'Complete the triangular trade diagram worksheet. Define all vocabulary terms.'},{day:3,unit:1,unitName:'Unit 1: Colonial America',title:'The French and Indian War',objective:'Students will explain the causes, key events, and consequences of the French and Indian War and how it set the stage for colonial unrest.',vocab:['French and Indian War','Albany Plan of Union','Treaty of Paris 1763','Proclamation of 1763','War debt'],activities:['Warm-up: \"What would you fight over?\" quickwrite','Timeline activity: Students sequence key events of the war on a class timeline','Video clip: 8-minute overview of the French and Indian War','Cause-and-effect chart: Students connect war outcomes to British policy changes'],discussion:['Why did the British and French both want the Ohio River Valley?','How did winning the war actually create new problems for Britain?'],homework:'Create a cause-and-effect flowchart: French and Indian War → 3 consequences for the colonies.'},{day:4,unit:1,unitName:'Unit 1: Colonial America',title:'Taxation Without Representation',objective:'Students will analyze the major British tax acts and explain why colonists viewed them as violations of their rights.',vocab:['Stamp Act','Townshend Acts','Quartering Act','Boycott','No taxation without representation'],activities:['Warm-up: \"Tax Day\" simulation — teacher collects random supplies from students without warning','Gallery walk: Stations with primary sources from each tax act','Debate prep: Half the class argues the British perspective, half argues the colonial perspective','Structured debate: \"Was Britain justified in taxing the colonies?\"'],discussion:['What\\'s the difference between being taxed by a government you elected vs. one you didn\\'t?','Are there modern parallels to \"taxation without representation\"?'],homework:'Write a persuasive letter from either a Loyalist or Patriot perspective on the Stamp Act.'},{day:5,unit:1,unitName:'Unit 1: Colonial America',title:'The Boston Massacre & Boston Tea Party',objective:'Students will analyze competing accounts of the Boston Massacre and explain the significance of the Boston Tea Party as an act of protest.',vocab:['Boston Massacre','Propaganda','Paul Revere','Sons of Liberty','Boston Tea Party'],activities:['Warm-up: Show Paul Revere\\'s engraving — \"What story does this image tell?\"','Primary source comparison: Revere\\'s engraving vs. written testimony from British soldiers','Think-pair-share: Was this propaganda? Why does perspective matter?','Role-play activity: Students act out the planning meeting for the Boston Tea Party'],discussion:['Can an image be both art and propaganda?','When is breaking the law justified as protest?'],homework:'Compare two accounts of the Boston Massacre (provided handout). Write a paragraph explaining which is more reliable and why.'},{day:6,unit:1,unitName:'Unit 1: Colonial America',title:'The First Continental Congress',objective:'Students will describe the purpose and outcomes of the First Continental Congress and explain how it unified colonial resistance.',vocab:['Continental Congress','Delegates','Petition','Suffolk Resolves','Colonial unity'],activities:['Warm-up: Review — create a timeline of events leading to this point','Jigsaw reading: Each group reads about a different colony\\'s delegation and reports back','Mock Congress: Students role-play delegates debating how to respond to Britain','Document analysis: Read excerpts from the Declaration of Rights and Grievances'],discussion:['Why was it significant that 12 of 13 colonies sent delegates?','What options did the colonists have besides war?'],homework:'Write a one-page summary: What did the First Continental Congress accomplish, and what problems remained?'},{day:7,unit:2,unitName:'Unit 2: The Revolution',title:'Lexington & Concord — The Shot Heard Round the World',objective:'Students will narrate the events at Lexington and Concord and evaluate why these battles marked the point of no return.',vocab:['Minutemen','Militia','Paul Revere\\'s Ride','Lexington Green','Concord Bridge'],activities:['Warm-up: Listen to an audio dramatization of Paul Revere\\'s ride','Map activity: Trace the route from Boston to Lexington to Concord','Close reading: Eyewitness accounts from both British soldiers and colonists','Creative writing: \"Breaking news\" report from April 19, 1775'],discussion:['Who fired the first shot? Does it matter?','At what point does protest become revolution?'],homework:'Write a newspaper article (headline + 2 paragraphs) covering the events as a colonial journalist.'},{day:8,unit:2,unitName:'Unit 2: The Revolution',title:'The Declaration of Independence',objective:'Students will analyze the key ideas in the Declaration of Independence and connect them to Enlightenment philosophy.',vocab:['Declaration of Independence','Natural rights','Social contract','Thomas Jefferson','Enlightenment'],activities:['Warm-up: \"What rights do you think every person is born with?\" brainstorm','Guided reading: Analyze the Declaration paragraph by paragraph in plain English','Annotation activity: Students highlight key phrases and write margin notes','Connection chart: Match Declaration ideas to John Locke\\'s philosophy'],discussion:['\"All men are created equal\" — who was included? Who was left out?','Why write a formal declaration instead of just fighting?'],homework:'Rewrite the preamble of the Declaration in your own words (modern language).'},{day:9,unit:2,unitName:'Unit 2: The Revolution',title:'Key Battles: Bunker Hill, Trenton & Saratoga',objective:'Students will describe turning-point battles and explain how each changed the course of the war.',vocab:['Battle of Bunker Hill','Crossing the Delaware','Battle of Saratoga','Turning point','Morale'],activities:['Warm-up: Quick map quiz — locate each battle site','Battle stations: Three stations, each with a short reading + map + discussion question about one battle','Strategy analysis: Why was Washington\\'s surprise attack at Trenton so effective?','Class discussion: Which battle was THE turning point, and why?'],discussion:['How did the American strategy differ from traditional European warfare?','Why was Saratoga called \"the battle that saved America\"?'],homework:'Choose one battle. Draw a simple battle map with annotations explaining the strategy and outcome.'},{day:10,unit:2,unitName:'Unit 2: The Revolution',title:'Life During the Revolution',objective:'Students will examine how the war affected soldiers, women, enslaved people, and Native Americans.',vocab:['Valley Forge','Camp followers','Loyalists vs. Patriots','Lord Dunmore\\'s Proclamation','Abigail Adams'],activities:['Warm-up: Examine a painting of Valley Forge — \"What do you notice? What do you wonder?\"','Stations activity: Four perspectives — soldier letters, women\\'s diaries, enslaved people\\'s choices, Native American alliances','Abigail Adams letter: Read her \"Remember the Ladies\" letter to John Adams','Perspective essay brainstorm: Choose one group and outline their wartime experience'],discussion:['Why did some enslaved people fight for the British?','How did the war change expectations for women?'],homework:'Write a letter home from the perspective of one group studied today.'},{day:11,unit:2,unitName:'Unit 2: The Revolution',title:'Foreign Allies & Turning Points',objective:'Students will explain how French, Spanish, and individual foreign volunteers helped the American cause.',vocab:['Alliance','Marquis de Lafayette','Baron von Steuben','Treaty of Alliance 1778','Benjamin Franklin'],activities:['Warm-up: \"Why would another country help a rebellion?\" quickwrite','Mini-bios: Students research one foreign ally and present a 1-minute \"elevator pitch\" for their contribution','Diplomacy simulation: Students role-play Franklin convincing the French court','Map activity: Show how French naval power changed the strategic picture'],discussion:['Was the Revolution truly an \"American\" victory or an international one?','What did France expect in return for helping?'],homework:'Create a \"baseball card\" for one foreign ally: name, country, contribution, fun fact.'},{day:12,unit:2,unitName:'Unit 2: The Revolution',title:'Victory at Yorktown & the Treaty of Paris',objective:'Students will describe the siege of Yorktown and explain the terms of the Treaty of Paris (1783).',vocab:['Siege of Yorktown','Cornwallis','Treaty of Paris 1783','Sovereignty','Independence'],activities:['Warm-up: Map the Yorktown campaign — why was Cornwallis trapped?','Animated battle overview (video + discussion)','Treaty analysis: Read key articles of the Treaty of Paris — what did each side get?','Unit 2 review game: Team quiz covering the entire Revolution unit'],discussion:['Why did the British surrender rather than keep fighting?','What challenges faced the new nation immediately after winning independence?'],homework:'Study for Unit 2 quiz. Complete the Revolution timeline worksheet.'},{day:13,unit:3,unitName:'Unit 3: Building a Nation',title:'The Articles of Confederation',objective:'Students will describe the structure of government under the Articles and evaluate its strengths and weaknesses.',vocab:['Articles of Confederation','Confederation','Unicameral','Shays\\' Rebellion','Sovereignty of states'],activities:['Warm-up: \"Design a government\" — small groups list what a government needs to function','Direct instruction: What the Articles created and why the founders feared strong central power','Strengths/weaknesses T-chart: Students categorize provisions of the Articles','Case study: Shays\\' Rebellion — what went wrong and why it scared leaders'],discussion:['Why would people who just fought a king create a weak government?','Is Shays\\' Rebellion an example of democracy working or failing?'],homework:'Complete the Articles of Confederation strengths/weaknesses worksheet.'},{day:14,unit:3,unitName:'Unit 3: Building a Nation',title:'The Constitutional Convention',objective:'Students will explain why the Convention was called and describe the key debates among the delegates.',vocab:['Constitutional Convention','Philadelphia 1787','James Madison','Delegates','Virginia Plan','New Jersey Plan'],activities:['Warm-up: \"What would you change about the Articles?\" brainstorm','Background reading: Who attended, who didn\\'t, and why it was kept secret','Simulation setup: Assign students roles as delegates from large and small states','Begin Convention simulation: Present the Virginia Plan and New Jersey Plan'],discussion:['Why was the Convention held in secret?','Should large states have more power than small states?'],homework:'Read about both plans. Write which plan you would support and why (1 paragraph).'},{day:15,unit:3,unitName:'Unit 3: Building a Nation',title:'The Great Compromise',objective:'Students will explain how the Great Compromise and the Three-Fifths Compromise resolved key disputes.',vocab:['Great Compromise','Bicameral legislature','Senate','House of Representatives','Three-Fifths Compromise'],activities:['Warm-up: Review — what were the two competing plans?','Continue Convention simulation: Students negotiate and vote on compromises','Direct instruction: The Three-Fifths Compromise — what it was and why it matters','Reflection writing: \"Was the Three-Fifths Compromise a necessary evil or a moral failure?\"'],discussion:['Can a compromise be both practical and morally wrong?','How did the Three-Fifths Compromise shape American politics for decades?'],homework:'Create a Venn diagram comparing the Virginia Plan, New Jersey Plan, and the Great Compromise.'},{day:16,unit:3,unitName:'Unit 3: Building a Nation',title:'The Constitution\\'s Key Principles',objective:'Students will identify and explain the six key principles embedded in the Constitution.',vocab:['Popular sovereignty','Separation of powers','Checks and balances','Federalism','Limited government','Judicial review'],activities:['Warm-up: Matching game — principles to definitions','Interactive lecture: Each principle with real-world examples','Scenarios activity: Read 10 scenarios and identify which principle applies','Create a visual: Students design an infographic showing how the three branches check each other'],discussion:['Why did the founders divide power so many ways?','Which principle do you think is most important for preventing tyranny?'],homework:'Draw and label a diagram of the three branches with at least two checks each branch has on the others.'},{day:17,unit:3,unitName:'Unit 3: Building a Nation',title:'The Bill of Rights',objective:'Students will identify the first ten amendments and explain why Anti-Federalists demanded their inclusion.',vocab:['Bill of Rights','Amendments','Civil liberties','Due process','Anti-Federalists'],activities:['Warm-up: \"List 5 rights you think you have\" — compare with a partner','Speed dating with amendments: Students rotate through stations, each covering one amendment','Scenario cards: \"Which amendment protects you?\" — students match real-life situations to amendments','Class ranking: Which 3 amendments matter most to you? Discuss and defend choices'],discussion:['Why weren\\'t these rights included in the original Constitution?','Are there rights missing from the Bill of Rights that should be there?'],homework:'Choose one amendment. Write a short essay explaining why it matters in your daily life.'},{day:18,unit:3,unitName:'Unit 3: Building a Nation',title:'Ratification Debates: Federalists vs. Anti-Federalists',objective:'Students will compare Federalist and Anti-Federalist arguments and explain how the Constitution was ratified.',vocab:['Ratification','Federalists','Anti-Federalists','The Federalist Papers','Alexander Hamilton','Patrick Henry'],activities:['Warm-up: \"Would you have voted to ratify?\" snap poll and discussion','Jigsaw: Groups read excerpts from Federalist No. 10 (Madison) and Anti-Federalist writings','Structured debate: Teams argue for and against ratification','Map activity: Track which states ratified first and why'],discussion:['Were the Anti-Federalists right to be worried about federal power?','How do Federalist vs. Anti-Federalist tensions still show up in American politics?'],homework:'Unit 3 review: Complete the study guide. Quiz on Building a Nation next class.'},{day:19,unit:4,unitName:'Unit 4: The Early Republic',title:'Washington\\'s Presidency',objective:'Students will describe the precedents Washington set and evaluate their lasting impact on the presidency.',vocab:['Precedent','Cabinet','Neutrality','Farewell Address','Mr. President'],activities:['Warm-up: \"You\\'re the first-ever president. What rules do you set?\" brainstorm','Interactive lecture: Washington\\'s key precedents — cabinet, two terms, neutrality, title','Primary source: Read excerpts from Washington\\'s Farewell Address','Legacy ranking: Students rank his precedents from most to least important and justify'],discussion:['Why was Washington\\'s decision to step down after two terms so important?','Which of his warnings in the Farewell Address were most prophetic?'],homework:'Read textbook section on Hamilton and Jefferson. Note three differences between their visions.'},{day:20,unit:4,unitName:'Unit 4: The Early Republic',title:'Hamilton vs. Jefferson: Birth of Political Parties',objective:'Students will compare Hamilton\\'s and Jefferson\\'s visions for America and trace the origins of the first party system.',vocab:['Federalist Party','Democratic-Republican Party','National bank','Strict vs. loose construction','Agrarian vs. industrial'],activities:['Warm-up: Political spectrum activity — where do you fall on key issues?','Comparison chart: Hamilton vs. Jefferson on economy, government power, foreign policy, and social vision','\"Dinner Party\" simulation: Students role-play the famous dinner where Hamilton and Jefferson struck a deal','Create a campaign poster for either Hamilton or Jefferson'],discussion:['Is it possible for a democracy to function without political parties?','Whose vision — Hamilton\\'s or Jefferson\\'s — more closely matches America today?'],homework:'Write a campaign speech (1 page) for either Hamilton or Jefferson\\'s vision of America.'},{day:21,unit:4,unitName:'Unit 4: The Early Republic',title:'John Adams & the Alien and Sedition Acts',objective:'Students will evaluate the Alien and Sedition Acts and debate whether national security can justify limiting civil liberties.',vocab:['Alien and Sedition Acts','Sedition','XYZ Affair','Kentucky and Virginia Resolutions','States\\' rights'],activities:['Warm-up: \"Should the government be able to jail people for criticizing it?\" poll','Background lecture: The XYZ Affair and fear of war with France','Document analysis: Read excerpts from the Sedition Act — what exactly did it ban?','Mock trial: Is the Sedition Act constitutional? Students argue both sides before a student jury'],discussion:['When, if ever, should free speech be limited for national security?','How do the Kentucky and Virginia Resolutions connect to later states\\' rights arguments?'],homework:'Write a judicial opinion (1 paragraph): Is the Sedition Act constitutional? Cite the First Amendment.'},{day:22,unit:4,unitName:'Unit 4: The Early Republic',title:'The Louisiana Purchase',objective:'Students will explain the circumstances of the Louisiana Purchase and debate whether Jefferson exceeded his constitutional authority.',vocab:['Louisiana Purchase','Napoleon Bonaparte','Strict construction','Doubling the nation','New Orleans'],activities:['Warm-up: Map comparison — U.S. before and after the Purchase','Storytelling lecture: How a war in Haiti led to the greatest real estate deal in history','Constitutional debate: Jefferson believed in strict construction — so how could he justify this?','Math connection: Calculate the price per acre in 1803 dollars and today\\'s dollars'],discussion:['Did Jefferson betray his own principles by making the Purchase?','What would America look like today without the Louisiana Purchase?'],homework:'Write a short editorial (1803 style) either praising or criticizing Jefferson\\'s decision.'},{day:23,unit:4,unitName:'Unit 4: The Early Republic',title:'Lewis & Clark and Sacagawea',objective:'Students will trace the Lewis and Clark expedition and evaluate the contributions of Sacagawea and the Corps of Discovery.',vocab:['Corps of Discovery','Meriwether Lewis','William Clark','Sacagawea','Expedition journals'],activities:['Warm-up: Pack your bag — if you were exploring unknown territory, what 10 items would you bring?','Map tracing: Follow the expedition route on a large wall map, marking key stops','Journal entries: Read actual excerpts from Lewis and Clark\\'s journals','Group project kickoff: Each group is assigned a leg of the journey to research and present'],discussion:['How did the expedition change Americans\\' understanding of the continent?','Why is Sacagawea\\'s role so significant, and how has it been remembered vs. what actually happened?'],homework:'Read about the War of 1812 background. Complete the Lewis & Clark map worksheet.'},{day:24,unit:4,unitName:'Unit 4: The Early Republic',title:'The War of 1812',objective:'Students will explain the causes, key events, and outcomes of the War of 1812 and its role in shaping national identity.',vocab:['War of 1812','Impressment','War Hawks','Burning of Washington','Star-Spangled Banner','Treaty of Ghent'],activities:['Warm-up: \"When is going to war the right decision?\" quickwrite','Cause-and-effect web: British impressment, Native American conflicts, War Hawks, trade restrictions','Battle highlights: Washington burning, Fort McHenry, Battle of New Orleans','Music analysis: Read the full lyrics of \"The Star-Spangled Banner\" — what story does it tell?'],discussion:['Was the War of 1812 a \"second war of independence\" or an unnecessary conflict?','Why is the Battle of New Orleans famous even though it happened after the treaty was signed?'],homework:'Unit 4 study guide. Create 10 flashcards covering key people, events, and terms.'},{day:25,unit:5,unitName:'Unit 5: Expansion & Reform',title:'The Monroe Doctrine & National Identity',objective:'Students will explain the Monroe Doctrine and analyze how the Era of Good Feelings shaped American identity.',vocab:['Monroe Doctrine','Era of Good Feelings','Nationalism','Henry Clay','American System'],activities:['Warm-up: \"Should America get involved in other countries\\' affairs?\" four corners activity','Direct instruction: The Monroe Doctrine — what it said and what it really meant','Political cartoon analysis: Era of Good Feelings cartoons showing national pride and tensions','Connection to today: Is the Monroe Doctrine still relevant? Find modern examples'],discussion:['Was the \"Era of Good Feelings\" really as good as it sounds?','Should one country tell other countries what to do in their hemisphere?'],homework:'Write a modern version of the Monroe Doctrine (1 paragraph) — what would it say today?'},{day:26,unit:5,unitName:'Unit 5: Expansion & Reform',title:'Jacksonian Democracy',objective:'Students will evaluate Andrew Jackson\\'s presidency and debate whether he expanded or undermined democracy.',vocab:['Jacksonian Democracy','Universal white male suffrage','Spoils system','Populism','\"Common man\"'],activities:['Warm-up: \"What makes someone a \\'man of the people\\'?\" brainstorm','Lecture with discussion: Jackson\\'s rise from frontier orphan to president','Analyze: The spoils system — democratic empowerment or corruption?','Fishbowl debate: \"Andrew Jackson: Champion of democracy or tyrant?\"'],discussion:['Jackson expanded voting rights for white men while oppressing others. How do we judge that?','Is populism good or dangerous for democracy?'],homework:'Read about the Indian Removal Act. Prepare 3 discussion questions for tomorrow.'},{day:27,unit:5,unitName:'Unit 5: Expansion & Reform',title:'Westward Expansion & Manifest Destiny',objective:'Students will define Manifest Destiny, analyze its cultural roots, and evaluate its impact on different groups.',vocab:['Manifest Destiny','John O\\'Sullivan','Oregon Trail','Mexican-American War','Territorial expansion'],activities:['Warm-up: Examine the painting \"American Progress\" by John Gast — what message does it send?','Concept mapping: What ideas fueled Manifest Destiny (religion, economics, nationalism, racism)?','Oregon Trail simulation: Decision-making scenarios along the route','Multiple perspectives: How did expansion look to settlers vs. Mexicans vs. Native Americans?'],discussion:['Is there a difference between expansion and invasion?','Can a belief in national destiny be separated from the harm it causes?'],homework:'Write three diary entries: one from a settler heading west, one from a Mexican citizen in Texas, one from a Native American watching wagon trains arrive.'},{day:28,unit:5,unitName:'Unit 5: Expansion & Reform',title:'The Trail of Tears',objective:'Students will describe the Indian Removal Act and the Trail of Tears and evaluate their moral and legal dimensions.',vocab:['Indian Removal Act','Trail of Tears','Cherokee Nation','Worcester v. Georgia','Forced relocation'],activities:['Warm-up: Read a Cherokee petition to Congress — what are they asking for?','Legal analysis: Worcester v. Georgia — the Supreme Court ruled in favor of the Cherokee. What happened next?','Map the removal: Trace the routes of the Five Civilized Tribes','Testimony reading: First-person accounts from the Trail of Tears (read aloud, debrief)'],discussion:['Jackson reportedly said \"John Marshall has made his decision; now let him enforce it.\" What does this mean for the rule of law?','How should the Trail of Tears be remembered and taught?'],homework:'Reflective journal: Write a one-page response to what you learned today. What surprised you? What troubled you?'},{day:29,unit:5,unitName:'Unit 5: Expansion & Reform',title:'The Abolition Movement & Reform Era',objective:'Students will describe the major reform movements of the 1830s–1850s with emphasis on abolitionism.',vocab:['Abolition','Frederick Douglass','Harriet Tubman','Underground Railroad','Seneca Falls Convention','Suffrage'],activities:['Warm-up: \"What would you risk to fight injustice?\" reflection','Stations: Abolition movement, women\\'s suffrage, education reform, temperance — rotate through each','Primary source: Read excerpts from Frederick Douglass\\'s \"What to the Slave Is the Fourth of July?\"','Connection web: How were these reform movements connected to each other?'],discussion:['Why did so many reform movements happen at the same time?','How did abolitionists use the language of the Declaration of Independence against slavery?'],homework:'Choose one reformer. Write a 1-page biography focusing on their impact and legacy.'},{day:30,unit:5,unitName:'Unit 5: Expansion & Reform',title:'Month in Review — Assessment & Reflection',objective:'Students will demonstrate mastery of key concepts from Colonial America through Expansion & Reform.',vocab:['All unit vocabulary'],