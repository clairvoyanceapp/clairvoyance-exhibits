  "metadata": {
    "id": "exhibit-1741826400000-s3dbrush",
    "name": "SculptGL - 3D Sculpting Tool",
    "description": "A browser-based 3D sculpting tool inspired by SculptGL. Sculpt a sphere mesh using inflate, flatten, smooth, pinch, and crease brushes with adjustable radius and strength.",
    "createdAt": 1741826400000,
    "updatedAt": 1741826400000,
