  "content": {
    "type": "html",
    "bundle": "<!DOCTYPE html><html><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"><style>*{margin:0;padding:0;box-sizing:border-box}body{overflow:hidden;background:#1a1a2e;font-family:'Segoe UI',system-ui,sans-serif;color:#e0e0e0}canvas{display:block}#ui{position:absolute;top:12px;left:12px;z-index:10;display:flex;flex-direction:column;gap:8px;pointer-events:none}#ui>*{pointer-events:auto}.panel{background:rgba(20,20,40,0.92);border:1px solid rgba(100,120,255,0.25);border-radius:10px;padding:14px 16px;backdrop-filter:blur(8px);min-width:200px}.panel h3{font-size:13px;text-transform:uppercase;letter-spacing:1.5px;color:rgba(140,160,255,0.8);margin-bottom:10px;font-weight:600}.tool-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:4px}.tool-btn{background:rgba(60,60,100,0.5);border:1px solid rgba(100,120,255,0.2);border-radius:6px;color:#c0c8ff;padding:7px 4px;font-size:11px;cursor:pointer;transition:all 0.15s;text-align:center}.tool-btn:hover{background:rgba(80,80,140,0.6);border-color:rgba(120,140,255,0.4)}.tool-btn.active{background:rgba(80,100,255,0.35);border-color:rgba(120,150,255,0.6);color:#fff;box-shadow:0 0 12px rgba(80,100,255,0.2)}.slider-row{display:flex;align-items:center;justify-content:space-between;margin-bottom:6px}.slider-row label{font-size:12px;color:#a0a8cc}.slider-row span{font-size:11px;color:#8090cc;min-width:32px;text-align:right}input[type=range]{width:100%;height:4px;-webkit-appearance:none;background:rgba(80,100,180,0.3);border-radius:2px;outline:none;margin:4px 0}input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:14px;height:14px;border-radius:50%;background:#6078ff;cursor:pointer;border:2px solid rgba(255,255,255,0.2)}#status{position:absolute;bottom:12px;left:12px;font-size:11px;color:rgba(160,170,220,0.6);z-index:10}#help-hint{position:absolute;bottom:12px;right:12px;font-size:11px;color:rgba(160,170,220,0.5);z-index:10}.action-btn{background:rgba(60,60,100,0.5);border:1px solid rgba(100,120,255,0.2);border-radius:6px;color:#c0c8ff;padding:7px 10px;font-size:11px;cursor:pointer;transition:all 0.15s;width:100%;margin-top:4px}.action-btn:hover{background:rgba(80,80,140,0.6);border-color:rgba(120,140,255,0.4)}#brush-cursor{position:absolute;border:2px solid rgba(120,160,255,0.5);border-radius:50%;pointer-events:none;z-index:5;display:none;transform:translate(-50%,-50%)}</style></head><body><div id=\"brush-cursor\"></div><div id=\"ui\"><div class=\"panel\"><h3>Brush</h3><div class=\"tool-grid\"><button class=\"tool-btn active\" data-tool=\"inflate\">Inflate</button><button class=\"tool-btn\" data-tool=\"deflate\">Deflate</button><button class=\"tool-btn\" data-tool=\"smooth\">Smooth</button><button class=\"tool-btn\" data-tool=\"flatten\">Flatten</button><button class=\"tool-btn\" data-tool=\"pinch\">Pinch</button><button class=\"tool-btn\" data-tool=\"crease\">Crease</button></div></div><div class=\"panel\"><h3>Settings</h3><div class=\"slider-row\"><label>Radius</label><span id=\"radius-val\">40</span></div><input type=\"range\" id=\"radius\" min=\"10\" max=\"120\" value=\"40\"><div class=\"slider-row\"><label>Strength</label><span id=\"strength-val\">50</span></div><input type=\"range\" id=\"strength\" min=\"5\" max=\"100\" value=\"50\"><div class=\"slider-row\"><label>Detail</label><span id=\"detail-val\">3</span></div><input type=\"range\" id=\"detail\" min=\"3\" max=\"8\" value=\"3\"></div><div class=\"panel\"><h3>Mesh</h3><button class=\"action-btn\" id=\"btn-reset\">Reset Sphere</button><button class=\"action-btn\" id=\"btn-wireframe\">Toggle Wireframe</button><button class=\"action-btn\" id=\"btn-matcap\">Cycle Material</button></div></div><div id=\"status\">Vertices: <span id=\"vert-count\">0</span> | Faces: <span id=\"face-count\">0</span></div><div id=\"help-hint\">Left-click: sculpt | Right-drag: rotate | Scroll: zoom | Shift+click: smooth</div><script src=\"https://cdn.jsdelivr.net/npm/@vladkrutenyuk/three-umd@0.0.10/dist/three.umd.min.js\"></script><script src=\"https://cdn.jsdelivr.net/npm/@vladkrutenyuk/three-umd@0.0.10/dist/addons/controls/OrbitControls.umd.js\"></script><script>(function(){'use strict';var OrbitControls=ThreeAddons.OrbitControls.OrbitControls;var scene,camera,renderer,controls;var sculptMesh,wireHelper;var raycaster=new THREE.Raycaster();var mouse=new THREE.Vector2();var isMouseDown=false;var isSculpting=false;var currentTool='inflate';var brushRadius=40;var brushStrength=50;var detailLevel=3;var showWireframe=false;var materialIndex=0;var brushCursor=document.getElementById('brush-cursor');var origPositions=null;var neighborMap=null;var DETAIL_SEGMENTS=[null,null,null,[96,48],[128,64],[160,80],[192,96],[224,112],[256,128]];var materials=[];function createClayMaterial(){return new THREE.MeshPhysicalMaterial({color:0xd4a574,roughness:0.32,metalness:0.02,clearcoat:0.1,clearcoatRoughness:0.4})}function createStoneMaterial(){return new THREE.MeshPhysicalMaterial({color:0xa0a0b0,roughness:0.2,metalness:0.12,clearcoat:0.15,clearcoatRoughness:0.3})}function createMetalMaterial(){return new THREE.MeshPhysicalMaterial({color:0x8899bb,roughness:0.08,metalness:0.92,clearcoat:0.3,clearcoatRoughness:0.1})}function createJadeMaterial(){return new THREE.MeshPhysicalMaterial({color:0x44bb66,roughness:0.12,metalness:0.08,clearcoat:0.5,clearcoatRoughness:0.15,emissive:0x112211,emissiveIntensity:0.1})}materials=[createClayMaterial(),createStoneMaterial(),createMetalMaterial(),createJadeMaterial()];function buildNeighborMap(geo){var idx=geo.index;var pos=geo.attributes.position;var map=new Array(pos.count);for(var i=0;i<pos.count;i++)map[i]=[];if(idx){var arr=idx.array;for(var i=0;i<arr.length;i+=3){var a=arr[i],b=arr[i+1],c=arr[i+2];if(map[a].indexOf(b)===-1)map[a].push(b);if(map[a].indexOf(c)===-1)map[a].push(c);if(map[b].indexOf(a)===-1)map[b].push(a);if(map[b].indexOf(c)===-1)map[b].push(c);if(map[c].indexOf(a)===-1)map[c].push(a);if(map[c].indexOf(b)===-1)map[c].push(b)}}return map}function init(){scene=new THREE.Scene();scene.background=new THREE.Color(0x1a1a2e);camera=new THREE.PerspectiveCamera(50,window.innerWidth/window.innerHeight,0.1,100);camera.position.set(0,0,4);renderer=new THREE.WebGLRenderer({antialias:true});renderer.setSize(window.innerWidth,window.innerHeight);renderer.setPixelRatio(Math.min(window.devicePixelRatio,2));renderer.toneMapping=THREE.ACESFilmicToneMapping;renderer.toneMappingExposure=1.5;document.body.appendChild(renderer.domElement);controls=new OrbitControls(camera,renderer.domElement);controls.enableDamping=true;controls.dampingFactor=0.08;controls.mouseButtons={LEFT:null,MIDDLE:THREE.MOUSE.DOLLY,RIGHT:THREE.MOUSE.ROTATE};controls.touches={ONE:null,TWO:THREE.TOUCH.DOLLY_ROTATE};var ambLight=new THREE.AmbientLight(0x505070,0.7);scene.add(ambLight);var dirLight1=new THREE.DirectionalLight(0xffeedd,1.8);dirLight1.position.set(3,5,4);scene.add(dirLight1);var dirLight2=new THREE.DirectionalLight(0x8888cc,0.7);dirLight2.position.set(-3,-2,-4);scene.add(dirLight2);var rimLight=new THREE.DirectionalLight(0xaaccff,0.5);rimLight.position.set(-2,1,5);scene.add(rimLight);var hemiLight=new THREE.HemisphereLight(0x8888aa,0x444466,0.6);scene.add(hemiLight);var pmremGen=new THREE.PMREMGenerator(renderer);pmremGen.compileEquirectangularShader();var envScene=new THREE.Scene();envScene.background=new THREE.Color(0x303050);var ep1=new THREE.Mesh(new THREE.PlaneGeometry(20,20),new THREE.MeshBasicMaterial({color:0xfff4e8,side:THREE.DoubleSide}));ep1.position.set(0,8,0);ep1.lookAt(0,0,0);envScene.add(ep1);var ep2=new THREE.Mesh(new THREE.PlaneGeometry(14,14),new THREE.MeshBasicMaterial({color:0xbbccff,side:THREE.DoubleSide}));ep2.position.set(-6,-3,-6);ep2.lookAt(0,0,0);envScene.add(ep2);var ep3=new THREE.Mesh(new THREE.PlaneGeometry(10,10),new THREE.MeshBasicMaterial({color:0xffddbb,side:THREE.DoubleSide}));ep3.position.set(6,2,-4);ep3.lookAt(0,0,0);envScene.add(ep3);var ep4=new THREE.Mesh(new THREE.PlaneGeometry(8,8),new THREE.MeshBasicMaterial({color:0x778899,side:THREE.DoubleSide}));ep4.position.set(0,-6,4);ep4.lookAt(0,0,0);envScene.add(ep4);var ep5=new THREE.Mesh(new THREE.PlaneGeometry(6,6),new THREE.MeshBasicMaterial({color:0xeeeeff,side:THREE.DoubleSide}));ep5.position.set(5,0,5);ep5.lookAt(0,0,0);envScene.add(ep5);var envMap=pmremGen.fromScene(envScene,0.04).texture;scene.environment=envMap;pmremGen.dispose();createMesh();setupEvents();animate()}function createMesh(){if(sculptMesh){scene.remove(sculptMesh);sculptMesh.geometry.dispose()}if(wireHelper){scene.remove(wireHelper);wireHelper.geometry.dispose();wireHelper=null}var segs=DETAIL_SEGMENTS[detailLevel]||[128,64];var geo=new THREE.SphereGeometry(1.4,segs[0],segs[1]);geo.computeVertexNormals();neighborMap=buildNeighborMap(geo);sculptMesh=new THREE.Mesh(geo,materials[materialIndex]);scene.add(sculptMesh);origPositions=new Float32Array(geo.attributes.position.array);if(showWireframe){addWireHelper()}updateStats()}function addWireHelper(){if(wireHelper){scene.remove(wireHelper);wireHelper.geometry.dispose()}var wgeo=new THREE.WireframeGeometry(sculptMesh.geometry);wireHelper=new THREE.LineSegments(wgeo,new THREE.LineBasicMaterial({color:0x4466aa,opacity:0.12,transparent:true}));scene.add(wireHelper)}function updateStats(){var geo=sculptMesh.geometry;var pos=geo.attributes.position;document.getElementById('vert-count').textContent=pos.count;var idx=geo.index;document.getElementById('face-count').textContent=idx?Math.floor(idx.count/3):Math.floor(pos.count/3)}function finishStroke(){if(!isSculpting)return;sculptMesh.geometry.computeVertexNormals();sculptMesh.geometry.computeBoundingSphere();sculptMesh.geometry.computeBoundingBox();isSculpting=false}function setupEvents(){var canvas=renderer.domElement;canvas.addEventListener('mousedown',function(e){if(e.button===0){isMouseDown=true;updateMouse(e);doSculpt(e)}});canvas.addEventListener('mousemove',function(e){updateMouse(e);updateBrushCursor(e);if(isMouseDown){doSculpt(e)}});canvas.addEventListener('mouseup',function(e){if(e.button===0){isMouseDown=false;finishStroke()}});canvas.addEventListener('mouseleave',function(){isMouseDown=false;brushCursor.style.display='none';finishStroke()});canvas.addEventListener('touchstart',function(e){if(e.touches.length===1){isMouseDown=true;var t=e.touches[0];updateMouse(t);doSculpt(t)}},{passive:false});canvas.addEventListener('touchmove',function(e){if(e.touches.length===1&&isMouseDown){e.preventDefault();var t=e.touches[0];updateMouse(t);doSculpt(t)}},{passive:false});canvas.addEventListener('touchend',function(){isMouseDown=false;finishStroke()});window.addEventListener('resize',function(){camera.aspect=window.innerWidth/window.innerHeight;camera.updateProjectionMatrix();renderer.setSize(window.innerWidth,window.innerHeight)});document.querySelectorAll('.tool-btn').forEach(function(btn){btn.addEventListener('click',function(){document.querySelectorAll('.tool-btn').forEach(function(b){b.classList.remove('active')});btn.classList.add('active');currentTool=btn.dataset.tool})});var radiusSlider=document.getElementById('radius');var strengthSlider=document.getElementById('strength');var detailSlider=document.getElementById('detail');radiusSlider.addEventListener('input',function(){brushRadius=parseInt(this.value);document.getElementById('radius-val').textContent=this.value});strengthSlider.addEventListener('input',function(){brushStrength=parseInt(this.value);document.getElementById('strength-val').textContent=this.value});detailSlider.addEventListener('input',function(){var v=parseInt(this.value);document.getElementById('detail-val').textContent=v;if(v!==detailLevel){detailLevel=v;createMesh()}});document.getElementById('btn-reset').addEventListener('click',function(){createMesh()});document.getElementById('btn-wireframe').addEventListener('click',function(){showWireframe=!showWireframe;sculptMesh.material.wireframe=showWireframe});document.getElementById('btn-matcap').addEventListener('click',function(){materialIndex=(materialIndex+1)%materials.length;sculptMesh.material=materials[materialIndex]})}function updateMouse(e){var cx=e.clientX||e.pageX;var cy=e.clientY||e.pageY;mouse.x=(cx/window.innerWidth)*2-1;mouse.y=-(cy/window.innerHeight)*2+1}function updateBrushCursor(e){var cx=e.clientX||e.pageX;var cy=e.clientY||e.pageY;brushCursor.style.display='block';brushCursor.style.left=cx+'px';brushCursor.style.top=cy+'px';var sz=brushRadius*1.5;brushCursor.style.width=sz+'px';brushCursor.style.height=sz+'px'}function doSculpt(e){raycaster.setFromCamera(mouse,camera);var intersects=raycaster.intersectObject(sculptMesh);if(intersects.length===0)return;isSculpting=true;var hit=intersects[0];var point=hit.point;var hitNormal=hit.face?hit.face.normal.clone().transformDirection(sculptMesh.matrixWorld).normalize():new THREE.Vector3(0,1,0);var localPoint=sculptMesh.worldToLocal(point.clone());var localNormal=hitNormal.clone().transformDirection(sculptMesh.matrixWorld.clone().invert()).normalize();var positions=sculptMesh.geometry.attributes.position;var normals=sculptMesh.geometry.attributes.normal;var worldRadius=brushRadius*0.004;var str=brushStrength*0.0004;var tool=e.shiftKey?'smooth':currentTool;var affected=[];for(var i=0;i<positions.count;i++){var vx=positions.getX(i);var vy=positions.getY(i);var vz=positions.getZ(i);var dx=vx-localPoint.x;var dy=vy-localPoint.y;var dz=vz-localPoint.z;var dist=Math.sqrt(dx*dx+dy*dy+dz*dz);if(dist<worldRadius){var falloff=1.0-dist/worldRadius;falloff=falloff*falloff*(3.0-2.0*falloff);affected.push({idx:i,dist:dist,falloff:falloff})}}if(affected.length===0)return;if(tool==='smooth'){var snapPos=new Float32Array(positions.count*3);for(var k=0;k<affected.length;k++){var ai=affected[k].idx;var neighbors=neighborMap[ai];if(!neighbors||neighbors.length===0)continue;var ax=0,ay=0,az=0;for(var n=0;n<neighbors.length;n++){ax+=positions.getX(neighbors[n]);ay+=positions.getY(neighbors[n]);az+=positions.getZ(neighbors[n])}ax/=neighbors.length;ay/=neighbors.length;az/=neighbors.length;var cvx=positions.getX(ai);var cvy=positions.getY(ai);var cvz=positions.getZ(ai);var f=affected[k].falloff*str*6;snapPos[ai*3]=cvx+(ax-cvx)*f;snapPos[ai*3+1]=cvy+(ay-cvy)*f;snapPos[ai*3+2]=cvz+(az-cvz)*f}for(var k=0;k<affected.length;k++){var ai=affected[k].idx;positions.setXYZ(ai,snapPos[ai*3],snapPos[ai*3+1],snapPos[ai*3+2])}}else if(tool==='flatten'){var faceN=hit.face?hit.face.normal.clone():new THREE.Vector3(0,1,0);for(var k=0;k<affected.length;k++){var ai=affected[k].idx;var vx=positions.getX(ai);var vy=positions.getY(ai);var vz=positions.getZ(ai);var dx2=vx-localPoint.x,dy2=vy-localPoint.y,dz2=vz-localPoint.z;var dot=dx2*faceN.x+dy2*faceN.y+dz2*faceN.z;var f=affected[k].falloff*Math.min(str*40,0.9);positions.setXYZ(ai,vx-faceN.x*dot*f,vy-faceN.y*dot*f,vz-faceN.z*dot*f)}}else{for(var k=0;k<affected.length;k++){var ai=affected[k].idx;var f=affected[k].falloff;var vx=positions.getX(ai);var vy=positions.getY(ai);var vz=positions.getZ(ai);var nx=normals.getX(ai);var ny=normals.getY(ai);var nz=normals.getZ(ai);switch(tool){case'inflate':positions.setXYZ(ai,vx+nx*str*f,vy+ny*str*f,vz+nz*str*f);break;case'deflate':positions.setXYZ(ai,vx-nx*str*f,vy-ny*str*f,vz-nz*str*f);break;case'pinch':var tx=localPoint.x-vx,ty=localPoint.y-vy,tz=localPoint.z-vz;var pm=f*Math.min(str*25,0.8);positions.setXYZ(ai,vx+tx*pm,vy+ty*pm,vz+tz*pm);break;case'crease':var cf=f*f;var ca=cf*Math.min(str*12,0.5);positions.setXYZ(ai,vx-nx*ca,vy-ny*ca,vz-nz*ca);break}}}positions.needsUpdate=true;sculptMesh.geometry.computeVertexNormals();sculptMesh.geometry.computeBoundingSphere()}function animate(){requestAnimationFrame(animate);controls.update();renderer.render(scene,camera)}init()})();</script></body></html>"
  },
