  "content": {
    "type": "html",
    "html": "<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Lorenz Attractor</title>\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    body { \n      background: #0a0a12; \n      overflow: hidden; \n      font-family: 'Segoe UI', system-ui, sans-serif;\n    }\n    canvas { display: block; }\n    \n    .info {\n      position: absolute;\n      top: 20px;\n      left: 20px;\n      color: rgba(255, 255, 255, 0.8);\n      pointer-events: none;\n      z-index: 100;\n    }\n    \n    .info h1 {\n      font-size: 24px;\n      font-weight: 300;\n      margin-bottom: 8px;\n      letter-spacing: 2px;\n    }\n    \n    .info .formula {\n      font-family: 'Times New Roman', serif;\n      font-size: 14px;\n      color: rgba(255, 255, 255, 0.5);\n      line-height: 1.8;\n    }\n    \n    .info .formula span {\n      color: rgba(120, 200, 255, 0.7);\n    }\n    \n    .controls {\n      position: absolute;\n      bottom: 20px;\n      left: 20px;\n      display: flex;\n      gap: 12px;\n      z-index: 100;\n    }\n    \n    .controls button {\n      background: rgba(255, 255, 255, 0.1);\n      border: 1px solid rgba(255, 255, 255, 0.2);\n      color: rgba(255, 255, 255, 0.8);\n      padding: 8px 16px;\n      border-radius: 4px;\n      cursor: pointer;\n      font-size: 12px;\n      transition: all 0.2s;\n    }\n    \n    .controls button:hover {\n      background: rgba(255, 255, 255, 0.2);\n      border-color: rgba(255, 255, 255, 0.4);\n    }\n    \n    .hint {\n      position: absolute;\n      bottom: 20px;\n      right: 20px;\n      color: rgba(255, 255, 255, 0.4);\n      font-size: 11px;\n      pointer-events: none;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"info\">\n    <h1>LORENZ ATTRACTOR</h1>\n    <div class=\"formula\">\n      dx/dt = <span>\\u03C3</span>(y - x)<br>\n      dy/dt = x(<span>\\u03C1</span> - z) - y<br>\n      dz/dt = xy - <span>\\u03B2</span>z\n    </div>\n  </div>\n  \n  <div class=\"controls\">\n    <button id=\"resetBtn\">Reset</button>\n    <button id=\"pauseBtn\">Pause</button>\n    <button id=\"trailBtn\">Clear Trails</button>\n  </div>\n  \n  <div class=\"hint\">Drag to rotate | Scroll to zoom</div>\n  \n  <script type=\"importmap\">\n  {\n    \"imports\": {\n      \"three\": \"https://unpkg.com/three@0.169.0/build/three.module.min.js\",\n      \"three/addons/\": \"https://unpkg.com/three@0.169.0/examples/jsm/\"\n    }\n  }\n  </script>\n  \n  <script type=\"module\">\n    import * as THREE from 'three';\n    import { OrbitControls } from 'three/addons/controls/OrbitControls.js';\n    \n    console.log('Three.js loaded, revision:', THREE.REVISION);\n    \n    // Lorenz parameters\n    const sigma = 10;\n    const rho = 28;\n    const beta = 8 / 3;\n    const dt = 0.005;\n    \n    // Scene setup\n    const scene = new THREE.Scene();\n    scene.background = new THREE.Color(0x0a0a12);\n    scene.fog = new THREE.FogExp2(0x0a0a12, 0.008);\n    \n    const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);\n    camera.position.set(0, 30, 80);\n    \n    const renderer = new THREE.WebGLRenderer({ antialias: true });\n    renderer.setSize(window.innerWidth, window.innerHeight);\n    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));\n    document.body.appendChild(renderer.domElement);\n    \n    const controls = new OrbitControls(camera, renderer.domElement);\n    controls.enableDamping = true;\n    controls.dampingFactor = 0.05;\n    controls.target.set(0, 0, 25);\n    controls.autoRotate = true;\n    controls.autoRotateSpeed = 0.3;\n    \n    // Lighting\n    const ambientLight = new THREE.AmbientLight(0xffffff, 0.3);\n    scene.add(ambientLight);\n    \n    // Particle system for trails\n    const numParticles = 5;\n    const trailLength = 2000;\n    const particles = [];\n    const trails = [];\n    \n    // Color palette\n    const colors = [\n      new THREE.Color(0xff6b6b),\n      new THREE.Color(0x4ecdc4),\n      new THREE.Color(0xffe66d),\n      new THREE.Color(0xa78bfa),\n      new THREE.Color(0x22d3ee)\n    ];\n    \n    function createTrail(color, startPos) {\n      const positions = new Float32Array(trailLength * 3);\n      const colorArray = new Float32Array(trailLength * 3);\n      \n      for (let i = 0; i < trailLength; i++) {\n        positions[i * 3] = startPos.x;\n        positions[i * 3 + 1] = startPos.y;\n        positions[i * 3 + 2] = startPos.z;\n        \n        const alpha = i / trailLength;\n        colorArray[i * 3] = color.r * alpha;\n        colorArray[i * 3 + 1] = color.g * alpha;\n        colorArray[i * 3 + 2] = color.b * alpha;\n      }\n      \n      const geometry = new THREE.BufferGeometry();\n      geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));\n      geometry.setAttribute('color', new THREE.BufferAttribute(colorArray, 3));\n      \n      const material = new THREE.LineBasicMaterial({\n        vertexColors: true,\n        transparent: true,\n        opacity: 0.8,\n        blending: THREE.AdditiveBlending\n      });\n      \n      const line = new THREE.Line(geometry, material);\n      scene.add(line);\n      \n      return {\n        line,\n        positions,\n        head: 0\n      };\n    }\n    \n    function createParticle(color, startPos) {\n      const geometry = new THREE.SphereGeometry(0.5, 16, 16);\n      const material = new THREE.MeshBasicMaterial({\n        color: color,\n        transparent: true,\n        opacity: 1\n      });\n      const sphere = new THREE.Mesh(geometry, material);\n      sphere.position.copy(startPos);\n      scene.add(sphere);\n      \n      // Glow\n      const glowGeometry = new THREE.SphereGeometry(1.2, 16, 16);\n      const glowMaterial = new THREE.MeshBasicMaterial({\n        color: color,\n        transparent: true,\n        opacity: 0.3,\n        blending: THREE.AdditiveBlending\n      });\n      const glow = new THREE.Mesh(glowGeometry, glowMaterial);\n      sphere.add(glow);\n      \n      return {\n        mesh: sphere,\n        x: startPos.x,\n        y: startPos.y,\n        z: startPos.z\n      };\n    }\n    \n    function initParticles() {\n      // Clear existing\n      particles.forEach(p => scene.remove(p.mesh));\n      trails.forEach(t => scene.remove(t.line));\n      particles.length = 0;\n      trails.length = 0;\n      \n      // Create new particles with slight variations\n      for (let i = 0; i < numParticles; i++) {\n        const startPos = new THREE.Vector3(\n          0.1 + Math.random() * 0.1,\n          0 + Math.random() * 0.1,\n          0 + Math.random() * 0.1\n        );\n        \n        particles.push(createParticle(colors[i], startPos));\n        trails.push(createTrail(colors[i], startPos));\n      }\n    }\n    \n    initParticles();\n    \n    // Lorenz system step\n    function lorenzStep(x, y, z) {\n      const dx = sigma * (y - x) * dt;\n      const dy = (x * (rho - z) - y) * dt;\n      const dz = (x * y - beta * z) * dt;\n      return {\n        x: x + dx,\n        y: y + dy,\n        z: z + dz\n      };\n    }\n    \n    let isPaused = false;\n    let time = 0;\n    \n    function animate() {\n      requestAnimationFrame(animate);\n      \n      if (!isPaused) {\n        time += 0.01;\n        \n        for (let i = 0; i < particles.length; i++) {\n          const p = particles[i];\n          const trail = trails[i];\n          \n          // Update position using Lorenz equations\n          const newPos = lorenzStep(p.x, p.y, p.z);\n          p.x = newPos.x;\n          p.y = newPos.y;\n          p.z = newPos.z;\n          \n          // Update mesh position\n          p.mesh.position.set(p.x, p.z - 25, p.y);\n          \n          // Update trail\n          const positions = trail.line.geometry.attributes.position.array;\n          \n          // Shift all positions back\n          for (let j = trailLength - 1; j > 0; j--) {\n            positions[j * 3] = positions[(j - 1) * 3];\n            positions[j * 3 + 1] = positions[(j - 1) * 3 + 1];\n            positions[j * 3 + 2] = positions[(j - 1) * 3 + 2];\n          }\n          \n          // Add new position at head\n          positions[0] = p.x;\n          positions[1] = p.z - 25;\n          positions[2] = p.y;\n          \n          trail.line.geometry.attributes.position.needsUpdate = true;\n        }\n      }\n      \n      controls.update();\n      renderer.render(scene, camera);\n    }\n    \n    animate();\n    \n    // Controls\n    document.getElementById('resetBtn').addEventListener('click', initParticles);\n    \n    document.getElementById('pauseBtn').addEventListener('click', function() {\n      isPaused = !isPaused;\n      this.textContent = isPaused ? 'Resume' : 'Pause';\n    });\n    \n    document.getElementById('trailBtn').addEventListener('click', function() {\n      trails.forEach(trail => {\n        const positions = trail.line.geometry.attributes.position.array;\n        for (let i = 0; i < trailLength * 3; i++) {\n          const pIdx = Math.floor(i / 3);\n          const p = particles[trails.indexOf(trail)];\n          positions[i * 3] = p.x;\n          positions[i * 3 + 1] = p.z - 25;\n          positions[i * 3 + 2] = p.y;\n        }\n        trail.line.geometry.attributes.position.needsUpdate = true;\n      });\n    });\n    \n    // Handle resize\n    window.addEventListener('resize', () => {\n      camera.aspect = window.innerWidth / window.innerHeight;\n      camera.updateProjectionMatrix();\n      renderer.setSize(window.innerWidth, window.innerHeight);\n    });\n  </script>\n</body>\n</html>",
    "css": "",
    "js": ""
  },
