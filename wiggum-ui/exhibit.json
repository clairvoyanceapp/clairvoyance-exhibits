  "content": {
    "type": "html",
    "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Wiggum Mode</title>\n  <style>\n    * { box-sizing: border-box; margin: 0; padding: 0; }\n    \n    :root {\n      --bg-primary: #1a1a2e;\n      --bg-secondary: #16213e;\n      --bg-card: #1f2937;\n      --bg-card-hover: #2a3a52;\n      --accent: #6366f1;\n      --accent-hover: #818cf8;\n      --success: #10b981;\n      --warning: #f59e0b;\n      --danger: #ef4444;\n      --text-primary: #f3f4f6;\n      --text-secondary: #9ca3af;\n      --text-muted: #6b7280;\n      --border: #374151;\n      --border-focus: #6366f1;\n    }\n    \n    body {\n      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\n      background: var(--bg-primary);\n      color: var(--text-primary);\n      min-height: 100vh;\n      padding: 24px;\n    }\n    \n    .container {\n      max-width: 1200px;\n      margin: 0 auto;\n    }\n    \n    header {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      margin-bottom: 24px;\n      padding-bottom: 16px;\n      border-bottom: 1px solid var(--border);\n    }\n    \n    .logo {\n      display: flex;\n      align-items: center;\n      gap: 12px;\n    }\n    \n    .logo-icon {\n      width: 40px;\n      height: 40px;\n      background: linear-gradient(135deg, var(--accent), #a855f7);\n      border-radius: 10px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-size: 20px;\n    }\n    \n    .logo h1 {\n      font-size: 24px;\n      font-weight: 600;\n    }\n    \n    .logo span {\n      color: var(--text-secondary);\n      font-size: 14px;\n      font-weight: 400;\n    }\n    \n    .status-badge {\n      display: flex;\n      align-items: center;\n      gap: 8px;\n      padding: 8px 16px;\n      border-radius: 20px;\n      font-size: 14px;\n      font-weight: 500;\n    }\n    \n    .status-idle { background: var(--bg-card); color: var(--text-secondary); }\n    .status-running { background: rgba(99, 102, 241, 0.2); color: var(--accent); }\n    .status-paused { background: rgba(245, 158, 11, 0.2); color: var(--warning); }\n    .status-completed { background: rgba(16, 185, 129, 0.2); color: var(--success); }\n    \n    .status-dot {\n      width: 8px;\n      height: 8px;\n      border-radius: 50%;\n      background: currentColor;\n    }\n    \n    .status-running .status-dot {\n      animation: pulse 1.5s ease-in-out infinite;\n    }\n    \n    @keyframes pulse {\n      0%, 100% { opacity: 1; transform: scale(1); }\n      50% { opacity: 0.5; transform: scale(1.2); }\n    }\n    \n    .main-grid {\n      display: grid;\n      grid-template-columns: 1fr 380px;\n      gap: 24px;\n    }\n    \n    @media (max-width: 900px) {\n      .main-grid { grid-template-columns: 1fr; }\n    }\n    \n    .panel {\n      background: var(--bg-secondary);\n      border-radius: 12px;\n      padding: 20px;\n      border: 1px solid var(--border);\n    }\n    \n    .panel-header {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      margin-bottom: 16px;\n    }\n    \n    .panel-title {\n      font-size: 16px;\n      font-weight: 600;\n      display: flex;\n      align-items: center;\n      gap: 8px;\n    }\n    \n    .panel-title .count {\n      background: var(--bg-card);\n      padding: 2px 8px;\n      border-radius: 10px;\n      font-size: 12px;\n      color: var(--text-secondary);\n    }\n    \n    .btn {\n      padding: 8px 16px;\n      border-radius: 8px;\n      font-size: 14px;\n      font-weight: 500;\n      cursor: pointer;\n      border: none;\n      transition: all 0.2s;\n      display: flex;\n      align-items: center;\n      gap: 6px;\n    }\n    \n    .btn-primary {\n      background: var(--accent);\n      color: white;\n    }\n    \n    .btn-primary:hover {\n      background: var(--accent-hover);\n    }\n    \n    .btn-secondary {\n      background: var(--bg-card);\n      color: var(--text-primary);\n      border: 1px solid var(--border);\n    }\n    \n    .btn-secondary:hover {\n      background: var(--bg-card-hover);\n    }\n    \n    .btn-success {\n      background: var(--success);\n      color: white;\n    }\n    \n    .btn-warning {\n      background: var(--warning);\n      color: white;\n    }\n    \n    .btn-danger {\n      background: rgba(239, 68, 68, 0.2);\n      color: var(--danger);\n      border: 1px solid var(--danger);\n    }\n    \n    .btn-danger:hover {\n      background: var(--danger);\n      color: white;\n    }\n    \n    .btn-sm {\n      padding: 6px 12px;\n      font-size: 12px;\n    }\n    \n    .btn-icon {\n      padding: 8px;\n      border-radius: 8px;\n    }\n    \n    .story-list {\n      display: flex;\n      flex-direction: column;\n      gap: 12px;\n      min-height: 200px;\n    }\n    \n    .story-card {\n      background: var(--bg-card);\n      border-radius: 10px;\n      padding: 16px;\n      cursor: grab;\n      transition: all 0.2s;\n      border: 2px solid transparent;\n      position: relative;\n    }\n    \n    .story-card:hover {\n      background: var(--bg-card-hover);\n    }\n    \n    .story-card.selected {\n      border-color: var(--accent);\n    }\n    \n    .story-card.dragging {\n      opacity: 0.5;\n      cursor: grabbing;\n    }\n    \n    .story-card.current {\n      border-color: var(--accent);\n      box-shadow: 0 0 20px rgba(99, 102, 241, 0.3);\n    }\n    \n    .story-header {\n      display: flex;\n      justify-content: space-between;\n      align-items: flex-start;\n      margin-bottom: 8px;\n    }\n    \n    .story-priority {\n      font-size: 11px;\n      font-weight: 600;\n      padding: 2px 8px;\n      border-radius: 4px;\n      background: var(--bg-secondary);\n      color: var(--text-secondary);\n    }\n    \n    .story-priority.p1 { background: rgba(239, 68, 68, 0.2); color: var(--danger); }\n    .story-priority.p2 { background: rgba(245, 158, 11, 0.2); color: var(--warning); }\n    .story-priority.p3 { background: rgba(99, 102, 241, 0.2); color: var(--accent); }\n    \n    .story-status {\n      font-size: 11px;\n      font-weight: 500;\n      padding: 2px 8px;\n      border-radius: 4px;\n    }\n    \n    .story-status.pending { background: var(--bg-secondary); color: var(--text-secondary); }\n    .story-status.in_progress { background: rgba(99, 102, 241, 0.2); color: var(--accent); }\n    .story-status.completed { background: rgba(16, 185, 129, 0.2); color: var(--success); }\n    .story-status.failed { background: rgba(239, 68, 68, 0.2); color: var(--danger); }\n    .story-status.blocked { background: rgba(245, 158, 11, 0.2); color: var(--warning); }\n    \n    .story-title {\n      font-size: 15px;\n      font-weight: 500;\n      margin-bottom: 4px;\n    }\n    \n    .story-desc {\n      font-size: 13px;\n      color: var(--text-secondary);\n      margin-bottom: 8px;\n    }\n    \n    .story-meta {\n      display: flex;\n      gap: 12px;\n      font-size: 12px;\n      color: var(--text-muted);\n    }\n    \n    .story-actions {\n      position: absolute;\n      top: 12px;\n      right: 12px;\n      display: flex;\n      gap: 4px;\n      opacity: 0;\n      transition: opacity 0.2s;\n    }\n    \n    .story-card:hover .story-actions {\n      opacity: 1;\n    }\n    \n    .action-btn {\n      width: 28px;\n      height: 28px;\n      border-radius: 6px;\n      background: var(--bg-secondary);\n      border: none;\n      color: var(--text-secondary);\n      cursor: pointer;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-size: 14px;\n    }\n    \n    .action-btn:hover {\n      background: var(--bg-primary);\n      color: var(--text-primary);\n    }\n    \n    .action-btn.delete:hover {\n      background: rgba(239, 68, 68, 0.2);\n      color: var(--danger);\n    }\n    \n    .progress-ring {\n      width: 120px;\n      height: 120px;\n      margin: 0 auto 16px;\n    }\n    \n    .progress-ring circle {\n      fill: none;\n      stroke-width: 8;\n      stroke-linecap: round;\n      transform: rotate(-90deg);\n      transform-origin: 50% 50%;\n    }\n    \n    .progress-ring .bg {\n      stroke: var(--bg-card);\n    }\n    \n    .progress-ring .progress {\n      stroke: var(--accent);\n      transition: stroke-dashoffset 0.5s ease;\n    }\n    \n    .progress-text {\n      text-anchor: middle;\n      dominant-baseline: middle;\n      font-size: 24px;\n      font-weight: 600;\n      fill: var(--text-primary);\n    }\n    \n    .progress-label {\n      text-anchor: middle;\n      dominant-baseline: middle;\n      font-size: 11px;\n      fill: var(--text-secondary);\n    }\n    \n    .stats-grid {\n      display: grid;\n      grid-template-columns: repeat(2, 1fr);\n      gap: 12px;\n      margin-bottom: 20px;\n    }\n    \n    .stat-card {\n      background: var(--bg-card);\n      padding: 12px;\n      border-radius: 8px;\n      text-align: center;\n    }\n    \n    .stat-value {\n      font-size: 20px;\n      font-weight: 600;\n      margin-bottom: 4px;\n    }\n    \n    .stat-label {\n      font-size: 11px;\n      color: var(--text-secondary);\n      text-transform: uppercase;\n      letter-spacing: 0.5px;\n    }\n    \n    .control-buttons {\n      display: flex;\n      gap: 8px;\n      margin-bottom: 20px;\n    }\n    \n    .control-buttons .btn {\n      flex: 1;\n      justify-content: center;\n    }\n    \n    .current-story {\n      background: var(--bg-card);\n      border-radius: 10px;\n      padding: 16px;\n      margin-bottom: 16px;\n    }\n    \n    .current-story-label {\n      font-size: 11px;\n      text-transform: uppercase;\n      letter-spacing: 0.5px;\n      color: var(--text-muted);\n      margin-bottom: 8px;\n    }\n    \n    .current-story-title {\n      font-size: 15px;\n      font-weight: 500;\n      margin-bottom: 12px;\n    }\n    \n    .criteria-list {\n      display: flex;\n      flex-direction: column;\n      gap: 8px;\n    }\n    \n    .criteria-item {\n      display: flex;\n      align-items: flex-start;\n      gap: 8px;\n      font-size: 13px;\n      color: var(--text-secondary);\n    }\n    \n    .criteria-check {\n      width: 16px;\n      height: 16px;\n      border-radius: 4px;\n      border: 2px solid var(--border);\n      flex-shrink: 0;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-size: 10px;\n    }\n    \n    .criteria-check.checked {\n      background: var(--success);\n      border-color: var(--success);\n      color: white;\n    }\n    \n    .log-panel {\n      background: var(--bg-card);\n      border-radius: 8px;\n      padding: 12px;\n      max-height: 150px;\n      overflow-y: auto;\n      font-family: 'SF Mono', Monaco, monospace;\n      font-size: 12px;\n    }\n    \n    .log-entry {\n      display: flex;\n      gap: 8px;\n      padding: 4px 0;\n      border-bottom: 1px solid var(--border);\n    }\n    \n    .log-entry:last-child {\n      border-bottom: none;\n    }\n    \n    .log-time {\n      color: var(--text-muted);\n      flex-shrink: 0;\n    }\n    \n    .log-message {\n      color: var(--text-secondary);\n    }\n    \n    .log-message.success { color: var(--success); }\n    .log-message.error { color: var(--danger); }\n    .log-message.info { color: var(--accent); }\n    \n    .empty-state {\n      text-align: center;\n      padding: 40px 20px;\n      color: var(--text-muted);\n    }\n    \n    .empty-state-icon {\n      font-size: 48px;\n      margin-bottom: 12px;\n    }\n    \n    .empty-state p {\n      margin-bottom: 16px;\n    }\n    \n    .modal-overlay {\n      position: fixed;\n      inset: 0;\n      background: rgba(0, 0, 0, 0.7);\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      z-index: 1000;\n      opacity: 0;\n      visibility: hidden;\n      transition: all 0.2s;\n    }\n    \n    .modal-overlay.active {\n      opacity: 1;\n      visibility: visible;\n    }\n    \n    .modal {\n      background: var(--bg-secondary);\n      border-radius: 16px;\n      padding: 24px;\n      width: 100%;\n      max-width: 500px;\n      max-height: 90vh;\n      overflow-y: auto;\n      transform: scale(0.95);\n      transition: transform 0.2s;\n      border: 1px solid var(--border);\n    }\n    \n    .modal-overlay.active .modal {\n      transform: scale(1);\n    }\n    \n    .modal-header {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      margin-bottom: 20px;\n    }\n    \n    .modal-title {\n      font-size: 18px;\n      font-weight: 600;\n    }\n    \n    .modal-close {\n      background: none;\n      border: none;\n      color: var(--text-secondary);\n      cursor: pointer;\n      font-size: 20px;\n      padding: 4px;\n    }\n    \n    .form-group {\n      margin-bottom: 16px;\n    }\n    \n    .form-label {\n      display: block;\n      font-size: 13px;\n      font-weight: 500;\n      margin-bottom: 6px;\n      color: var(--text-secondary);\n    }\n    \n    .form-input, .form-textarea, .form-select {\n      width: 100%;\n      padding: 10px 12px;\n      border-radius: 8px;\n      border: 1px solid var(--border);\n      background: var(--bg-card);\n      color: var(--text-primary);\n      font-size: 14px;\n      transition: border-color 0.2s;\n    }\n    \n    .form-input:focus, .form-textarea:focus, .form-select:focus {\n      outline: none;\n      border-color: var(--border-focus);\n    }\n    \n    .form-textarea {\n      min-height: 80px;\n      resize: vertical;\n    }\n    \n    .criteria-inputs {\n      display: flex;\n      flex-direction: column;\n      gap: 8px;\n    }\n    \n    .criteria-input-row {\n      display: flex;\n      gap: 8px;\n    }\n    \n    .criteria-input-row input {\n      flex: 1;\n    }\n    \n    .form-actions {\n      display: flex;\n      justify-content: flex-end;\n      gap: 8px;\n      margin-top: 24px;\n    }\n    \n    .drag-indicator {\n      position: absolute;\n      left: 12px;\n      top: 50%;\n      transform: translateY(-50%);\n      color: var(--text-muted);\n      opacity: 0;\n      transition: opacity 0.2s;\n    }\n    \n    .story-card:hover .drag-indicator {\n      opacity: 1;\n    }\n    \n    .iteration-indicator {\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      gap: 8px;\n      padding: 12px;\n      background: rgba(99, 102, 241, 0.1);\n      border-radius: 8px;\n      margin-bottom: 16px;\n      font-size: 13px;\n      color: var(--accent);\n    }\n    \n    .spinner {\n      width: 16px;\n      height: 16px;\n      border: 2px solid var(--accent);\n      border-top-color: transparent;\n      border-radius: 50%;\n      animation: spin 0.8s linear infinite;\n    }\n    \n    @keyframes spin {\n      to { transform: rotate(360deg); }\n    }\n    \n    .drop-zone {\n      border: 2px dashed var(--border);\n      border-radius: 10px;\n      padding: 24px;\n      text-align: center;\n      color: var(--text-muted);\n      transition: all 0.2s;\n    }\n    \n    .drop-zone.drag-over {\n      border-color: var(--accent);\n      background: rgba(99, 102, 241, 0.1);\n      color: var(--accent);\n    }\n  </style>\n</head>\n<body>\n  <div class=\"container\">\n    <header>\n      <div class=\"logo\">\n        <div class=\"logo-icon\">W</div>\n        <div>\n          <h1>Wiggum Mode</h1>\n          <span>Autonomous Task Queue</span>\n        </div>\n      </div>\n      <div id=\"statusBadge\" class=\"status-badge status-idle\">\n        <span class=\"status-dot\"></span>\n        <span id=\"statusText\">Idle</span>\n      </div>\n    </header>\n    \n    <div class=\"main-grid\">\n      <div class=\"panel\">\n        <div class=\"panel-header\">\n          <h2 class=\"panel-title\">\n            Story Backlog\n            <span id=\"storyCount\" class=\"count\">0</span>\n          </h2>\n          <button class=\"btn btn-primary\" onclick=\"openAddModal()\">\n            <span>+</span> Add Story\n          </button>\n        </div>\n        \n        <div id=\"storyList\" class=\"story-list\">\n          <div class=\"empty-state\">\n            <div class=\"empty-state-icon\">&#128221;</div>\n            <p>No stories in the backlog yet</p>\n            <button class=\"btn btn-primary\" onclick=\"openAddModal()\">\n              <span>+</span> Add Your First Story\n            </button>\n          </div>\n        </div>\n      </div>\n      \n      <div>\n        <div class=\"panel\" style=\"margin-bottom: 16px;\">\n          <div class=\"panel-header\">\n            <h2 class=\"panel-title\">Progress</h2>\n          </div>\n          \n          <svg class=\"progress-ring\" viewBox=\"0 0 120 120\">\n            <circle class=\"bg\" cx=\"60\" cy=\"60\" r=\"52\"></circle>\n            <circle id=\"progressCircle\" class=\"progress\" cx=\"60\" cy=\"60\" r=\"52\"\n              stroke-dasharray=\"326.7\"\n              stroke-dashoffset=\"326.7\"></circle>\n            <text class=\"progress-text\" x=\"60\" y=\"55\" id=\"progressPercent\">0%</text>\n            <text class=\"progress-label\" x=\"60\" y=\"75\" id=\"progressLabel\">0 of 0</text>\n          </svg>\n          \n          <div class=\"stats-grid\">\n            <div class=\"stat-card\">\n              <div class=\"stat-value\" id=\"iterationCount\">0</div>\n              <div class=\"stat-label\">Iterations</div>\n            </div>\n            <div class=\"stat-card\">\n              <div class=\"stat-value\" id=\"timeElapsed\">0:00</div>\n              <div class=\"stat-label\">Time Elapsed</div>\n            </div>\n            <div class=\"stat-card\">\n              <div class=\"stat-value success\" id=\"completedCount\">0</div>\n              <div class=\"stat-label\">Completed</div>\n            </div>\n            <div class=\"stat-card\">\n              <div class=\"stat-value\" style=\"color: var(--danger)\" id=\"failedCount\">0</div>\n              <div class=\"stat-label\">Failed</div>\n            </div>\n          </div>\n          \n          <div class=\"control-buttons\" id=\"controlButtons\">\n            <button class=\"btn btn-success\" id=\"startBtn\" onclick=\"startLoop()\">\n              &#9654; Start\n            </button>\n          </div>\n          \n          <div id=\"iterationIndicator\" class=\"iteration-indicator\" style=\"display: none;\">\n            <div class=\"spinner\"></div>\n            <span id=\"iterationText\">Working on iteration 1...</span>\n          </div>\n          \n          <div id=\"currentStoryPanel\" class=\"current-story\" style=\"display: none;\">\n            <div class=\"current-story-label\">Currently Working On</div>\n            <div class=\"current-story-title\" id=\"currentStoryTitle\">-</div>\n            <div class=\"criteria-list\" id=\"currentCriteria\"></div>\n          </div>\n        </div>\n        \n        <div class=\"panel\">\n          <div class=\"panel-header\">\n            <h2 class=\"panel-title\">Activity Log</h2>\n          </div>\n          <div class=\"log-panel\" id=\"logPanel\">\n            <div class=\"log-entry\">\n              <span class=\"log-time\">--:--</span>\n              <span class=\"log-message\">Waiting to start...</span>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n  \n  <div id=\"addModal\" class=\"modal-overlay\">\n    <div class=\"modal\">\n      <div class=\"modal-header\">\n        <h3 class=\"modal-title\" id=\"modalTitle\">Add Story</h3>\n        <button class=\"modal-close\" onclick=\"closeModal()\">&times;</button>\n      </div>\n      \n      <form id=\"storyForm\" onsubmit=\"saveStory(event)\">\n        <div class=\"form-group\">\n          <label class=\"form-label\">Title *</label>\n          <input type=\"text\" class=\"form-input\" id=\"storyTitle\" required\n            placeholder=\"e.g., Implement user authentication\">\n        </div>\n        \n        <div class=\"form-group\">\n          <label class=\"form-label\">Description</label>\n          <textarea class=\"form-textarea\" id=\"storyDesc\"\n            placeholder=\"Describe what needs to be done...\"></textarea>\n        </div>\n        \n        <div class=\"form-group\">\n          <label class=\"form-label\">Priority</label>\n          <select class=\"form-select\" id=\"storyPriority\">\n            <option value=\"1\">P1 - Critical</option>\n            <option value=\"2\" selected>P2 - High</option>\n            <option value=\"3\">P3 - Normal</option>\n          </select>\n        </div>\n        \n        <div class=\"form-group\">\n          <label class=\"form-label\">Acceptance Criteria</label>\n          <div id=\"criteriaInputs\" class=\"criteria-inputs\">\n            <div class=\"criteria-input-row\">\n              <input type=\"text\" class=\"form-input\" placeholder=\"Criterion 1...\">\n              <button type=\"button\" class=\"btn btn-secondary btn-icon\" onclick=\"addCriteriaInput()\">+</button>\n            </div>\n          </div>\n        </div>\n        \n        <div class=\"form-actions\">\n          <button type=\"button\" class=\"btn btn-secondary\" onclick=\"closeModal()\">Cancel</button>\n          <button type=\"submit\" class=\"btn btn-primary\" id=\"saveBtn\">Add Story</button>\n        </div>\n      </form>\n    </div>\n  </div>\n  \n  <script>\n    let stories = [];\n    let loopState = {\n      status: 'idle',\n      currentIteration: 0,\n      currentStoryId: null,\n      startTime: null,\n      completedStories: [],\n      failedStories: []\n    };\n    let editingStoryId = null;\n    let draggedItem = null;\n    let timerInterval = null;\n    let simulationInterval = null;\n    \n    function generateId() {\n      return 'story-' + Date.now() + '-' + Math.random().toString(36).substr(2, 9);\n    }\n    \n    function renderStories() {\n      const container = document.getElementById('storyList');\n      const countEl = document.getElementById('storyCount');\n      countEl.textContent = stories.length;\n      \n      if (stories.length === 0) {\n        container.innerHTML = `\n          <div class=\"empty-state\">\n            <div class=\"empty-state-icon\">&#128221;</div>\n            <p>No stories in the backlog yet</p>\n            <button class=\"btn btn-primary\" onclick=\"openAddModal()\">\n              <span>+</span> Add Your First Story\n            </button>\n          </div>\n        `;\n        return;\n      }\n      \n      const sortedStories = [...stories].sort((a, b) => a.priority - b.priority);\n      \n      container.innerHTML = sortedStories.map(story => {\n        const isCurrent = loopState.currentStoryId === story.id;\n        const isCompleted = loopState.completedStories.includes(story.id);\n        const isFailed = loopState.failedStories.includes(story.id);\n        \n        let status = story.status;\n        if (isCompleted) status = 'completed';\n        if (isFailed) status = 'failed';\n        if (isCurrent && loopState.status === 'running') status = 'in_progress';\n        \n        return `\n          <div class=\"story-card ${isCurrent ? 'current' : ''} ${story.id === editingStoryId ? 'selected' : ''}\"\n               draggable=\"true\"\n               ondragstart=\"handleDragStart(event, '${story.id}')\"\n               ondragover=\"handleDragOver(event)\"\n               ondrop=\"handleDrop(event, '${story.id}')\"\n               onclick=\"selectStory('${story.id}')\">\n            <span class=\"drag-indicator\">&#8942;&#8942;</span>\n            <div class=\"story-header\">\n              <span class=\"story-priority p${story.priority}\">P${story.priority}</span>\n              <span class=\"story-status ${status}\">${formatStatus(status)}</span>\n            </div>\n            <div class=\"story-title\">${escapeHtml(story.title)}</div>\n            <div class=\"story-desc\">${escapeHtml(story.description || 'No description')}</div>\n            <div class=\"story-meta\">\n              <span>&#10003; ${story.acceptanceCriteria.length} criteria</span>\n              <span>&#8635; ${story.attempts || 0} attempts</span>\n            </div>\n            <div class=\"story-actions\">\n              <button class=\"action-btn\" onclick=\"event.stopPropagation(); editStory('${story.id}')\" title=\"Edit\">\n                &#9998;\n              </button>\n              <button class=\"action-btn delete\" onclick=\"event.stopPropagation(); deleteStory('${story.id}')\" title=\"Delete\">\n                &#128465;\n              </button>\n            </div>\n          </div>\n        `;\n      }).join('');\n    }\n    \n    function formatStatus(status) {\n      const map = {\n        pending: 'Pending',\n        in_progress: 'In Progress',\n        completed: 'Completed',\n        failed: 'Failed',\n        blocked: 'Blocked'\n      };\n      return map[status] || status;\n    }\n    \n    function escapeHtml(text) {\n      const div = document.createElement('div');\n      div.textContent = text;\n      return div.innerHTML;\n    }\n    \n    function updateProgress() {\n      const total = stories.length;\n      const completed = loopState.completedStories.length;\n      const failed = loopState.failedStories.length;\n      const percent = total > 0 ? Math.round((completed / total) * 100) : 0;\n      \n      const circumference = 326.7;\n      const offset = circumference - (percent / 100) * circumference;\n      \n      document.getElementById('progressCircle').style.strokeDashoffset = offset;\n      document.getElementById('progressPercent').textContent = percent + '%';\n      document.getElementById('progressLabel').textContent = completed + ' of ' + total;\n      document.getElementById('completedCount').textContent = completed;\n      document.getElementById('failedCount').textContent = failed;\n      document.getElementById('iterationCount').textContent = loopState.currentIteration;\n    }\n    \n    function updateStatus() {\n      const badge = document.getElementById('statusBadge');\n      const text = document.getElementById('statusText');\n      const controls = document.getElementById('controlButtons');\n      \n      badge.className = 'status-badge status-' + loopState.status;\n      \n      const statusMap = {\n        idle: 'Idle',\n        running: 'Running',\n        paused: 'Paused',\n        completed: 'Completed',\n        failed: 'Failed',\n        stopped: 'Stopped'\n      };\n      text.textContent = statusMap[loopState.status] || loopState.status;\n      \n      let buttons = '';\n      switch (loopState.status) {\n        case 'idle':\n        case 'stopped':\n        case 'completed':\n          buttons = `<button class=\"btn btn-success\" onclick=\"startLoop()\" ${stories.length === 0 ? 'disabled' : ''}>&#9654; Start</button>`;\n          break;\n        case 'running':\n          buttons = `\n            <button class=\"btn btn-warning\" onclick=\"pauseLoop()\">&#10074;&#10074; Pause</button>\n            <button class=\"btn btn-danger\" onclick=\"stopLoop()\">&#9632; Stop</button>\n          `;\n          break;\n        case 'paused':\n          buttons = `\n            <button class=\"btn btn-success\" onclick=\"resumeLoop()\">&#9654; Resume</button>\n            <button class=\"btn btn-danger\" onclick=\"stopLoop()\">&#9632; Stop</button>\n          `;\n          break;\n      }\n      controls.innerHTML = buttons;\n    }\n    \n    function openAddModal() {\n      editingStoryId = null;\n      document.getElementById('modalTitle').textContent = 'Add Story';\n      document.getElementById('saveBtn').textContent = 'Add Story';\n      document.getElementById('storyForm').reset();\n      document.getElementById('criteriaInputs').innerHTML = `\n        <div class=\"criteria-input-row\">\n          <input type=\"text\" class=\"form-input\" placeholder=\"Criterion 1...\">\n          <button type=\"button\" class=\"btn btn-secondary btn-icon\" onclick=\"addCriteriaInput()\">+</button>\n        </div>\n      `;\n      document.getElementById('addModal').classList.add('active');\n    }\n    \n    function editStory(id) {\n      const story = stories.find(s => s.id === id);\n      if (!story) return;\n      \n      editingStoryId = id;\n      document.getElementById('modalTitle').textContent = 'Edit Story';\n      document.getElementById('saveBtn').textContent = 'Save Changes';\n      document.getElementById('storyTitle').value = story.title;\n      document.getElementById('storyDesc').value = story.description || '';\n      document.getElementById('storyPriority').value = story.priority;\n      \n      const criteriaContainer = document.getElementById('criteriaInputs');\n      criteriaContainer.innerHTML = story.acceptanceCriteria.map((c, i) => `\n        <div class=\"criteria-input-row\">\n          <input type=\"text\" class=\"form-input\" placeholder=\"Criterion ${i + 1}...\" value=\"${escapeHtml(c)}\">\n          ${i === story.acceptanceCriteria.length - 1 ? \n            '<button type=\"button\" class=\"btn btn-secondary btn-icon\" onclick=\"addCriteriaInput()\">+</button>' :\n            '<button type=\"button\" class=\"btn btn-danger btn-icon\" onclick=\"removeCriteriaInput(this)\">-</button>'\n          }\n        </div>\n      `).join('') || `\n        <div class=\"criteria-input-row\">\n          <input type=\"text\" class=\"form-input\" placeholder=\"Criterion 1...\">\n          <button type=\"button\" class=\"btn btn-secondary btn-icon\" onclick=\"addCriteriaInput()\">+</button>\n        </div>\n      `;\n      \n      document.getElementById('addModal').classList.add('active');\n    }\n    \n    function closeModal() {\n      document.getElementById('addModal').classList.remove('active');\n      editingStoryId = null;\n    }\n    \n    function addCriteriaInput() {\n      const container = document.getElementById('criteriaInputs');\n      const rows = container.querySelectorAll('.criteria-input-row');\n      const lastRow = rows[rows.length - 1];\n      const btn = lastRow.querySelector('button');\n      btn.textContent = '-';\n      btn.className = 'btn btn-danger btn-icon';\n      btn.setAttribute('onclick', 'removeCriteriaInput(this)');\n      \n      const newRow = document.createElement('div');\n      newRow.className = 'criteria-input-row';\n      newRow.innerHTML = `\n        <input type=\"text\" class=\"form-input\" placeholder=\"Criterion ${rows.length + 1}...\">\n        <button type=\"button\" class=\"btn btn-secondary btn-icon\" onclick=\"addCriteriaInput()\">+</button>\n      `;\n      container.appendChild(newRow);\n      newRow.querySelector('input').focus();\n    }\n    \n    function removeCriteriaInput(btn) {\n      btn.parentElement.remove();\n    }\n    \n    function saveStory(e) {\n      e.preventDefault();\n      \n      const title = document.getElementById('storyTitle').value.trim();\n      const description = document.getElementById('storyDesc').value.trim();\n      const priority = parseInt(document.getElementById('storyPriority').value);\n      \n      const criteriaInputs = document.querySelectorAll('#criteriaInputs input');\n      const acceptanceCriteria = Array.from(criteriaInputs)\n        .map(input => input.value.trim())\n        .filter(c => c.length > 0);\n      \n      if (editingStoryId) {\n        const story = stories.find(s => s.id === editingStoryId);\n        if (story) {\n          story.title = title;\n          story.description = description;\n          story.priority = priority;\n          story.acceptanceCriteria = acceptanceCriteria;\n        }\n        addLog('Story updated: ' + title, 'info');\n      } else {\n        stories.push({\n          id: generateId(),\n          title,\n          description,\n          priority,\n          acceptanceCriteria,\n          status: 'pending',\n          attempts: 0,\n          completedAt: null\n        });\n        addLog('Story added: ' + title, 'info');\n      }\n      \n      closeModal();\n      renderStories();\n      updateProgress();\n      updateStatus();\n    }\n    \n    function deleteStory(id) {\n      if (!confirm('Are you sure you want to delete this story?')) return;\n      \n      const story = stories.find(s => s.id === id);\n      stories = stories.filter(s => s.id !== id);\n      loopState.completedStories = loopState.completedStories.filter(sid => sid !== id);\n      loopState.failedStories = loopState.failedStories.filter(sid => sid !== id);\n      \n      if (story) addLog('Story removed: ' + story.title, 'info');\n      \n      renderStories();\n      updateProgress();\n      updateStatus();\n    }\n    \n    function selectStory(id) {\n      editingStoryId = editingStoryId === id ? null : id;\n      renderStories();\n    }\n    \n    function handleDragStart(e, id) {\n      draggedItem = id;\n      e.target.classList.add('dragging');\n    }\n    \n    function handleDragOver(e) {\n      e.preventDefault();\n    }\n    \n    function handleDrop(e, targetId) {\n      e.preventDefault();\n      if (!draggedItem || draggedItem === targetId) return;\n      \n      const draggedStory = stories.find(s => s.id === draggedItem);\n      const targetStory = stories.find(s => s.id === targetId);\n      \n      if (draggedStory && targetStory) {\n        const tempPriority = draggedStory.priority;\n        draggedStory.priority = targetStory.priority;\n        targetStory.priority = tempPriority;\n      }\n      \n      draggedItem = null;\n      renderStories();\n    }\n    \n    function addLog(message, type = '') {\n      const panel = document.getElementById('logPanel');\n      const now = new Date();\n      const time = now.toLocaleTimeString('en-US', { hour12: false, hour: '2-digit', minute: '2-digit' });\n      \n      const entry = document.createElement('div');\n      entry.className = 'log-entry';\n      entry.innerHTML = `\n        <span class=\"log-time\">${time}</span>\n        <span class=\"log-message ${type}\">${escapeHtml(message)}</span>\n      `;\n      \n      panel.insertBefore(entry, panel.firstChild);\n      if (panel.children.length > 50) {\n        panel.removeChild(panel.lastChild);\n      }\n    }\n    \n    function updateTimer() {\n      if (!loopState.startTime) return;\n      \n      const elapsed = Math.floor((Date.now() - loopState.startTime) / 1000);\n      const minutes = Math.floor(elapsed / 60);\n      const seconds = elapsed % 60;\n      document.getElementById('timeElapsed').textContent = \n        minutes + ':' + seconds.toString().padStart(2, '0');\n    }\n    \n    function startLoop() {\n      if (stories.length === 0) {\n        addLog('No stories to process!', 'error');\n        return;\n      }\n      \n      loopState.status = 'running';\n      loopState.currentIteration = 0;\n      loopState.startTime = Date.now();\n      loopState.completedStories = [];\n      loopState.failedStories = [];\n      \n      addLog('Wiggum loop started', 'success');\n      updateStatus();\n      \n      timerInterval = setInterval(updateTimer, 1000);\n      document.getElementById('iterationIndicator').style.display = 'flex';\n      \n      processNextStory();\n    }\n    \n    function processNextStory() {\n      if (loopState.status !== 'running') return;\n      \n      const pendingStories = stories.filter(s => \n        !loopState.completedStories.includes(s.id) && \n        !loopState.failedStories.includes(s.id)\n      ).sort((a, b) => a.priority - b.priority);\n      \n      if (pendingStories.length === 0) {\n        completeLoop();\n        return;\n      }\n      \n      const currentStory = pendingStories[0];\n      loopState.currentStoryId = currentStory.id;\n      loopState.currentIteration++;\n      \n      document.getElementById('iterationText').textContent = \n        'Working on iteration ' + loopState.currentIteration + '...';\n      \n      showCurrentStory(currentStory);\n      addLog('Starting: ' + currentStory.title, 'info');\n      renderStories();\n      updateProgress();\n      \n      // Simulate work (3-8 seconds per story)\n      const workTime = 3000 + Math.random() * 5000;\n      simulationInterval = setTimeout(() => {\n        if (loopState.status !== 'running') return;\n        \n        // 85% success rate simulation\n        const success = Math.random() > 0.15;\n        \n        if (success) {\n          loopState.completedStories.push(currentStory.id);\n          currentStory.attempts++;\n          addLog('Completed: ' + currentStory.title, 'success');\n        } else {\n          currentStory.attempts++;\n          if (currentStory.attempts >= 3) {\n            loopState.failedStories.push(currentStory.id);\n            addLog('Failed (max attempts): ' + currentStory.title, 'error');\n          } else {\n            addLog('Retrying: ' + currentStory.title + ' (attempt ' + currentStory.attempts + ')', 'error');\n          }\n        }\n        \n        renderStories();\n        updateProgress();\n        \n        // Small delay before next story\n        setTimeout(() => processNextStory(), 500);\n      }, workTime);\n    }\n    \n    function showCurrentStory(story) {\n      const panel = document.getElementById('currentStoryPanel');\n      panel.style.display = 'block';\n      document.getElementById('currentStoryTitle').textContent = story.title;\n      \n      const criteriaHtml = story.acceptanceCriteria.map(c => `\n        <div class=\"criteria-item\">\n          <div class=\"criteria-check\"></div>\n          <span>${escapeHtml(c)}</span>\n        </div>\n      `).join('');\n      \n      document.getElementById('currentCriteria').innerHTML = criteriaHtml || \n        '<span style=\"color: var(--text-muted); font-size: 13px;\">No acceptance criteria defined</span>';\n    }\n    \n    function pauseLoop() {\n      loopState.status = 'paused';\n      clearTimeout(simulationInterval);\n      addLog('Loop paused', 'info');\n      updateStatus();\n    }\n    \n    function resumeLoop() {\n      loopState.status = 'running';\n      addLog('Loop resumed', 'success');\n      updateStatus();\n      processNextStory();\n    }\n    \n    function stopLoop() {\n      loopState.status = 'stopped';\n      loopState.currentStoryId = null;\n      clearTimeout(simulationInterval);\n      clearInterval(timerInterval);\n      \n      document.getElementById('iterationIndicator').style.display = 'none';\n      document.getElementById('currentStoryPanel').style.display = 'none';\n      \n      addLog('Loop stopped by user', 'error');\n      renderStories();\n      updateStatus();\n    }\n    \n    function completeLoop() {\n      loopState.status = 'completed';\n      loopState.currentStoryId = null;\n      clearInterval(timerInterval);\n      \n      document.getElementById('iterationIndicator').style.display = 'none';\n      document.getElementById('currentStoryPanel').style.display = 'none';\n      \n      const completed = loopState.completedStories.length;\n      const failed = loopState.failedStories.length;\n      addLog(`Loop completed: ${completed} succeeded, ${failed} failed`, 'success');\n      \n      renderStories();\n      updateProgress();\n      updateStatus();\n    }\n    \n    // Initialize with sample stories\n    function loadSampleStories() {\n      stories = [\n        {\n          id: generateId(),\n          title: 'Create user authentication system',\n          description: 'Implement JWT-based authentication with login/logout flows',\n          priority: 1,\n          acceptanceCriteria: [\n            'Login endpoint returns JWT on valid credentials',\n            'Protected routes require valid token',\n            'Refresh token mechanism works'\n          ],\n          status: 'pending',\n          attempts: 0\n        },\n        {\n          id: generateId(),\n          title: 'Build dashboard layout',\n          description: 'Create responsive dashboard with sidebar navigation',\n          priority: 2,\n          acceptanceCriteria: [\n            'Sidebar collapses on mobile',\n            'Navigation links work correctly',\n            'Dark mode support'\n          ],\n          status: 'pending',\n          attempts: 0\n        },\n        {\n          id: generateId(),\n          title: 'Add unit tests for API routes',\n          description: 'Write comprehensive tests for all REST endpoints',\n          priority: 3,\n          acceptanceCriteria: [\n            'Coverage above 80%',\n            'All edge cases tested',\n            'CI pipeline passes'\n          ],\n          status: 'pending',\n          attempts: 0\n        }\n      ];\n      \n      renderStories();\n      updateProgress();\n      updateStatus();\n      addLog('Sample stories loaded', 'info');\n    }\n    \n    // Initialize\n    loadSampleStories();\n  </script>\n</body>\n</html>",
    "css": "",
    "js": ""
  },
  "permissions": {
    "allowNetwork": false,
    "allowStorage": false,
    "allowClipboard": false
  }
}
