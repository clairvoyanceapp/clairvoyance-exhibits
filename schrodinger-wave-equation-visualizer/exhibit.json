  "content": {
    "type": "html",
    "bundle": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Schrodinger Wave Equation Visualizer</title>\n  <style>\n    :root {\n      --bg: #08111f;\n      --bg-soft: #101d33;\n      --panel: rgba(10, 18, 34, 0.78);\n      --panel-border: rgba(165, 191, 255, 0.14);\n      --text: #eff6ff;\n      --muted: #9eb2d8;\n      --accent: #64f0d0;\n      --accent-2: #7aa8ff;\n      --accent-3: #ffc36b;\n      --danger: #ff7f95;\n      --shadow: 0 24px 60px rgba(0, 0, 0, 0.34);\n    }\n\n    * {\n      box-sizing: border-box;\n    }\n\n    html, body {\n      margin: 0;\n      min-height: 100%;\n      background:\n        radial-gradient(circle at top left, rgba(100, 240, 208, 0.12), transparent 34%),\n        radial-gradient(circle at 85% 20%, rgba(122, 168, 255, 0.15), transparent 24%),\n        linear-gradient(160deg, #07101d 0%, #08111f 48%, #0b1730 100%);\n      color: var(--text);\n      font-family: \"Segoe UI\", \"Helvetica Neue\", Arial, sans-serif;\n    }\n\n    body {\n      padding: 24px;\n    }\n\n    .shell {\n      max-width: 1380px;\n      margin: 0 auto;\n      display: grid;\n      gap: 18px;\n    }\n\n    .hero,\n    .content {\n      display: grid;\n      gap: 18px;\n    }\n\n    .hero {\n      grid-template-columns: 1.4fr 0.9fr;\n    }\n\n    .content {\n      grid-template-columns: 1.5fr 0.8fr;\n      align-items: start;\n    }\n\n    .panel {\n      background: var(--panel);\n      border: 1px solid var(--panel-border);\n      border-radius: 24px;\n      box-shadow: var(--shadow);\n      backdrop-filter: blur(18px);\n      overflow: hidden;\n    }\n\n    .headline {\n      padding: 28px 30px;\n      position: relative;\n    }\n\n    .eyebrow {\n      text-transform: uppercase;\n      letter-spacing: 0.18em;\n      font-size: 11px;\n      color: var(--accent);\n      margin-bottom: 12px;\n    }\n\n    h1 {\n      margin: 0 0 14px;\n      font-size: clamp(34px, 4vw, 58px);\n      line-height: 0.96;\n      max-width: 12ch;\n    }\n\n    .summary {\n      margin: 0;\n      max-width: 58ch;\n      color: var(--muted);\n      line-height: 1.6;\n      font-size: 15px;\n    }\n\n    .status {\n      padding: 26px;\n      display: grid;\n      gap: 14px;\n    }\n\n    .status-card {\n      padding: 18px 18px 16px;\n      border-radius: 18px;\n      background: linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.02));\n      border: 1px solid rgba(255, 255, 255, 0.06);\n    }\n\n    .status-card strong {\n      display: block;\n      font-size: 22px;\n      margin-bottom: 6px;\n    }\n\n    .status-card span,\n    .status-card p {\n      margin: 0;\n      color: var(--muted);\n      line-height: 1.55;\n      font-size: 14px;\n    }\n\n    .viz-panel {\n      padding: 18px;\n    }\n\n    .panel-title {\n      margin: 0 0 12px;\n      font-size: 13px;\n      letter-spacing: 0.14em;\n      text-transform: uppercase;\n      color: var(--muted);\n    }\n\n    canvas {\n      width: 100%;\n      display: block;\n      border-radius: 18px;\n      background:\n        linear-gradient(180deg, rgba(15, 28, 48, 0.9), rgba(6, 14, 24, 0.95)),\n        radial-gradient(circle at 20% 20%, rgba(100, 240, 208, 0.06), transparent 28%);\n      border: 1px solid rgba(255, 255, 255, 0.06);\n    }\n\n    .control-panel,\n    .info-panel {\n      padding: 20px;\n      display: grid;\n      gap: 16px;\n    }\n\n    .toolbar {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 10px;\n    }\n\n    button,\n    select {\n      border: 1px solid rgba(255, 255, 255, 0.08);\n      border-radius: 999px;\n      padding: 10px 14px;\n      background: rgba(255, 255, 255, 0.05);\n      color: var(--text);\n      font: inherit;\n    }\n\n    button {\n      cursor: pointer;\n      transition: transform 140ms ease, background 140ms ease, border-color 140ms ease;\n    }\n\n    button:hover,\n    select:hover {\n      background: rgba(255, 255, 255, 0.1);\n      border-color: rgba(255, 255, 255, 0.18);\n    }\n\n    button:active {\n      transform: translateY(1px);\n    }\n\n    .primary {\n      background: linear-gradient(135deg, rgba(100, 240, 208, 0.22), rgba(122, 168, 255, 0.22));\n      border-color: rgba(100, 240, 208, 0.28);\n    }\n\n    .controls-grid {\n      display: grid;\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n      gap: 12px 16px;\n    }\n\n    .control {\n      display: grid;\n      gap: 7px;\n    }\n\n    .control label {\n      font-size: 13px;\n      color: var(--muted);\n      display: flex;\n      justify-content: space-between;\n      gap: 10px;\n    }\n\n    input[type=\"range\"] {\n      width: 100%;\n      accent-color: var(--accent);\n    }\n\n    .legend {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 10px;\n    }\n\n    .chip {\n      display: inline-flex;\n      align-items: center;\n      gap: 8px;\n      padding: 6px 10px;\n      border-radius: 999px;\n      font-size: 12px;\n      color: var(--muted);\n      background: rgba(255, 255, 255, 0.05);\n    }\n\n    .dot {\n      width: 9px;\n      height: 9px;\n      border-radius: 50%;\n      display: inline-block;\n    }\n\n    .stats {\n      display: grid;\n      grid-template-columns: repeat(3, minmax(0, 1fr));\n      gap: 10px;\n    }\n\n    .metric {\n      padding: 14px;\n      border-radius: 18px;\n      background: rgba(255, 255, 255, 0.03);\n      border: 1px solid rgba(255, 255, 255, 0.05);\n    }\n\n    .metric strong {\n      display: block;\n      margin-bottom: 4px;\n      font-size: 22px;\n    }\n\n    .metric span {\n      color: var(--muted);\n      font-size: 12px;\n      line-height: 1.4;\n    }\n\n    .equation {\n      padding: 16px 18px;\n      border-radius: 18px;\n      background: linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.02));\n      border: 1px solid rgba(255, 255, 255, 0.05);\n      font-size: 18px;\n      color: #d7e6ff;\n      letter-spacing: 0.03em;\n      overflow-x: auto;\n      white-space: nowrap;\n    }\n\n    .notes {\n      display: grid;\n      gap: 12px;\n    }\n\n    .note {\n      padding: 14px 16px;\n      border-radius: 18px;\n      background: rgba(255, 255, 255, 0.03);\n      border: 1px solid rgba(255, 255, 255, 0.05);\n    }\n\n    .note strong {\n      display: block;\n      margin-bottom: 5px;\n      font-size: 15px;\n    }\n\n    .note span {\n      color: var(--muted);\n      line-height: 1.55;\n      font-size: 13px;\n    }\n\n    .footer {\n      padding: 16px 20px;\n      color: var(--muted);\n      font-size: 13px;\n      line-height: 1.6;\n    }\n\n    @media (max-width: 1120px) {\n      .hero,\n      .content {\n        grid-template-columns: 1fr;\n      }\n    }\n\n    @media (max-width: 760px) {\n      body {\n        padding: 14px;\n      }\n\n      .controls-grid,\n      .stats {\n        grid-template-columns: 1fr;\n      }\n\n      h1 {\n        max-width: none;\n      }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"shell\">\n    <section class=\"hero\">\n      <div class=\"panel headline\">\n        <div class=\"eyebrow\">Quantum Playground</div>\n        <h1>Schrodinger Wave Equation</h1>\n        <p class=\"summary\">\n          A one-dimensional wavepacket evolving under the time-dependent Schrödinger equation.\n          The cyan curve is probability density, the blue and gold curves are the real and imaginary\n          parts of the wavefunction, and the coral outline is the potential landscape trying to\n          impose its opinion on the whole affair.\n        </p>\n      </div>\n      <aside class=\"panel status\">\n        <div class=\"status-card\">\n          <strong id=\"status-headline\">Free packet in motion</strong>\n          <span id=\"status-detail\">The wavepacket is translating and spreading in a flat potential, which is quantum mechanics' version of “left alone, things get interesting anyway.”</span>\n        </div>\n        <div class=\"status-card\">\n          <strong id=\"norm-value\">Norm 1.0000</strong>\n          <p id=\"status-subdetail\">The numerical solver renormalizes gently to keep probability from leaking into the carpet.</p>\n        </div>\n      </aside>\n    </section>\n\n    <section class=\"content\">\n      <div class=\"panel viz-panel\">\n        <div class=\"panel-title\">Wavefunction View</div>\n        <canvas id=\"waveCanvas\" width=\"920\" height=\"500\" aria-label=\"Schrodinger wave equation visualization\"></canvas>\n        <div class=\"legend\" style=\"margin-top: 14px;\">\n          <span class=\"chip\"><span class=\"dot\" style=\"background: #64f0d0\"></span>|ψ|² probability density</span>\n          <span class=\"chip\"><span class=\"dot\" style=\"background: #7aa8ff\"></span>Re(ψ)</span>\n          <span class=\"chip\"><span class=\"dot\" style=\"background: #ffc36b\"></span>Im(ψ)</span>\n          <span class=\"chip\"><span class=\"dot\" style=\"background: #ff8d8d\"></span>Potential V(x)</span>\n        </div>\n      </div>\n\n      <div class=\"panel control-panel\">\n        <div class=\"panel-title\">Controls</div>\n        <div class=\"toolbar\">\n          <button class=\"primary\" id=\"toggleBtn\">Pause</button>\n          <button id=\"resetBtn\">Reset Packet</button>\n          <select id=\"presetSelect\" aria-label=\"Potential preset\">\n            <option value=\"free\">Free Particle</option>\n            <option value=\"barrier\">Barrier Tunnel</option>\n            <option value=\"well\">Finite Well</option>\n            <option value=\"oscillator\">Harmonic Oscillator</option>\n            <option value=\"double-slit\">Double Barrier</option>\n          </select>\n        </div>\n\n        <div class=\"controls-grid\">\n          <div class=\"control\">\n            <label for=\"widthRange\"><span>Packet Width σ</span><strong id=\"widthValue\">0.85</strong></label>\n            <input id=\"widthRange\" type=\"range\" min=\"0.35\" max=\"1.75\" step=\"0.01\" value=\"0.85\">\n          </div>\n          <div class=\"control\">\n            <label for=\"momentumRange\"><span>Momentum k₀</span><strong id=\"momentumValue\">5.4</strong></label>\n            <input id=\"momentumRange\" type=\"range\" min=\"-10\" max=\"10\" step=\"0.1\" value=\"5.4\">\n          </div>\n          <div class=\"control\">\n            <label for=\"positionRange\"><span>Initial Center x₀</span><strong id=\"positionValue\">-3.6</strong></label>\n            <input id=\"positionRange\" type=\"range\" min=\"-7.5\" max=\"7.5\" step=\"0.1\" value=\"-3.6\">\n          </div>\n          <div class=\"control\">\n            <label for=\"heightRange\"><span>Potential Height</span><strong id=\"heightValue\">1.80</strong></label>\n            <input id=\"heightRange\" type=\"range\" min=\"0.2\" max=\"4.0\" step=\"0.05\" value=\"1.8\">\n          </div>\n          <div class=\"control\">\n            <label for=\"dtRange\"><span>Time Step</span><strong id=\"dtValue\">0.0040</strong></label>\n            <input id=\"dtRange\" type=\"range\" min=\"0.001\" max=\"0.012\" step=\"0.0005\" value=\"0.004\">\n          </div>\n          <div class=\"control\">\n            <label for=\"speedRange\"><span>Steps / Frame</span><strong id=\"speedValue\">2</strong></label>\n            <input id=\"speedRange\" type=\"range\" min=\"1\" max=\"6\" step=\"1\" value=\"2\">\n          </div>\n        </div>\n\n        <div class=\"stats\">\n          <div class=\"metric\">\n            <strong id=\"timeMetric\">0.000</strong>\n            <span>Time t</span>\n          </div>\n          <div class=\"metric\">\n            <strong id=\"energyMetric\">0.000</strong>\n            <span>Approx. energy expectation</span>\n          </div>\n          <div class=\"metric\">\n            <strong id=\"centerMetric\">0.000</strong>\n            <span>Packet center ⟨x⟩</span>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"content\">\n      <div class=\"panel info-panel\">\n        <div class=\"panel-title\">Equation</div>\n        <div class=\"equation\">\n          i ħ ∂ψ/∂t = - (ħ² / 2m) ∂²ψ/∂x² + V(x) ψ\n        </div>\n        <div class=\"notes\">\n          <div class=\"note\">\n            <strong>What you are seeing</strong>\n            <span>The solver discretizes space, evolves ψ(x, t) with a fourth-order Runge-Kutta step, and rescales lightly so the integrated probability stays at 1.</span>\n          </div>\n          <div class=\"note\">\n            <strong>How to read the curves</strong>\n            <span>Probability density shows where the particle is likely to be measured. Real and imaginary parts oscillate underneath; together they are the actual state, not decorative bureaucracy.</span>\n          </div>\n          <div class=\"note\">\n            <strong>Presets worth trying</strong>\n            <span>Use <em>Barrier Tunnel</em> for partial reflection and transmission, <em>Finite Well</em> for confinement, and <em>Harmonic Oscillator</em> to watch the packet slosh like a civilized quantum pendulum.</span>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"panel footer\">\n        This is an educational visualization, not a production-grade physics engine. It aims to make the structure of the time-dependent Schrödinger equation legible without requiring the user to develop a personal relationship with a numerical methods textbook.\n      </div>\n    </section>\n  </div>\n\n  <script>\n    const canvas = document.getElementById(\"waveCanvas\");\n    const ctx = canvas.getContext(\"2d\");\n\n    const toggleBtn = document.getElementById(\"toggleBtn\");\n    const resetBtn = document.getElementById(\"resetBtn\");\n    const presetSelect = document.getElementById(\"presetSelect\");\n    const widthRange = document.getElementById(\"widthRange\");\n    const momentumRange = document.getElementById(\"momentumRange\");\n    const positionRange = document.getElementById(\"positionRange\");\n    const heightRange = document.getElementById(\"heightRange\");\n    const dtRange = document.getElementById(\"dtRange\");\n    const speedRange = document.getElementById(\"speedRange\");\n\n    const labels = {\n      widthValue: document.getElementById(\"widthValue\"),\n      momentumValue: document.getElementById(\"momentumValue\"),\n      positionValue: document.getElementById(\"positionValue\"),\n      heightValue: document.getElementById(\"heightValue\"),\n      dtValue: document.getElementById(\"dtValue\"),\n      speedValue: document.getElementById(\"speedValue\"),\n      statusHeadline: document.getElementById(\"status-headline\"),\n      statusDetail: document.getElementById(\"status-detail\"),\n      normValue: document.getElementById(\"norm-value\"),\n      statusSubdetail: document.getElementById(\"status-subdetail\"),\n      timeMetric: document.getElementById(\"timeMetric\"),\n      energyMetric: document.getElementById(\"energyMetric\"),\n      centerMetric: document.getElementById(\"centerMetric\")\n    };\n\n    const N = 256;\n    const xMin = -10;\n    const xMax = 10;\n    const dx = (xMax - xMin) / (N - 1);\n    const hbar = 1;\n    const mass = 1;\n\n    const x = new Float64Array(N);\n    for (let i = 0; i < N; i += 1) {\n      x[i] = xMin + i * dx;\n    }\n\n    let psiRe = new Float64Array(N);\n    let psiIm = new Float64Array(N);\n    let potential = new Float64Array(N);\n    let running = true;\n    let elapsed = 0;\n\n    const state = {\n      width: parseFloat(widthRange.value),\n      momentum: parseFloat(momentumRange.value),\n      position: parseFloat(positionRange.value),\n      height: parseFloat(heightRange.value),\n      dt: parseFloat(dtRange.value),\n      stepsPerFrame: parseInt(speedRange.value, 10),\n      preset: presetSelect.value\n    };\n\n    const presetDescriptions = {\n      free: {\n        headline: \"Free packet in motion\",\n        detail: \"The wavepacket is translating and spreading in a flat potential, which is quantum mechanics' version of “left alone, things get interesting anyway.”\"\n      },\n      barrier: {\n        headline: \"Tunneling through a barrier\",\n        detail: \"Part of the packet reflects, part tunnels through. Classical intuition objects loudly, which is why this topic keeps getting invited back.\"\n      },\n      well: {\n        headline: \"Finite quantum well\",\n        detail: \"The packet feels a confining dip in the potential and ricochets inside it, leaking only if you let the walls stop taking the job seriously.\"\n      },\n      oscillator: {\n        headline: \"Harmonic oscillator\",\n        detail: \"A quadratic potential pulls the packet back toward center, creating a smooth oscillation that looks suspiciously elegant for quantum mechanics.\"\n      },\n      \"double-slit\": {\n        headline: \"Double barrier interference\",\n        detail: \"Two narrow barriers create internal reflections and richer interference. Nature remains extremely committed to not taking the shortest explanatory route.\"\n      }\n    };\n\n    function updateControlLabels() {\n      labels.widthValue.textContent = state.width.toFixed(2);\n      labels.momentumValue.textContent = state.momentum.toFixed(1);\n      labels.positionValue.textContent = state.position.toFixed(1);\n      labels.heightValue.textContent = state.height.toFixed(2);\n      labels.dtValue.textContent = state.dt.toFixed(4);\n      labels.speedValue.textContent = String(state.stepsPerFrame);\n    }\n\n    function syncStatusText() {\n      const presetInfo = presetDescriptions[state.preset];\n      labels.statusHeadline.textContent = presetInfo.headline;\n      labels.statusDetail.textContent = presetInfo.detail;\n    }\n\n    function buildPotential() {\n      for (let i = 0; i < N; i += 1) {\n        const xi = x[i];\n        let value = 0;\n\n        if (state.preset === \"barrier\") {\n          value = Math.abs(xi) < 0.75 ? state.height : 0;\n        } else if (state.preset === \"well\") {\n          value = Math.abs(xi) < 2.8 ? -0.65 * state.height : 0.2 * state.height;\n        } else if (state.preset === \"oscillator\") {\n          value = 0.08 * state.height * xi * xi;\n        } else if (state.preset === \"double-slit\") {\n          const leftBarrier = Math.abs(xi + 1.4) < 0.34;\n          const rightBarrier = Math.abs(xi - 1.4) < 0.34;\n          value = leftBarrier || rightBarrier ? state.height : 0;\n        }\n\n        potential[i] = value;\n      }\n    }\n\n    function initializeWavePacket() {\n      buildPotential();\n      elapsed = 0;\n      const sigma = state.width;\n      const k0 = state.momentum;\n      const x0 = state.position;\n\n      for (let i = 0; i < N; i += 1) {\n        const displacement = x[i] - x0;\n        const envelope = Math.exp(-(displacement * displacement) / (2 * sigma * sigma));\n        const phase = k0 * displacement;\n        psiRe[i] = envelope * Math.cos(phase);\n        psiIm[i] = envelope * Math.sin(phase);\n      }\n\n      normalizeWave();\n      updateMetrics();\n    }\n\n    function normalizeWave() {\n      let sum = 0;\n      for (let i = 0; i < N; i += 1) {\n        sum += (psiRe[i] * psiRe[i] + psiIm[i] * psiIm[i]) * dx;\n      }\n      const factor = sum > 0 ? 1 / Math.sqrt(sum) : 1;\n      for (let i = 0; i < N; i += 1) {\n        psiRe[i] *= factor;\n        psiIm[i] *= factor;\n      }\n    }\n\n    function computeDerivatives(re, im) {\n      const dRe = new Float64Array(N);\n      const dIm = new Float64Array(N);\n      const invDx2 = 1 / (dx * dx);\n\n      for (let i = 1; i < N - 1; i += 1) {\n        const lapRe = (re[i + 1] - 2 * re[i] + re[i - 1]) * invDx2;\n        const lapIm = (im[i + 1] - 2 * im[i] + im[i - 1]) * invDx2;\n        dRe[i] = -( -0.5 * lapIm + potential[i] * im[i] );\n        dIm[i] = ( -0.5 * lapRe + potential[i] * re[i] );\n      }\n\n      dRe[0] = dRe[N - 1] = 0;\n      dIm[0] = dIm[N - 1] = 0;\n      return { dRe, dIm };\n    }\n\n    function rk4Step(dt) {\n      const k1 = computeDerivatives(psiRe, psiIm);\n\n      const re2 = new Float64Array(N);\n      const im2 = new Float64Array(N);\n      for (let i = 0; i < N; i += 1) {\n        re2[i] = psiRe[i] + 0.5 * dt * k1.dRe[i];\n        im2[i] = psiIm[i] + 0.5 * dt * k1.dIm[i];\n      }\n\n      const k2 = computeDerivatives(re2, im2);\n      const re3 = new Float64Array(N);\n      const im3 = new Float64Array(N);\n      for (let i = 0; i < N; i += 1) {\n        re3[i] = psiRe[i] + 0.5 * dt * k2.dRe[i];\n        im3[i] = psiIm[i] + 0.5 * dt * k2.dIm[i];\n      }\n\n      const k3 = computeDerivatives(re3, im3);\n      const re4 = new Float64Array(N);\n      const im4 = new Float64Array(N);\n      for (let i = 0; i < N; i += 1) {\n        re4[i] = psiRe[i] + dt * k3.dRe[i];\n        im4[i] = psiIm[i] + dt * k3.dIm[i];\n      }\n\n      const k4 = computeDerivatives(re4, im4);\n\n      for (let i = 0; i < N; i += 1) {\n        psiRe[i] += (dt / 6) * (k1.dRe[i] + 2 * k2.dRe[i] + 2 * k3.dRe[i] + k4.dRe[i]);\n        psiIm[i] += (dt / 6) * (k1.dIm[i] + 2 * k2.dIm[i] + 2 * k3.dIm[i] + k4.dIm[i]);\n      }\n\n      psiRe[0] = psiIm[0] = 0;\n      psiRe[N - 1] = psiIm[N - 1] = 0;\n      normalizeWave();\n      elapsed += dt;\n    }\n\n    function computeObservables() {\n      let norm = 0;\n      let center = 0;\n      let energy = 0;\n      const invDx2 = 1 / (dx * dx);\n\n      for (let i = 0; i < N; i += 1) {\n        const prob = psiRe[i] * psiRe[i] + psiIm[i] * psiIm[i];\n        norm += prob * dx;\n        center += x[i] * prob * dx;\n      }\n\n      for (let i = 1; i < N - 1; i += 1) {\n        const lapRe = (psiRe[i + 1] - 2 * psiRe[i] + psiRe[i - 1]) * invDx2;\n        const lapIm = (psiIm[i + 1] - 2 * psiIm[i] + psiIm[i - 1]) * invDx2;\n        const kinetic = -0.5 * (psiRe[i] * lapRe + psiIm[i] * lapIm);\n        const potentialEnergy = potential[i] * (psiRe[i] * psiRe[i] + psiIm[i] * psiIm[i]);\n        energy += (kinetic + potentialEnergy) * dx;\n      }\n\n      return { norm, center, energy };\n    }\n\n    function updateMetrics() {\n      const { norm, center, energy } = computeObservables();\n      labels.normValue.textContent = `Norm ${norm.toFixed(4)}`;\n      labels.statusSubdetail.textContent = `Current preset: ${presetSelect.options[presetSelect.selectedIndex].text}. The domain is finite, the numerics are honest, and the packet remains normalized.`;\n      labels.timeMetric.textContent = elapsed.toFixed(3);\n      labels.energyMetric.textContent = energy.toFixed(3);\n      labels.centerMetric.textContent = center.toFixed(3);\n    }\n\n    function drawCurve(values, scale, offsetY, color, lineWidth) {\n      ctx.beginPath();\n      for (let i = 0; i < N; i += 1) {\n        const px = (i / (N - 1)) * canvas.width;\n        const py = offsetY - values[i] * scale;\n        if (i === 0) {\n          ctx.moveTo(px, py);\n        } else {\n          ctx.lineTo(px, py);\n        }\n      }\n      ctx.strokeStyle = color;\n      ctx.lineWidth = lineWidth;\n      ctx.stroke();\n    }\n\n    function fillProbability(probabilities, scale, offsetY) {\n      ctx.beginPath();\n      ctx.moveTo(0, offsetY);\n      for (let i = 0; i < N; i += 1) {\n        const px = (i / (N - 1)) * canvas.width;\n        const py = offsetY - probabilities[i] * scale;\n        ctx.lineTo(px, py);\n      }\n      ctx.lineTo(canvas.width, offsetY);\n      ctx.closePath();\n      const gradient = ctx.createLinearGradient(0, 0, 0, canvas.height);\n      gradient.addColorStop(0, \"rgba(100, 240, 208, 0.45)\");\n      gradient.addColorStop(1, \"rgba(100, 240, 208, 0.03)\");\n      ctx.fillStyle = gradient;\n      ctx.fill();\n    }\n\n    function drawGrid(offsetY, height) {\n      ctx.save();\n      ctx.strokeStyle = \"rgba(255,255,255,0.08)\";\n      ctx.lineWidth = 1;\n      for (let i = 0; i <= 8; i += 1) {\n        const y = offsetY - height / 2 + (height / 8) * i;\n        ctx.beginPath();\n        ctx.moveTo(0, y);\n        ctx.lineTo(canvas.width, y);\n        ctx.stroke();\n      }\n      for (let i = 0; i <= 10; i += 1) {\n        const xLine = (canvas.width / 10) * i;\n        ctx.beginPath();\n        ctx.moveTo(xLine, offsetY - height / 2);\n        ctx.lineTo(xLine, offsetY + height / 2);\n        ctx.stroke();\n      }\n      ctx.restore();\n    }\n\n    function render() {\n      ctx.clearRect(0, 0, canvas.width, canvas.height);\n\n      const topOffset = canvas.height * 0.34;\n      const bottomOffset = canvas.height * 0.8;\n      const topHeight = canvas.height * 0.46;\n      const bottomHeight = canvas.height * 0.28;\n\n      drawGrid(topOffset, topHeight);\n      drawGrid(bottomOffset, bottomHeight);\n\n      const probabilities = new Float64Array(N);\n      let maxProb = 0;\n      let maxPotential = 0.0001;\n      let maxAmp = 0.0001;\n\n      for (let i = 0; i < N; i += 1) {\n        const prob = psiRe[i] * psiRe[i] + psiIm[i] * psiIm[i];\n        probabilities[i] = prob;\n        if (prob > maxProb) maxProb = prob;\n        if (Math.abs(potential[i]) > maxPotential) maxPotential = Math.abs(potential[i]);\n        maxAmp = Math.max(maxAmp, Math.abs(psiRe[i]), Math.abs(psiIm[i]));\n      }\n\n      const probScale = topHeight * 0.82 / maxProb;\n      const waveScale = topHeight * 0.33 / maxAmp;\n      const potentialScale = bottomHeight * 0.38 / maxPotential;\n\n      fillProbability(probabilities, probScale, topOffset + topHeight * 0.38);\n      drawCurve(psiRe, waveScale, topOffset + topHeight * 0.18, \"#7aa8ff\", 2.2);\n      drawCurve(psiIm, waveScale, topOffset + topHeight * 0.18, \"#ffc36b\", 2.2);\n      drawCurve(probabilities, probScale, topOffset + topHeight * 0.38, \"#64f0d0\", 3.2);\n      drawCurve(potential, potentialScale, bottomOffset, \"#ff8d8d\", 2.8);\n\n      ctx.fillStyle = \"rgba(239,246,255,0.82)\";\n      ctx.font = \"12px Segoe UI, sans-serif\";\n      ctx.fillText(\"|ψ|²\", 14, 24);\n      ctx.fillText(\"Re(ψ), Im(ψ)\", 14, 40);\n      ctx.fillText(\"V(x)\", 14, bottomOffset - bottomHeight * 0.44);\n      ctx.fillText(\"x\", canvas.width - 20, canvas.height - 14);\n    }\n\n    function tick() {\n      if (running) {\n        for (let i = 0; i < state.stepsPerFrame; i += 1) {\n          rk4Step(state.dt);\n        }\n        updateMetrics();\n      }\n      render();\n      requestAnimationFrame(tick);\n    }\n\n    function readControls() {\n      state.width = parseFloat(widthRange.value);\n      state.momentum = parseFloat(momentumRange.value);\n      state.position = parseFloat(positionRange.value);\n      state.height = parseFloat(heightRange.value);\n      state.dt = parseFloat(dtRange.value);\n      state.stepsPerFrame = parseInt(speedRange.value, 10);\n      state.preset = presetSelect.value;\n      updateControlLabels();\n    }\n\n    function rebuild() {\n      readControls();\n      syncStatusText();\n      initializeWavePacket();\n      render();\n    }\n\n    [widthRange, momentumRange, positionRange, heightRange, dtRange, speedRange].forEach((input) => {\n      input.addEventListener(\"input\", () => {\n        readControls();\n        updateMetrics();\n      });\n      input.addEventListener(\"change\", rebuild);\n    });\n\n    presetSelect.addEventListener(\"change\", rebuild);\n\n    toggleBtn.addEventListener(\"click\", () => {\n      running = !running;\n      toggleBtn.textContent = running ? \"Pause\" : \"Resume\";\n    });\n\n    resetBtn.addEventListener(\"click\", rebuild);\n\n    updateControlLabels();\n    syncStatusText();\n    initializeWavePacket();\n    render();\n    requestAnimationFrame(tick);\n  </script>\n</body>\n</html>\n"
  },
  "permissions": {
    "allowNetwork": false,
    "allowStorage": false,
    "allowClipboard": false
  }
}
