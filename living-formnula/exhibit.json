  "content": {
    "type": "html",
    "html": "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Living Formnula</title>\n<script type=\"importmap\">\n{\n  \"imports\": {\n    \"three\": \"https://unpkg.com/three@0.169.0/build/three.module.min.js\",\n    \"three/addons/\": \"https://unpkg.com/three@0.169.0/examples/jsm/\"\n  }\n}\n</script>\n<style>\n* { margin: 0; padding: 0; box-sizing: border-box; }\nhtml, body { width: 100%; height: 100%; overflow: hidden; background: #050508; }\ncanvas { display: block; }\n#info {\n  position: fixed;\n  bottom: 16px;\n  left: 50%;\n  transform: translateX(-50%);\n  color: rgba(255,255,255,0.35);\n  font-family: 'Courier New', monospace;\n  font-size: 11px;\n  text-align: center;\n  pointer-events: none;\n  letter-spacing: 1px;\n}\n#controls {\n  position: fixed;\n  top: 16px;\n  right: 16px;\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  z-index: 10;\n}\n.btn {\n  background: rgba(255,255,255,0.06);\n  border: 1px solid rgba(255,255,255,0.12);\n  color: rgba(255,255,255,0.6);\n  padding: 6px 14px;\n  border-radius: 6px;\n  cursor: pointer;\n  font-family: 'Courier New', monospace;\n  font-size: 11px;\n  transition: all 0.3s;\n}\n.btn:hover {\n  background: rgba(255,255,255,0.12);\n  color: rgba(255,255,255,0.9);\n}\n.btn.active {\n  background: rgba(120,80,255,0.2);\n  border-color: rgba(120,80,255,0.5);\n  color: rgba(200,180,255,0.9);\n}\n</style>\n</head>\n<body>\n<div id=\"controls\">\n  <button class=\"btn\" id=\"btnPalette\">palette</button>\n  <button class=\"btn\" id=\"btnTrails\">trails</button>\n  <button class=\"btn\" id=\"btnPause\">pause</button>\n</div>\n<div id=\"info\">a=(θ,d)=&gt;point(q·sin(c)+200, (q+40)·cos(c)+190) — @yuruyurau</div>\n<script type=\"module\">\nimport * as THREE from 'three';\n\nconsole.log('Three.js loaded, revision:', THREE.REVISION);\n\nconst PI = Math.PI;\nconst TOTAL_POINTS = 20000;\nconst PASSES = 2;\nconst PARTICLE_COUNT = TOTAL_POINTS * PASSES;\n\nlet t = 0;\nlet paused = false;\nlet trailMode = true;\nlet paletteIndex = 0;\n\nconst paletteNames = ['cosmic', 'fire', 'ocean', 'aurora', 'mono'];\n\n// Renderer\nconst renderer = new THREE.WebGLRenderer({ antialias: false, alpha: false });\nrenderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));\nrenderer.setSize(window.innerWidth, window.innerHeight);\nrenderer.setClearColor(0x050508, 1);\nrenderer.autoClear = false;\ndocument.body.prepend(renderer.domElement);\n\n// Scene and camera (orthographic to match 2D layout)\nconst scene = new THREE.Scene();\nconst W = window.innerWidth;\nconst H = window.innerHeight;\nconst camera = new THREE.OrthographicCamera(0, W, 0, H, -1, 1);\n\n// Trail fade: a fullscreen quad with low-opacity black\nconst fadeScene = new THREE.Scene();\nconst fadeCam = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);\nconst fadeMat = new THREE.MeshBasicMaterial({\n  color: 0x050508,\n  transparent: true,\n  opacity: 0.08,\n  depthTest: false,\n  depthWrite: false\n});\nconst fadeQuad = new THREE.Mesh(new THREE.PlaneGeometry(2, 2), fadeMat);\nfadeScene.add(fadeQuad);\n\n// Particle geometry\nconst positions = new Float32Array(PARTICLE_COUNT * 3);\nconst colors = new Float32Array(PARTICLE_COUNT * 3);\nconst alphas = new Float32Array(PARTICLE_COUNT);\n\nconst geometry = new THREE.BufferGeometry();\ngeometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));\ngeometry.setAttribute('aColor', new THREE.BufferAttribute(colors, 3));\ngeometry.setAttribute('aAlpha', new THREE.BufferAttribute(alphas, 1));\n\nconst material = new THREE.ShaderMaterial({\n  transparent: true,\n  depthTest: false,\n  depthWrite: false,\n  vertexShader: `\n    attribute vec3 aColor;\n    attribute float aAlpha;\n    varying vec3 vColor;\n    varying float vAlpha;\n    uniform float uSize;\n    void main() {\n      vColor = aColor;\n      vAlpha = aAlpha;\n      gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);\n      gl_PointSize = uSize;\n    }\n  `,\n  fragmentShader: `\n    varying vec3 vColor;\n    varying float vAlpha;\n    void main() {\n      gl_FragColor = vec4(vColor, vAlpha);\n    }\n  `,\n  uniforms: {\n    uSize: { value: 1.5 * Math.min(window.devicePixelRatio, 2) }\n  }\n});\n\nconst points = new THREE.Points(geometry, material);\nscene.add(points);\n\n// Palette functions (return [r, g, b] in 0-1 range)\nfunction paletteCosmic(frac) {\n  const r = (80 + 120 * Math.sin(frac * PI * 2)) / 255;\n  const g = (40 + 80 * Math.sin(frac * PI * 2 + 2)) / 255;\n  const b = (180 + 75 * Math.sin(frac * PI * 2 + 4)) / 255;\n  return [r, g, b];\n}\nfunction paletteFire(frac) {\n  const r = (200 + 55 * Math.sin(frac * PI * 2)) / 255;\n  const g = (60 + 120 * Math.sin(frac * PI * 2 + 1)) / 255;\n  const b = (10 + 40 * Math.sin(frac * PI * 2 + 3)) / 255;\n  return [r, g, b];\n}\nfunction paletteOcean(frac) {\n  const r = (20 + 60 * Math.sin(frac * PI * 2 + 4)) / 255;\n  const g = (120 + 100 * Math.sin(frac * PI * 2 + 1)) / 255;\n  const b = (180 + 75 * Math.sin(frac * PI * 2)) / 255;\n  return [r, g, b];\n}\nfunction paletteAurora(frac) {\n  const r = (30 + 100 * Math.sin(frac * PI * 2 + 2)) / 255;\n  const g = (180 + 75 * Math.sin(frac * PI * 2)) / 255;\n  const b = (100 + 120 * Math.sin(frac * PI * 2 + 3.5)) / 255;\n  return [r, g, b];\n}\nfunction paletteMono(frac) {\n  const v = (160 + 95 * Math.sin(frac * PI * 2)) / 255;\n  return [v, v, v];\n}\nconst palettes = [paletteCosmic, paletteFire, paletteOcean, paletteAurora, paletteMono];\n\nfunction mag(a, b) {\n  return Math.sqrt(a * a + b * b);\n}\n\nfunction updateParticles() {\n  const cx = window.innerWidth / 2;\n  const cy = window.innerHeight / 2;\n  const sc = Math.min(window.innerWidth, window.innerHeight) / 400;\n  const getPalette = palettes[paletteIndex];\n  let idx = 0;\n\n  for (let pass = 0; pass < PASSES; pass++) {\n    for (let i = TOTAL_POINTS; i >= 0; i--) {\n      const y = i / 99;\n      const k = 8 * Math.cos(y);\n      const e = y / 8 - 12;\n      const m = mag(k, e);\n      const d = (m * m * m) / 999 + 1;\n      const innerVal = 8 + 4 * Math.sin(d * d - t + Math.cos(e + t / 2));\n      const q = 79 - e * Math.sin(k) + (k / d) * innerVal;\n      const c = d / 2 + (e / 99) * Math.sin(t + d) - t / 8 + pass * 3;\n\n      const px = (q * Math.sin(c) + 200 - 200) * sc + cx;\n      const py = ((q + 40) * Math.cos(c) + 190 - 200) * sc + cy;\n\n      positions[idx * 3] = px;\n      positions[idx * 3 + 1] = py;\n      positions[idx * 3 + 2] = 0;\n\n      const frac = i / TOTAL_POINTS;\n      const [r, g, b] = getPalette(frac + t * 0.02);\n      colors[idx * 3] = r;\n      colors[idx * 3 + 1] = g;\n      colors[idx * 3 + 2] = b;\n\n      alphas[idx] = 0.15 + 0.25 * (1 - Math.abs(frac - 0.5) * 2);\n      idx++;\n    }\n  }\n\n  geometry.attributes.position.needsUpdate = true;\n  geometry.attributes.aColor.needsUpdate = true;\n  geometry.attributes.aAlpha.needsUpdate = true;\n}\n\nfunction animate() {\n  if (!paused) {\n    t += PI / 45;\n  }\n\n  updateParticles();\n\n  if (trailMode) {\n    // Draw fade quad over previous frame, then draw particles on top\n    renderer.render(fadeScene, fadeCam);\n    renderer.render(scene, camera);\n  } else {\n    renderer.clear();\n    renderer.render(scene, camera);\n  }\n\n  requestAnimationFrame(animate);\n}\n\n// Controls\nconst btnPalette = document.getElementById('btnPalette');\nconst btnTrails = document.getElementById('btnTrails');\nconst btnPause = document.getElementById('btnPause');\n\nbtnTrails.classList.add('active');\n\nbtnPalette.addEventListener('click', () => {\n  paletteIndex = (paletteIndex + 1) % palettes.length;\n  btnPalette.textContent = paletteNames[paletteIndex];\n});\n\nbtnTrails.addEventListener('click', () => {\n  trailMode = !trailMode;\n  btnTrails.classList.toggle('active', trailMode);\n});\n\nbtnPause.addEventListener('click', () => {\n  paused = !paused;\n  btnPause.classList.toggle('active', paused);\n  btnPause.textContent = paused ? 'play' : 'pause';\n});\n\nwindow.addEventListener('resize', () => {\n  const w = window.innerWidth;\n  const h = window.innerHeight;\n  renderer.setSize(w, h);\n  camera.right = w;\n  camera.bottom = h;\n  camera.updateProjectionMatrix();\n  material.uniforms.uSize.value = 1.5 * Math.min(window.devicePixelRatio, 2);\n});\n\nanimate();\n</script>\n</body>\n</html>",
    "css": "",
    "js": ""
  },
