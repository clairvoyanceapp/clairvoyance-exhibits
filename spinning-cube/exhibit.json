  "content": {
    "type": "html",
    "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Spinning Cube</title>\n  <style>\n    * {\n      margin: 0;\n      padding: 0;\n      box-sizing: border-box;\n    }\n\n    body {\n      min-height: 100vh;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      background: linear-gradient(135deg, #0c0c1e 0%, #1a1a3e 50%, #0f0f2d 100%);\n      font-family: 'Segoe UI', system-ui, sans-serif;\n      overflow: hidden;\n    }\n\n    .scene {\n      width: 200px;\n      height: 200px;\n      perspective: 800px;\n      perspective-origin: 50% 50%;\n    }\n\n    .cube {\n      width: 100%;\n      height: 100%;\n      position: relative;\n      transform-style: preserve-3d;\n      animation: spin 8s infinite linear;\n    }\n\n    .cube.paused {\n      animation-play-state: paused;\n    }\n\n    .face {\n      position: absolute;\n      width: 200px;\n      height: 200px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-size: 2rem;\n      font-weight: bold;\n      color: white;\n      text-shadow: 0 2px 10px rgba(0,0,0,0.5);\n      border: 2px solid rgba(255,255,255,0.3);\n      border-radius: 8px;\n      backdrop-filter: blur(5px);\n      box-shadow: \n        inset 0 0 60px rgba(255,255,255,0.1),\n        0 0 30px rgba(0,0,0,0.3);\n    }\n\n    .front {\n      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n      transform: translateZ(100px);\n    }\n\n    .back {\n      background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);\n      transform: rotateY(180deg) translateZ(100px);\n    }\n\n    .right {\n      background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);\n      transform: rotateY(90deg) translateZ(100px);\n    }\n\n    .left {\n      background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);\n      transform: rotateY(-90deg) translateZ(100px);\n    }\n\n    .top {\n      background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);\n      transform: rotateX(90deg) translateZ(100px);\n    }\n\n    .bottom {\n      background: linear-gradient(135deg, #a18cd1 0%, #fbc2eb 100%);\n      transform: rotateX(-90deg) translateZ(100px);\n    }\n\n    @keyframes spin {\n      0% {\n        transform: rotateX(-20deg) rotateY(0deg);\n      }\n      100% {\n        transform: rotateX(-20deg) rotateY(360deg);\n      }\n    }\n\n    .controls {\n      margin-top: 60px;\n      display: flex;\n      gap: 15px;\n      flex-wrap: wrap;\n      justify-content: center;\n    }\n\n    button {\n      padding: 12px 24px;\n      font-size: 1rem;\n      border: none;\n      border-radius: 25px;\n      cursor: pointer;\n      transition: all 0.3s ease;\n      font-weight: 600;\n      text-transform: uppercase;\n      letter-spacing: 1px;\n    }\n\n    .btn-pause {\n      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n      color: white;\n      box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);\n    }\n\n    .btn-pause:hover {\n      transform: translateY(-2px);\n      box-shadow: 0 6px 20px rgba(102, 126, 234, 0.6);\n    }\n\n    .btn-speed {\n      background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);\n      color: white;\n      box-shadow: 0 4px 15px rgba(79, 172, 254, 0.4);\n    }\n\n    .btn-speed:hover {\n      transform: translateY(-2px);\n      box-shadow: 0 6px 20px rgba(79, 172, 254, 0.6);\n    }\n\n    .btn-speed.active {\n      background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);\n      box-shadow: 0 4px 15px rgba(67, 233, 123, 0.4);\n    }\n\n    .title {\n      color: white;\n      font-size: 2rem;\n      margin-bottom: 40px;\n      text-shadow: 0 2px 20px rgba(102, 126, 234, 0.5);\n      letter-spacing: 3px;\n    }\n\n    .glow {\n      position: absolute;\n      width: 300px;\n      height: 300px;\n      background: radial-gradient(circle, rgba(102, 126, 234, 0.3) 0%, transparent 70%);\n      border-radius: 50%;\n      pointer-events: none;\n      animation: pulse 4s ease-in-out infinite;\n    }\n\n    @keyframes pulse {\n      0%, 100% { transform: scale(1); opacity: 0.5; }\n      50% { transform: scale(1.2); opacity: 0.8; }\n    }\n\n    .speed-label {\n      color: rgba(255,255,255,0.7);\n      font-size: 0.9rem;\n      margin-top: 20px;\n    }\n  </style>\n</head>\n<body>\n  <h1 class=\"title\">✨ SPINNING CUBE ✨</h1>\n  \n  <div class=\"glow\"></div>\n  \n  <div class=\"scene\">\n    <div class=\"cube\" id=\"cube\">\n      <div class=\"face front\">FRONT</div>\n      <div class=\"face back\">BACK</div>\n      <div class=\"face right\">RIGHT</div>\n      <div class=\"face left\">LEFT</div>\n      <div class=\"face top\">TOP</div>\n      <div class=\"face bottom\">BOTTOM</div>\n    </div>\n  </div>\n  \n  <div class=\"controls\">\n    <button class=\"btn-pause\" id=\"pauseBtn\" onclick=\"togglePause()\">Pause</button>\n    <button class=\"btn-speed\" data-speed=\"slow\" onclick=\"setSpeed('slow')\">Slow</button>\n    <button class=\"btn-speed active\" data-speed=\"normal\" onclick=\"setSpeed('normal')\">Normal</button>\n    <button class=\"btn-speed\" data-speed=\"fast\" onclick=\"setSpeed('fast')\">Fast</button>\n    <button class=\"btn-speed\" data-speed=\"turbo\" onclick=\"setSpeed('turbo')\">Turbo</button>\n  </div>\n  \n  <p class=\"speed-label\" id=\"speedLabel\">Speed: Normal (8s)</p>\n\n  <script>\n    const cube = document.getElementById('cube');\n    const pauseBtn = document.getElementById('pauseBtn');\n    const speedLabel = document.getElementById('speedLabel');\n    let isPaused = false;\n\n    const speeds = {\n      slow: { duration: '16s', label: 'Slow (16s)' },\n      normal: { duration: '8s', label: 'Normal (8s)' },\n      fast: { duration: '3s', label: 'Fast (3s)' },\n      turbo: { duration: '1s', label: 'Turbo (1s)' }\n    };\n\n    function togglePause() {\n      isPaused = !isPaused;\n      cube.classList.toggle('paused', isPaused);\n      pauseBtn.textContent = isPaused ? 'Play' : 'Pause';\n    }\n\n    function setSpeed(speed) {\n      const config = speeds[speed];\n      cube.style.animationDuration = config.duration;\n      speedLabel.textContent = 'Speed: ' + config.label;\n      \n      document.querySelectorAll('.btn-speed').forEach(btn => {\n        btn.classList.toggle('active', btn.dataset.speed === speed);\n      });\n    }\n\n    // Add mouse interaction for manual rotation\n    let isDragging = false;\n    let startX, startY, currentX = 0, currentY = -20;\n\n    cube.addEventListener('mousedown', (e) => {\n      if (!isPaused) togglePause();\n      isDragging = true;\n      startX = e.clientX;\n      startY = e.clientY;\n      cube.style.cursor = 'grabbing';\n    });\n\n    document.addEventListener('mousemove', (e) => {\n      if (!isDragging) return;\n      const deltaX = e.clientX - startX;\n      const deltaY = e.clientY - startY;\n      currentX = currentY + deltaY * 0.5;\n      const rotY = deltaX * 0.5;\n      cube.style.transform = `rotateX(${currentX}deg) rotateY(${rotY}deg)`;\n    });\n\n    document.addEventListener('mouseup', () => {\n      isDragging = false;\n      cube.style.cursor = 'grab';\n    });\n\n    cube.style.cursor = 'grab';\n  </script>\n</body>\n</html>",
