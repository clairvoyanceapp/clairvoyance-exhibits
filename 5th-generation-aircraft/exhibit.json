    "type": "html",
    "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>5th Generation Aircraft</title>\n  <style>\n    * {\n      margin: 0;\n      padding: 0;\n      box-sizing: border-box;\n    }\n    \n    body {\n      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;\n      background: linear-gradient(135deg, #0c1929 0%, #1a2f4a 50%, #0d2137 100%);\n      color: #e0e8f0;\n      min-height: 100vh;\n      overflow: hidden;\n    }\n    \n    .presentation {\n      width: 100vw;\n      height: 100vh;\n      position: relative;\n    }\n    \n    .slide {\n      position: absolute;\n      top: 0;\n      left: 0;\n      width: 100%;\n      height: 100%;\n      display: flex;\n      flex-direction: column;\n      justify-content: center;\n      align-items: center;\n      padding: 60px;\n      opacity: 0;\n      transform: translateX(100%);\n      transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);\n      pointer-events: none;\n    }\n    \n    .slide.active {\n      opacity: 1;\n      transform: translateX(0);\n      pointer-events: auto;\n    }\n    \n    .slide.prev {\n      opacity: 0;\n      transform: translateX(-100%);\n    }\n    \n    h1 {\n      font-size: 3.5rem;\n      font-weight: 700;\n      margin-bottom: 20px;\n      text-align: center;\n      background: linear-gradient(135deg, #60a5fa, #a78bfa);\n      -webkit-background-clip: text;\n      -webkit-text-fill-color: transparent;\n      background-clip: text;\n    }\n    \n    h2 {\n      font-size: 2.5rem;\n      font-weight: 600;\n      margin-bottom: 30px;\n      color: #60a5fa;\n      text-align: center;\n    }\n    \n    .subtitle {\n      font-size: 1.5rem;\n      color: #94a3b8;\n      margin-bottom: 40px;\n      text-align: center;\n    }\n    \n    .content {\n      max-width: 1000px;\n      width: 100%;\n    }\n    \n    .feature-grid {\n      display: grid;\n      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n      gap: 25px;\n      margin-top: 30px;\n    }\n    \n    .feature-card {\n      background: rgba(30, 58, 95, 0.5);\n      border: 1px solid rgba(96, 165, 250, 0.2);\n      border-radius: 16px;\n      padding: 25px;\n      transition: all 0.3s ease;\n    }\n    \n    .feature-card:hover {\n      transform: translateY(-5px);\n      border-color: rgba(96, 165, 250, 0.5);\n      box-shadow: 0 10px 40px rgba(96, 165, 250, 0.15);\n    }\n    \n    .feature-card h3 {\n      font-size: 1.3rem;\n      color: #60a5fa;\n      margin-bottom: 12px;\n      display: flex;\n      align-items: center;\n      gap: 10px;\n    }\n    \n    .feature-card p {\n      color: #94a3b8;\n      line-height: 1.6;\n    }\n    \n    .aircraft-showcase {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 30px;\n      justify-content: center;\n      margin-top: 30px;\n    }\n    \n    .aircraft-card {\n      background: rgba(30, 58, 95, 0.6);\n      border: 1px solid rgba(96, 165, 250, 0.2);\n      border-radius: 20px;\n      padding: 30px;\n      width: 300px;\n      text-align: center;\n      transition: all 0.3s ease;\n      cursor: pointer;\n    }\n    \n    .aircraft-card:hover {\n      transform: scale(1.05);\n      border-color: rgba(96, 165, 250, 0.6);\n    }\n    \n    .aircraft-card.selected {\n      border-color: #60a5fa;\n      box-shadow: 0 0 30px rgba(96, 165, 250, 0.3);\n    }\n    \n    .aircraft-icon {\n      font-size: 4rem;\n      margin-bottom: 15px;\n    }\n    \n    .aircraft-card h3 {\n      font-size: 1.4rem;\n      color: #fff;\n      margin-bottom: 8px;\n    }\n    \n    .aircraft-card .country {\n      font-size: 0.9rem;\n      color: #60a5fa;\n      margin-bottom: 10px;\n    }\n    \n    .aircraft-card .year {\n      font-size: 0.85rem;\n      color: #64748b;\n    }\n    \n    .aircraft-details {\n      margin-top: 30px;\n      background: rgba(30, 58, 95, 0.4);\n      border-radius: 16px;\n      padding: 30px;\n      max-width: 800px;\n      display: none;\n    }\n    \n    .aircraft-details.visible {\n      display: block;\n      animation: fadeIn 0.4s ease;\n    }\n    \n    @keyframes fadeIn {\n      from { opacity: 0; transform: translateY(10px); }\n      to { opacity: 1; transform: translateY(0); }\n    }\n    \n    .specs-grid {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 20px;\n      margin-top: 20px;\n    }\n    \n    .spec-item {\n      text-align: center;\n    }\n    \n    .spec-value {\n      font-size: 1.8rem;\n      font-weight: 700;\n      color: #60a5fa;\n    }\n    \n    .spec-label {\n      font-size: 0.85rem;\n      color: #64748b;\n      margin-top: 5px;\n    }\n    \n    .timeline {\n      position: relative;\n      padding: 20px 0;\n      max-width: 900px;\n    }\n    \n    .timeline::before {\n      content: '';\n      position: absolute;\n      left: 50%;\n      transform: translateX(-50%);\n      width: 4px;\n      height: 100%;\n      background: linear-gradient(to bottom, #60a5fa, #a78bfa);\n      border-radius: 2px;\n    }\n    \n    .timeline-item {\n      display: flex;\n      align-items: center;\n      margin-bottom: 40px;\n      position: relative;\n    }\n    \n    .timeline-item:nth-child(odd) {\n      flex-direction: row-reverse;\n    }\n    \n    .timeline-content {\n      width: 45%;\n      background: rgba(30, 58, 95, 0.5);\n      border: 1px solid rgba(96, 165, 250, 0.2);\n      border-radius: 12px;\n      padding: 20px;\n    }\n    \n    .timeline-year {\n      position: absolute;\n      left: 50%;\n      transform: translateX(-50%);\n      background: #60a5fa;\n      color: #0c1929;\n      padding: 8px 16px;\n      border-radius: 20px;\n      font-weight: 700;\n      font-size: 0.9rem;\n    }\n    \n    .comparison-table {\n      width: 100%;\n      border-collapse: separate;\n      border-spacing: 0;\n      margin-top: 20px;\n    }\n    \n    .comparison-table th {\n      background: rgba(96, 165, 250, 0.2);\n      padding: 15px;\n      text-align: left;\n      font-weight: 600;\n      color: #60a5fa;\n    }\n    \n    .comparison-table th:first-child {\n      border-radius: 12px 0 0 0;\n    }\n    \n    .comparison-table th:last-child {\n      border-radius: 0 12px 0 0;\n    }\n    \n    .comparison-table td {\n      padding: 15px;\n      border-bottom: 1px solid rgba(96, 165, 250, 0.1);\n      background: rgba(30, 58, 95, 0.3);\n    }\n    \n    .comparison-table tr:last-child td:first-child {\n      border-radius: 0 0 0 12px;\n    }\n    \n    .comparison-table tr:last-child td:last-child {\n      border-radius: 0 0 12px 0;\n    }\n    \n    .nav-controls {\n      position: fixed;\n      bottom: 30px;\n      left: 50%;\n      transform: translateX(-50%);\n      display: flex;\n      gap: 15px;\n      align-items: center;\n      background: rgba(12, 25, 41, 0.9);\n      padding: 12px 25px;\n      border-radius: 50px;\n      border: 1px solid rgba(96, 165, 250, 0.3);\n      backdrop-filter: blur(10px);\n      z-index: 100;\n    }\n    \n    .nav-btn {\n      background: rgba(96, 165, 250, 0.2);\n      border: none;\n      color: #60a5fa;\n      width: 45px;\n      height: 45px;\n      border-radius: 50%;\n      cursor: pointer;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      transition: all 0.3s ease;\n      font-size: 1.2rem;\n    }\n    \n    .nav-btn:hover {\n      background: rgba(96, 165, 250, 0.4);\n      transform: scale(1.1);\n    }\n    \n    .nav-btn:disabled {\n      opacity: 0.3;\n      cursor: not-allowed;\n      transform: none;\n    }\n    \n    .slide-indicator {\n      display: flex;\n      gap: 8px;\n    }\n    \n    .dot {\n      width: 10px;\n      height: 10px;\n      border-radius: 50%;\n      background: rgba(96, 165, 250, 0.3);\n      cursor: pointer;\n      transition: all 0.3s ease;\n    }\n    \n    .dot.active {\n      background: #60a5fa;\n      transform: scale(1.2);\n    }\n    \n    .dot:hover {\n      background: rgba(96, 165, 250, 0.6);\n    }\n    \n    .key-point {\n      display: flex;\n      align-items: flex-start;\n      gap: 15px;\n      margin-bottom: 20px;\n      padding: 15px;\n      background: rgba(30, 58, 95, 0.4);\n      border-radius: 12px;\n      border-left: 4px solid #60a5fa;\n    }\n    \n    .key-point-icon {\n      font-size: 1.5rem;\n      flex-shrink: 0;\n    }\n    \n    .key-point-text h4 {\n      color: #fff;\n      margin-bottom: 5px;\n    }\n    \n    .key-point-text p {\n      color: #94a3b8;\n      font-size: 0.95rem;\n      line-height: 1.5;\n    }\n    \n    .radar-container {\n      display: flex;\n      justify-content: center;\n      margin: 30px 0;\n    }\n    \n    .stealth-visual {\n      position: relative;\n      width: 300px;\n      height: 200px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n    \n    .stealth-aircraft {\n      font-size: 5rem;\n      position: relative;\n      z-index: 2;\n      animation: pulse 2s ease-in-out infinite;\n    }\n    \n    @keyframes pulse {\n      0%, 100% { opacity: 1; }\n      50% { opacity: 0.6; }\n    }\n    \n    .radar-wave {\n      position: absolute;\n      border: 2px solid rgba(96, 165, 250, 0.3);\n      border-radius: 50%;\n      animation: radarPing 3s ease-out infinite;\n    }\n    \n    .radar-wave:nth-child(1) { animation-delay: 0s; }\n    .radar-wave:nth-child(2) { animation-delay: 1s; }\n    .radar-wave:nth-child(3) { animation-delay: 2s; }\n    \n    @keyframes radarPing {\n      0% {\n        width: 50px;\n        height: 50px;\n        opacity: 0.8;\n      }\n      100% {\n        width: 300px;\n        height: 300px;\n        opacity: 0;\n      }\n    }\n    \n    .intro-badge {\n      display: inline-block;\n      background: linear-gradient(135deg, rgba(96, 165, 250, 0.2), rgba(167, 139, 250, 0.2));\n      border: 1px solid rgba(96, 165, 250, 0.3);\n      padding: 8px 20px;\n      border-radius: 30px;\n      font-size: 0.9rem;\n      color: #60a5fa;\n      margin-bottom: 20px;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"presentation\">\n    <!-- Slide 1: Title -->\n    <div class=\"slide active\" data-slide=\"0\">\n      <div class=\"intro-badge\">Aviation Technology</div>\n      <h1>5th Generation Fighter Aircraft</h1>\n      <p class=\"subtitle\">The Evolution of Air Superiority</p>\n      <div class=\"stealth-visual\">\n        <div class=\"radar-wave\"></div>\n        <div class=\"radar-wave\"></div>\n        <div class=\"radar-wave\"></div>\n        <div class=\"stealth-aircraft\">&#9992;</div>\n      </div>\n      <p style=\"color: #64748b; margin-top: 40px;\">Press arrow keys or use controls to navigate</p>\n    </div>\n\n    <!-- Slide 2: What Defines 5th Gen -->\n    <div class=\"slide\" data-slide=\"1\">\n      <h2>What Defines 5th Generation?</h2>\n      <div class=\"content\">\n        <div class=\"feature-grid\">\n          <div class=\"feature-card\">\n            <h3>&#128683; Stealth Technology</h3>\n            <p>Radar-absorbing materials and angular designs minimize radar cross-section to the size of a small bird or insect.</p>\n          </div>\n          <div class=\"feature-card\">\n            <h3>&#128640; Supercruise</h3>\n            <p>Ability to sustain supersonic flight without afterburners, improving range and reducing thermal signature.</p>\n          </div>\n          <div class=\"feature-card\">\n            <h3>&#128187; Sensor Fusion</h3>\n            <p>Integrated avionics combine data from multiple sensors into a unified tactical picture for the pilot.</p>\n          </div>\n          <div class=\"feature-card\">\n            <h3>&#127919; Advanced Avionics</h3>\n            <p>AESA radar, electronic warfare suites, and sophisticated communication systems networked together.</p>\n          </div>\n          <div class=\"feature-card\">\n            <h3>&#128736; Internal Weapons</h3>\n            <p>Weapons carried internally to maintain stealth profile, with external hardpoints for non-stealth missions.</p>\n          </div>\n          <div class=\"feature-card\">\n            <h3>&#9889; High Maneuverability</h3>\n            <p>Thrust vectoring and advanced aerodynamics enable superior dogfighting and evasive capabilities.</p>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Slide 3: The Aircraft -->\n    <div class=\"slide\" data-slide=\"2\">\n      <h2>5th Generation Aircraft</h2>\n      <p class=\"subtitle\">Click on an aircraft to see specifications</p>\n      <div class=\"aircraft-showcase\">\n        <div class=\"aircraft-card\" data-aircraft=\"f22\">\n          <div class=\"aircraft-icon\">&#9992;</div>\n          <h3>F-22 Raptor</h3>\n          <p class=\"country\">United States</p>\n          <p class=\"year\">First Flight: 1997</p>\n        </div>\n        <div class=\"aircraft-card\" data-aircraft=\"f35\">\n          <div class=\"aircraft-icon\">&#9992;</div>\n          <h3>F-35 Lightning II</h3>\n          <p class=\"country\">United States</p>\n          <p class=\"year\">First Flight: 2006</p>\n        </div>\n        <div class=\"aircraft-card\" data-aircraft=\"su57\">\n          <div class=\"aircraft-icon\">&#9992;</div>\n          <h3>Su-57 Felon</h3>\n          <p class=\"country\">Russia</p>\n          <p class=\"year\">First Flight: 2010</p>\n        </div>\n        <div class=\"aircraft-card\" data-aircraft=\"j20\">\n          <div class=\"aircraft-icon\">&#9992;</div>\n          <h3>J-20 Mighty Dragon</h3>\n          <p class=\"country\">China</p>\n          <p class=\"year\">First Flight: 2011</p>\n        </div>\n      </div>\n      <div class=\"aircraft-details\" id=\"aircraft-details\">\n        <h3 id=\"detail-name\"></h3>\n        <p id=\"detail-desc\" style=\"color: #94a3b8; margin: 15px 0;\"></p>\n        <div class=\"specs-grid\" id=\"specs-grid\"></div>\n      </div>\n    </div>\n\n    <!-- Slide 4: Development Timeline -->\n    <div class=\"slide\" data-slide=\"3\">\n      <h2>Development Timeline</h2>\n      <div class=\"timeline\">\n        <div class=\"timeline-item\">\n          <div class=\"timeline-content\">\n            <h4 style=\"color: #60a5fa; margin-bottom: 8px;\">ATF Program Begins</h4>\n            <p style=\"color: #94a3b8; font-size: 0.9rem;\">USAF launches Advanced Tactical Fighter program to replace F-15</p>\n          </div>\n          <span class=\"timeline-year\">1981</span>\n        </div>\n        <div class=\"timeline-item\">\n          <div class=\"timeline-content\">\n            <h4 style=\"color: #60a5fa; margin-bottom: 8px;\">YF-22 Selected</h4>\n            <p style=\"color: #94a3b8; font-size: 0.9rem;\">Lockheed's YF-22 wins competition against Northrop YF-23</p>\n          </div>\n          <span class=\"timeline-year\">1991</span>\n        </div>\n        <div class=\"timeline-item\">\n          <div class=\"timeline-content\">\n            <h4 style=\"color: #60a5fa; margin-bottom: 8px;\">F-22 Operational</h4>\n            <p style=\"color: #94a3b8; font-size: 0.9rem;\">First F-22 squadron achieves initial operational capability</p>\n          </div>\n          <span class=\"timeline-year\">2005</span>\n        </div>\n        <div class=\"timeline-item\">\n          <div class=\"timeline-content\">\n            <h4 style=\"color: #60a5fa; margin-bottom: 8px;\">F-35 Era Begins</h4>\n            <p style=\"color: #94a3b8; font-size: 0.9rem;\">F-35A declared combat ready; international partners receive aircraft</p>\n          </div>\n          <span class=\"timeline-year\">2016</span>\n        </div>\n        <div class=\"timeline-item\">\n          <div class=\"timeline-content\">\n            <h4 style=\"color: #60a5fa; margin-bottom: 8px;\">Global 5th Gen</h4>\n            <p style=\"color: #94a3b8; font-size: 0.9rem;\">Multiple nations operating or developing 5th generation fighters</p>\n          </div>\n          <span class=\"timeline-year\">2020+</span>\n        </div>\n      </div>\n    </div>\n\n    <!-- Slide 5: Stealth Explained -->\n    <div class=\"slide\" data-slide=\"4\">\n      <h2>Stealth Technology Explained</h2>\n      <div class=\"content\">\n        <div class=\"key-point\">\n          <span class=\"key-point-icon\">&#128316;</span>\n          <div class=\"key-point-text\">\n            <h4>Radar Cross Section (RCS)</h4>\n            <p>The F-22's RCS is estimated at 0.0001 to 0.001 m&sup2;, compared to an F-15's 25 m&sup2;. This is roughly the radar signature of a marble versus a barn door.</p>\n          </div>\n        </div>\n        <div class=\"key-point\">\n          <span class=\"key-point-icon\">&#128421;</span>\n          <div class=\"key-point-text\">\n            <h4>Radar-Absorbing Materials</h4>\n            <p>Specialized coatings and composite materials absorb radar energy instead of reflecting it back. These require careful maintenance and controlled storage environments.</p>\n          </div>\n        </div>\n        <div class=\"key-point\">\n          <span class=\"key-point-icon\">&#128204;</span>\n          <div class=\"key-point-text\">\n            <h4>Shaping Principles</h4>\n            <p>Angular surfaces deflect radar away from the source. Aligned edges, canted vertical tails, and serpentine inlet ducts all contribute to reducing radar returns.</p>\n          </div>\n        </div>\n        <div class=\"key-point\">\n          <span class=\"key-point-icon\">&#127777;</span>\n          <div class=\"key-point-text\">\n            <h4>Infrared Signature Management</h4>\n            <p>Flattened engine exhausts and cooling systems reduce heat signatures, making aircraft harder to track with infrared sensors and heat-seeking missiles.</p>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Slide 6: Comparison -->\n    <div class=\"slide\" data-slide=\"5\">\n      <h2>Generation Comparison</h2>\n      <div class=\"content\">\n        <table class=\"comparison-table\">\n          <thead>\n            <tr>\n              <th>Capability</th>\n              <th>4th Gen (F-15, Su-27)</th>\n              <th>4.5 Gen (F-16V, Typhoon)</th>\n              <th>5th Gen (F-22, F-35)</th>\n            </tr>\n          </thead>\n          <tbody>\n            <tr>\n              <td>Stealth</td>\n              <td>None</td>\n              <td>Reduced RCS features</td>\n              <td>All-aspect stealth</td>\n            </tr>\n            <tr>\n              <td>Radar</td>\n              <td>Pulse-Doppler</td>\n              <td>AESA (some)</td>\n              <td>Advanced AESA + LPI</td>\n            </tr>\n            <tr>\n              <td>Supercruise</td>\n              <td>No</td>\n              <td>Limited (some)</td>\n              <td>Yes</td>\n            </tr>\n            <tr>\n              <td>Sensor Fusion</td>\n              <td>Basic</td>\n              <td>Moderate</td>\n              <td>Full integration</td>\n            </tr>\n            <tr>\n              <td>Data Links</td>\n              <td>Limited</td>\n              <td>Improved</td>\n              <td>Advanced networked</td>\n            </tr>\n            <tr>\n              <td>Internal Weapons</td>\n              <td>No</td>\n              <td>No</td>\n              <td>Yes</td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n    </div>\n\n    <!-- Slide 7: Future -->\n    <div class=\"slide\" data-slide=\"6\">\n      <h2>Looking Ahead: 6th Generation</h2>\n      <div class=\"content\">\n        <div class=\"feature-grid\">\n          <div class=\"feature-card\">\n            <h3>&#129302; Manned-Unmanned Teaming</h3>\n            <p>Piloted aircraft controlling swarms of loyal wingman drones for expanded sensor coverage and strike capacity.</p>\n          </div>\n          <div class=\"feature-card\">\n            <h3>&#128161; Directed Energy Weapons</h3>\n            <p>Laser systems for missile defense and potentially offensive operations, enabled by next-gen power systems.</p>\n          </div>\n          <div class=\"feature-card\">\n            <h3>&#127760; Enhanced Connectivity</h3>\n            <p>Space-based networking and quantum-resistant communications for seamless multi-domain operations.</p>\n          </div>\n          <div class=\"feature-card\">\n            <h3>&#129504; AI Integration</h3>\n            <p>Machine learning for real-time threat assessment, automated countermeasures, and mission planning assistance.</p>\n          </div>\n        </div>\n        <div style=\"margin-top: 40px; text-align: center;\">\n          <p style=\"color: #64748b;\">Programs in development: NGAD (USA), FCAS (Europe), Tempest (UK/Italy/Japan)</p>\n        </div>\n      </div>\n    </div>\n\n    <!-- Slide 8: Summary -->\n    <div class=\"slide\" data-slide=\"7\">\n      <h2>Key Takeaways</h2>\n      <div class=\"content\">\n        <div class=\"key-point\">\n          <span class=\"key-point-icon\">1</span>\n          <div class=\"key-point-text\">\n            <h4>Stealth Changed Everything</h4>\n            <p>Low observability fundamentally altered air combat doctrine and force structure planning worldwide.</p>\n          </div>\n        </div>\n        <div class=\"key-point\">\n          <span class=\"key-point-icon\">2</span>\n          <div class=\"key-point-text\">\n            <h4>Information Dominance</h4>\n            <p>5th gen fighters are as much sensor platforms as weapons systems - their ability to gather and share data is transformative.</p>\n          </div>\n        </div>\n        <div class=\"key-point\">\n          <span class=\"key-point-icon\">3</span>\n          <div class=\"key-point-text\">\n            <h4>Cost vs. Capability</h4>\n            <p>The expense of these platforms drives debates about fleet composition and the role of advanced 4th gen aircraft.</p>\n          </div>\n        </div>\n        <div class=\"key-point\">\n          <span class=\"key-point-icon\">4</span>\n          <div class=\"key-point-text\">\n            <h4>Evolution Continues</h4>\n            <p>6th generation development is already underway, incorporating lessons learned and emerging technologies.</p>\n          </div>\n        </div>\n      </div>\n      <p style=\"color: #60a5fa; margin-top: 40px; text-align: center;\">End of Presentation</p>\n    </div>\n  </div>\n\n  <div class=\"nav-controls\">\n    <button class=\"nav-btn\" id=\"prev-btn\">&#9664;</button>\n    <div class=\"slide-indicator\" id=\"slide-indicator\"></div>\n    <button class=\"nav-btn\" id=\"next-btn\">&#9654;</button>\n  </div>\n\n  <script>\n    const slides = document.querySelectorAll('.slide');\n    const prevBtn = document.getElementById('prev-btn');\n    const nextBtn = document.getElementById('next-btn');\n    const indicator = document.getElementById('slide-indicator');\n    let currentSlide = 0;\n\n    // Aircraft data\n    const aircraftData = {\n      f22: {\n        name: 'F-22 Raptor',\n        desc: 'The world\\'s first operational 5th generation fighter. Designed for air superiority with unmatched combination of stealth, speed, agility, and situational awareness.',\n        specs: [\n          { value: 'Mach 2.25', label: 'Max Speed' },\n          { value: '65,000 ft', label: 'Service Ceiling' },\n          { value: '$150M+', label: 'Unit Cost' },\n          { value: '195', label: 'Built' },\n          { value: '35,000 lbf', label: 'Thrust (each)' },\n          { value: '1,839 mi', label: 'Range' }\n        ]\n      },\n      f35: {\n        name: 'F-35 Lightning II',\n        desc: 'Multi-role stealth fighter in three variants (A/B/C) for conventional, STOVL, and carrier operations. The largest military aircraft program in history.',\n        specs: [\n          { value: 'Mach 1.6', label: 'Max Speed' },\n          { value: '50,000 ft', label: 'Service Ceiling' },\n          { value: '$80-100M', label: 'Unit Cost' },\n          { value: '1,000+', label: 'Delivered' },\n          { value: '43,000 lbf', label: 'Thrust' },\n          { value: '1,380 mi', label: 'Range' }\n        ]\n      },\n      su57: {\n        name: 'Su-57 Felon',\n        desc: 'Russia\\'s answer to Western 5th generation fighters. Features advanced sensors and super-maneuverability, though production numbers remain limited.',\n        specs: [\n          { value: 'Mach 2', label: 'Max Speed' },\n          { value: '65,000 ft', label: 'Service Ceiling' },\n          { value: '$35-50M', label: 'Est. Cost' },\n          { value: '~30', label: 'Produced' },\n          { value: '32,000 lbf', label: 'Thrust (each)' },\n          { value: '2,175 mi', label: 'Range' }\n        ]\n      },\n      j20: {\n        name: 'J-20 Mighty Dragon',\n        desc: 'China\\'s first stealth fighter, entering service in 2017. Large delta-canard design optimized for long-range interception.',\n        specs: [\n          { value: 'Mach 2+', label: 'Max Speed' },\n          { value: '65,000 ft', label: 'Est. Ceiling' },\n          { value: 'Unknown', label: 'Unit Cost' },\n          { value: '200+', label: 'Est. Built' },\n          { value: '44,000 lbf', label: 'Thrust (each)' },\n          { value: '1,400+ mi', label: 'Est. Range' }\n        ]\n      }\n    };\n\n    // Create indicator dots\n    slides.forEach((_, i) => {\n      const dot = document.createElement('div');\n      dot.className = 'dot' + (i === 0 ? ' active' : '');\n      dot.addEventListener('click', () => goToSlide(i));\n      indicator.appendChild(dot);\n    });\n\n    function updateSlides() {\n      slides.forEach((slide, i) => {\n        slide.classList.remove('active', 'prev');\n        if (i === currentSlide) {\n          slide.classList.add('active');\n        } else if (i < currentSlide) {\n          slide.classList.add('prev');\n        }\n      });\n\n      const dots = indicator.querySelectorAll('.dot');\n      dots.forEach((dot, i) => {\n        dot.classList.toggle('active', i === currentSlide);\n      });\n\n      prevBtn.disabled = currentSlide === 0;\n      nextBtn.disabled = currentSlide === slides.length - 1;\n    }\n\n    function goToSlide(index) {\n      currentSlide = Math.max(0, Math.min(index, slides.length - 1));\n      updateSlides();\n    }\n\n    prevBtn.addEventListener('click', () => goToSlide(currentSlide - 1));\n    nextBtn.addEventListener('click', () => goToSlide(currentSlide + 1));\n\n    document.addEventListener('keydown', (e) => {\n      if (e.key === 'ArrowRight' || e.key === ' ') {\n        goToSlide(currentSlide + 1);\n      } else if (e.key === 'ArrowLeft') {\n        goToSlide(currentSlide - 1);\n      }\n    });\n\n    // Aircraft card interactions\n    const aircraftCards = document.querySelectorAll('.aircraft-card');\n    const detailsPanel = document.getElementById('aircraft-details');\n    const detailName = document.getElementById('detail-name');\n    const detailDesc = document.getElementById('detail-desc');\n    const specsGrid = document.getElementById('specs-grid');\n\n    aircraftCards.forEach(card => {\n      card.addEventListener('click', () => {\n        const id = card.dataset.aircraft;\n        const data = aircraftData[id];\n        \n        aircraftCards.forEach(c => c.classList.remove('selected'));\n        card.classList.add('selected');\n        \n        detailName.textContent = data.name;\n        detailName.style.color = '#60a5fa';\n        detailDesc.textContent = data.desc;\n        \n        specsGrid.innerHTML = data.specs.map(spec => `\n          <div class=\"spec-item\">\n            <div class=\"spec-value\">${spec.value}</div>\n            <div class=\"spec-label\">${spec.label}</div>\n          </div>\n        `).join('');\n        \n        detailsPanel.classList.add('visible');\n      });\n    });\n\n    // Initial state\n    updateSlides();\n  </script>\n</body>\n</html>",
    "css": "",
    "js": ""
  },
  "permissions": {
    "allowNetwork": false,
    "allowStorage": false,
    "allowClipboard": false
  }
