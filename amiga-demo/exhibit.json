  "content": {
    "type": "html",
    "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Amiga Boing Ball Demo</title>\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    \n    body {\n      background: linear-gradient(180deg, #5555aa 0%, #8888cc 50%, #aaaaee 100%);\n      min-height: 100vh;\n      overflow: hidden;\n      font-family: 'Courier New', monospace;\n    }\n    \n    .container {\n      position: relative;\n      width: 100vw;\n      height: 100vh;\n    }\n    \n    /* Grid background like original Amiga demo */\n    .grid {\n      position: absolute;\n      top: 0;\n      left: 0;\n      width: 100%;\n      height: 100%;\n      background-image: \n        linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px),\n        linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px);\n      background-size: 50px 50px;\n      perspective: 500px;\n      transform-style: preserve-3d;\n    }\n    \n    .grid::before {\n      content: '';\n      position: absolute;\n      bottom: 0;\n      left: 0;\n      right: 0;\n      height: 40%;\n      background: linear-gradient(transparent, rgba(128,128,128,0.3));\n      transform: rotateX(60deg);\n      transform-origin: bottom;\n    }\n    \n    /* The bouncing ball canvas */\n    #ballCanvas {\n      position: absolute;\n      top: 0;\n      left: 0;\n      width: 100%;\n      height: 100%;\n    }\n    \n    /* Shadow on the floor */\n    #shadow {\n      position: absolute;\n      width: 120px;\n      height: 30px;\n      background: radial-gradient(ellipse, rgba(0,0,0,0.4) 0%, transparent 70%);\n      border-radius: 50%;\n      bottom: 50px;\n      left: 50%;\n      transform: translateX(-50%);\n      pointer-events: none;\n    }\n    \n    /* Title text */\n    .title {\n      position: absolute;\n      top: 20px;\n      left: 50%;\n      transform: translateX(-50%);\n      color: #fff;\n      text-shadow: 2px 2px 4px rgba(0,0,0,0.5);\n      font-size: 24px;\n      font-weight: bold;\n      letter-spacing: 4px;\n      z-index: 10;\n    }\n    \n    .subtitle {\n      position: absolute;\n      bottom: 20px;\n      left: 50%;\n      transform: translateX(-50%);\n      color: rgba(255,255,255,0.7);\n      font-size: 12px;\n      z-index: 10;\n    }\n    \n    /* Controls */\n    .controls {\n      position: absolute;\n      top: 60px;\n      left: 50%;\n      transform: translateX(-50%);\n      display: flex;\n      gap: 10px;\n      z-index: 10;\n    }\n    \n    .controls button {\n      background: linear-gradient(180deg, #ff6666 0%, #cc0000 100%);\n      border: 2px solid #fff;\n      color: #fff;\n      padding: 8px 16px;\n      font-family: inherit;\n      font-size: 12px;\n      cursor: pointer;\n      border-radius: 4px;\n      text-shadow: 1px 1px 2px rgba(0,0,0,0.5);\n      box-shadow: 2px 2px 4px rgba(0,0,0,0.3);\n    }\n    \n    .controls button:hover {\n      background: linear-gradient(180deg, #ff8888 0%, #ee2222 100%);\n    }\n    \n    .controls button:active {\n      transform: translateY(1px);\n    }\n  </style>\n</head>\n<body>\n  <div class=\"container\">\n    <div class=\"grid\"></div>\n    <canvas id=\"ballCanvas\"></canvas>\n    <div id=\"shadow\"></div>\n    <div class=\"title\">AMIGA BOING!</div>\n    <div class=\"controls\">\n      <button onclick=\"togglePause()\">PAUSE/PLAY</button>\n      <button onclick=\"resetBall()\">RESET</button>\n      <button onclick=\"addBall()\">ADD BALL</button>\n    </div>\n    <div class=\"subtitle\">Click anywhere to add momentum - Recreation of the 1984 Amiga Demo</div>\n  </div>\n  \n  <script>\n    const canvas = document.getElementById('ballCanvas');\n    const ctx = canvas.getContext('2d');\n    const shadow = document.getElementById('shadow');\n    \n    let width, height;\n    let paused = false;\n    \n    // Ball properties\n    const balls = [];\n    \n    function createBall(x, y) {\n      return {\n        x: x || width / 2,\n        y: y || height / 3,\n        vx: (Math.random() - 0.5) * 8,\n        vy: 0,\n        radius: 60,\n        rotation: 0,\n        rotationSpeed: 0.03,\n        gravity: 0.4,\n        bounce: 0.85,\n        friction: 0.99\n      };\n    }\n    \n    function resize() {\n      width = canvas.width = window.innerWidth;\n      height = canvas.height = window.innerHeight;\n    }\n    \n    function drawCheckerBall(ball) {\n      ctx.save();\n      ctx.translate(ball.x, ball.y);\n      \n      // Draw the 3D checkered sphere\n      const segments = 8;\n      const rings = 6;\n      \n      for (let ring = 0; ring < rings; ring++) {\n        const phi1 = (ring / rings) * Math.PI;\n        const phi2 = ((ring + 1) / rings) * Math.PI;\n        \n        for (let seg = 0; seg < segments; seg++) {\n          const theta1 = ((seg / segments) * 2 * Math.PI) + ball.rotation;\n          const theta2 = (((seg + 1) / segments) * 2 * Math.PI) + ball.rotation;\n          \n          // Calculate 3D positions and project to 2D\n          const points = [\n            project3D(ball.radius, theta1, phi1),\n            project3D(ball.radius, theta2, phi1),\n            project3D(ball.radius, theta2, phi2),\n            project3D(ball.radius, theta1, phi2)\n          ];\n          \n          // Only draw if facing camera (z > 0 for at least one point)\n          const avgZ = (points[0].z + points[1].z + points[2].z + points[3].z) / 4;\n          if (avgZ > -ball.radius * 0.3) {\n            // Checkerboard pattern - alternating red and white\n            const isRed = (ring + seg) % 2 === 0;\n            \n            // Shading based on position\n            const shade = 0.5 + (avgZ / ball.radius) * 0.5;\n            \n            if (isRed) {\n              const r = Math.floor(200 * shade + 55);\n              ctx.fillStyle = `rgb(${r}, ${Math.floor(30 * shade)}, ${Math.floor(30 * shade)})`;\n            } else {\n              const w = Math.floor(200 * shade + 55);\n              ctx.fillStyle = `rgb(${w}, ${w}, ${w})`;\n            }\n            \n            ctx.beginPath();\n            ctx.moveTo(points[0].x, points[0].y);\n            ctx.lineTo(points[1].x, points[1].y);\n            ctx.lineTo(points[2].x, points[2].y);\n            ctx.lineTo(points[3].x, points[3].y);\n            ctx.closePath();\n            ctx.fill();\n            \n            // Subtle outline\n            ctx.strokeStyle = 'rgba(0,0,0,0.1)';\n            ctx.lineWidth = 0.5;\n            ctx.stroke();\n          }\n        }\n      }\n      \n      // Add highlight\n      const gradient = ctx.createRadialGradient(\n        -ball.radius * 0.3, -ball.radius * 0.3, 0,\n        0, 0, ball.radius\n      );\n      gradient.addColorStop(0, 'rgba(255,255,255,0.4)');\n      gradient.addColorStop(0.3, 'rgba(255,255,255,0.1)');\n      gradient.addColorStop(1, 'rgba(0,0,0,0.2)');\n      \n      ctx.beginPath();\n      ctx.arc(0, 0, ball.radius, 0, Math.PI * 2);\n      ctx.fillStyle = gradient;\n      ctx.fill();\n      \n      ctx.restore();\n    }\n    \n    function project3D(radius, theta, phi) {\n      const x = radius * Math.sin(phi) * Math.cos(theta);\n      const y = radius * Math.cos(phi);\n      const z = radius * Math.sin(phi) * Math.sin(theta);\n      return { x, y, z };\n    }\n    \n    function updateBall(ball) {\n      // Apply gravity\n      ball.vy += ball.gravity;\n      \n      // Apply velocity\n      ball.x += ball.vx;\n      ball.y += ball.vy;\n      \n      // Apply friction\n      ball.vx *= ball.friction;\n      \n      // Rotate based on horizontal movement\n      ball.rotation += ball.vx * 0.02;\n      \n      // Bounce off floor\n      const floor = height - 80;\n      if (ball.y + ball.radius > floor) {\n        ball.y = floor - ball.radius;\n        ball.vy = -ball.vy * ball.bounce;\n        // Add rotation on bounce\n        ball.rotationSpeed = ball.vx * 0.01;\n      }\n      \n      // Bounce off walls\n      if (ball.x - ball.radius < 0) {\n        ball.x = ball.radius;\n        ball.vx = -ball.vx * ball.bounce;\n      }\n      if (ball.x + ball.radius > width) {\n        ball.x = width - ball.radius;\n        ball.vx = -ball.vx * ball.bounce;\n      }\n      \n      // Bounce off ceiling\n      if (ball.y - ball.radius < 0) {\n        ball.y = ball.radius;\n        ball.vy = -ball.vy * ball.bounce;\n      }\n    }\n    \n    function updateShadow() {\n      if (balls.length > 0) {\n        const ball = balls[0];\n        const floor = height - 80;\n        const distFromFloor = floor - (ball.y + ball.radius);\n        const maxDist = floor - ball.radius;\n        const scale = 1 - (distFromFloor / maxDist) * 0.5;\n        const opacity = 0.4 * (1 - distFromFloor / maxDist);\n        \n        shadow.style.left = ball.x + 'px';\n        shadow.style.width = (120 * scale) + 'px';\n        shadow.style.opacity = Math.max(0, opacity);\n      }\n    }\n    \n    function animate() {\n      if (!paused) {\n        ctx.clearRect(0, 0, width, height);\n        \n        balls.forEach(ball => {\n          updateBall(ball);\n          drawCheckerBall(ball);\n        });\n        \n        updateShadow();\n      }\n      \n      requestAnimationFrame(animate);\n    }\n    \n    function togglePause() {\n      paused = !paused;\n    }\n    \n    function resetBall() {\n      balls.length = 0;\n      balls.push(createBall(width / 2, height / 3));\n    }\n    \n    function addBall() {\n      if (balls.length < 5) {\n        balls.push(createBall(\n          Math.random() * (width - 200) + 100,\n          Math.random() * (height / 2)\n        ));\n      }\n    }\n    \n    // Click to add momentum\n    canvas.addEventListener('click', (e) => {\n      balls.forEach(ball => {\n        const dx = e.clientX - ball.x;\n        const dy = e.clientY - ball.y;\n        const dist = Math.sqrt(dx * dx + dy * dy);\n        \n        if (dist < 200) {\n          ball.vx += (dx / dist) * 10;\n          ball.vy += (dy / dist) * 10;\n        }\n      });\n    });\n    \n    // Initialize\n    window.addEventListener('resize', resize);\n    resize();\n    balls.push(createBall());\n    animate();\n  </script>\n</body>\n</html>"
  },
  "permissions": {
    "allowNetwork": false,
    "allowStorage": false,
    "allowClipboard": false
  }
