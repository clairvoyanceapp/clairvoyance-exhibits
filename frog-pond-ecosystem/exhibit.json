  "content": {
    "type": "html",
    "bundle": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><style>*{box-sizing:border-box}html,body{height:100%;width:100%;margin:0;padding:0;background:#0a1418;font-family:system-ui,-apple-system,sans-serif;color:#e8f0e8;overflow:hidden}#app{display:flex;flex-direction:row;height:100vh;width:100vw}#pond{flex:1 1 auto;position:relative;min-width:0;min-height:300px;background:#0a1418}#canvas{display:block;position:absolute;top:0;left:0;width:100%;height:100%}#hud{position:absolute;top:10px;left:10px;background:rgba(8,18,22,.88);padding:8px 12px;border-radius:8px;font-size:12px;border:1px solid #1c3640;z-index:5}#hud .row{display:flex;gap:14px}#hud .stat{min-width:56px}#hud .lbl{color:#7da7a3;font-size:10px;text-transform:uppercase;letter-spacing:.06em}#hud .val{font-size:18px;font-weight:600;font-variant-numeric:tabular-nums}#chart{position:absolute;bottom:10px;left:10px;right:10px;height:80px;background:rgba(8,18,22,.7);border-radius:8px;border:1px solid #1c3640;z-index:5}#panel{width:260px;flex-shrink:0;background:#0d1d22;padding:14px;overflow-y:auto;border-left:1px solid #1c3640;height:100vh}#panel h2{margin:0 0 10px;font-size:11px;font-weight:600;color:#98c5b8;text-transform:uppercase;letter-spacing:.1em}.ctrl{margin-bottom:12px}.ctrl label{display:flex;justify-content:space-between;font-size:12px;margin-bottom:4px;color:#b8d2cc}.ctrl input[type=range]{width:100%;accent-color:#6fb89a}.ctrl .v{color:#6fb89a;font-variant-numeric:tabular-nums;font-weight:600}.pre button{width:100%;padding:7px 10px;background:#1c3640;border:none;color:#cfe5dd;border-radius:4px;cursor:pointer;margin-bottom:5px;font-size:12px;text-align:left}.pre button:hover{background:#2a4d5a}#reset{background:#5a2a2a!important}#reset:hover{background:#7a3a3a!important}#ev{position:absolute;top:10px;right:10px;max-width:220px;pointer-events:none;z-index:10}.ev-msg{background:rgba(8,18,22,.9);padding:6px 10px;border-radius:4px;margin-bottom:4px;font-size:12px;border-left:3px solid #6fb89a;opacity:0;transform:translateX(10px);transition:all .3s}.ev-msg.show{opacity:1;transform:translateX(0)}.ev-msg.bad{border-left-color:#d68b6f}.ev-msg.good{border-left-color:#a8d96f}.section-divider{margin:14px 0 10px;border-top:1px solid #1c3640;padding-top:12px}#err{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);background:#3a1a1a;color:#ffcfcf;padding:14px 18px;border-radius:6px;font-family:monospace;font-size:12px;max-width:80%;display:none;white-space:pre-wrap;z-index:99}</style></head><body><div id=\"app\"><div id=\"pond\"><canvas id=\"canvas\" width=\"800\" height=\"600\"></canvas><div id=\"hud\"><div class=\"row\"><div class=\"stat\"><div class=\"lbl\">Frogs</div><div class=\"val\" id=\"s-frogs\">0</div></div><div class=\"stat\"><div class=\"lbl\">Tadpoles</div><div class=\"val\" id=\"s-tads\">0</div></div><div class=\"stat\"><div class=\"lbl\">Day</div><div class=\"val\" id=\"s-day\">0</div></div><div class=\"stat\"><div class=\"lbl\">Births</div><div class=\"val\" id=\"s-births\">0</div></div><div class=\"stat\"><div class=\"lbl\">Deaths</div><div class=\"val\" id=\"s-deaths\">0</div></div></div></div><canvas id=\"chart\" width=\"600\" height=\"80\"></canvas><div id=\"ev\"></div><div id=\"err\"></div></div><div id=\"panel\"><h2>Pond Conditions</h2><div class=\"ctrl\"><label>Temperature <span class=\"v\" id=\"v-temp\">22&deg;C</span></label><input type=\"range\" id=\"c-temp\" min=\"0\" max=\"40\" value=\"22\" step=\"1\"></div><div class=\"ctrl\"><label>Water Quality <span class=\"v\" id=\"v-water\">70%</span></label><input type=\"range\" id=\"c-water\" min=\"0\" max=\"100\" value=\"70\" step=\"1\"></div><div class=\"ctrl\"><label>Insect Abundance <span class=\"v\" id=\"v-food\">60%</span></label><input type=\"range\" id=\"c-food\" min=\"0\" max=\"100\" value=\"60\" step=\"1\"></div><div class=\"ctrl\"><label>Predator Pressure <span class=\"v\" id=\"v-pred\">15%</span></label><input type=\"range\" id=\"c-pred\" min=\"0\" max=\"100\" value=\"15\" step=\"1\"></div><div class=\"ctrl\"><label>Disease Risk <span class=\"v\" id=\"v-dis\">5%</span></label><input type=\"range\" id=\"c-dis\" min=\"0\" max=\"100\" value=\"5\" step=\"1\"></div><div class=\"ctrl\"><label>Rainfall <span class=\"v\" id=\"v-rain\">50%</span></label><input type=\"range\" id=\"c-rain\" min=\"0\" max=\"100\" value=\"50\" step=\"1\"></div><div class=\"ctrl\"><label>Time Speed <span class=\"v\" id=\"v-speed\">2&times;</span></label><input type=\"range\" id=\"c-speed\" min=\"0\" max=\"10\" value=\"2\" step=\"1\"></div><h2 class=\"section-divider\">Presets</h2><div class=\"pre\"><button data-preset=\"paradise\">Paradise</button><button data-preset=\"drought\">Drought</button><button data-preset=\"winter\">Cold Snap</button><button data-preset=\"plague\">Plague</button><button data-preset=\"overpop\">Overpopulation</button><button id=\"reset\">Reset Pond</button></div></div></div><script>window.onerror=function(msg,src,ln,col,e){var er=document.getElementById('err');if(er){er.style.display='block';er.textContent='ERROR: '+msg+'\\nLine '+ln+':'+col+(e&&e.stack?'\\n'+e.stack:'')}return false};try{(function(){var canvas=document.getElementById('canvas');var ctx=canvas.getContext('2d');var chart=document.getElementById('chart');var cctx=chart.getContext('2d');var frogs=[];var tadpoles=[];var ripples=[];var lilies=[];var insects=[];var day=0;var dayFrac=0;var totalBirths=0;var totalDeaths=0;var lastBirthCheck=-99;var deadAnnounced=false;var history=[];var maxHistory=240;var cond={temp:22,water:70,food:60,pred:15,dis:5,rain:50,speed:2};var pondCx=400,pondCy=300,pondR=200;var W=800,H=600;var initialized=false;function resize(){var pondEl=document.getElementById('pond');var rect=pondEl.getBoundingClientRect();W=Math.floor(rect.width);H=Math.floor(rect.height);if(W<50)W=Math.max(400,document.documentElement.clientWidth-260);if(H<50)H=Math.max(400,document.documentElement.clientHeight);canvas.width=W;canvas.height=H;pondCx=W/2;pondCy=H/2-20;pondR=Math.max(80,Math.min(W*0.45,(H-130)*0.5));var crect=chart.getBoundingClientRect();var cw=Math.floor(crect.width);if(cw<50)cw=W-20;chart.width=cw;chart.height=80}function rand(a,b){return a+Math.random()*(b-a)}function randAngle(){return Math.random()*Math.PI*2}function pointInPond(x,y){var dx=x-pondCx,dy=y-pondCy;return dx*dx+dy*dy<pondR*pondR*0.9}function randomPondPoint(){var a=randAngle();var r=Math.sqrt(Math.random())*pondR*0.85;return{x:pondCx+Math.cos(a)*r,y:pondCy+Math.sin(a)*r}}function makeFrog(x,y){var roll=Math.random();var color=roll<0.08?'#a8c95a':(roll<0.18?'#7ba84a':(roll<0.45?'#5c8a3a':'#3d6b25'));return{x:x,y:y,tx:x,ty:y,age:Math.floor(rand(60,220)),health:100,hunger:rand(20,60),sex:Math.random()<0.5?'M':'F',sick:false,hopTimer:rand(0,80),color:color,size:rand(7,11),bob:Math.random()*Math.PI*2,jumpPhase:0}}function makeTadpole(x,y){return{x:x,y:y,age:0,health:100,bob:Math.random()*Math.PI*2,dir:randAngle()}}function init(){frogs=[];tadpoles=[];ripples=[];lilies=[];insects=[];day=0;totalBirths=0;totalDeaths=0;lastBirthCheck=-99;deadAnnounced=false;history=[];for(var i=0;i<14;i++){var p=randomPondPoint();frogs.push(makeFrog(p.x,p.y))}var lilyCount=Math.max(4,Math.floor(pondR/35));for(var i=0;i<lilyCount;i++){var p=randomPondPoint();lilies.push({x:p.x,y:p.y,r:rand(16,28),rot:randAngle()})}for(var i=0;i<18;i++){insects.push({x:rand(0,W),y:rand(0,Math.max(100,H-100)),vx:rand(-0.3,0.3),vy:rand(-0.3,0.3)})}initialized=true}function ev(msg,kind){var el=document.createElement('div');el.className='ev-msg'+(kind?' '+kind:'');el.textContent=msg;document.getElementById('ev').appendChild(el);setTimeout(function(){el.classList.add('show')},10);setTimeout(function(){el.classList.remove('show')},3800);setTimeout(function(){if(el.parentNode)el.parentNode.removeChild(el)},4300)}function step(dt){dayFrac+=dt*cond.speed*0.005;while(dayFrac>=1){dayFrac-=1;day++;dailyTick()}var spdMul=Math.max(0.2,cond.temp/22);for(var i=0;i<frogs.length;i++){var f=frogs[i];f.bob+=dt*0.005;f.hopTimer-=dt*cond.speed*spdMul;if(f.hopTimer<=0){var a=randAngle();var d=rand(20,55);var nx=f.x+Math.cos(a)*d;var ny=f.y+Math.sin(a)*d;if(pointInPond(nx,ny)){f.tx=nx;f.ty=ny;f.jumpPhase=1;addRipple(f.x,f.y,0.6)}f.hopTimer=rand(60,180)/Math.max(0.4,cond.temp/22)}var dx=f.tx-f.x,dy=f.ty-f.y;var dist=Math.sqrt(dx*dx+dy*dy);if(dist>0.5){var spd=0.6*Math.min(cond.speed,3);var mv=Math.min(spd,dist);f.x+=(dx/dist)*mv;f.y+=(dy/dist)*mv;if(f.jumpPhase>0)f.jumpPhase=Math.max(0,f.jumpPhase-0.04)}}for(var i=0;i<tadpoles.length;i++){var t=tadpoles[i];t.bob+=dt*0.01;t.dir+=rand(-0.1,0.1);t.x+=Math.cos(t.dir)*0.4*cond.speed;t.y+=Math.sin(t.dir)*0.4*cond.speed;if(!pointInPond(t.x,t.y)){t.dir+=Math.PI;t.x+=Math.cos(t.dir)*2;t.y+=Math.sin(t.dir)*2}}for(var i=0;i<insects.length;i++){var ins=insects[i];ins.vx+=rand(-0.04,0.04);ins.vy+=rand(-0.04,0.04);ins.vx=Math.max(-0.5,Math.min(0.5,ins.vx));ins.vy=Math.max(-0.5,Math.min(0.5,ins.vy));ins.x+=ins.vx*cond.speed;ins.y+=ins.vy*cond.speed;if(ins.x<0)ins.x=W;if(ins.x>W)ins.x=0;if(ins.y<0)ins.y=H-100;if(ins.y>H-100)ins.y=0}for(var i=ripples.length-1;i>=0;i--){ripples[i].r+=dt*0.06;ripples[i].life-=dt*0.0015;if(ripples[i].life<=0)ripples.splice(i,1)}var targetInsects=Math.floor(5+cond.food*0.25);while(insects.length<targetInsects){insects.push({x:rand(0,W),y:rand(0,Math.max(100,H-100)),vx:rand(-0.3,0.3),vy:rand(-0.3,0.3)})}while(insects.length>targetInsects+3){insects.pop()}}function dailyTick(){var tempStress=0;if(cond.temp<8)tempStress=(8-cond.temp)*0.45;else if(cond.temp<16)tempStress=(16-cond.temp)*0.12;else if(cond.temp>33)tempStress=(cond.temp-33)*0.5;else if(cond.temp>28)tempStress=(cond.temp-28)*0.18;var waterStress=cond.water<50?(50-cond.water)*0.06:0;var foodStress=cond.food<40?(40-cond.food)*0.05:0;var rainStress=cond.rain<25?(25-cond.rain)*0.08:0;for(var i=frogs.length-1;i>=0;i--){var f=frogs[i];f.age+=1;var dmg=tempStress+waterStress+foodStress+rainStress;if(f.sick)dmg+=2.5;if(f.age>700)dmg+=(f.age-700)*0.04;f.health-=dmg;if(dmg<1.5)f.health=Math.min(100,f.health+1.2);if(!f.sick&&Math.random()<cond.dis*0.0006){f.sick=true}if(f.sick&&Math.random()<0.08){for(var j=0;j<frogs.length;j++){if(j===i)continue;var of=frogs[j];var ddx=of.x-f.x,ddy=of.y-f.y;if(ddx*ddx+ddy*ddy<1800&&!of.sick&&Math.random()<0.25)of.sick=true}}if(f.sick&&Math.random()<0.05){f.sick=false;f.health=Math.min(f.health,60)}if(Math.random()<cond.pred*0.0009){frogs.splice(i,1);totalDeaths++;addRipple(f.x,f.y,2.5);continue}if(f.health<=0){frogs.splice(i,1);totalDeaths++;addRipple(f.x,f.y,1.2);continue}}if(cond.temp>=15&&cond.temp<=30&&cond.water>=40&&cond.rain>=25){var males=0,females=0;for(var i=0;i<frogs.length;i++){if(frogs[i].age>120&&frogs[i].health>55&&!frogs[i].sick){if(frogs[i].sex==='M')males++;else females++}}var pairs=Math.min(males,females);var capacity=55+(cond.food-50)*0.4-cond.pred*0.2;capacity=Math.max(15,capacity);var crowding=(frogs.length+tadpoles.length*0.4)/capacity;if(day-lastBirthCheck>=3&&pairs>0&&Math.random()<0.55/Math.max(1,crowding*crowding)){var baseClutch=rand(3,9);var clutchSize=Math.floor(baseClutch*(cond.food/65)/Math.max(1,crowding*0.7));clutchSize=Math.min(clutchSize,15);if(clutchSize>0){for(var i=0;i<clutchSize;i++){var p=randomPondPoint();tadpoles.push(makeTadpole(p.x,p.y))}lastBirthCheck=day;if(clutchSize>=6)ev(clutchSize+' tadpoles hatched!','good')}}}for(var i=tadpoles.length-1;i>=0;i--){var t=tadpoles[i];t.age+=1;if(cond.water<35)t.health-=4;if(cond.temp<8||cond.temp>35)t.health-=3;if(Math.random()<cond.pred*0.0004)t.health-=15;if(t.health<=0){tadpoles.splice(i,1);continue}if(t.age>=12){tadpoles.splice(i,1);if(Math.random()<0.55){frogs.push(makeFrog(t.x,t.y));frogs[frogs.length-1].age=0;totalBirths++}}}if(frogs.length===0&&tadpoles.length===0&&!deadAnnounced&&day>10){ev('The pond is silent. No frogs remain.','bad');deadAnnounced=true}if(frogs.length>0)deadAnnounced=false;history.push({d:day,f:frogs.length,t:tadpoles.length});if(history.length>maxHistory)history.shift()}function addRipple(x,y,scale){ripples.push({x:x,y:y,r:3*(scale||1),life:1})}function drawPond(){var g=ctx.createRadialGradient(pondCx,pondCy,0,pondCx,pondCy,Math.max(W,H));g.addColorStop(0,'#1a2a22');g.addColorStop(1,'#0a1418');ctx.fillStyle=g;ctx.fillRect(0,0,W,H);ctx.fillStyle='#243d22';ctx.beginPath();ctx.arc(pondCx,pondCy,pondR+22,0,Math.PI*2);ctx.fill();ctx.fillStyle='#2d4d28';ctx.beginPath();ctx.arc(pondCx,pondCy,pondR+12,0,Math.PI*2);ctx.fill();var wg=ctx.createRadialGradient(pondCx-pondR*0.2,pondCy-pondR*0.3,0,pondCx,pondCy,pondR);if(cond.water<35){wg.addColorStop(0,'#5a5a2a');wg.addColorStop(1,'#3d4520')}else if(cond.water<60){wg.addColorStop(0,'#3a5d4a');wg.addColorStop(1,'#1f4548')}else{wg.addColorStop(0,'#3d7785');wg.addColorStop(1,'#1a4a55')}ctx.fillStyle=wg;ctx.beginPath();ctx.arc(pondCx,pondCy,pondR,0,Math.PI*2);ctx.fill();ctx.save();ctx.beginPath();ctx.arc(pondCx,pondCy,pondR,0,Math.PI*2);ctx.clip();ctx.globalAlpha=0.12;ctx.strokeStyle='#bfe5e8';ctx.lineWidth=1;var tm=Date.now()*0.0002;for(var i=0;i<8;i++){var yy=pondCy-pondR+((i+tm)%1)*pondR*2;ctx.beginPath();ctx.moveTo(pondCx-pondR*0.7,yy);ctx.bezierCurveTo(pondCx-pondR*0.3,yy-3,pondCx+pondR*0.3,yy+3,pondCx+pondR*0.7,yy);ctx.stroke()}ctx.restore();for(var i=0;i<lilies.length;i++)drawLily(lilies[i]);ctx.save();ctx.beginPath();ctx.arc(pondCx,pondCy,pondR,0,Math.PI*2);ctx.clip();for(var i=0;i<ripples.length;i++){var r=ripples[i];ctx.globalAlpha=r.life*0.55;ctx.strokeStyle='#bfe5e8';ctx.lineWidth=1.2;ctx.beginPath();ctx.arc(r.x,r.y,r.r,0,Math.PI*2);ctx.stroke()}ctx.restore();ctx.globalAlpha=1}function drawLily(l){ctx.save();ctx.translate(l.x,l.y);ctx.rotate(l.rot);var grd=ctx.createRadialGradient(0,0,0,0,0,l.r);grd.addColorStop(0,'#4a8a45');grd.addColorStop(1,'#1f4d28');ctx.fillStyle=grd;ctx.beginPath();ctx.moveTo(0,0);ctx.arc(0,0,l.r,0.35,Math.PI*2);ctx.lineTo(0,0);ctx.fill();ctx.strokeStyle='rgba(20,50,28,0.6)';ctx.lineWidth=1;for(var a=1;a<6;a++){ctx.beginPath();ctx.moveTo(0,0);var ang=0.35+(a/6)*(Math.PI*2-0.35);ctx.lineTo(Math.cos(ang)*l.r*0.92,Math.sin(ang)*l.r*0.92);ctx.stroke()}ctx.restore()}function drawFrog(f){var bob=Math.sin(f.bob)*0.4-f.jumpPhase*4;ctx.save();ctx.translate(f.x,f.y+bob);ctx.fillStyle='rgba(0,0,0,0.3)';ctx.beginPath();ctx.ellipse(1,3-bob*0.3,f.size*1.05,f.size*0.35,0,0,Math.PI*2);ctx.fill();var body=f.sick?'#7a8a44':f.color;ctx.fillStyle=body;ctx.beginPath();ctx.ellipse(0,0,f.size,f.size*0.72,0,0,Math.PI*2);ctx.fill();ctx.fillStyle='rgba(255,255,255,0.12)';ctx.beginPath();ctx.ellipse(-f.size*0.3,-f.size*0.3,f.size*0.35,f.size*0.18,0.4,0,Math.PI*2);ctx.fill();var ey=-f.size*0.45;ctx.fillStyle=body;ctx.beginPath();ctx.arc(-f.size*0.4,ey,f.size*0.3,0,Math.PI*2);ctx.arc(f.size*0.4,ey,f.size*0.3,0,Math.PI*2);ctx.fill();ctx.fillStyle=f.sick?'#cca838':'#1a1a0a';ctx.beginPath();ctx.arc(-f.size*0.4,ey,f.size*0.22,0,Math.PI*2);ctx.arc(f.size*0.4,ey,f.size*0.22,0,Math.PI*2);ctx.fill();ctx.fillStyle='#fff';ctx.beginPath();ctx.arc(-f.size*0.34,ey-f.size*0.06,f.size*0.08,0,Math.PI*2);ctx.arc(f.size*0.46,ey-f.size*0.06,f.size*0.08,0,Math.PI*2);ctx.fill();if(f.health<60){ctx.fillStyle='rgba(0,0,0,0.5)';ctx.fillRect(-f.size,f.size+2,f.size*2,2.5);ctx.fillStyle=f.health>30?'#d4b842':'#d65f3f';ctx.fillRect(-f.size,f.size+2,(f.size*2)*(f.health/100),2.5)}ctx.restore()}function drawTadpole(t){ctx.save();ctx.translate(t.x,t.y);ctx.rotate(t.dir);ctx.fillStyle='#1a2614';ctx.beginPath();ctx.ellipse(0,0,3.2,2,0,0,Math.PI*2);ctx.fill();ctx.strokeStyle='#1a2614';ctx.lineWidth=1.3;ctx.beginPath();ctx.moveTo(-2,0);ctx.quadraticCurveTo(-5,Math.sin(t.bob)*2,-8,Math.sin(t.bob)*1);ctx.stroke();ctx.restore()}function drawInsect(ins){ctx.fillStyle='rgba(230,210,110,0.75)';ctx.beginPath();ctx.arc(ins.x,ins.y,1.3,0,Math.PI*2);ctx.fill()}function drawChart(){var w=chart.width,h=chart.height;cctx.clearRect(0,0,w,h);if(history.length<2){cctx.fillStyle='#7da7a3';cctx.font='11px system-ui';cctx.fillText('Population over time (start tweaking to see results)',12,16);return}var maxVal=10;for(var i=0;i<history.length;i++){var total=history[i].f+history[i].t;if(total>maxVal)maxVal=total}cctx.fillStyle='rgba(120,160,100,0.25)';cctx.beginPath();cctx.moveTo(0,h);for(var i=0;i<history.length;i++){var x=(i/(maxHistory-1))*w;var y=h-((history[i].f+history[i].t)/maxVal)*(h-18)-6;cctx.lineTo(x,y)}cctx.lineTo(((history.length-1)/(maxHistory-1))*w,h);cctx.closePath();cctx.fill();cctx.strokeStyle='#6fb89a';cctx.lineWidth=2;cctx.beginPath();for(var i=0;i<history.length;i++){var x=(i/(maxHistory-1))*w;var y=h-(history[i].f/maxVal)*(h-18)-6;if(i===0)cctx.moveTo(x,y);else cctx.lineTo(x,y)}cctx.stroke();cctx.fillStyle='#98c5b8';cctx.font='10px system-ui';cctx.fillText('peak '+maxVal,8,14);cctx.fillStyle='#6fb89a';cctx.fillRect(80,8,8,8);cctx.fillStyle='#cfe5dd';cctx.fillText('adults',92,15);cctx.fillStyle='rgba(120,160,100,0.5)';cctx.fillRect(140,8,8,8);cctx.fillStyle='#cfe5dd';cctx.fillText('+ tadpoles',152,15)}function draw(){if(!initialized)return;drawPond();for(var i=0;i<tadpoles.length;i++)drawTadpole(tadpoles[i]);for(var i=0;i<insects.length;i++)drawInsect(insects[i]);for(var i=0;i<frogs.length;i++)drawFrog(frogs[i]);drawChart();document.getElementById('s-frogs').textContent=frogs.length;document.getElementById('s-tads').textContent=tadpoles.length;document.getElementById('s-day').textContent=day;document.getElementById('s-births').textContent=totalBirths;document.getElementById('s-deaths').textContent=totalDeaths}var lastT=0;function loop(t){var dt=lastT===0?16:Math.min(60,t-lastT);lastT=t;if(initialized)step(dt);draw();requestAnimationFrame(loop)}function bind(id,key,fmt){var el=document.getElementById('c-'+id);var lbl=document.getElementById('v-'+id);function upd(){cond[key]=parseFloat(el.value);lbl.innerHTML=fmt(cond[key])}el.addEventListener('input',upd);upd()}bind('temp','temp',function(v){return v+'&deg;C'});bind('water','water',function(v){return v+'%'});bind('food','food',function(v){return v+'%'});bind('pred','pred',function(v){return v+'%'});bind('dis','dis',function