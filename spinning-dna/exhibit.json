  "content": {
    "type": "html",
    "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Spinning DNA</title>\n  <style>\n    * {\n      margin: 0;\n      padding: 0;\n      box-sizing: border-box;\n    }\n\n    body {\n      min-height: 100vh;\n      background: radial-gradient(ellipse at center, #0a0a1a 0%, #000005 100%);\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      overflow: hidden;\n      font-family: 'Segoe UI', system-ui, sans-serif;\n    }\n\n    .stars {\n      position: fixed;\n      top: 0;\n      left: 0;\n      width: 100%;\n      height: 100%;\n      pointer-events: none;\n      z-index: 0;\n    }\n\n    .star {\n      position: absolute;\n      width: 2px;\n      height: 2px;\n      background: white;\n      border-radius: 50%;\n      animation: twinkle 3s ease-in-out infinite;\n    }\n\n    @keyframes twinkle {\n      0%, 100% { opacity: 0.3; transform: scale(1); }\n      50% { opacity: 1; transform: scale(1.2); }\n    }\n\n    .container {\n      position: relative;\n      z-index: 1;\n      perspective: 1200px;\n      perspective-origin: 50% 50%;\n    }\n\n    .dna-helix {\n      position: relative;\n      width: 200px;\n      height: 500px;\n      transform-style: preserve-3d;\n      animation: rotate 8s linear infinite;\n    }\n\n    @keyframes rotate {\n      from { transform: rotateY(0deg); }\n      to { transform: rotateY(360deg); }\n    }\n\n    .base-pair {\n      position: absolute;\n      width: 100%;\n      height: 4px;\n      transform-style: preserve-3d;\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n    }\n\n    .nucleotide {\n      width: 24px;\n      height: 24px;\n      border-radius: 50%;\n      position: relative;\n      box-shadow: 0 0 20px currentColor, 0 0 40px currentColor, inset 0 0 10px rgba(255,255,255,0.3);\n      animation: pulse 2s ease-in-out infinite;\n    }\n\n    .nucleotide::after {\n      content: attr(data-base);\n      position: absolute;\n      top: 50%;\n      left: 50%;\n      transform: translate(-50%, -50%);\n      font-size: 10px;\n      font-weight: bold;\n      color: rgba(255,255,255,0.9);\n      text-shadow: 0 0 5px currentColor;\n    }\n\n    @keyframes pulse {\n      0%, 100% { transform: scale(1); }\n      50% { transform: scale(1.1); }\n    }\n\n    .adenine { background: linear-gradient(135deg, #ff4444, #cc0000); color: #ff6666; }\n    .thymine { background: linear-gradient(135deg, #44ff44, #00cc00); color: #66ff66; }\n    .guanine { background: linear-gradient(135deg, #4444ff, #0000cc); color: #6666ff; }\n    .cytosine { background: linear-gradient(135deg, #ffff44, #cccc00); color: #ffff66; }\n\n    .bond {\n      flex: 1;\n      height: 3px;\n      margin: 0 5px;\n      background: linear-gradient(90deg, \n        transparent 0%, \n        rgba(255,255,255,0.1) 10%,\n        rgba(255,255,255,0.4) 50%,\n        rgba(255,255,255,0.1) 90%,\n        transparent 100%);\n      position: relative;\n    }\n\n    .bond::before {\n      content: '';\n      position: absolute;\n      top: -1px;\n      left: 0;\n      right: 0;\n      height: 5px;\n      background: linear-gradient(90deg,\n        transparent 0%,\n        rgba(100,200,255,0.2) 50%,\n        transparent 100%);\n      filter: blur(2px);\n    }\n\n    .backbone {\n      position: absolute;\n      width: 8px;\n      height: 100%;\n      border-radius: 4px;\n    }\n\n    .backbone-left {\n      left: 8px;\n      background: linear-gradient(180deg, #00ffff, #0088ff, #00ffff);\n      box-shadow: 0 0 15px #00aaff, 0 0 30px rgba(0,170,255,0.5);\n    }\n\n    .backbone-right {\n      right: 8px;\n      background: linear-gradient(180deg, #ff00ff, #ff0088, #ff00ff);\n      box-shadow: 0 0 15px #ff00aa, 0 0 30px rgba(255,0,170,0.5);\n    }\n\n    .title {\n      position: absolute;\n      top: 30px;\n      left: 50%;\n      transform: translateX(-50%);\n      color: #fff;\n      font-size: 28px;\n      font-weight: 300;\n      letter-spacing: 8px;\n      text-transform: uppercase;\n      text-shadow: 0 0 20px rgba(100,200,255,0.8), 0 0 40px rgba(100,200,255,0.4);\n      z-index: 2;\n    }\n\n    .controls {\n      position: absolute;\n      bottom: 30px;\n      left: 50%;\n      transform: translateX(-50%);\n      display: flex;\n      gap: 15px;\n      z-index: 2;\n    }\n\n    .btn {\n      padding: 10px 25px;\n      background: rgba(255,255,255,0.1);\n      border: 1px solid rgba(255,255,255,0.3);\n      border-radius: 25px;\n      color: #fff;\n      font-size: 14px;\n      cursor: pointer;\n      transition: all 0.3s ease;\n      backdrop-filter: blur(10px);\n    }\n\n    .btn:hover {\n      background: rgba(255,255,255,0.2);\n      border-color: rgba(255,255,255,0.5);\n      box-shadow: 0 0 20px rgba(100,200,255,0.3);\n    }\n\n    .btn.active {\n      background: rgba(100,200,255,0.3);\n      border-color: #00aaff;\n    }\n\n    .speed-control {\n      display: flex;\n      align-items: center;\n      gap: 10px;\n      color: rgba(255,255,255,0.7);\n      font-size: 12px;\n    }\n\n    .speed-slider {\n      width: 100px;\n      -webkit-appearance: none;\n      appearance: none;\n      height: 4px;\n      background: rgba(255,255,255,0.2);\n      border-radius: 2px;\n      outline: none;\n    }\n\n    .speed-slider::-webkit-slider-thumb {\n      -webkit-appearance: none;\n      appearance: none;\n      width: 16px;\n      height: 16px;\n      background: linear-gradient(135deg, #00aaff, #00ffff);\n      border-radius: 50%;\n      cursor: pointer;\n      box-shadow: 0 0 10px rgba(0,170,255,0.5);\n    }\n\n    .legend {\n      position: absolute;\n      top: 80px;\n      right: 30px;\n      display: flex;\n      flex-direction: column;\n      gap: 8px;\n      z-index: 2;\n    }\n\n    .legend-item {\n      display: flex;\n      align-items: center;\n      gap: 8px;\n      color: rgba(255,255,255,0.7);\n      font-size: 12px;\n    }\n\n    .legend-dot {\n      width: 12px;\n      height: 12px;\n      border-radius: 50%;\n    }\n\n    .legend-dot.a { background: #ff4444; box-shadow: 0 0 8px #ff4444; }\n    .legend-dot.t { background: #44ff44; box-shadow: 0 0 8px #44ff44; }\n    .legend-dot.g { background: #4444ff; box-shadow: 0 0 8px #4444ff; }\n    .legend-dot.c { background: #ffff44; box-shadow: 0 0 8px #ffff44; }\n\n    .info {\n      position: absolute;\n      bottom: 80px;\n      left: 50%;\n      transform: translateX(-50%);\n      color: rgba(255,255,255,0.5);\n      font-size: 11px;\n      text-align: center;\n      z-index: 2;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"stars\" id=\"stars\"></div>\n  \n  <h1 class=\"title\">DNA Helix</h1>\n  \n  <div class=\"legend\">\n    <div class=\"legend-item\"><div class=\"legend-dot a\"></div>Adenine (A)</div>\n    <div class=\"legend-item\"><div class=\"legend-dot t\"></div>Thymine (T)</div>\n    <div class=\"legend-item\"><div class=\"legend-dot g\"></div>Guanine (G)</div>\n    <div class=\"legend-item\"><div class=\"legend-dot c\"></div>Cytosine (C)</div>\n  </div>\n  \n  <div class=\"container\">\n    <div class=\"dna-helix\" id=\"dna\">\n      <div class=\"backbone backbone-left\"></div>\n      <div class=\"backbone backbone-right\"></div>\n    </div>\n  </div>\n  \n  <p class=\"info\">A pairs with T • G pairs with C</p>\n  \n  <div class=\"controls\">\n    <button class=\"btn\" id=\"pauseBtn\">Pause</button>\n    <div class=\"speed-control\">\n      <span>Speed:</span>\n      <input type=\"range\" class=\"speed-slider\" id=\"speedSlider\" min=\"2\" max=\"20\" value=\"8\">\n    </div>\n    <button class=\"btn\" id=\"reverseBtn\">Reverse</button>\n  </div>\n\n  <script>\n    // Create starfield background\n    const starsContainer = document.getElementById('stars');\n    for (let i = 0; i < 150; i++) {\n      const star = document.createElement('div');\n      star.className = 'star';\n      star.style.left = Math.random() * 100 + '%';\n      star.style.top = Math.random() * 100 + '%';\n      star.style.animationDelay = Math.random() * 3 + 's';\n      star.style.opacity = Math.random() * 0.5 + 0.3;\n      starsContainer.appendChild(star);\n    }\n\n    // DNA base pairs - A-T and G-C pairings\n    const basePairs = [\n      ['A', 'T'], ['G', 'C'], ['T', 'A'], ['C', 'G'],\n      ['A', 'T'], ['C', 'G'], ['G', 'C'], ['T', 'A'],\n      ['G', 'C'], ['A', 'T'], ['T', 'A'], ['C', 'G'],\n      ['A', 'T'], ['G', 'C'], ['C', 'G'], ['T', 'A'],\n      ['G', 'C'], ['A', 'T'], ['A', 'T'], ['C', 'G'],\n      ['T', 'A'], ['G', 'C'], ['C', 'G'], ['A', 'T'],\n      ['G', 'C'], ['T', 'A']\n    ];\n\n    const baseClasses = {\n      'A': 'adenine',\n      'T': 'thymine',\n      'G': 'guanine',\n      'C': 'cytosine'\n    };\n\n    const dna = document.getElementById('dna');\n    const numPairs = basePairs.length;\n    const helixHeight = 500;\n    const spacing = helixHeight / numPairs;\n    const helixRadius = 80;\n\n    // Create base pairs in helix formation\n    basePairs.forEach((pair, i) => {\n      const basePairEl = document.createElement('div');\n      basePairEl.className = 'base-pair';\n      \n      const angle = (i / numPairs) * Math.PI * 4; // Two full rotations\n      const y = i * spacing;\n      const rotateY = (angle * 180 / Math.PI);\n      \n      basePairEl.style.top = y + 'px';\n      basePairEl.style.transform = `rotateY(${rotateY}deg) translateZ(0px)`;\n      basePairEl.style.animationDelay = `${i * 0.1}s`;\n\n      const leftNuc = document.createElement('div');\n      leftNuc.className = `nucleotide ${baseClasses[pair[0]]}`;\n      leftNuc.setAttribute('data-base', pair[0]);\n      leftNuc.style.animationDelay = `${i * 0.15}s`;\n\n      const bond = document.createElement('div');\n      bond.className = 'bond';\n\n      const rightNuc = document.createElement('div');\n      rightNuc.className = `nucleotide ${baseClasses[pair[1]]}`;\n      rightNuc.setAttribute('data-base', pair[1]);\n      rightNuc.style.animationDelay = `${i * 0.15 + 0.5}s`;\n\n      basePairEl.appendChild(leftNuc);\n      basePairEl.appendChild(bond);\n      basePairEl.appendChild(rightNuc);\n      dna.appendChild(basePairEl);\n    });\n\n    // Controls\n    let isPaused = false;\n    let isReversed = false;\n    let speed = 8;\n\n    const pauseBtn = document.getElementById('pauseBtn');\n    const reverseBtn = document.getElementById('reverseBtn');\n    const speedSlider = document.getElementById('speedSlider');\n\n    pauseBtn.addEventListener('click', () => {\n      isPaused = !isPaused;\n      dna.style.animationPlayState = isPaused ? 'paused' : 'running';\n      pauseBtn.textContent = isPaused ? 'Play' : 'Pause';\n      pauseBtn.classList.toggle('active', isPaused);\n    });\n\n    reverseBtn.addEventListener('click', () => {\n      isReversed = !isReversed;\n      dna.style.animationDirection = isReversed ? 'reverse' : 'normal';\n      reverseBtn.classList.toggle('active', isReversed);\n    });\n\n    speedSlider.addEventListener('input', (e) => {\n      speed = e.target.value;\n      dna.style.animationDuration = speed + 's';\n    });\n  </script>\n</body>\n</html>"
  },
  "permissions": {
    "allowNetwork": false,
    "allowStorage": false,
    "allowClipboard": false
  }
}
